          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">World</string>
              <string name="Source"><![CDATA[-- Client-side world visuals:
--  * channel visibility: parts tagged "ChannelPart" only show in the right inspection channel
--    (CamOnly on the Lane Cam, NotOnCam everywhere except the Lane Cam, UVOnly under UV light)
--  * the UV flashlight
--  * little animations that make tells readable: blinking, finger counts that change,
--    TV-static skin, a smile that grows when you look away, blinking traffic light.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local World = {}

local player = Players.LocalPlayer
World.mode = "Normal" -- "Normal" | "LaneCam"
World.uv = false

local function setGuiEnabled(part: Instance, enabled: boolean)
	for _, d in part:GetDescendants() do
		if d:IsA("SurfaceGui") or d:IsA("BillboardGui") then
			d.Enabled = enabled
		end
	end
end

local function applyChannel(part: Instance)
	if not part:IsA("BasePart") then
		return
	end
	local mode = part:GetAttribute("Channel")
	local visible = true
	if mode == "CamOnly" then
		visible = World.mode == "LaneCam"
	elseif mode == "NotOnCam" then
		visible = World.mode ~= "LaneCam"
	elseif mode == "UVOnly" then
		visible = World.uv
	end
	part.LocalTransparencyModifier = if visible then 0 else 1
	setGuiEnabled(part, visible)
end

function World.refreshChannels()
	for _, part in CollectionService:GetTagged("ChannelPart") do
		applyChannel(part)
	end
end

function World.setMode(mode: string)
	World.mode = mode
	World.refreshChannels()
end

local uvLight: SpotLight? = nil
function World.setUV(on: boolean)
	World.uv = on
	World.refreshChannels()
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	if on and head then
		if not uvLight or not uvLight.Parent then
			local light = Instance.new("SpotLight")
			light.Name = "UVLight"
			light.Color = Color3.fromRGB(170, 70, 255)
			light.Brightness = 4
			light.Range = 40
			light.Angle = 50
			light.Face = Enum.NormalId.Front
			light.Parent = head
			uvLight = light
		end
	elseif uvLight then
		uvLight:Destroy()
		uvLight = nil
	end
end

---------------------------------------------------------------------------
-- Tell animations
---------------------------------------------------------------------------

local blinkAt: { [Instance]: number } = {}
local fingerAt: { [Instance]: number } = {}
local smiles: { [Instance]: number } = {}

local function faceOf(head: Instance): Frame?
	local gui = head:FindFirstChild("FaceGui")
	return gui and gui:FindFirstChild("Face") :: Frame?
end

local function animateCars(now: number)
	local map = workspace:FindFirstChild("Munchies")
	local dynamic = map and map:FindFirstChild("Dynamic")
	local cars = dynamic and dynamic:FindFirstChild("Cars")
	if not cars then
		return
	end
	local camera = workspace.CurrentCamera
	for _, car in cars:GetChildren() do
		for _, d in car:GetChildren() do
			if d:IsA("BasePart") and d:GetAttribute("IsDriverHead") then
				local face = faceOf(d)
				if face and d:GetAttribute("Blinks") then
					local nextBlink = blinkAt[d] or (now + math.random() * 3)
					local closed = now >= nextBlink and now < nextBlink + 0.14
					for _, lid in { "LidL", "LidR" } do
						local f = face:FindFirstChild(lid) :: Frame?
						if f then
							f.Visible = closed
						end
					end
					if now >= nextBlink + 0.14 then
						blinkAt[d] = now + 2 + math.random() * 3
					elseif not blinkAt[d] then
						blinkAt[d] = nextBlink
					end
				end
				if face and d:GetAttribute("GrowingSmile") and camera then
					local toHead = (d.Position - camera.CFrame.Position).Unit
					local looking = camera.CFrame.LookVector:Dot(toHead) > 0.93
					local width = smiles[d] or 0.5
					if not looking then
						width = math.min(0.95, width + 0.004)
					end
					smiles[d] = width
					local mouth = face:FindFirstChild("Mouth") :: Frame?
					local cover = face:FindFirstChild("MouthCover") :: Frame?
					if mouth and cover then
						mouth.Size = UDim2.fromScale(width, 0.16)
						cover.Size = UDim2.fromScale(width + 0.06, 0.12)
					end
				end
				if d:GetAttribute("Static") then
					local g = 0.4 + math.random() * 0.5
					d.Color = Color3.new(g, g, g)
				end
			elseif d:IsA("Model") and d.Name == "Hand" and d:GetAttribute("FingerCycle") then
				local nextCycle = fingerAt[d] or 0
				if now >= nextCycle then
					fingerAt[d] = now + 0.9
					local show = math.random(6, 7)
					for _, finger in d:GetChildren() do
						local digit = finger:GetAttribute("Digit")
						if digit and finger:IsA("BasePart") then
							finger.LocalTransparencyModifier = if digit <= show then 0 else 1
						end
					end
				end
			end
		end
	end
end

local function blinkTrafficLight(now: number)
	local on = math.floor(now * 1.2) % 2 == 0
	for _, part in CollectionService:GetTagged("BlinkLight") do
		if part:IsA("BasePart") then
			part.LocalTransparencyModifier = if on then 0 else 0.85
			local light = part:FindFirstChildOfClass("PointLight")
			if light then
				light.Enabled = on
			end
		end
	end
end

function World.init()
	CollectionService:GetInstanceAddedSignal("ChannelPart"):Connect(function(part)
		task.defer(applyChannel, part)
	end)
	World.refreshChannels()
	player.CharacterAdded:Connect(function()
		uvLight = nil
		if World.uv then
			task.wait(0.5)
			World.setUV(true)
		end
	end)
	local accumulator = 0
	RunService.RenderStepped:Connect(function(dt)
		accumulator += dt
		if accumulator < 1 / 30 then
			return
		end
		accumulator = 0
		local now = os.clock()
		animateCars(now)
		blinkTrafficLight(now)
	end)
	-- forget destroyed heads
	task.spawn(function()
		while true do
			task.wait(10)
			for head in blinkAt do
				if not head.Parent then
					blinkAt[head] = nil
					smiles[head] = nil
				end
			end
			for hand in fingerAt do
				if not hand.Parent then
					fingerAt[hand] = nil
				end
			end
		end
	end)
end

return World
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="69">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Night Shift: Drive-Thru — client entry point. Starts every controller in order.

local Controllers = script.Parent:WaitForChild("Controllers")
local Kit = require(script.Parent:WaitForChild("UI"):WaitForChild("Kit"))

Kit.watchViewport()

local ORDER = {
	"State",
	"Audio",
	"World",
	"CameraView",
	"Effects",
	"HUD",
	"Panels",
	"OrderPanel",
	"AssemblyPanel",
	"WindowPanel",
	"MenuPanels",
	"Lobby",
	"Hide",
	"DebugPanel",
}

for _, name in ORDER do
	local ok, err = pcall(function()
		local controller = require(Controllers:WaitForChild(name)) :: any
		if controller.init then
			controller.init()
		end
	end)
	if not ok then
		warn(("[NightShift] client controller %s failed: %s"):format(name, tostring(err)))
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="70">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[-- Tiny UI kit: theme + constructors. Everything is built in code (no assets) and scaled with a
-- UIScale so it reads on phones (design doc §7.8: mobile-first, big tap targets).

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Kit = {}

Kit.Theme = {
	ketchup = Color3.fromRGB(215, 38, 61),
	mustard = Color3.fromRGB(244, 180, 0),
	pickle = Color3.fromRGB(106, 153, 78),
	bun = Color3.fromRGB(233, 196, 106),
	navy = Color3.fromRGB(29, 45, 80),
	ink = Color3.fromRGB(28, 28, 34),
	panel = Color3.fromRGB(36, 36, 46),
	panelLight = Color3.fromRGB(52, 52, 66),
	paper = Color3.fromRGB(255, 250, 236),
	white = Color3.fromRGB(255, 255, 255),
	muted = Color3.fromRGB(170, 170, 185),
	good = Color3.fromRGB(70, 170, 90),
	bad = Color3.fromRGB(210, 55, 55),
	warn = Color3.fromRGB(235, 150, 40),
	uv = Color3.fromRGB(190, 90, 255),
	crt = Color3.fromRGB(16, 32, 20),
	crtText = Color3.fromRGB(110, 255, 140),
	title = Enum.Font.FredokaOne,
	body = Enum.Font.GothamMedium,
	bold = Enum.Font.GothamBold,
	mono = Enum.Font.Arcade,
	hand = Enum.Font.PatrickHand,
}
local T = Kit.Theme

local scales: { { scale: UIScale, gui: ScreenGui } } = {}

-- Everything is laid out on a 1280x720 canvas. The scale fits that canvas into the ScreenGui's
-- actual (safe-area) size, so panels up to ~1060x600 always fit, even on small phones.
local function computeScale(size: Vector2?): number
	local area = size
	if not area or area.X < 10 then
		local camera = workspace.CurrentCamera
		area = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	end
	local fitted = math.min(area.X / 1280, area.Y / 720)
	return math.clamp(fitted, 0.35, 1.35)
end

local function refreshScales()
	for _, entry in scales do
		entry.scale.Scale = computeScale(entry.gui.AbsoluteSize)
	end
end

function Kit.watchViewport()
	local function hook()
		local camera = workspace.CurrentCamera
		if camera then
			camera:GetPropertyChangedSignal("ViewportSize"):Connect(refreshScales)
		end
		refreshScales()
	end
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(hook)
	hook()
end

function Kit.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	if inst:IsA("GuiObject") then
		(inst :: any).BorderSizePixel = 0
	end
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(inst :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Kit.screen(name: string, order: number?, safeArea: boolean?): ScreenGui
	local gui = Kit.new("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		IgnoreGuiInset = not safeArea,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = order or 1,
	})
	if safeArea then
		gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	end
	local root = Kit.new("Frame", {
		Name = "Root",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	local scale = Kit.new("UIScale", { Parent = root })
	table.insert(scales, { scale = scale, gui = gui })
	scale.Scale = computeScale(nil)
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		scale.Scale = computeScale(gui.AbsoluteSize)
	end)
	-- the scaled root is sized so that children laid out at 1280x720 fit any screen
	local function fit()
		local s = scale.Scale
		root.Size = UDim2.fromScale(1 / s, 1 / s)
	end
	scale:GetPropertyChangedSignal("Scale"):Connect(fit)
	fit()
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	return gui
end

function Kit.root(gui: ScreenGui): Frame
	return gui:FindFirstChild("Root") :: Frame
end

function Kit.corner(parent: Instance, radius: number?)
	return Kit.new("UICorner", { CornerRadius = UDim.new(0, radius or 12), Parent = parent })
end

function Kit.stroke(parent: Instance, color: Color3?, thickness: number?)
	return Kit.new("UIStroke", {
		Color = color or T.ink,
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function Kit.padding(parent: Instance, px: number)
	return Kit.new("UIPadding", {
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		Parent = parent,
	})
end

function Kit.list(parent: Instance, direction: Enum.FillDirection?, spacing: number?, align: Enum.HorizontalAlignment?)
	return Kit.new("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, spacing or 8),
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = parent,
	})
end

function Kit.label(parent: Instance?, text: string, props: { [string]: any }?): TextLabel
	local label = Kit.new("TextLabel", {
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = T.white,
		Font = T.body,
		TextScaled = true,
		TextWrapped = true,
		Size = UDim2.new(1, 0, 0, 28),
	})
	local maxSize = 0
	if props then
		for key, value in props do
			if key == "MaxText" then
				maxSize = value
			else
				(label :: any)[key] = value
			end
		end
	end
	if label.TextScaled then
		Kit.new("UITextSizeConstraint", { MaxTextSize = if maxSize > 0 then maxSize else 36, MinTextSize = 8, Parent = label })
	end
	if parent then
		label.Parent = parent
	end
	return label
end

function Kit.button(parent: Instance?, text: string, color: Color3?, onClick: (() -> ())?, props: { [string]: any }?): TextButton
	local button = Kit.new("TextButton", {
		Text = text,
		BackgroundColor3 = color or T.panelLight,
		TextColor3 = T.white,
		Font = T.title,
		TextScaled = true,
		AutoButtonColor = true,
		Size = UDim2.fromOffset(160, 56),
	})
	Kit.corner(button, 12)
	Kit.new("UITextSizeConstraint", { MaxTextSize = 30, MinTextSize = 10, Parent = button })
	Kit.new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), Parent = button })
	if props then
		for key, value in props do
			(button :: any)[key] = value
		end
	end
	if onClick then
		button.Activated:Connect(function()
			local scale = button:FindFirstChildOfClass("UIScale") or Kit.new("UIScale", { Parent = button })
			scale.Scale = 0.92
			TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1 }):Play()
			onClick()
		end)
	end
	if parent then
		button.Parent = parent
	end
	return button
end

-- A centered card with a title bar. Returns (frame, content, closeButton).
function Kit.panel(parent: Instance, title: string, size: UDim2, onClose: (() -> ())?): (Frame, Frame, TextButton?)
	local frame = Kit.new("Frame", {
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = size,
		BackgroundColor3 = T.panel,
		Parent = parent,
	})
	Kit.corner(frame, 18)
	Kit.stroke(frame, T.mustard, 3)
	local bar = Kit.new("Frame", {
		Name = "TitleBar",
		Size = UDim2.new(1, 0, 0, 52),
		BackgroundColor3 = T.ketchup,
		Parent = frame,
	})
	Kit.corner(bar, 18)
	Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 18), Position = UDim2.new(0, 0, 1, -18), BackgroundColor3 = T.ketchup, Parent = bar })
	Kit.label(bar, title, {
		Name = "Title",
		Size = UDim2.new(1, -120, 1, -8),
		Position = UDim2.fromOffset(18, 4),
		Font = T.title,
		TextColor3 = T.mustard,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxText = 32,
	})
	local close = nil
	if onClose then
		close = Kit.button(bar, "✕", T.ink, onClose, {
			Name = "Close",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(44, 40),
		})
	end
	local content = Kit.new("Frame", {
		Name = "Content",
		Size = UDim2.new(1, -24, 1, -68),
		Position = UDim2.fromOffset(12, 60),
		BackgroundTransparency = 1,
		Parent = frame,
	})
	return frame, content, close
end

function Kit.scroll(parent: Instance, props: { [string]: any }?): ScrollingFrame
	local frame = Kit.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = T.mustard,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
	})
	if props then
		for key, value in props do
			(frame :: any)[key] = value
		end
	end
	frame.Parent = parent
	return frame
end

function Kit.clear(container: Instance)
	for _, child in container:GetChildren() do
		if not child:IsA("UIListLayout") and not child:IsA("UIGridLayout") and not child:IsA("UIPadding") and not child:IsA("UICorner") and not child:IsA("UIStroke") then
			child:Destroy()
		end
	end
end

function Kit.fade(gui: GuiObject, to: number, time: number?)
	local props = { BackgroundTransparency = to }
	if gui:IsA("TextLabel") or gui:IsA("TextButton") then
		(props :: any).TextTransparency = to
	end
	TweenService:Create(gui, TweenInfo.new(time or 0.3), props):Play()
end

return Kit
