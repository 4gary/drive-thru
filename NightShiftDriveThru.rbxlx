            <string name="Name">Layout</string>
            <string name="Source"><![CDATA[-- Every world position the game uses, in one place. MapBuilder builds the greybox from these
-- numbers and the server systems (cars, scares, hiding, cameras) read the same numbers.
--
-- Axes: +X runs along the drive-thru lane (entrance -> exit). +Z points from the kitchen out to
-- the lane. The parking-lot lobby is behind the building (-Z). Ground top is y = 0.
--
-- This module must stay dependency-free (it is also loaded by Lune at build time).

local Layout = {}

Layout.Floor = 0.2 -- top of the interior floor tiles
Layout.WallHeight = 16

-- Building interior (kitchen + hallway + back rooms)
Layout.Building = { minX = -56, maxX = 56, minZ = -48, maxZ = 12 }
Layout.KitchenZ = { min = -14, max = 12 }
Layout.HallZ = { min = -22, max = -14 }
Layout.RoomZ = { min = -48, max = -22 }
Layout.KitchenDoorsX = { -40, 0, 40 }
Layout.DoorWidth = 8

Layout.Rooms = {
	Freezer = { minX = -56, maxX = -34 },
	Storage = { minX = -34, maxX = -12 },
	Office = { minX = -12, maxX = 10 },
	BreakRoom = { minX = 10, maxX = 34 },
	Bathroom = { minX = 34, maxX = 56 },
}
Layout.RoomOrder = { "Freezer", "Storage", "Office", "BreakRoom", "Bathroom" }

Layout.PlayPlace = { minX = -96, maxX = -56, minZ = -48, maxZ = 12 }
Layout.PlayPlaceDoorZ = -18

-- Front counter (stations) and back counter
Layout.FrontCounter = { minZ = 6.5, maxZ = 10.5, top = 3.6 }
Layout.BackCounter = { minZ = -13, maxZ = -10, top = 3.6 }

-- Stations (positions of the interactive parts)
Layout.Stations = {
	OrderConsole = Vector3.new(-46, 4.9, 8.5),
	ReceiptPrinter = Vector3.new(-40.5, 4.1, 8.5),
	Grill = Vector3.new(-26, 3.75, 8.5),
	GrillSpots = {
		Vector3.new(-30.5, 3.95, 8.5),
		Vector3.new(-27.5, 3.95, 8.5),
		Vector3.new(-24.5, 3.95, 8.5),
		Vector3.new(-21.5, 3.95, 8.5),
	},
	PattyBox = Vector3.new(-17.5, 4.1, 9),
	AssemblyPlate = Vector3.new(-10, 3.7, 8.2),
	Fryers = { Vector3.new(2.5, 3.9, 8.5), Vector3.new(8, 3.9, 8.5) },
	FryBin = Vector3.new(14, 4, 8.5),
	SodaFountain = Vector3.new(19.5, 4.6, 8.8),
	ShakeMachine = Vector3.new(24.5, 4.6, 8.8),
	BagCounter = Vector3.new(34, 4.0, 8.5),
	BagSpots = {
		Vector3.new(29.5, 4.4, 8.5),
		Vector3.new(32.5, 4.4, 8.5),
		Vector3.new(35.5, 4.4, 8.5),
		Vector3.new(38.5, 4.4, 8.5),
	},
	BagFix = Vector3.new(41.5, 4.0, 8.5),
	Window = Vector3.new(48, 4.6, 9.8),
	Trash = { Vector3.new(-2, 1.6, 3.5), Vector3.new(26.5, 1.6, 3.5) },
	TimeClock = Vector3.new(52, 4.6, -13.3),
	Bobblehead = Vector3.new(50.6, 4.1, 10.2),
	Napkin = Vector3.new(-3.5, 3.9, 9.5),
	Extinguisher = Vector3.new(-0.6, 1.8, 6.2),
}

-- Pickup window opening in the front wall
Layout.PickupWindow = { minX = 45, maxX = 51, minY = 3.4, maxY = 8.2 }
-- Front glass windows (High Beams shine through these). Bottom edge = the "window line".
Layout.FrontWindows = { minY = 4.4, maxY = 10 }

-- Respawn & spawn points
Layout.RespawnPoint = Vector3.new(52, Layout.Floor + 3, -9)
Layout.KitchenSpawns = {
	Vector3.new(-40, Layout.Floor + 3, 2),
	Vector3.new(-20, Layout.Floor + 3, 2),
	Vector3.new(6, Layout.Floor + 3, 2),
	Vector3.new(34, Layout.Floor + 3, 2),
}
Layout.LobbySpawn = Vector3.new(0, 3, -100)
Layout.GizmoHome = Vector3.new(6, Layout.Floor, -6)
Layout.GizmoNapkin = Vector3.new(-3.5, Layout.Floor, 4.5)

-- Drive-thru lane
Layout.LaneZ = 19.5
Layout.LaneStartX = -170
Layout.LaneEndX = 190
Layout.Slots = {
	{ name = "Window", x = 47 },
	{ name = "Hold1", x = 31 },
	{ name = "Hold2", x = 15 },
	{ name = "Hold3", x = -1 },
	{ name = "Speaker", x = -25 },
	{ name = "Queue1", x = -42 },
	{ name = "Queue2", x = -59 },
}
Layout.WindowSlot = 1
Layout.SpeakerSlot = 5
Layout.DriverOffset = Vector3.new(0.9, 0, -1.5) -- driver seat relative to the car root
Layout.SpeakerPost = Vector3.new(-24, 0, 15.2)
Layout.MenuBoard = Vector3.new(-31.5, 0, 15.6)

-- Cameras (CFrame.lookAt(from, to))
Layout.Cameras = {
	Window = { from = Vector3.new(48, 5.6, 8.6), to = Vector3.new(48.5, 4.6, 18.5), fov = 55 },
	LaneCam = { from = Vector3.new(22, 16, 33), to = Vector3.new(42, 2.5, 19), fov = 60 },
	Mirror = { from = Vector3.new(56, 8.5, 14.2), to = Vector3.new(47.5, 4.2, 18.6), fov = 50 },
	Order = { from = Vector3.new(-46, 6.5, 2.5), to = Vector3.new(-46, 4.6, 9), fov = 60 },
}
Layout.LaneCamPole = Vector3.new(22, 0, 34)
Layout.MirrorPole = Vector3.new(56, 0, 14.2)

-- Hiding spots: prompt = where the HIDE prompt is, inside = where the hidden player is parked,
-- peekFrom/peekTo = the peephole camera.
Layout.HidingSpots = {
	UnderCounter = {
		label = "Under the Counter",
		capacity = 1,
		prompt = Vector3.new(-14.5, 1.7, 6.2),
		inside = Vector3.new(-14.5, 1.4, 8.5),
		peekFrom = Vector3.new(-14.5, 1.9, 6.0),
		peekTo = Vector3.new(-14.5, 3.2, -6),
		message = "Your knees are not happy about this.",
	},
	Freezer = {
		label = "Walk-in Freezer",
		capacity = 2,
		prompt = Vector3.new(-45, 4, -21.4),
		inside = Vector3.new(-45, 3.2, -36),
		peekFrom = Vector3.new(-45, 5.6, -22.6),
		peekTo = Vector3.new(-45, 4.2, -10),
		message = "Brr. They don't like the cold.",
		campMessage = "Frost is creeping over the glass...",
	},
	CostumeCloset = {
		label = "Costume Closet",
		capacity = 1,
		prompt = Vector3.new(-29, 4, -44.2),
		inside = Vector3.new(-29, 3.2, -46.6),
		peekFrom = Vector3.new(-29, 5.2, -44.6),
		peekTo = Vector3.new(-23, 4, -24),
		message = "It smells like a mascot in here.",
		campMessage = "The Mr. Munch costume is... breathing?",
	},
	BathroomStall = {
		label = "Bathroom Stall",
		capacity = 1,
		prompt = Vector3.new(50, 4, -38.4),
		inside = Vector3.new(50, 3.2, -43),
		peekFrom = Vector3.new(50, 5.2, -38.8),
		peekTo = Vector3.new(45, 4, -22),
		message = "Occupied.",
		campMessage = "The Air-Freshener-Bot is warming up...",
	},
	BallPit = {
		label = "Ball Pit",
		capacity = 3,
		prompt = Vector3.new(-80, 2.6, -21.6),
		inside = Vector3.new(-80, 0.8, -30),
		peekFrom = Vector3.new(-80, 2.3, -29),
		peekTo = Vector3.new(-70, 4, -5),
		message = "You sink into the balls. It's fine. It's fine.",
		campMessage = "The ball pit is eating your shoe.",
	},
}
Layout.HidingOrder = { "UnderCounter", "Freezer", "CostumeCloset", "BathroomStall", "BallPit" }

-- Mr. Munch
Layout.StatuePosition = Vector3.new(-76, Layout.Floor, -2)
Layout.StatueFacing = Vector3.new(-56, Layout.Floor, -2)
Layout.MunchPath = {
	Vector3.new(-76, Layout.Floor, -2),
	Vector3.new(-72, Layout.Floor, -18),
	Vector3.new(-56, Layout.Floor, -18),
	Vector3.new(-40, Layout.Floor, -18),
	Vector3.new(-40, Layout.Floor, -10),
	Vector3.new(-36, Layout.Floor, 1),
	Vector3.new(-18, Layout.Floor, 2),
	Vector3.new(0, Layout.Floor, 1),
	Vector3.new(18, Layout.Floor, 2),
	Vector3.new(38, Layout.Floor, 1),
	Vector3.new(46, Layout.Floor, 3),
	Vector3.new(40, Layout.Floor, -8),
	Vector3.new(40, Layout.Floor, -18),
	Vector3.new(22, Layout.Floor, -18),
	Vector3.new(0, Layout.Floor, -18),
	Vector3.new(-23, Layout.Floor, -18),
	Vector3.new(-45, Layout.Floor, -18),
	Vector3.new(-60, Layout.Floor, -18),
	Vector3.new(-72, Layout.Floor, -10),
	Vector3.new(-76, Layout.Floor, -2),
}
-- Night 5 reveal: the statue appears outside the pickup window.
Layout.StatueAtWindow = Vector3.new(48, 0, 15.5)

-- High Beams sweep through the kitchen along X
Layout.HighBeams = { fromX = -60, toX = 60 }

-- Break room: Employee of the Month wall (13 frames on the back wall)
Layout.EmployeeWall = { centerX = 22, z = -47.4, y = 7.5, spacing = 1.75 }
Layout.VHS = Vector3.new(-6, 4.2, -44)
Layout.DebDesk = Vector3.new(-1, 0, -40)

-- Lobby (parking lot behind the building)
Layout.Lobby = {
	minX = -80,
	maxX = 80,
	minZ = -155,
	maxZ = -58,
	Booths = {
		{ id = "A", position = Vector3.new(-22, 0, -82) },
		{ id = "B", position = Vector3.new(22, 0, -82) },
	},
	BoothSize = 12,
	Locker = Vector3.new(-55, 0, -115),
	Fax = Vector3.new(55, 0, -112),
	Leaderboard = Vector3.new(-18, 0, -146),
	LobbyTV = Vector3.new(18, 0, -146),
	CreditsWall = Vector3.new(62, 0, -140),
	EmployeeSign = Vector3.new(0, 0, -64),
	FieldGuide = Vector3.new(-55, 0, -85),
}

-- Road & scenery
Layout.RoadZ = 70
Layout.SignPole = Vector3.new(80, 0, 40)
Layout.WaterTower = Vector3.new(170, 0, 170)

return Layout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[-- Builds the greybox Munchie's #001 (Exit 13, Route 404) plus the parking-lot lobby.
-- Design doc §6.3 layout. Pure Instance code (no services) so it can run at build time in Lune
-- (the result is saved into the place file) or at runtime if the map is missing.

local Layout = require(script.Parent.Layout)
local ModelFactory = require(script.Parent.ModelFactory)

local MapBuilder = {}

local H = Layout.WallHeight
local F = Layout.Floor

local C = {
	ketchup = Color3.fromRGB(215, 38, 61),
	mustard = Color3.fromRGB(244, 180, 0),
	pickle = Color3.fromRGB(106, 153, 78),
	bun = Color3.fromRGB(233, 196, 106),
	navy = Color3.fromRGB(29, 45, 80),
	wall = Color3.fromRGB(240, 230, 210),
	wallOut = Color3.fromRGB(200, 60, 50),
	trim = Color3.fromRGB(244, 180, 0),
	floor = Color3.fromRGB(236, 226, 206),
	hall = Color3.fromRGB(200, 200, 205),
	steel = Color3.fromRGB(190, 192, 196),
	darkSteel = Color3.fromRGB(80, 82, 88),
	laminate = Color3.fromRGB(250, 245, 235),
	counterBody = Color3.fromRGB(196, 60, 50),
	asphalt = Color3.fromRGB(45, 45, 50),
	lot = Color3.fromRGB(55, 55, 60),
	grass = Color3.fromRGB(50, 78, 44),
	corn = Color3.fromRGB(120, 140, 50),
	white = Color3.fromRGB(245, 245, 245),
	black = Color3.fromRGB(25, 25, 28),
	glass = Color3.fromRGB(150, 190, 215),
	warmLight = Color3.fromRGB(255, 240, 210),
	sodium = Color3.fromRGB(255, 165, 80),
	wood = Color3.fromRGB(150, 105, 65),
}
MapBuilder.Colors = C

---------------------------------------------------------------------------
-- helpers
---------------------------------------------------------------------------

local function folder(parent: Instance, name: string): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function block(parent: Instance, name: string, minV: Vector3, maxV: Vector3, color: Color3, material: Enum.Material?, props: { [string]: any }?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = Vector3.new(math.abs(maxV.X - minV.X), math.abs(maxV.Y - minV.Y), math.abs(maxV.Z - minV.Z))
	p.CFrame = CFrame.new((minV + maxV) / 2)
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props then
		for key, value in props do
			(p :: any)[key] = value
		end
	end
	p.Parent = parent
	return p
end

local function at(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, props: { [string]: any }?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props then
		for key, value in props do
			(p :: any)[key] = value
		end
	end
	p.Parent = parent
	return p
end

local function cyl(parent: Instance, name: string, length: number, diameter: number, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = at(parent, name, Vector3.new(length, diameter, diameter), cf, color, material)
	p.Shape = Enum.PartType.Cylinder
	return p
end

local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))

local function sign(p: BasePart, face: Enum.NormalId, text: string, opts: { [string]: any }?): SurfaceGui
	local o = opts or {}
	local gui = Instance.new("SurfaceGui")
	gui.Name = o.name or "Sign"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = o.ppu or 30
	gui.LightInfluence = o.lightInfluence or 0
	gui.Brightness = o.brightness or 1
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = if o.background then 0 else 1
	label.BackgroundColor3 = o.background or Color3.new(0, 0, 0)
	label.Text = text
	label.TextColor3 = o.color or C.white
	label.TextScaled = true
	label.TextWrapped = true
	label.Font = o.font or Enum.Font.FredokaOne
	label.TextXAlignment = o.align or Enum.TextXAlignment.Center
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.04, 0)
	pad.PaddingRight = UDim.new(0.04, 0)
	pad.PaddingTop = UDim.new(0.04, 0)
	pad.PaddingBottom = UDim.new(0.04, 0)
	pad.Parent = label
	label.Parent = gui
	gui.Parent = p
	return gui
end

local function pointLight(p: BasePart, color: Color3, range: number, brightness: number, enabled: boolean?): PointLight
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness
	light.Shadows = false
	light.Enabled = if enabled == nil then true else enabled
	light.Parent = p
	return light
end

-- Wall along X (fixed Z band [z0,z1]) from x0 to x1 with rectangular holes {x0,x1,y0,y1}.
local function wallX(parent: Instance, name: string, z0: number, z1: number, x0: number, x1: number, holes: { { number } }, color: Color3, material: Enum.Material?, height: number?)
	local h = height or H
	local cuts = { x0, x1 }
	for _, hole in holes do
		table.insert(cuts, hole[1])
		table.insert(cuts, hole[2])
	end
	table.sort(cuts)
	for i = 1, #cuts - 1 do
		local a, b = cuts[i], cuts[i + 1]
		if b - a > 0.01 then
			local mid = (a + b) / 2
			local covering = nil
			for _, hole in holes do
				if mid > hole[1] and mid < hole[2] then
					covering = hole
				end
			end
			if not covering then
				block(parent, name, Vector3.new(a, 0, z0), Vector3.new(b, h, z1), color, material)
			else
				if covering[3] > 0.01 then
					block(parent, name, Vector3.new(a, 0, z0), Vector3.new(b, covering[3], z1), color, material)
				end
				if covering[4] < h - 0.01 then
					block(parent, name, Vector3.new(a, covering[4], z0), Vector3.new(b, h, z1), color, material)
				end
			end
		end
	end
end

-- Wall along Z (fixed X band [x0,x1]) from z0 to z1 with holes {z0,z1,y0,y1}.
local function wallZ(parent: Instance, name: string, x0: number, x1: number, z0: number, z1: number, holes: { { number } }, color: Color3, material: Enum.Material?, height: number?)
	local h = height or H
	local cuts = { z0, z1 }
	for _, hole in holes do
		table.insert(cuts, hole[1])
		table.insert(cuts, hole[2])
	end
	table.sort(cuts)
	for i = 1, #cuts - 1 do
		local a, b = cuts[i], cuts[i + 1]
		if b - a > 0.01 then
			local mid = (a + b) / 2
			local covering = nil
			for _, hole in holes do
				if mid > hole[1] and mid < hole[2] then
					covering = hole
				end
			end
			if not covering then
				block(parent, name, Vector3.new(x0, 0, a), Vector3.new(x1, h, b), color, material)
			else
				if covering[3] > 0.01 then
					block(parent, name, Vector3.new(x0, 0, a), Vector3.new(x1, covering[3], b), color, material)
				end
				if covering[4] < h - 0.01 then
					block(parent, name, Vector3.new(x0, covering[4], a), Vector3.new(x1, h, b), color, material)
				end
			end
		end
	end
end

local function counter(parent: Instance, name: string, x0: number, x1: number, z0: number, z1: number, top: Color3, body: Color3, topMaterial: Enum.Material?)
	block(parent, name .. "Body", Vector3.new(x0, F, z0 + 0.3), Vector3.new(x1, Layout.FrontCounter.top - 0.2, z1), body)
	return block(parent, name .. "Top", Vector3.new(x0 - 0.1, Layout.FrontCounter.top - 0.2, z0), Vector3.new(x1 + 0.1, Layout.FrontCounter.top, z1 + 0.1), top, topMaterial)
end

local function lamp(parent: Instance, position: Vector3, height: number?)
	local h = height or 18
	at(parent, "LampPole", Vector3.new(0.6, h, 0.6), CFrame.new(position + Vector3.new(0, h / 2, 0)), C.darkSteel, Enum.Material.Metal)
	local head = at(parent, "LampHead", Vector3.new(2.4, 0.6, 1.2), CFrame.new(position + Vector3.new(0, h, 0)), C.sodium, Enum.Material.Neon)
	head:AddTag("ExteriorLight")
	pointLight(head, C.sodium, 50, 1.6)
end

---------------------------------------------------------------------------
-- sections
---------------------------------------------------------------------------

local function buildGround(root: Instance)
	local g = folder(root, "Ground")
	block(g, "Grass", Vector3.new(-600, -2, -600), Vector3.new(600, 0, 600), C.grass, Enum.Material.Grass)
	-- drive-thru lane
	local laneMin = Layout.LaneZ - 6
	local laneMax = Layout.LaneZ + 6
	block(g, "Lane", Vector3.new(Layout.LaneStartX - 10, 0, laneMin), Vector3.new(Layout.LaneEndX + 10, 0.06, laneMax), C.asphalt, Enum.Material.Asphalt)
	block(g, "LaneCurb", Vector3.new(Layout.LaneStartX - 10, 0, laneMax), Vector3.new(Layout.LaneEndX + 10, 0.5, laneMax + 0.8), C.mustard, Enum.Material.Concrete)
	for x = Layout.LaneStartX, Layout.LaneEndX, 30 do
		local arrow = at(g, "LaneArrow", Vector3.new(5, 0.08, 3), CFrame.new(x, 0.07, Layout.LaneZ), C.white, Enum.Material.SmoothPlastic, { Transparency = 1 })
		sign(arrow, Enum.NormalId.Top, "→", { color = Color3.fromRGB(230, 230, 230), ppu = 20 })
	end
	-- lane entrance / exit to Route 404
	block(g, "LaneEntry", Vector3.new(Layout.LaneStartX - 20, 0, laneMin), Vector3.new(Layout.LaneStartX - 6, 0.06, Layout.RoadZ - 8), C.asphalt, Enum.Material.Asphalt)
	block(g, "LaneExit", Vector3.new(Layout.LaneEndX + 6, 0, laneMin), Vector3.new(Layout.LaneEndX + 20, 0.06, Layout.RoadZ - 8), C.asphalt, Enum.Material.Asphalt)
	-- Route 404
	block(g, "Route404", Vector3.new(-600, 0, Layout.RoadZ - 10), Vector3.new(600, 0.06, Layout.RoadZ + 10), C.asphalt, Enum.Material.Asphalt)
	for x = -590, 590, 24 do
		at(g, "Dash", Vector3.new(10, 0.08, 0.5), CFrame.new(x, 0.08, Layout.RoadZ), C.mustard, Enum.Material.SmoothPlastic)
	end
	local routeSign = at(g, "RouteSign", Vector3.new(6, 4, 0.3), CFrame.new(-150, 9, Layout.RoadZ - 13), Color3.fromRGB(30, 110, 60))
	at(g, "RouteSignPole", Vector3.new(0.4, 9, 0.4), CFrame.new(-150, 4.5, Layout.RoadZ - 13), C.darkSteel, Enum.Material.Metal)
	sign(routeSign, Enum.NormalId.Back, "ROUTE 404\nEXIT 13", { color = C.white })
	sign(routeSign, Enum.NormalId.Front, "LOWER DIMMSWORTH\n3 mi", { color = C.white })
	-- cornfield
	for i = 0, 11 do
		local z = Layout.RoadZ + 18 + i * 7
		block(g, "CornRow", Vector3.new(-600, 0, z), Vector3.new(600, 7 + (i % 3), z + 3), C.corn, Enum.Material.Grass)
	end
	-- blinking yellow traffic light
	at(g, "TrafficPole", Vector3.new(0.6, 16, 0.6), CFrame.new(-120, 8, Layout.RoadZ - 11), C.darkSteel, Enum.Material.Metal)
	at(g, "TrafficArm", Vector3.new(0.4, 0.4, 11), CFrame.new(-120, 16, Layout.RoadZ - 5.5), C.darkSteel, Enum.Material.Metal)
	local blink = at(g, "BlinkLight", Vector3.new(1.4, 1.4, 1.4), CFrame.new(-120, 15, Layout.RoadZ), C.mustard, Enum.Material.Neon)
	blink:AddTag("BlinkLight")
	pointLight(blink, C.mustard, 20, 2)
	-- water tower
	local wt = folder(g, "WaterTower")
	for _, offset in { Vector3.new(-5, 0, -5), Vector3.new(5, 0, -5), Vector3.new(-5, 0, 5), Vector3.new(5, 0, 5) } do
		at(wt, "Leg", Vector3.new(1, 40, 1), CFrame.new(Layout.WaterTower + offset + Vector3.new(0, 20, 0)), C.steel, Enum.Material.Metal)
	end
	local tank = cyl(wt, "Tank", 14, 18, CFrame.new(Layout.WaterTower + Vector3.new(0, 46, 0)) * UPRIGHT, Color3.fromRGB(170, 190, 200), Enum.Material.Metal)
	tank.Name = "Tank"
	local banner = at(wt, "Banner", Vector3.new(16, 5, 0.2), CFrame.new(Layout.WaterTower + Vector3.new(0, 46, -9.2)), Color3.fromRGB(170, 190, 200), Enum.Material.Metal, { Transparency = 1 })
	sign(banner, Enum.NormalId.Front, "LOWER DIMMSWORTH: WE'RE STILL HERE", { color = C.navy })
end

local function buildShell(root: Instance)
	local b = folder(root, "Building")
	local B = Layout.Building
	-- floors
	block(b, "KitchenFloor", Vector3.new(B.minX, 0, Layout.KitchenZ.min), Vector3.new(B.maxX, F, B.maxZ), C.floor, Enum.Material.CeramicTiles)
	block(b, "HallFloor", Vector3.new(B.minX, 0, Layout.HallZ.min), Vector3.new(B.maxX, F, Layout.HallZ.max), C.hall, Enum.Material.CeramicTiles)
	local roomFloors = {
		Freezer = { Color3.fromRGB(200, 225, 235), Enum.Material.DiamondPlate },
		Storage = { Color3.fromRGB(150, 150, 150), Enum.Material.Concrete },
		Office = { Color3.fromRGB(120, 85, 60), Enum.Material.Carpet },
		BreakRoom = { Color3.fromRGB(170, 120, 75), Enum.Material.WoodPlanks },
		Bathroom = { Color3.fromRGB(190, 220, 230), Enum.Material.CeramicTiles },
	}
	for roomName, room in Layout.Rooms do
		local look = roomFloors[roomName]
		block(b, roomName .. "Floor", Vector3.new(room.minX, 0, B.minZ), Vector3.new(room.maxX, F, Layout.RoomZ.max), look[1], look[2])
	end
	local P = Layout.PlayPlace
	block(b, "PlayPlaceFloor", Vector3.new(P.minX, 0, P.minZ), Vector3.new(P.maxX, F, P.maxZ), Color3.fromRGB(90, 60, 140), Enum.Material.Carpet)

	-- outer walls
	local W = Layout.FrontWindows
	local PW = Layout.PickupWindow
	wallX(b, "FrontWall", B.maxZ, B.maxZ + 1, B.minX - 1, B.maxX + 1, {
		{ -50, 40, W.minY, W.maxY },
		{ PW.minX, PW.maxX, PW.minY, PW.maxY },
	}, C.wallOut, Enum.Material.Brick)
	block(b, "FrontGlass", Vector3.new(-50, W.minY, B.maxZ + 0.4), Vector3.new(40, W.maxY, B.maxZ + 0.6), C.glass, Enum.Material.Glass, { Transparency = 0.75, CastShadow = false })
	block(b, "WindowSill", Vector3.new(-50.2, W.minY - 0.3, B.maxZ - 0.3), Vector3.new(40.2, W.minY, B.maxZ + 1.3), C.trim)
	-- invisible barrier in the pickup window opening (players can't climb out; raycasts pass)
	block(b, "PickupBarrier", Vector3.new(PW.minX, PW.minY, B.maxZ + 0.3), Vector3.new(PW.maxX, PW.maxY, B.maxZ + 0.7), C.glass, Enum.Material.Glass, { Transparency = 1, CanQuery = false, CastShadow = false })
	wallX(b, "BackWall", B.minZ - 1, B.minZ, B.minX - 1, B.maxX + 1, {}, C.wallOut, Enum.Material.Brick)
	wallZ(b, "LeftWall", B.minX - 1, B.minX, B.minZ, B.maxZ, {
		{ Layout.HallZ.min, Layout.HallZ.max, 0, 9 },
	}, C.wall, Enum.Material.Plaster)
	wallZ(b, "RightWall", B.maxX, B.maxX + 1, B.minZ, B.maxZ, {}, C.wallOut, Enum.Material.Brick)

	-- inner walls
	local doorHoles = {}
	for _, x in Layout.KitchenDoorsX do
		table.insert(doorHoles, { x - Layout.DoorWidth / 2, x + Layout.DoorWidth / 2, 0, 9 })
	end
	wallX(b, "KitchenBackWall", Layout.KitchenZ.min - 0.5, Layout.KitchenZ.min + 0.5, B.minX, B.maxX, doorHoles, C.wall, Enum.Material.Plaster)
	local roomDoors = {}
	for _, roomName in Layout.RoomOrder do
		local room = Layout.Rooms[roomName]
		local cx = (room.minX + room.maxX) / 2
		if roomName ~= "Freezer" then
			table.insert(roomDoors, { cx - 3, cx + 3, 0, 9 })
		end
	end
	wallX(b, "HallBackWall", Layout.HallZ.min - 0.5, Layout.HallZ.min + 0.5, B.minX, B.maxX, roomDoors, C.wall, Enum.Material.Plaster)
	for _, x in { -34, -12, 10, 34 } do
		wallZ(b, "RoomWall", x - 0.5, x + 0.5, B.minZ, Layout.RoomZ.max - 0.5, {}, C.wall, Enum.Material.Plaster)
	end

	-- PlayPlace wing
	wallX(b, "PlayFront", P.maxZ, P.maxZ + 1, P.minX - 1, P.maxX, { { P.minX + 4, P.maxX - 4, 3, 13 } }, C.wallOut, Enum.Material.Brick)
	block(b, "PlayFrontGlass", Vector3.new(P.minX + 4, 3, P.maxZ + 0.4), Vector3.new(P.maxX - 4, 13, P.maxZ + 0.6), C.glass, Enum.Material.Glass, { Transparency = 0.7 })
	wallX(b, "PlayBack", P.minZ - 1, P.minZ, P.minX - 1, P.maxX, {}, C.wallOut, Enum.Material.Brick)
	wallZ(b, "PlaySide", P.minX - 1, P.minX, P.minZ, P.maxZ, { { -40, 4, 3, 13 } }, C.wallOut, Enum.Material.Brick)
	block(b, "PlaySideGlass", Vector3.new(P.minX - 0.6, 3, -40), Vector3.new(P.minX - 0.4, 13, 4), C.glass, Enum.Material.Glass, { Transparency = 0.7 })

	-- ceilings + roof
	block(b, "Ceiling", Vector3.new(B.minX - 1, H, B.minZ - 1), Vector3.new(B.maxX + 1, H + 1, B.maxZ + 1), Color3.fromRGB(235, 235, 230))
	block(b, "PlayCeiling", Vector3.new(P.minX - 1, H, P.minZ - 1), Vector3.new(P.maxX, H + 1, P.maxZ + 1), Color3.fromRGB(60, 40, 90))
	block(b, "RoofTrim", Vector3.new(P.minX - 1.5, H + 1, B.maxZ + 0.5), Vector3.new(B.maxX + 1.5, H + 2.5, B.maxZ + 1.5), C.mustard)
	local roofSign = at(b, "RoofSign", Vector3.new(44, 7, 1), CFrame.new(0, H + 6, B.maxZ + 0.5), C.ketchup, Enum.Material.SmoothPlastic)
	sign(roofSign, Enum.NormalId.Back, "MUNCHIE'S", { color = C.mustard, ppu = 12 })
	pointLight(roofSign, C.ketchup, 30, 1)
	local backSign = at(b, "BackSign", Vector3.new(36, 6, 1), CFrame.new(0, H - 4, B.minZ - 1.6), C.ketchup)
	sign(backSign, Enum.NormalId.Front, "MUNCHIE'S #001 — CREW ENTRANCE", { color = C.mustard, ppu = 12 })
	-- awning over the pickup window
	at(b, "Awning", Vector3.new(10, 0.4, 4), CFrame.new(48, 9.5, B.maxZ + 3) * CFrame.Angles(math.rad(-12), 0, 0), C.ketchup)
	local pickupSign = at(b, "PickupSign", Vector3.new(8, 1.6, 0.3), CFrame.new(48, 11, B.maxZ + 1.2), C.mustard)
	sign(pickupSign, Enum.NormalId.Back, "PICK UP HERE", { color = C.ketchup })
end

local function buildLights(root: Instance)
	local lights = folder(root, "Lights")
	local function fixture(position: Vector3, zone: string, range: number?)
		local p = at(lights, "CeilingLight", Vector3.new(6, 0.3, 2), CFrame.new(position), C.warmLight, Enum.Material.Neon)
		p:AddTag("InteriorLight")
		p:SetAttribute("Zone", zone)
		pointLight(p, C.warmLight, range or 24, 1.15)
	end
	for _, x in { -48, -32, -16, 0, 16, 32, 48 } do
		fixture(Vector3.new(x, H - 0.3, -5), "Kitchen")
		fixture(Vector3.new(x, H - 0.3, 6), "Kitchen")
	end
	for _, x in { -42, -14, 14, 42 } do
		fixture(Vector3.new(x, H - 0.3, -18), "Hall", 18)
	end
	for roomName, room in Layout.Rooms do
		if roomName ~= "Freezer" then
			fixture(Vector3.new((room.minX + room.maxX) / 2, H - 0.3, -35), roomName, 22)
		end
	end
	-- the PlayPlace is dark (one dim night light) until Night 3's "the light is on. It shouldn't be."
	local night = at(lights, "PlayNightLight", Vector3.new(1, 0.4, 1), CFrame.new(-76, H - 0.3, -20), Color3.fromRGB(120, 100, 200), Enum.Material.Neon)
	pointLight(night, Color3.fromRGB(110, 90, 200), 30, 0.5)
	local playLight = at(lights, "PlayPlaceLight", Vector3.new(6, 0.3, 2), CFrame.new(-76, H - 0.3, -5), C.warmLight, Enum.Material.SmoothPlastic)
	pointLight(playLight, C.warmLight, 40, 1.4, false)
end

local function buildKitchen(root: Instance)
	local k = folder(root, "Kitchen")
	local FC = Layout.FrontCounter
	local S = Layout.Stations
	local z0, z1 = FC.minZ, FC.maxZ

	-- front counter run
	counter(k, "OrderCounter", -55.5, -36, z0, z1, C.laminate, C.counterBody)
	counter(k, "GrillCounter", -35, -18.6, z0, z1, C.steel, C.darkSteel, Enum.Material.DiamondPlate)
	counter(k, "AssemblyCounter", -18.4, 0, z0, z1, C.laminate, C.counterBody)
	counter(k, "FryBinCounter", 10.6, 17, z0, z1, C.steel, C.darkSteel, Enum.Material.DiamondPlate)
	counter(k, "DrinkCounter", 17.2, 27.6, z0, z1, C.laminate, C.counterBody)
	counter(k, "BagCounterRun", 27.8, 43.8, z0, z1, C.laminate, C.counterBody)
	counter(k, "WindowLedgeRun", 44, 52.6, z0, z1 + 1, C.laminate, C.counterBody)
	counter(k, "EndCounter", 52.8, 55.5, z0, z1, C.laminate, C.counterBody)
	-- back counter (prep / supplies)
	for _, range in { { -34, -6 }, { 6, 34 } } do
		block(k, "BackCounterBody", Vector3.new(range[1], F, Layout.BackCounter.minZ), Vector3.new(range[2], 3.4, Layout.BackCounter.maxZ), C.darkSteel)
		block(k, "BackCounterTop", Vector3.new(range[1] - 0.1, 3.4, Layout.BackCounter.minZ), Vector3.new(range[2] + 0.1, 3.6, Layout.BackCounter.maxZ + 0.1), C.steel, Enum.Material.DiamondPlate)
		for x = range[1] + 3, range[2] - 3, 6 do
			at(k, "SupplyBox", Vector3.new(2.4, 1.8, 2), CFrame.new(x, 4.5, Layout.BackCounter.minZ + 1.5), Color3.fromRGB(196, 150, 100), Enum.Material.Cardboard)
		end
	end

	-- ORDER STATION: CRT + headset + receipt printer
	at(k, "OrderConsole", Vector3.new(3.4, 2.6, 2.6), CFrame.new(S.OrderConsole), Color3.fromRGB(225, 215, 190))
	local screen = at(k, "OrderScreen", Vector3.new(2.6, 1.9, 0.1), CFrame.new(S.OrderConsole + Vector3.new(0, 0.1, -1.32)), Color3.fromRGB(20, 40, 25), Enum.Material.Neon)
	sign(screen, Enum.NormalId.Front, "MUNCHIE'S POS v1.987\n> TAKE ORDER_", { color = Color3.fromRGB(90, 255, 120), font = Enum.Font.Arcade, ppu = 60, name = "Screen" })
	at(k, "Headset", Vector3.new(1.2, 0.3, 1), CFrame.new(-43, 3.75, 8.2), C.black)
	at(k, "ReceiptPrinter", Vector3.new(1.6, 0.9, 1.6), CFrame.new(S.ReceiptPrinter), Color3.fromRGB(60, 60, 65))
	at(k, "ReceiptPaper", Vector3.new(1, 0.05, 1.4), CFrame.new(S.ReceiptPrinter + Vector3.new(0, 0.3, -1.2)), C.white)
	local orderSign = at(k, "OrderSign", Vector3.new(6, 1.2, 0.2), CFrame.new(-46, 8.2, 11.6), C.mustard)
	sign(orderSign, Enum.NormalId.Front, "ORDER STATION", { color = C.ketchup })

	-- GRILL LINE
	at(k, "Grill", Vector3.new(12, 0.3, 3.4), CFrame.new(S.Grill), Color3.fromRGB(40, 40, 42), Enum.Material.DiamondPlate)
	at(k, "GrillHood", Vector3.new(13, 2, 4), CFrame.new(S.Grill + Vector3.new(0, 7.2, 0.6)), C.steel, Enum.Material.Metal)
	local pattyBox = at(k, "PattyBox", Vector3.new(2.2, 1, 1.8), CFrame.new(S.PattyBox), Color3.fromRGB(196, 150, 100), Enum.Material.Cardboard)
	sign(pattyBox, Enum.NormalId.Front, "PATTIES", { color = C.ketchup, ppu = 40 })
	local grillSign = at(k, "GrillSign", Vector3.new(5, 1.2, 0.2), CFrame.new(-26, 9.8, 10.6), C.mustard)
	sign(grillSign, Enum.NormalId.Front, "GRILL", { color = C.ketchup })

	-- ASSEMBLY BOARD
	at(k, "CuttingBoard", Vector3.new(5, 0.15, 3.2), CFrame.new(-10, FC.top + 0.07, 8.4), Color3.fromRGB(230, 200, 150), Enum.Material.Wood)
	local plate = at(k, "AssemblyPlate", Vector3.new(0.15, 2.4, 2.4), CFrame.new(S.AssemblyPlate) * UPRIGHT, C.white)
	plate.Shape = Enum.PartType.Cylinder
	local bins = {
		{ "Bun", Color3.fromRGB(222, 170, 98) },
		{ "Cheese", Color3.fromRGB(255, 205, 40) },
		{ "Lettuce", Color3.fromRGB(110, 190, 70) },
		{ "Pickles", Color3.fromRGB(80, 130, 50) },
		{ "Sauce", Color3.fromRGB(220, 50, 40) },
	}
	for i, bin in bins do
		local x = -15 + (i - 1) * 1.9
		at(k, "Bin" .. bin[1], Vector3.new(1.6, 0.5, 1.2), CFrame.new(x, FC.top + 0.25, 10), C.steel, Enum.Material.Metal)
		at(k, "BinFill", Vector3.new(1.4, 0.2, 1.0), CFrame.new(x, FC.top + 0.45, 10), bin[2])
		local tag = at(k, "BinTag", Vector3.new(1.6, 0.5, 0.05), CFrame.new(x, FC.top + 0.25, 9.37), C.white)
		sign(tag, Enum.NormalId.Front, string.upper(bin[1]), { color = C.black, font = Enum.Font.GothamBold, ppu = 60 })
	end
	at(k, "UnderCounterDoor", Vector3.new(3, 2.6, 0.15), CFrame.new(-14.5, 1.65, z0 + 0.22), Color3.fromRGB(170, 45, 40))
	at(k, "CabinetHandle", Vector3.new(0.8, 0.15, 0.15), CFrame.new(-14.5, 2.5, z0 + 0.1), C.steel, Enum.Material.Metal)
	at(k, "Napkin", Vector3.new(1, 1.2, 0.8), CFrame.new(S.Napkin), C.white)
	local assemblySign = at(k, "AssemblySign", Vector3.new(6, 1.2, 0.2), CFrame.new(-10, 9.8, 10.6), C.mustard)
	sign(assemblySign, Enum.NormalId.Front, "BUILD BURGERS", { color = C.ketchup })

	-- FRYERS + fry bin
	for i, pos in S.Fryers do
		block(k, "Fryer" .. i, Vector3.new(pos.X - 2.2, F, z0 + 0.3), Vector3.new(pos.X + 2.2, FC.top, z1), C.steel, Enum.Material.Metal)
		at(k, "FryerOil" .. i, Vector3.new(3.6, 0.1, 3), CFrame.new(pos.X, FC.top + 0.02, 8.5), Color3.fromRGB(200, 160, 40), Enum.Material.Glass, { Transparency = 0.2 })
		at(k, "FryerBasket" .. i, Vector3.new(2.6, 0.8, 2.2), CFrame.new(pos.X, FC.top + 0.9, 8.5), Color3.fromRGB(120, 120, 120), Enum.Material.DiamondPlate)
		local label = at(k, "FryerLabel" .. i, Vector3.new(3, 0.8, 0.05), CFrame.new(pos.X, 2.4, z0 + 0.27), C.mustard)
		sign(label, Enum.NormalId.Front, "FRYER " .. i, { color = C.black, font = Enum.Font.GothamBold, ppu = 40 })
	end
	at(k, "FryBin", Vector3.new(4, 0.8, 3), CFrame.new(S.FryBin), C.steel, Enum.Material.Metal)
	local heatLamp = at(k, "HeatLamp", Vector3.new(4, 0.5, 1.5), CFrame.new(S.FryBin + Vector3.new(0, 4, 0.5)), Color3.fromRGB(255, 80, 40), Enum.Material.Neon)
	pointLight(heatLamp, Color3.fromRGB(255, 120, 60), 8, 0.8)
	cyl(k, "Extinguisher", 1.8, 0.7, CFrame.new(S.Extinguisher) * UPRIGHT, C.ketchup, Enum.Material.Metal)
	local frySign = at(k, "FrySign", Vector3.new(7, 1.2, 0.2), CFrame.new(8, 9.8, 10.6), C.mustard)
	sign(frySign, Enum.NormalId.Front, "FRIES", { color = C.ketchup })

	-- DRINKS
	local soda = at(k, "SodaFountain", Vector3.new(3.4, 3, 2.4), CFrame.new(S.SodaFountain + Vector3.new(0, 0.5, 0)), Color3.fromRGB(70, 120, 200))
	sign(soda, Enum.NormalId.Front, "SODA", { color = C.white })
	local shake = at(k, "ShakeMachine", Vector3.new(3.4, 3.4, 2.4), CFrame.new(S.ShakeMachine + Vector3.new(0, 0.7, 0)), Color3.fromRGB(240, 150, 190))
	sign(shake, Enum.NormalId.Front, "SHAKES", { color = C.white })

	-- BAG & WINDOW
	at(k, "BagCounter", Vector3.new(12, 0.2, 3.4), CFrame.new(S.BagCounter + Vector3.new(0, -0.3, 0)), Color3.fromRGB(255, 250, 240))
	local bagSign = at(k, "BagSign", Vector3.new(8, 1.2, 0.2), CFrame.new(34, 9.8, 10.6), C.mustard)
	sign(bagSign, Enum.NormalId.Front, "BAG IT", { color = C.ketchup })
	local fix = at(k, "BagFix", Vector3.new(1.6, 1.2, 1.6), CFrame.new(S.BagFix), Color3.fromRGB(70, 70, 75))
	sign(fix, Enum.NormalId.Front, "FIX BAGS", { color = C.white, ppu = 40 })
	at(k, "WindowStation", Vector3.new(4, 0.4, 1.2), CFrame.new(S.Window), C.mustard)
	local shutter = at(k, "WindowShutter", Vector3.new(6.6, 5.2, 0.3), CFrame.new(48, Layout.PickupWindow.maxY + 2.4, Layout.Building.maxZ - 0.3), C.steel, Enum.Material.Metal)
	sign(shutter, Enum.NormalId.Back, "SORRY, WE'RE CLOSED", { color = C.ketchup, background = C.white })
	local windowSign = at(k, "WindowSign", Vector3.new(6, 1.2, 0.2), CFrame.new(48, 9.8, 10.6), C.mustard)
	sign(windowSign, Enum.NormalId.Front, "WINDOW", { color = C.ketchup })

	-- trash + time clock
	for i, pos in S.Trash do
		cyl(k, "Trash" .. i, 3, 2.2, CFrame.new(pos) * UPRIGHT, Color3.fromRGB(60, 60, 64), Enum.Material.Metal)
	end
	local clock = at(k, "TimeClock", Vector3.new(2, 2.6, 0.8), CFrame.new(S.TimeClock), Color3.fromRGB(110, 110, 115), Enum.Material.Metal)
	sign(clock, Enum.NormalId.Back, "TIME CLOCK", { color = C.white, ppu = 40 })
	local wallClock = at(k, "WallClock", Vector3.new(3, 3, 0.2), CFrame.new(0, 12, -13.3), C.white)
	sign(wallClock, Enum.NormalId.Back, "6:00", { color = C.black, font = Enum.Font.Arcade, name = "ClockFace" })

	-- posters (text swaps after the reveal)
	local posters = folder(k, "Posters")
	local posterTexts = { "SMILING IS MANDATORY", "THE FREEZER IS NOT A NAP ROOM", "WASH HANDS. WASH THEM AGAIN." }
	for i, text in posterTexts do
		local p = at(posters, "Poster" .. i, Vector3.new(5, 6, 0.1), CFrame.new(-26 + (i - 1) * 26, 9, -13.4), C.white)
		sign(p, Enum.NormalId.Back, text, { color = C.ketchup, background = Color3.fromRGB(255, 250, 235), name = "Text" })
	end

	-- bobblehead on the window ledge
	local bobble = ModelFactory.buildMunch({ scale = 0.16, anchored = true })
	bobble.Name = "Bobblehead"
	ModelFactory.place(bobble, CFrame.new(S.Bobblehead))
	bobble.Parent = k
end

local function buildRooms(root: Instance)
	local r = folder(root, "Rooms")
	-- Freezer door (closed, metal, little frosted window)
	local freezerDoor = at(r, "FreezerDoor", Vector3.new(6, 8.6, 0.6), CFrame.new(-45, F + 4.3, Layout.HallZ.min), Color3.fromRGB(200, 215, 225), Enum.Material.DiamondPlate)
	sign(freezerDoor, Enum.NormalId.Back, "WALK-IN FREEZER\n(NOT A NAP ROOM)", { color = C.navy, ppu = 30 })
	at(r, "FreezerWindow", Vector3.new(1.6, 1.2, 0.7), CFrame.new(-45, F + 5.5, Layout.HallZ.min), Color3.fromRGB(220, 240, 255), Enum.Material.Ice, { Transparency = 0.3 })

	-- Storage: shelves, costume closet, Mr. Munch costume
	local st = Layout.Rooms.Storage
	for i = 0, 2 do
		block(r, "Shelf", Vector3.new(st.minX + 1, F, -40 + i * 6), Vector3.new(st.minX + 3, 9, -37 + i * 6), C.wood, Enum.Material.WoodPlanks)
	end
	block(r, "CostumeClosetBox", Vector3.new(-32, F, -48), Vector3.new(-26, 10, -45), Color3.fromRGB(120, 80, 50), Enum.Material.WoodPlanks)
	local closetDoor = at(r, "CostumeClosetDoor", Vector3.new(5.6, 9, 0.2), CFrame.new(-29, F + 4.7, -44.9), Color3.fromRGB(140, 95, 60), Enum.Material.WoodPlanks)
	sign(closetDoor, Enum.NormalId.Back, "COSTUMES", { color = C.mustard, ppu = 20 })
	local costume = ModelFactory.buildMunch({ scale = 0.62, anchored = true })
	costume.Name = "MunchCostume"
	ModelFactory.place(costume, CFrame.new(-21, F, -46.5))
	costume.Parent = r

	-- Office: Deb's desk, coffee, TV + VHS
	block(r, "DebDesk", Vector3.new(-6, F, -42), Vector3.new(4, 3.4, -38), C.wood, Enum.Material.Wood)
	at(r, "DebCoffee", Vector3.new(0.6, 0.8, 0.6), CFrame.new(1, 3.8, -40), C.white)
	local tv = at(r, "OfficeTV", Vector3.new(3.4, 2.6, 2.2), CFrame.new(-6, 4.7, -44), Color3.fromRGB(40, 40, 45))
	sign(tv, Enum.NormalId.Back, "", { name = "Screen", background = Color3.fromRGB(20, 20, 30), color = C.white, font = Enum.Font.Arcade })
	at(r, "VHSTape", Vector3.new(1.4, 0.4, 0.8), CFrame.new(Layout.VHS + Vector3.new(2.5, -0.6, 2)), C.black)
	at(r, "OfficeChair", Vector3.new(2, 2.4, 2), CFrame.new(-1, F + 1.2, -36), Color3.fromRGB(40, 40, 50))
	local cork = at(r, "Corkboard", Vector3.new(6, 4, 0.2), CFrame.new(-1, 8, -47.6), Color3.fromRGB(190, 150, 100))
	sign(cork, Enum.NormalId.Back, "LATE CUSTOMER POLICY:\nThey are not dangerous.\nDo not serve them.\nIf you serve them, they will become Regulars.\nWe do not want more Regulars.", { color = C.black, font = Enum.Font.PatrickHand, ppu = 30 })

	-- Break room: Employee of the Month wall
	local wall = folder(r, "EmployeeWall")
	local EW = Layout.EmployeeWall
	local header = at(wall, "Header", Vector3.new(14, 1.4, 0.1), CFrame.new(EW.centerX, EW.y + 3.4, EW.z), C.mustard)
	sign(header, Enum.NormalId.Back, "EMPLOYEE OF THE MONTH", { color = C.ketchup })
	for i = 1, 13 do
		local col = (i - 1) % 7
		local row = math.floor((i - 1) / 7)
		local x = EW.centerX + (col - 3) * EW.spacing * 1.15
		local y = EW.y + 1.2 - row * 2.6
		local photo = at(wall, "Photo" .. i, Vector3.new(1.7, 2.2, 0.1), CFrame.new(x, y, EW.z), Color3.fromRGB(120, 90, 50), Enum.Material.Wood)
		photo:SetAttribute("Index", i)
		local uv = at(wall, "PhotoUV" .. i, Vector3.new(1.6, 2.0, 0.05), CFrame.new(x, y, EW.z + 0.1), Color3.fromRGB(190, 90, 255), Enum.Material.Neon, { Transparency = 0.6 })
		uv:SetAttribute("Index", i)
	end
	block(r, "BreakTable", Vector3.new(16, F, -38), Vector3.new(28, 3.2, -33), Color3.fromRGB(240, 240, 235))
	for i = 0, 4 do
		block(r, "Locker", Vector3.new(11 + i * 2.2, F, -32), Vector3.new(13 + i * 2.2, 9, -30), Color3.fromRGB(80, 110, 160), Enum.Material.Metal)
	end

	-- Bathroom stall
	local bath = Layout.Rooms.Bathroom
	block(r, "StallWalls", Vector3.new(46, F, -48), Vector3.new(46.3, 8, -39), Color3.fromRGB(150, 180, 200))
	block(r, "StallWalls", Vector3.new(53.7, F, -48), Vector3.new(54, 8, -39), Color3.fromRGB(150, 180, 200))
	local stallDoor = at(r, "StallDoor", Vector3.new(7.4, 7, 0.2), CFrame.new(50, F + 4, -39), Color3.fromRGB(150, 180, 200))
	sign(stallDoor, Enum.NormalId.Back, "OCCUPIED?", { color = C.navy, ppu = 20 })
	block(r, "Sink", Vector3.new(bath.minX + 1, 3, -30), Vector3.new(bath.minX + 4, 3.6, -26), C.white)

	-- PlayPlace: ball pit, slide, statue
	local P = Layout.PlayPlace
	local pitCenter = Vector3.new(-80, 0, -30)
	block(r, "BallPitWall", pitCenter + Vector3.new(-7, F, -7), pitCenter + Vector3.new(7, 2.4, -6.5), C.mustard)
	block(r, "BallPitWall", pitCenter + Vector3.new(-7, F, 6.5), pitCenter + Vector3.new(7, 2.4, 7), C.mustard)
	block(r, "BallPitWall", pitCenter + Vector3.new(-7, F, -7), pitCenter + Vector3.new(-6.5, 2.4, 7), C.mustard)
	block(r, "BallPitWall", pitCenter + Vector3.new(6.5, F, -7), pitCenter + Vector3.new(7, 2.4, 7), C.mustard)
	local ballColors = { C.ketchup, C.mustard, C.pickle, Color3.fromRGB(60, 120, 220), Color3.fromRGB(240, 120, 200) }
	local rng = Random.new(13)
	local balls = folder(r, "BallPitBalls")
	for i = 1, 70 do
		local p = at(balls, "Ball", Vector3.new(1.1, 1.1, 1.1), CFrame.new(pitCenter + Vector3.new(rng:NextNumber(-6, 6), 1.1 + rng:NextNumber(0, 0.9), rng:NextNumber(-6, 6))), ballColors[(i % #ballColors) + 1])
		p.Shape = Enum.PartType.Ball
		p.CanCollide = false
	end
	local slide = Instance.new("WedgePart")
	slide.Name = "Slide"
	slide.Size = Vector3.new(4, 7, 12)
	slide.CFrame = CFrame.new(-88, F + 3.5, -2)
	slide.Color = Color3.fromRGB(60, 120, 220)
	slide.Anchored = true
	slide.Parent = r
	block(r, "SlideTower", Vector3.new(-91, F, -12), Vector3.new(-85, 7, -8), C.ketchup)
	local statue = ModelFactory.buildMunch({ statue = true, anchored = true, scale = 0.85 })
	ModelFactory.place(statue, CFrame.lookAt(Layout.StatuePosition, Layout.StatueFacing))
	statue.Parent = r
	local playSign = at(r, "PlayPlaceSign", Vector3.new(10, 2, 0.2), CFrame.new(-76, 12, P.minZ + 0.2), C.mustard)
	sign(playSign, Enum.NormalId.Back, "MR. MUNCH'S PLAYPLACE", { color = C.ketchup })
end

local function buildHidingSpots(root: Instance)
	local h = folder(root, "HidingSpots")
	for _, id in Layout.HidingOrder do
		local spot = Layout.HidingSpots[id]
		local p = at(h, id, Vector3.new(2, 2, 0.5), CFrame.new(spot.prompt), C.white, Enum.Material.SmoothPlastic, {
			Transparency = 1,
			CanCollide = false,
			CanQuery = false,
		})
		p:SetAttribute("Capacity", spot.capacity)
		p:SetAttribute("Label", spot.label)
	end
end

local function buildLane(root: Instance)
	local l = folder(root, "Lane")
	-- speaker post
	local post = Layout.SpeakerPost
	at(l, "SpeakerPole", Vector3.new(0.6, 4, 0.6), CFrame.new(post + Vector3.new(0, 2, 0)), C.darkSteel, Enum.Material.Metal)
	local speaker = at(l, "SpeakerPost", Vector3.new(1.6, 2.2, 1.2), CFrame.new(post + Vector3.new(0, 4.6, 0)), C.ketchup)
	sign(speaker, Enum.NormalId.Back, "ORDER HERE", { color = C.mustard, ppu = 40 })
	at(l, "SpeakerLight", Vector3.new(0.4, 0.4, 0.2), CFrame.new(post + Vector3.new(0, 5.4, 0.62)), Color3.fromRGB(80, 255, 120), Enum.Material.Neon)
	-- menu board
	local mb = Layout.MenuBoard
	at(l, "MenuLegL", Vector3.new(0.5, 3, 0.5), CFrame.new(mb + Vector3.new(-3, 1.5, 0)), C.darkSteel, Enum.Material.Metal)
	at(l, "MenuLegR", Vector3.new(0.5, 3, 0.5), CFrame.new(mb + Vector3.new(3, 1.5, 0)), C.darkSteel, Enum.Material.Metal)
	local board = at(l, "MenuBoard", Vector3.new(8, 5, 0.5), CFrame.new(mb + Vector3.new(0, 5.5, 0)), Color3.fromRGB(30, 30, 35))
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Menu"
	gui.Face = Enum.NormalId.Back
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Parent = board
	local list = Instance.new("TextLabel")
	list.Name = "Label"
	list.Size = UDim2.fromScale(1, 1)
	list.BackgroundColor3 = Color3.fromRGB(30, 20, 20)
	list.TextColor3 = C.mustard
	list.Font = Enum.Font.FredokaOne
	list.TextScaled = true
	list.TextXAlignment = Enum.TextXAlignment.Left
	list.Text = "  MUNCHIE'S\n  #1 Munch Burger   3.49\n  #2 Cheeseburger    3.99\n  #3 Fries                1.99\n  #4 Munch Stack      5.99\n  #5 Drink                1.49\n  #6 Shake               2.99"
	list.Parent = gui
	pointLight(board, Color3.fromRGB(255, 220, 160), 14, 1)
	-- lane camera on a pole across the lane
	local pole = Layout.LaneCamPole
	at(l, "LaneCamPole", Vector3.new(0.6, 16, 0.6), CFrame.new(pole + Vector3.new(0, 8, 0)), C.darkSteel, Enum.Material.Metal)
	local cam = Layout.Cameras.LaneCam
	at(l, "LaneCam", Vector3.new(1, 1, 2), CFrame.lookAt(cam.from, cam.to), Color3.fromRGB(230, 230, 230))
	at(l, "LaneCamLight", Vector3.new(0.3, 0.3, 0.3), CFrame.lookAt(cam.from, cam.to) * CFrame.new(0.3, 0.4, -0.9), Color3.fromRGB(255, 30, 30), Enum.Material.Neon)
	-- convex safety mirror
	local mp = Layout.MirrorPole
	at(l, "MirrorPole", Vector3.new(0.4, 8.5, 0.4), CFrame.new(mp + Vector3.new(0, 4.25, 0)), C.darkSteel, Enum.Material.Metal)
	local mirrorCam = Layout.Cameras.Mirror
	local mirror = at(l, "ConvexMirror", Vector3.new(0.4, 2.6, 2.6), CFrame.lookAt(mirrorCam.from, mirrorCam.to) * CFrame.Angles(0, math.rad(90), 0), C.steel, Enum.Material.Foil)
	mirror.Shape = Enum.PartType.Cylinder
	-- lane lights
	for _, x in { -120, -60, 0, 60, 120 } do
		lamp(l, Vector3.new(x, 0, Layout.LaneZ + 9))
	end
	-- the big pole sign
	local sp = Layout.SignPole
	at(l, "SignPole", Vector3.new(1.4, 34, 1.4), CFrame.new(sp + Vector3.new(0, 17, 0)), C.darkSteel, Enum.Material.Metal)
	local bigSign = at(l, "BigSign", Vector3.new(18, 8, 2), CFrame.new(sp + Vector3.new(0, 36, 0)), C.ketchup)
	sign(bigSign, Enum.NormalId.Back, "MUNCHIE'S", { color = C.mustard, ppu = 12 })
	sign(bigSign, Enum.NormalId.Front, "MUNCHIE'S", { color = C.mustard, ppu = 12 })
	pointLight(bigSign, C.ketchup, 40, 1.2)
	local openSign = at(l, "OpenSign", Vector3.new(16, 3, 1), CFrame.new(sp + Vector3.new(0, 30, 0)), Color3.fromRGB(20, 20, 25))
	sign(openSign, Enum.NormalId.Back, "OPEN LATE. OPEN ALWAYS.", { color = Color3.fromRGB(255, 80, 120), ppu = 20, name = "OpenText" })
	sign(openSign, Enum.NormalId.Front, "OPEN LATE. OPEN ALWAYS.", { color = Color3.fromRGB(255, 80, 120), ppu = 20, name = "OpenTextBack" })
	-- decorations that come and go by night
	local scenery = folder(root, "Scenery")
	local balloons = folder(scenery, "Balloons")
	for i, x in { -48, -30, 30, 54 } do
		local color = ({ C.ketchup, C.mustard, C.pickle, Color3.fromRGB(60, 120, 220) })[i]
		at(balloons, "String", Vector3.new(0.05, 6, 0.05), CFrame.new(x, 3, 13.6), C.white)
		local balloon = at(balloons, "Balloon", Vector3.new(2, 2.4, 2), CFrame.new(x, 7, 13.6), color)
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = balloon
	end
	local grand = at(balloons, "GrandBanner", Vector3.new(20, 2, 0.2), CFrame.new(-5, 12.5, 13.6), C.white)
	sign(grand, Enum.NormalId.Back, "GRAND RE-OPENING!", { color = C.ketchup })
	local safety = at(scenery, "SafetyPoster", Vector3.new(5, 6, 0.1), CFrame.new(22, 8.5, -29.9), C.white)
	sign(safety, Enum.NormalId.Back, "EMPLOYEE SAFETY:\nIf the lights flicker,\nHIDE.\nThis is a normal part of 24-hour service.", { color = C.navy, background = Color3.fromRGB(255, 250, 230), name = "Text" })
	local visit = at(scenery, "VisitBanner", Vector3.new(26, 2.4, 0.2), CFrame.new(0, 13.5, -13.4), C.mustard)
	sign(visit, Enum.NormalId.Back, "MR. MUNCH VISITING! SMILE!", { color = C.ketchup })
	local rain = at(scenery, "Rain", Vector3.new(400, 1, 120), CFrame.new(0, 60, 0), C.white, Enum.Material.SmoothPlastic, { Transparency = 1, CanCollide = false, CanQuery = false })
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "RainEmitter"
	emitter.Enabled = false
	emitter.Rate = 600
	emitter.Lifetime = NumberRange.new(1.2, 1.6)
	emitter.Speed = NumberRange.new(60, 70)
	emitter.EmissionDirection = Enum.NormalId.Bottom
	emitter.Size = NumberSequence.new(0.15)
	emitter.Transparency = NumberSequence.new(0.4)
	emitter.Color = ColorSequence.new(Color3.fromRGB(180, 200, 230))
	emitter.LightEmission = 0.2
	emitter.Parent = rain
end

local function buildLobby(root: Instance)
	local lobby = folder(root, "Lobby")
	local L = Layout.Lobby
	block(lobby, "ParkingLot", Vector3.new(L.minX, 0, L.minZ), Vector3.new(L.maxX, 0.06, L.maxZ), C.lot, Enum.Material.Asphalt)
	-- path from the lot to the crew door
	for x = L.minX + 8, L.maxX - 8, 10 do
		at(lobby, "ParkingLine", Vector3.new(0.3, 0.08, 10), CFrame.new(x, 0.08, -132), C.white)
		at(lobby, "ParkingLine", Vector3.new(0.3, 0.08, 10), CFrame.new(x, 0.08, -120), C.white)
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Size = Vector3.new(10, 0.4, 10)
	spawn.CFrame = CFrame.new(Layout.LobbySpawn.X, 0.2, Layout.LobbySpawn.Z)
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Color = C.mustard
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = lobby
	for _, booth in L.Booths do
		local p = booth.position
		local pad = at(lobby, "Booth" .. booth.id, Vector3.new(L.BoothSize, 0.3, L.BoothSize), CFrame.new(p + Vector3.new(0, 0.15, 0)), C.ketchup, Enum.Material.Neon, { Transparency = 0.4 })
		pad:SetAttribute("BoothId", booth.id)
		at(lobby, "BoothClockPost", Vector3.new(0.5, 6, 0.5), CFrame.new(p + Vector3.new(0, 3, L.BoothSize / 2 + 1)), C.darkSteel, Enum.Material.Metal)
		local display = at(lobby, "Booth" .. booth.id .. "Display", Vector3.new(7, 4.5, 0.4), CFrame.new(p + Vector3.new(0, 7.5, L.BoothSize / 2 + 1)), Color3.fromRGB(30, 30, 35))
		sign(display, Enum.NormalId.Front, "CLOCK IN " .. booth.id .. "\nStep on the pad to start a shift", { color = C.mustard, name = "Display", ppu = 30 })
	end
	local welcome = at(lobby, "WelcomeSign", Vector3.new(30, 5, 0.5), CFrame.new(0, 12, -60), C.ketchup)
	sign(welcome, Enum.NormalId.Front, "MUNCHIE'S CREW PARKING — STEP ON A CLOCK-IN PAD TO START YOUR SHIFT", { color = C.mustard })
	at(lobby, "WelcomePoleL", Vector3.new(0.6, 12, 0.6), CFrame.new(-14, 6, -60), C.darkSteel)
	at(lobby, "WelcomePoleR", Vector3.new(0.6, 12, 0.6), CFrame.new(14, 6, -60), C.darkSteel)
	-- locker room shed
	local lp = L.Locker
	block(lobby, "LockerShed", lp + Vector3.new(-8, 0, -6), lp + Vector3.new(8, 10, 6), Color3.fromRGB(80, 110, 160), Enum.Material.Metal)
	local locker = at(lobby, "Locker", Vector3.new(6, 7, 0.5), CFrame.new(lp + Vector3.new(0, 3.5, 6.3)), Color3.fromRGB(60, 90, 140), Enum.Material.Metal)
	sign(locker, Enum.NormalId.Back, "LOCKER ROOM\n(cosmetics)", { color = C.white })
	-- fax machine for codes
	local fp = L.Fax
	block(lobby, "FaxTable", fp + Vector3.new(-3, 0, -2), fp + Vector3.new(3, 3.2, 2), C.wood, Enum.Material.Wood)
	at(lobby, "Fax", Vector3.new(2.6, 1.2, 2), CFrame.new(fp + Vector3.new(0, 3.8, 0)), Color3.fromRGB(225, 215, 190))
	local faxSign = at(lobby, "FaxSign", Vector3.new(6, 2, 0.2), CFrame.new(fp + Vector3.new(0, 7, 2)), C.mustard)
	sign(faxSign, Enum.NormalId.Back, "CORPORATE FAX\n(enter codes)", { color = C.ketchup })
	-- field guide kiosk
	local fg = L.FieldGuide
	local kiosk = at(lobby, "FieldGuideKiosk", Vector3.new(4, 6, 2), CFrame.new(fg + Vector3.new(0, 3, 0)), C.pickle)
	sign(kiosk, Enum.NormalId.Back, "FIELD GUIDE\n& BADGES", { color = C.white })
	-- leaderboard + lobby TV
	local board = at(lobby, "Leaderboard", Vector3.new(18, 12, 0.6), CFrame.new(L.Leaderboard + Vector3.new(0, 9, 0)), Color3.fromRGB(25, 25, 30))
	sign(board, Enum.NormalId.Back, "TOP LATE-CUSTOMER CATCHERS\n(loading...)", { color = C.mustard, name = "Board", font = Enum.Font.GothamBold, ppu = 20 })
	at(lobby, "LeaderboardLegs", Vector3.new(16, 3, 0.4), CFrame.new(L.Leaderboard + Vector3.new(0, 1.5, 0)), C.darkSteel)
	local tv = at(lobby, "LobbyTV", Vector3.new(16, 10, 0.8), CFrame.new(L.LobbyTV + Vector3.new(0, 8, 0)), Color3.fromRGB(20, 20, 25))
	sign(tv, Enum.NormalId.Back, "MUNCHIE'S TV\nNext shift: Night 1", { color = Color3.fromRGB(140, 220, 255), name = "Screen", font = Enum.Font.Arcade, ppu = 20 })
	at(lobby, "TVLegs", Vector3.new(14, 3, 0.4), CFrame.new(L.LobbyTV + Vector3.new(0, 1.5, 0)), C.darkSteel)
	local credits = at(lobby, "CreditsWall", Vector3.new(14, 8, 0.6), CFrame.new(L.CreditsWall + Vector3.new(0, 5, 0)), Color3.fromRGB(240, 235, 220))
	sign(credits, Enum.NormalId.Back, "THANK YOU, SUPPORTERS!", { color = C.ketchup, name = "Credits", ppu = 20 })
	-- employee-of-the-month teaser on the lot
	local teaser = at(lobby, "EmployeeTeaser", Vector3.new(12, 4, 0.4), CFrame.new(L.EmployeeSign + Vector3.new(30, 8, 0)), C.mustard)
	sign(teaser, Enum.NormalId.Front, "EMPLOYEE OF THE MONTH:\nYOU?", { color = C.ketchup })
	for _, x in { -60, 0, 60 } do
		for _, z in { -80, -130 } do
			lamp(lobby, Vector3.new(x, 0, z), 16)
		end
	end
end

local function buildGhostCollision(root: Instance)
	local g = folder(root, "GhostCollision")
	local minX, maxX = Layout.PlayPlace.minX - 1, Layout.Building.maxX + 1
	local minZ, maxZ = Layout.Building.minZ - 1, Layout.Building.maxZ + 1
	local floor = block(g, "GhostFloor", Vector3.new(minX, -0.4, minZ), Vector3.new(maxX, F, maxZ), C.white, Enum.Material.SmoothPlastic, {
		Transparency = 1,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
		CollisionGroup = "GhostFloor",
	})
	floor:AddTag("GhostFloor")
	local walls = {
		{ Vector3.new(minX - 1, 0, minZ - 1), Vector3.new(maxX + 1, 30, minZ) },
		{ Vector3.new(minX - 1, 0, maxZ), Vector3.new(maxX + 1, 30, maxZ + 1) },
		{ Vector3.new(minX - 1, 0, minZ), Vector3.new(minX, 30, maxZ) },
		{ Vector3.new(maxX, 0, minZ), Vector3.new(maxX + 1, 30, maxZ) },
		{ Vector3.new(minX, 18, minZ), Vector3.new(maxX, 19, maxZ) },
	}
	for _, w in walls do
		local p = block(g, "GhostBounds", w[1], w[2], C.white, Enum.Material.SmoothPlastic, {
			Transparency = 1,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
			CollisionGroup = "GhostBounds",
		})
		p:AddTag("GhostBounds")
	end
end

---------------------------------------------------------------------------

function MapBuilder.build(parent: Instance): Folder
	local root = Instance.new("Folder")
	root.Name = "Munchies"
	buildGround(root)
	buildShell(root)
	buildLights(root)
	buildKitchen(root)
	buildRooms(root)
	buildHidingSpots(root)
	buildLane(root)
	buildLobby(root)
	buildGhostCollision(root)
	folder(root, "Dynamic")
	root:SetAttribute("BuiltBy", "MapBuilder")
	root.Parent = parent
	return root
end

return MapBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">ModelFactory</string>
            <string name="Source"><![CDATA[-- Builds every greybox model the game spawns: customers + cars (with their anomaly tells),
-- Mr. Munch, Gizmo, food items, raccoons, Shift Ghost sheets, props.
--
-- Models are built around the origin with an anchored "Root" PrimaryPart. With `anchored = false`
-- (the default for runtime models) every other part is welded to Root and unanchored, so moving
-- Root moves the whole thing. Must not use PivotTo/GetPivot so Lune can run it at build time.
--
-- Channel tags (read by the client's view controller):
--   CollectionService tag "ChannelPart" + attribute Channel = "CamOnly" | "NotOnCam" | "UVOnly"

local ModelFactory = {}

local SMOOTH = Enum.Material.SmoothPlastic
local VERTICAL = CFrame.Angles(0, 0, math.rad(90)) -- turns a cylinder's X axis to Y

local COLORS = {
	white = Color3.fromRGB(245, 245, 245),
	black = Color3.fromRGB(25, 25, 28),
	glass = Color3.fromRGB(160, 200, 220),
	tire = Color3.fromRGB(30, 30, 32),
	chrome = Color3.fromRGB(200, 200, 205),
	headlight = Color3.fromRGB(255, 244, 200),
	taillight = Color3.fromRGB(200, 30, 30),
	bun = Color3.fromRGB(222, 166, 92),
	patty = Color3.fromRGB(105, 60, 34),
	lettuce = Color3.fromRGB(110, 190, 70),
	cheese = Color3.fromRGB(255, 205, 40),
	ketchup = Color3.fromRGB(215, 38, 61),
	mustard = Color3.fromRGB(244, 180, 0),
	uv = Color3.fromRGB(190, 90, 255),
	glove = Color3.fromRGB(250, 250, 250),
	lips = Color3.fromRGB(150, 40, 50),
}
ModelFactory.Colors = COLORS

---------------------------------------------------------------------------
-- Low-level helpers
---------------------------------------------------------------------------

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, props: { [string]: any }?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or SMOOTH
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	if props then
		for key, value in props do
			(p :: any)[key] = value
		end
	end
	p.Parent = parent
	return p
end
ModelFactory.part = part

local function cylinder(parent: Instance, name: string, length: number, diameter: number, cf: CFrame, color: Color3, material: Enum.Material?, props: { [string]: any }?): Part
	local p = part(parent, name, Vector3.new(length, diameter, diameter), cf, color, material, props)
	p.Shape = Enum.PartType.Cylinder
	return p
end
ModelFactory.cylinder = cylinder

local function ball(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = part(parent, name, size, cf, color, material)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end
ModelFactory.ball = ball

local function channel(inst: BasePart, mode: string)
	inst:SetAttribute("Channel", mode)
	inst:AddTag("ChannelPart")
end
ModelFactory.channel = channel

local function newModel(name: string): (Model, Part)
	local model = Instance.new("Model")
	model.Name = name
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(1, 1, 1)
	root.CFrame = CFrame.new()
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.Parent = model
	model.PrimaryPart = root
	return model, root
end
ModelFactory.newModel = newModel

-- Weld everything to Root (unless the model should stay fully anchored).
local function finalize(model: Model, anchored: boolean?)
	local root = model.PrimaryPart :: BasePart
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d ~= root then
			if not anchored then
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = root
				weld.Part1 = d
				weld.Parent = d
				d.Anchored = false
				d.Massless = true
			end
			d.CanCollide = false
			d.CanTouch = false
		end
	end
	return model
end
ModelFactory.finalize = finalize

-- Move a model so its Root lands on `cf` (works without PivotTo).
function ModelFactory.place(model: Model, cf: CFrame)
	local root = model.PrimaryPart :: BasePart
	local inverse = root.CFrame:Inverse()
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CFrame = cf * (inverse * d.CFrame)
		end
	end
end

local function surfaceText(p: BasePart, face: Enum.NormalId, text: string, color: Color3, font: Enum.Font?, background: Color3?): SurfaceGui
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Text"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 50
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = if background then 0 else 1
	label.BackgroundColor3 = background or Color3.new(0, 0, 0)
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.TextWrapped = true
	label.Font = font or Enum.Font.FredokaOne
	label.Parent = gui
	gui.Parent = p
	return gui
end
ModelFactory.surfaceText = surfaceText

---------------------------------------------------------------------------
-- Faces (drawn with GUI frames so tells like "never blinks" can be animated)
---------------------------------------------------------------------------

local function frame(parent: Instance, name: string, pos: UDim2, size: UDim2, color: Color3, round: boolean?): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = pos
	f.Size = size
	f.BackgroundColor3 = color
	f.BorderSizePixel = 0
	if round then
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = f
	end
	f.Parent = parent
	return f
end

-- Draws a face into `container` (a SurfaceGui or Frame). Returns the canvas frame.
function ModelFactory.drawFace(container: Instance, skin: Color3, opts: { [string]: any }?)
	local o = opts or {}
	local canvas = frame(container, "Face", UDim2.fromScale(0.5, 0.5), UDim2.fromScale(1, 1), skin)
	canvas.BackgroundTransparency = if o.transparentBackground then 1 else 0
	local eyeSize = UDim2.fromScale(0.2, 0.2)
	for _, side in { { "L", 0.32 }, { "R", 0.68 } } do
		local eye = frame(canvas, "Eye" .. side[1], UDim2.fromScale(side[2], 0.4), eyeSize, COLORS.white, true)
		frame(eye, "Pupil", UDim2.fromScale(0.5, 0.55), UDim2.fromScale(0.5, 0.5), o.pupilColor or COLORS.black, true)
		local lid = frame(canvas, "Lid" .. side[1], UDim2.fromScale(side[2], 0.4), UDim2.fromScale(0.24, 0.24), skin, true)
		lid.Visible = false
		lid.ZIndex = 3
	end
	local mouthWidth = o.mouthWidth or 0.36
	local mouth = frame(canvas, "Mouth", UDim2.fromScale(0.5, 0.72), UDim2.fromScale(mouthWidth, 0.16), COLORS.lips, true)
	mouth.ZIndex = 2
	local cover = frame(canvas, "MouthCover", UDim2.fromScale(0.5, 0.66), UDim2.fromScale(mouthWidth + 0.06, 0.12), skin)
	cover.ZIndex = 2
	if o.teethText then
		local teeth = Instance.new("TextLabel")
		teeth.Name = "Teeth"
		teeth.AnchorPoint = Vector2.new(0.5, 0.5)
		teeth.Position = UDim2.fromScale(0.5, 0.74)
		teeth.Size = UDim2.fromScale(0.34, 0.12)
		teeth.BackgroundColor3 = COLORS.white
		teeth.BorderSizePixel = 0
		teeth.Text = o.teethText
		teeth.TextColor3 = COLORS.ketchup
		teeth.TextScaled = true
		teeth.Font = Enum.Font.FredokaOne
		teeth.ZIndex = 4
		teeth.Parent = canvas
	end
	if o.tears then
		frame(canvas, "Tear", UDim2.fromScale(0.3, 0.6), UDim2.fromScale(0.06, 0.14), Color3.fromRGB(90, 160, 255), true).ZIndex = 4
		frame(canvas, "Tear2", UDim2.fromScale(0.7, 0.62), UDim2.fromScale(0.06, 0.14), Color3.fromRGB(90, 160, 255), true).ZIndex = 4
	end
	return canvas
end

local function faceGui(head: BasePart, skin: Color3, opts: { [string]: any }?): SurfaceGui
	local gui = Instance.new("SurfaceGui")
	gui.Name = "FaceGui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 60
	gui.LightInfluence = 0.6
	ModelFactory.drawFace(gui, skin, opts)
	gui.Parent = head
	return gui
end

---------------------------------------------------------------------------
-- People. Built facing -Z (toward the restaurant window), origin at the seat.
---------------------------------------------------------------------------

local function addHair(model: Model, head: BasePart, style: string, color: Color3)
	local top = head.CFrame * CFrame.new(0, 0.75, 0)
	if style == "Bald" then
		return
	elseif style == "Short" then
		part(model, "Hair", Vector3.new(1.85, 0.35, 1.85), top, color)
	elseif style == "Long" then
		part(model, "Hair", Vector3.new(1.9, 0.4, 1.9), top, color)
		part(model, "HairBack", Vector3.new(1.9, 1.8, 0.4), head.CFrame * CFrame.new(0, -0.1, 0.85), color)
	elseif style == "Bun" then
		part(model, "Hair", Vector3.new(1.85, 0.35, 1.85), top, color)
		ball(model, "Bun", Vector3.new(0.9, 0.9, 0.9), head.CFrame * CFrame.new(0, 1.05, 0.4), color)
	elseif style == "Curly" then
		ball(model, "Hair", Vector3.new(2.2, 1.2, 2.2), head.CFrame * CFrame.new(0, 0.75, 0.1), color)
	elseif style == "Spiky" then
		for i = -1, 1 do
			local spike = Instance.new("WedgePart")
			spike.Name = "Spike"
			spike.Size = Vector3.new(0.5, 0.7, 0.9)
			spike.CFrame = head.CFrame * CFrame.new(i * 0.55, 1.05, 0)
			spike.Color = color
			spike.Material = SMOOTH
			spike.Anchored = true
			spike.CanCollide = false
			spike.Parent = model
		end
		part(model, "Hair", Vector3.new(1.85, 0.3, 1.85), top, color)
	elseif style == "Beanie" then
		ball(model, "Hair", Vector3.new(2, 1.1, 2), head.CFrame * CFrame.new(0, 0.6, 0), color)
	elseif style == "Cap" then
		part(model, "Cap", Vector3.new(1.9, 0.45, 1.9), top, color)
		part(model, "Brim", Vector3.new(1.4, 0.12, 0.9), head.CFrame * CFrame.new(0, 0.6, -1.2), color)
	end
end

-- Waving hand held up out of the car window. digits = number of fingers (thumb included).
local function addHand(model: Model, at: CFrame, skin: Color3, digits: number, opts: { [string]: any }?)
	local o = opts or {}
	local hand = Instance.new("Model")
	hand.Name = "Hand"
	hand.Parent = model
	local handColor = o.glove or skin
	part(hand, "Palm", Vector3.new(1.0, 0.9, 0.3), at, handColor)
	if o.cast then
		part(hand, "Cast", Vector3.new(1.3, 1.9, 0.6), at * CFrame.new(0, 0.4, 0), COLORS.white, Enum.Material.Fabric)
		return hand
	end
	local spread = 1.1
	for i = 1, digits do
		local x = -spread / 2 + (i - 0.5) * spread / digits
		local finger = part(
			hand,
			"Finger" .. i,
			Vector3.new(math.min(0.2, spread / digits * 0.8), 0.75, 0.22),
			at * CFrame.new(x, 0.75, 0),
			handColor
		)
		finger:SetAttribute("Digit", i)
	end
	part(model, "Arm", Vector3.new(0.6, 1.6, 0.6), at * CFrame.new(0.2, -1.1, 0.2), o.sleeve or skin)
	return hand
end

-- spec: { skin, hairColor, hairStyle, shirt, glasses, kid? }
function ModelFactory.addPerson(model: Model, seat: CFrame, spec: { [string]: any }, opts: { [string]: any }?): BasePart
	local o = opts or {}
	local scale = if spec.kid then 0.6 else 1
	local skin = spec.skin or Color3.fromRGB(224, 172, 105)
	part(model, o.prefix and (o.prefix .. "Torso") or "Torso", Vector3.new(2.1, 2, 1.1) * scale, seat * CFrame.new(0, 1.0 * scale, 0), spec.shirt or COLORS.white)
	local head = part(model, o.prefix and (o.prefix .. "Head") or "Head", Vector3.new(1.7, 1.7, 1.7) * scale, seat * CFrame.new(0, 2.85 * scale, 0), skin)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Head
	mesh.Scale = Vector3.new(1.1, 1.1, 1.1)
	mesh.Parent = head
	faceGui(head, skin, o.face)
	if not o.noEars then
		part(model, "EarL", Vector3.new(0.3, 0.6, 0.4) * scale, head.CFrame * CFrame.new(-0.98 * scale, 0, 0), skin)
		part(model, "EarR", Vector3.new(0.3, 0.6, 0.4) * scale, head.CFrame * CFrame.new(0.98 * scale, 0, 0), skin)
	end
	if not spec.kid then
		addHair(model, head, spec.hairStyle or "Short", spec.hairColor or Color3.fromRGB(40, 30, 20))
	elseif spec.hairStyle ~= "Bald" then
		ball(model, "Hair", Vector3.new(1.3, 0.7, 1.3), head.CFrame * CFrame.new(0, 0.5, 0.05), spec.hairColor or Color3.fromRGB(40, 30, 20))
	end
	if spec.glasses then
		part(model, "Glasses", Vector3.new(1.5, 0.35, 0.08) * scale, head.CFrame * CFrame.new(0, 0.2 * scale, -0.95 * scale), COLORS.black)
	end
	return head
end

---------------------------------------------------------------------------
-- Cars. Face +X. Root at ground level, centered. Driver seat on the -Z side.
---------------------------------------------------------------------------

local CAR_SHAPES = {
	Sedan = { length = 12, width = 6, body = 2.2, cabinLen = 6, cabinH = 2.8, roof = true },
	Hatchback = { length = 10.5, width = 5.8, body = 2.2, cabinLen = 6.5, cabinH = 2.8, roof = true, cabinBack = true },
	Compact = { length = 8.5, width = 5.4, body = 2, cabinLen = 5, cabinH = 2.7, roof = true, cabinBack = true },
	Pickup = { length = 13, width = 6.2, body = 2.6, cabinLen = 4.4, cabinH = 2.8, roof = true, bed = true },
	Minivan = { length = 13, width = 6.4, body = 2.4, cabinLen = 10, cabinH = 3.4, roof = true, cabinBack = true },
	Convertible = { length = 12, width = 6, body = 2.1, cabinLen = 5, cabinH = 1.2, roof = false },
	Buick = { length = 14, width = 6.4, body = 2.2, cabinLen = 6.5, cabinH = 2.8, roof = true },
	Police = { length = 12.5, width = 6.2, body = 2.2, cabinLen = 6, cabinH = 2.8, roof = true, police = true },
	Vintage = { length = 13, width = 6.2, body = 2.4, cabinLen = 6, cabinH = 2.9, roof = true, boxy = true },
}

local function buildCarBody(model: Model, kind: string, color: Color3): CFrame
	local shape = CAR_SHAPES[kind] or CAR_SHAPES.Sedan
	local L, W = shape.length, shape.width
	local bodyBottom = 0.9
	local bodyTop = bodyBottom + shape.body
	part(model, "Body", Vector3.new(L, shape.body, W), CFrame.new(0, bodyBottom + shape.body / 2, 0), color, Enum.Material.Metal)
	-- bumpers & lights
	part(model, "BumperF", Vector3.new(0.4, 0.6, W), CFrame.new(L / 2 + 0.1, bodyBottom + 0.3, 0), COLORS.chrome, Enum.Material.Metal)
	part(model, "BumperR", Vector3.new(0.4, 0.6, W), CFrame.new(-L / 2 - 0.1, bodyBottom + 0.3, 0), COLORS.chrome, Enum.Material.Metal)
	for _, z in { -W / 2 + 0.9, W / 2 - 0.9 } do
		local light = part(model, "Headlight", Vector3.new(0.2, 0.6, 1.1), CFrame.new(L / 2 + 0.05, bodyTop - 0.6, z), COLORS.headlight, Enum.Material.Neon)
		local spot = Instance.new("SpotLight")
		spot.Face = Enum.NormalId.Right
		spot.Range = 28
		spot.Angle = 60
		spot.Brightness = 1.5
		spot.Color = COLORS.headlight
		spot.Shadows = false
		spot.Parent = light
		part(model, "Taillight", Vector3.new(0.2, 0.5, 1), CFrame.new(-L / 2 - 0.05, bodyTop - 0.6, z), COLORS.taillight, Enum.Material.Neon)
	end
	-- wheels
	for _, x in { L / 2 - 2.4, -L / 2 + 2.4 } do
		for _, z in { -W / 2 + 0.2, W / 2 - 0.2 } do
			cylinder(model, "Wheel", 0.9, 2.1, CFrame.new(x, 1.05, z) * CFrame.Angles(0, math.rad(90), 0), COLORS.tire)
			cylinder(model, "Hubcap", 0.95, 1.0, CFrame.new(x, 1.05, z) * CFrame.Angles(0, math.rad(90), 0), COLORS.chrome, Enum.Material.Metal)
		end
	end
	-- cabin: pillars, windshield, roof, passenger-side glass. The driver side (-Z) stays open.
	local cabinX = if shape.cabinBack then -L / 2 + shape.cabinLen / 2 + 0.6 else 0
	local cabinTop = bodyTop + shape.cabinH
	local front = cabinX + shape.cabinLen / 2
	local back = cabinX - shape.cabinLen / 2
	if shape.roof then
		part(model, "Roof", Vector3.new(shape.cabinLen, 0.3, W - 0.2), CFrame.new(cabinX, cabinTop, 0), color, Enum.Material.Metal, { Transparency = 0.15 })
		for _, x in { front - 0.2, back + 0.2 } do
			for _, z in { -W / 2 + 0.2, W / 2 - 0.2 } do
				part(model, "Pillar", Vector3.new(0.3, shape.cabinH, 0.3), CFrame.new(x, bodyTop + shape.cabinH / 2, z), color, Enum.Material.Metal)
			end
		end
		part(model, "Windshield", Vector3.new(0.15, shape.cabinH - 0.2, W - 0.6), CFrame.new(front - 0.2, bodyTop + shape.cabinH / 2, 0), COLORS.glass, Enum.Material.Glass, { Transparency = 0.7 })
		part(model, "RearGlass", Vector3.new(0.15, shape.cabinH - 0.2, W - 0.6), CFrame.new(back + 0.2, bodyTop + shape.cabinH / 2, 0), COLORS.glass, Enum.Material.Glass, { Transparency = 0.7 })
		part(model, "SideGlass", Vector3.new(shape.cabinLen - 0.6, shape.cabinH - 0.2, 0.15), CFrame.new(cabinX, bodyTop + shape.cabinH / 2, W / 2 - 0.2), COLORS.glass, Enum.Material.Glass, { Transparency = 0.7 })
		if shape.cabinLen > 6.5 then
			-- rear windows on the driver side for vans (the front seat window stays open)
			part(model, "RearSideGlass", Vector3.new(shape.cabinLen - 4, shape.cabinH - 0.2, 0.15), CFrame.new(back + (shape.cabinLen - 4) / 2 + 0.3, bodyTop + shape.cabinH / 2, -W / 2 + 0.2), COLORS.glass, Enum.Material.Glass, { Transparency = 0.7 })
		end
	else
		part(model, "Windshield", Vector3.new(0.15, 1.2, W - 0.6), CFrame.new(1.8, bodyTop + 0.6, 0), COLORS.glass, Enum.Material.Glass, { Transparency = 0.6 })
	end
	if shape.bed then
		part(model, "BedFloor", Vector3.new(L / 2 - 1, 0.2, W - 0.6), CFrame.new(-L / 4 - 0.5, bodyTop - 0.1, 0), COLORS.black)
	end
	if shape.police then
		part(model, "DoorBlack", Vector3.new(4, shape.body - 0.4, W + 0.05), CFrame.new(0.5, bodyBottom + shape.body / 2, 0), COLORS.black, Enum.Material.Metal)
		part(model, "LightbarR", Vector3.new(0.6, 0.35, 1.6), CFrame.new(cabinX, cabinTop + 0.3, -0.9), Color3.fromRGB(255, 30, 30), Enum.Material.Neon)
		part(model, "LightbarB", Vector3.new(0.6, 0.35, 1.6), CFrame.new(cabinX, cabinTop + 0.3, 0.9), Color3.fromRGB(30, 80, 255), Enum.Material.Neon)
	end
	-- seat (the driver sits here)
	local seatX = if shape.cabinBack then front - 1.6 else 0.9
	part(model, "Seat", Vector3.new(1.6, 0.4, 1.6), CFrame.new(seatX - 0.3, bodyBottom + 0.9, -1.5), COLORS.black)
	-- fake drop shadow that only shows on the Lane Cam (anomalies can lack it)
	local shadow = part(model, "CamShadow", Vector3.new(L + 1, 0.05, W + 1.2), CFrame.new(0, 0.08, 0), Color3.new(0, 0, 0), SMOOTH, { Transparency = 0.45, CastShadow = false })
	channel(shadow, "CamOnly")
	return CFrame.new(seatX, bodyBottom + 0.9, -1.5)
end

local function buildScooter(model: Model, color: Color3): CFrame
	part(model, "Deck", Vector3.new(4, 0.4, 1.2), CFrame.new(0, 1.2, 0), color, Enum.Material.Metal)
	part(model, "Stem", Vector3.new(0.3, 2.6, 0.3), CFrame.new(1.8, 2.6, 0), COLORS.chrome, Enum.Material.Metal)
	part(model, "Handlebar", Vector3.new(0.3, 0.3, 2), CFrame.new(1.8, 3.9, 0), COLORS.black)
	for _, x in { 1.6, -1.6 } do
		cylinder(model, "Wheel", 0.5, 1.4, CFrame.new(x, 0.7, 0) * CFrame.Angles(0, math.rad(90), 0), COLORS.tire)
	end
	part(model, "DeliveryBox", Vector3.new(1.8, 1.8, 1.8), CFrame.new(-1.4, 2.4, 0), color, SMOOTH)
	local box = part(model, "BoxLabel", Vector3.new(1.82, 1.2, 1.82), CFrame.new(-1.4, 2.4, 0), color, SMOOTH, { Transparency = 1 })
	surfaceText(box, Enum.NormalId.Front, "EATS", COLORS.white)
	local light = part(model, "Headlight", Vector3.new(0.3, 0.5, 0.5), CFrame.new(1.95, 3.4, 0), COLORS.headlight, Enum.Material.Neon)
	local spot = Instance.new("SpotLight")
	spot.Face = Enum.NormalId.Right
	spot.Range = 20
	spot.Brightness = 1.2
	spot.Parent = light
	local shadow = part(model, "CamShadow", Vector3.new(5, 0.05, 2.2), CFrame.new(0, 0.08, 0), Color3.new(0, 0, 0), SMOOTH, { Transparency = 0.45, CastShadow = false })
	channel(shadow, "CamOnly")
	return CFrame.new(0, 1.4, -0.4)
end

---------------------------------------------------------------------------
-- Customer (car + driver + tells)
---------------------------------------------------------------------------

local function hasModifier(modifiers: { string }, name: string): (boolean, string?)
	for _, m in modifiers do
		local key, arg = string.match(m, "^([^:]+):(.+)$")
		if m == name or key == name then
			return true, arg
		end
	end
	return false, nil
end
ModelFactory.hasModifier = hasModifier

local function buildMunchHeadInto(model: Model, at: CFrame, scale: number, knockoff: boolean, realMouth: boolean?)
	local s = scale
	local bunColor = if knockoff then Color3.fromRGB(235, 190, 120) else COLORS.bun
	cylinder(model, "BunBottom", 0.6 * s, 3.4 * s, at * CFrame.new(0, 0.3 * s, 0) * VERTICAL, bunColor)
	cylinder(model, "PattyLayer", 0.55 * s, 3.6 * s, at * CFrame.new(0, 0.85 * s, 0) * VERTICAL, COLORS.patty)
	if not knockoff then
		part(model, "CheeseLayer", Vector3.new(3.4 * s, 0.15 * s, 3.4 * s), at * CFrame.new(0, 1.15 * s, 0) * CFrame.Angles(0, math.rad(45), 0), COLORS.cheese)
	end
	cylinder(model, "Lettuce", 0.25 * s, 3.9 * s, at * CFrame.new(0, 1.25 * s, 0) * VERTICAL, COLORS.lettuce)
	local top = ball(model, "BunTop", Vector3.new(3.5 * s, 2.4 * s, 3.5 * s), at * CFrame.new(0, 2.1 * s, 0), bunColor)
	if not knockoff then
		for i = 1, 6 do
			local angle = i * math.pi / 3
			part(model, "Seed", Vector3.new(0.25, 0.1, 0.15) * s, at * CFrame.new(math.cos(angle) * 0.9 * s, 3.2 * s, math.sin(angle) * 0.9 * s), COLORS.white)
		end
	end
	-- face on the front (-Z) of the top bun
	local facePlate = part(model, "FacePlate", Vector3.new(2.6 * s, 1.6 * s, 0.05), at * CFrame.new(0, 2.0 * s, -1.72 * s), bunColor, SMOOTH, { Transparency = 1 })
	local gui = Instance.new("SurfaceGui")
	gui.Name = "MunchFace"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0.3
	gui.Parent = facePlate
	local canvas = ModelFactory.drawFace(gui, bunColor, { transparentBackground = true, mouthWidth = 0.7 })
	if realMouth then
		local mouth = canvas:FindFirstChild("Mouth") :: Frame
		mouth.BackgroundColor3 = Color3.fromRGB(40, 0, 10)
		mouth.Size = UDim2.fromScale(0.75, 0.3)
		for i = 1, 6 do
			frame(canvas, "Tooth" .. i, UDim2.fromScale(0.18 + i * 0.1, 0.63), UDim2.fromScale(0.07, 0.08), COLORS.white).ZIndex = 5
		end
	end
	if not knockoff then
		-- top hat + monocle
		cylinder(model, "HatBrim", 0.12 * s, 2.0 * s, at * CFrame.new(0.4 * s, 3.35 * s, 0) * VERTICAL, COLORS.black)
		cylinder(model, "HatTop", 1.3 * s, 1.3 * s, at * CFrame.new(0.4 * s, 4.0 * s, 0) * VERTICAL, COLORS.black)
		cylinder(model, "HatBand", 0.3 * s, 1.34 * s, at * CFrame.new(0.4 * s, 3.6 * s, 0) * VERTICAL, COLORS.ketchup)
		cylinder(model, "Monocle", 0.08, 0.8 * s, at * CFrame.new(0.55 * s, 2.25 * s, -1.75 * s) * CFrame.Angles(0, math.rad(90), 0), COLORS.mustard, Enum.Material.Metal, { Transparency = 0.2 })
	end
	return top
end

-- data: { person = spec, car = {kind,color}, modifiers = {...}, kidsCount? }
function ModelFactory.buildCustomer(data: { [string]: any }): Model
	local model, root = newModel("Customer")
	local modifiers = data.modifiers or {}
	local spec = data.person or {}
	local carKind = data.car and data.car.kind or "Sedan"
	local carColor = data.car and data.car.color or Color3.fromRGB(150, 150, 160)
	local seat: CFrame
	if carKind == "None" then
		seat = CFrame.new(0, 1.8, -2)
		-- on foot: legs under the torso
		part(model, "Legs", Vector3.new(1.8, 2, 0.9), seat * CFrame.new(0, -0.9, 0), Color3.fromRGB(40, 40, 60))
	elseif carKind == "Scooter" then
		seat = buildScooter(model, carColor)
	else
		seat = buildCarBody(model, carKind, carColor)
	end
	model:SetAttribute("CarKind", carKind)

	if hasModifier(modifiers, "NoShadowCam") then
		local shadow = model:FindFirstChild("CamShadow")
		if shadow then
			shadow:Destroy()
		end
	end

	local noDriver = hasModifier(modifiers, "NoDriver")
	local skin = spec.skin or Color3.fromRGB(224, 172, 105)
	local head: BasePart? = nil

	if not noDriver then
		if hasModifier(modifiers, "TrenchStack") then
			-- Window view: three stacked heads in one trench coat. Lane Cam: one very tall guy.
			local coat = part(model, "Coat", Vector3.new(2.3, 3.2, 1.3), seat * CFrame.new(0, 1.5, 0), Color3.fromRGB(140, 110, 70), Enum.Material.Fabric)
			channel(coat, "NotOnCam")
			local faces = { Color3.fromRGB(150, 150, 150), Color3.fromRGB(130, 130, 135), Color3.fromRGB(110, 110, 115) }
			for i = 1, 3 do
				local h = part(model, "StackHead" .. i, Vector3.new(1.3, 1.1, 1.3), seat * CFrame.new(0, 3.4 + (i - 1) * 1.05, 0), faces[i])
				faceGui(h, faces[i], { pupilColor = Color3.fromRGB(10, 10, 10) })
				part(model, "MaskStripe" .. i, Vector3.new(1.32, 0.3, 1.32), h.CFrame * CFrame.new(0, 0.15, 0), COLORS.black)
				channel(h, "NotOnCam")
				channel(model:FindFirstChild("MaskStripe" .. i) :: BasePart, "NotOnCam")
			end
			local tall = part(model, "TallGuy", Vector3.new(2, 5.5, 1.2), seat * CFrame.new(0, 2.6, 0), Color3.fromRGB(140, 110, 70), Enum.Material.Fabric)
			channel(tall, "CamOnly")
			local tallHead = part(model, "TallHead", Vector3.new(1.4, 1.4, 1.4), seat * CFrame.new(0, 6.1, 0), skin)
			channel(tallHead, "CamOnly")
			addHand(model, seat * CFrame.new(-0.5, 2.6, -1.9), Color3.fromRGB(130, 130, 135), 5)
		elseif hasModifier(modifiers, "Twins") then
			local kid = table.clone(spec)
			kid.kid = true
			ModelFactory.addPerson(model, seat * CFrame.new(-0.45, 0.2, 0), kid, { prefix = "Twin1" })
			ModelFactory.addPerson(model, seat * CFrame.new(0.45, 0.2, 0), kid, { prefix = "Twin2" })
			part(model, "BoosterSeat", Vector3.new(2, 0.6, 1.4), seat * CFrame.new(0, 0, 0), Color3.fromRGB(240, 200, 80))
			head = model:FindFirstChild("Twin1Head") :: BasePart
		elseif hasModifier(modifiers, "KnockoffMunch") then
			part(model, "Torso", Vector3.new(2.3, 2.1, 1.2), seat * CFrame.new(0, 1.05, 0), Color3.fromRGB(200, 40, 40))
			local headModel = Instance.new("Model")
			headModel.Name = "KnockoffHead"
			headModel.Parent = model
			buildMunchHeadInto(headModel, seat * CFrame.new(0, 2.1, 0), 0.6, true)
			addHand(model, seat * CFrame.new(-0.5, 2.4, -1.9), skin, 5, { glove = COLORS.glove, sleeve = Color3.fromRGB(200, 40, 40) })
		elseif hasModifier(modifiers, "Robot") then
			part(model, "Torso", Vector3.new(2.1, 2, 1.1), seat * CFrame.new(0, 1, 0), Color3.fromRGB(170, 170, 180), Enum.Material.Metal)
			local h = part(model, "Head", Vector3.new(1.8, 1.5, 1.5), seat * CFrame.new(0, 2.8, 0), Color3.fromRGB(200, 200, 210), Enum.Material.Metal)
			local gui = surfaceText(h, Enum.NormalId.Front, "◉ ◉\n▬", Color3.fromRGB(80, 255, 140), Enum.Font.Arcade, Color3.fromRGB(20, 30, 30))
			gui.Name = "RobotFace"
			part(model, "Antenna", Vector3.new(0.15, 1, 0.15), seat * CFrame.new(0, 4, 0), COLORS.chrome)
			addHand(model, seat * CFrame.new(-0.5, 2.4, -1.9), Color3.fromRGB(170, 170, 180), 3)
			head = h
		else
			local identical = hasModifier(modifiers, "IdenticalKids")
			local personSpec = table.clone(spec)
			if identical then
				personSpec.kid = true
			end
			local faceOpts = {}
			if hasModifier(modifiers, "LipstickHI") then
				faceOpts.teethText = "HI"
			end
			if hasModifier(modifiers, "GrowingSmile") then
				faceOpts.mouthWidth = 0.5
			end
			head = ModelFactory.addPerson(model, seat, personSpec, { face = faceOpts })
			local digits = 5
			local hasSeven = hasModifier(modifiers, "SevenFingers")
			if hasSeven then
				digits = 7
			end
			local hand = addHand(model, seat * CFrame.new(-0.6, 2.4, -1.9), skin, digits, {
				cast = hasModifier(modifiers, "Cast"),
				sleeve = spec.shirt,
			})
			if hasSeven then
				hand:SetAttribute("FingerCycle", true)
			end
			if hasModifier(modifiers, "ExtraEars") and head then
				part(model, "EarExtra", Vector3.new(0.3, 0.6, 0.4), head.CFrame * CFrame.new(0.98, 0.75, 0), skin)
				part(model, "EarExtra2", Vector3.new(0.3, 0.5, 0.35), head.CFrame * CFrame.new(1.05, -0.6, 0), skin)
			end
			if hasModifier(modifiers, "UpsideDownHat") and head then
				for _, name in { "Cap", "Brim" } do
					local p = model:FindFirstChild(name)
					if p and p:IsA("BasePart") then
						p.CFrame = head.CFrame * CFrame.new(0, 1.2, if name == "Brim" then -0.6 else 0) * CFrame.Angles(math.rad(180), 0, 0)
					end
				end
			end
			if hasModifier(modifiers, "CamPaintedFace") and head then
				local panel = part(model, "PaintedFace", Vector3.new(1.6, 1.6, 0.05), head.CFrame * CFrame.new(0, 0, -0.98), Color3.fromRGB(250, 235, 215), SMOOTH)
				local gui = Instance.new("SurfaceGui")
				gui.Face = Enum.NormalId.Front
				gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
				gui.PixelsPerStud = 60
				gui.LightInfluence = 0
				gui.Parent = panel
				ModelFactory.drawFace(gui, Color3.fromRGB(250, 235, 215), { mouthWidth = 0.8 })
				channel(panel, "CamOnly")
			end
			if hasModifier(modifiers, "StaticSkin") and head then
				head:SetAttribute("Static", true)
			end
		end
	end

	if head then
		head:SetAttribute("IsDriverHead", true)
		if not hasModifier(modifiers, "NeverBlinks") and not hasModifier(modifiers, "Robot") then
			head:SetAttribute("Blinks", true)
		end
		if hasModifier(modifiers, "GrowingSmile") then
			head:SetAttribute("GrowingSmile", true)
		end
	end

	-- Kids in the back of the minivan (the Hendersons)
	local hasKids, kidsArg = hasModifier(modifiers, "Kids")
	local identicalKids, identicalArg = hasModifier(modifiers, "IdenticalKids")
	local kidCount = tonumber(kidsArg or identicalArg or "0") or 0
	if (hasKids or identicalKids) and kidCount > 0 then
		local rng = Random.new(kidCount * 7 + 1)
		local tones = {
			Color3.fromRGB(224, 172, 105),
			Color3.fromRGB(198, 134, 66),
			Color3.fromRGB(255, 224, 189),
			Color3.fromRGB(161, 102, 50),
		}
		for i = 1, kidCount do
			local row = math.floor((i - 1) / 3)
			local col = (i - 1) % 3
			local kidSkin = if identicalKids then skin else tones[rng:NextInteger(1, #tones)]
			local h = part(model, "KidHead" .. i, Vector3.new(1.1, 1.1, 1.1), CFrame.new(-1.2 - row * 1.6, 3.9, -1.6 + col * 1.6), kidSkin)
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Head
			mesh.Parent = h
			faceGui(h, kidSkin, if identicalKids then { mouthWidth = 0.5 } else nil)
		end
	end

	-- UV-only marks
	local hasTag, tagText = hasModifier(modifiers, "UVTag")
	if hasTag and tagText then
		local torso = model:FindFirstChild("Torso") :: BasePart?
		if torso then
			local tag = part(model, "UVTag", Vector3.new(1.4, 0.6, 0.05), torso.CFrame * CFrame.new(0, 0.3, -0.6), COLORS.uv, Enum.Material.Neon, { Transparency = 0.2 })
			surfaceText(tag, Enum.NormalId.Front, tagText, Color3.fromRGB(255, 255, 255), Enum.Font.Arcade)
			channel(tag, "UVOnly")
		end
	end
	local hasText, uvText = hasModifier(modifiers, "UVText")
	if hasText and uvText then
		local shape = CAR_SHAPES[carKind] or CAR_SHAPES.Sedan
		local door = part(model, "UVDoor", Vector3.new(5, 1.6, 0.05), CFrame.new(0, 2.0, -shape.width / 2 - 0.05), COLORS.uv, Enum.Material.Neon, { Transparency = 0.3 })
		surfaceText(door, Enum.NormalId.Front, uvText, Color3.fromRGB(255, 255, 255), Enum.Font.FredokaOne)
		channel(door, "UVOnly")
	end
	if hasModifier(modifiers, "UVHandprints") then
		for i = 1, 4 do
			local print_ = part(model, "UVHandprint", Vector3.new(0.1, 0.7, 0.55), CFrame.new(2.85, 3.6 + (i % 2) * 0.6, -2 + i * 0.9) * CFrame.Angles(0, 0, math.rad(15 * i)), COLORS.uv, Enum.Material.Neon, { Transparency = 0.2 })
			channel(print_, "UVOnly")
		end
	end

	root.Name = "Root"
	return finalize(model, false)
end

---------------------------------------------------------------------------
-- Mr. Munch (also the fiberglass statue, the bobblehead and the knockoffs)
---------------------------------------------------------------------------

-- opts: { anchored, scale, statue, realMouth, knockoff }
function ModelFactory.buildMunch(opts: { [string]: any }?): Model
	local o = opts or {}
	local s = o.scale or 1
	local model = newModel(if o.statue then "MunchStatue" else "MrMunch")
	local tux = if o.statue then Color3.fromRGB(200, 50, 50) else Color3.fromRGB(190, 30, 40)
	local glove = COLORS.glove
	-- shoes (squeak squeak)
	for _, x in { -0.8, 0.8 } do
		part(model, "Shoe", Vector3.new(1.4, 0.9, 2.6) * s, CFrame.new(x * s, 0.45 * s, -0.5 * s), COLORS.ketchup)
		part(model, "ShoeToe", Vector3.new(1.45, 0.5, 0.8) * s, CFrame.new(x * s, 0.6 * s, -1.6 * s), COLORS.white)
		part(model, "Leg", Vector3.new(0.9, 2.4, 0.9) * s, CFrame.new(x * s, 2.1 * s, 0), COLORS.black)
	end
	local torso = part(model, "Torso", Vector3.new(3, 3, 1.8) * s, CFrame.new(0, 4.8 * s, 0), tux)
	part(model, "Shirt", Vector3.new(1, 2.6, 0.1) * s, CFrame.new(0, 4.9 * s, -0.92 * s), COLORS.white)
	part(model, "BowTie", Vector3.new(1.2, 0.5, 0.2) * s, CFrame.new(0, 6.0 * s, -1 * s), COLORS.mustard)
	part(model, "PipingL", Vector3.new(0.15, 3, 0.12) * s, CFrame.new(-0.65 * s, 4.8 * s, -0.94 * s), COLORS.mustard, Enum.Material.Neon)
	part(model, "PipingR", Vector3.new(0.15, 3, 0.12) * s, CFrame.new(0.65 * s, 4.8 * s, -0.94 * s), COLORS.mustard, Enum.Material.Neon)
	for _, x in { -1.9, 1.9 } do
		part(model, "Arm", Vector3.new(0.85, 2.8, 0.85) * s, CFrame.new(x * s, 4.7 * s, 0), tux)
		ball(model, "Glove", Vector3.new(1.2, 1.2, 1.2) * s, CFrame.new(x * s, 3.1 * s, -0.1 * s), glove)
		for f = 1, 4 do
			part(model, "GloveFinger", Vector3.new(0.22, 0.6, 0.22) * s, CFrame.new((x + (f - 2.5) * 0.25) * s, 2.5 * s, -0.25 * s), glove)
		end
	end
	local headModel = Instance.new("Model")
	headModel.Name = "Head"
	headModel.Parent = model
	buildMunchHeadInto(headModel, CFrame.new(0, 6.3 * s, 0), s, o.knockoff == true, o.realMouth)
	model:SetAttribute("Height", 10 * s)
	torso:SetAttribute("IsTorso", true)
	return finalize(model, o.anchored)
end

---------------------------------------------------------------------------
-- Gizmo, the Fry-Bot 3000 (and its tiny fryer-basket ghost)
---------------------------------------------------------------------------

function ModelFactory.buildGizmo(opts: { [string]: any }?): Model
	local o = opts or {}
	local model = newModel("Gizmo")
	cylinder(model, "Base", 0.8, 3.4, CFrame.new(0, 0.4, 0) * VERTICAL, Color3.fromRGB(50, 50, 55))
	part(model, "Body", Vector3.new(2.4, 2.4, 2), CFrame.new(0, 2.0, 0), COLORS.chrome, Enum.Material.DiamondPlate)
	local screen = part(model, "Screen", Vector3.new(1.9, 1.3, 0.1), CFrame.new(0, 2.3, -1.05), Color3.fromRGB(20, 30, 30))
	local gui = surfaceText(screen, Enum.NormalId.Front, ":)", Color3.fromRGB(80, 255, 140), Enum.Font.Arcade, Color3.fromRGB(20, 30, 30))
	gui.Name = "ScreenGui"
	part(model, "Antenna", Vector3.new(0.12, 1.2, 0.12), CFrame.new(0.7, 3.8, 0), COLORS.chrome)
	ball(model, "AntennaTip", Vector3.new(0.4, 0.4, 0.4), CFrame.new(0.7, 4.45, 0), COLORS.ketchup, Enum.Material.Neon)
	part(model, "Arm", Vector3.new(0.3, 0.3, 1.6), CFrame.new(1.35, 2.2, -0.6), COLORS.chrome)
	part(model, "Basket", Vector3.new(1, 0.6, 0.9), CFrame.new(1.35, 2.0, -1.5), Color3.fromRGB(120, 120, 120), Enum.Material.DiamondPlate)
	local tag = part(model, "NameTag", Vector3.new(1.6, 0.4, 0.05), CFrame.new(0, 1.2, -1.03), COLORS.mustard)
	surfaceText(tag, Enum.NormalId.Front, "FRY-BOT 3000", COLORS.black, Enum.Font.GothamBold)
	return finalize(model, o.anchored)
end

function ModelFactory.buildGizmoGhost(): Model
	local model = newModel("GizmoGhost")
	part(model, "Basket", Vector3.new(1.2, 0.7, 1.1), CFrame.new(0, 2.5, 0), Color3.fromRGB(120, 120, 120), Enum.Material.DiamondPlate, { Transparency = 0.4 })
	ball(model, "Sheet", Vector3.new(1.8, 1.6, 1.8), CFrame.new(0, 3.2, 0), COLORS.white, SMOOTH).Transparency = 0.35
	for _, x in { -0.35, 0.35 } do
		part(model, "Eye", Vector3.new(0.18, 0.3, 0.05), CFrame.new(x, 3.35, -0.88), COLORS.black)
	end
	return finalize(model, false)
end

---------------------------------------------------------------------------
-- Shift Ghost sheet (welded over a booped player's body)
---------------------------------------------------------------------------

function ModelFactory.buildGhostSheet(color: Color3, hatColor: Color3?, name: string?): Model
	local model = newModel("ShiftGhost")
	local sheet = ball(model, "Sheet", Vector3.new(3.2, 4.4, 3.2), CFrame.new(0, 0.2, 0), color, SMOOTH)
	sheet.Transparency = 0.3
	cylinder(model, "Hem", 0.4, 3.4, CFrame.new(0, -1.7, 0) * VERTICAL, color, SMOOTH, { Transparency = 0.45 })
	for _, x in { -0.5, 0.5 } do
		local eye = ball(model, "Eye", Vector3.new(0.45, 0.7, 0.2), CFrame.new(x, 0.9, -1.5), COLORS.black)
		eye.Transparency = 0.1
	end
	local visor = part(model, "Visor", Vector3.new(2.6, 0.35, 2.4), CFrame.new(0, 2.25, -0.1), hatColor or COLORS.ketchup)
	visor.Transparency = 0.1
	part(model, "VisorBill", Vector3.new(2, 0.15, 1), CFrame.new(0, 2.15, -1.4), hatColor or COLORS.ketchup)
	if name then
		local tag = part(model, "Tag", Vector3.new(1.4, 0.45, 0.05), CFrame.new(0, -0.2, -1.55), COLORS.white)
		surfaceText(tag, Enum.NormalId.Front, name, COLORS.black, Enum.Font.GothamBold)
	end
	return finalize(model, false)
end

---------------------------------------------------------------------------
-- Food items (carried, bagged, on the grill)
---------------------------------------------------------------------------

function ModelFactory.buildStack(stack: { string }, toppingColors: { [string]: { color: Color3, height: number } }): Model
	local model, root = newModel("Stack")
	local y = 0
	for i, topping in stack do
		local info = toppingColors[topping]
		local height = if info then info.height else 0.2
		local color = if info then info.color else COLORS.white
		local diameter = if topping == "Cheese" then 1.9 elseif topping == "Lettuce" then 2.0 else 1.7
		local layerCf = CFrame.new(0, y + height / 2, 0)
		if topping == "Cheese" then
			part(model, "Layer" .. i, Vector3.new(1.6, height, 1.6), layerCf * CFrame.Angles(0, math.rad(45), 0), color)
		elseif topping == "BunTop" then
			ball(model, "Layer" .. i, Vector3.new(diameter, height * 1.6, diameter), CFrame.new(0, y + height * 0.4, 0), color)
		else
			cylinder(model, "Layer" .. i, height, diameter, layerCf * VERTICAL, color)
		end
		y += height
	end
	root.Size = Vector3.new(1.8, math.max(0.4, y), 1.8)
	root.CFrame = CFrame.new(0, 0, 0)
	return finalize(model, false)
end

function ModelFactory.buildItem(kind: string, data: { [string]: any }?): Model
	local d = data or {}
	local model: Model
	if kind == "Burger" and d.stack and d.toppings then
		model = ModelFactory.buildStack(d.stack, d.toppings)
		model.Name = "Burger"
		return model
	end
	local root
	model, root = newModel(kind)
	if kind == "Patty" then
		cylinder(model, "Patty", 0.4, 1.7, CFrame.new(0, 0.2, 0) * VERTICAL, d.color or COLORS.patty)
	elseif kind == "Fries" then
		part(model, "Carton", Vector3.new(1.1, 1.2, 0.7), CFrame.new(0, 0.6, 0), COLORS.ketchup)
		local label = part(model, "Logo", Vector3.new(0.8, 0.5, 0.05), CFrame.new(0, 0.6, -0.36), COLORS.mustard)
		label.Transparency = 0
		for i = 1, 6 do
			part(model, "Fry", Vector3.new(0.14, 0.9, 0.14), CFrame.new(-0.4 + i * 0.13, 1.4 + (i % 2) * 0.12, (i % 3 - 1) * 0.15), Color3.fromRGB(255, 214, 92))
		end
	elseif kind == "Drink" or kind == "Shake" then
		local cupColor = if kind == "Shake" then Color3.fromRGB(255, 185, 215) else COLORS.white
		cylinder(model, "Cup", 1.5, 0.95, CFrame.new(0, 0.75, 0) * VERTICAL, cupColor)
		cylinder(model, "Band", 0.4, 0.98, CFrame.new(0, 0.85, 0) * VERTICAL, COLORS.ketchup)
		if kind == "Shake" then
			ball(model, "Dome", Vector3.new(1, 0.6, 1), CFrame.new(0, 1.55, 0), Color3.fromRGB(250, 250, 255)).Transparency = 0.3
		else
			cylinder(model, "Lid", 0.1, 1.0, CFrame.new(0, 1.52, 0) * VERTICAL, COLORS.white)
		end
		part(model, "Straw", Vector3.new(0.12, 1.0, 0.12), CFrame.new(0.15, 1.9, 0) * CFrame.Angles(0, 0, math.rad(-10)), COLORS.ketchup)
	elseif kind == "Bag" then
		part(model, "Bag", Vector3.new(1.8, 2.1, 1.1), CFrame.new(0, 1.05, 0), Color3.fromRGB(196, 150, 100), Enum.Material.Cardboard)
		local logo = part(model, "Logo", Vector3.new(1.3, 0.8, 0.05), CFrame.new(0, 1.2, -0.56), COLORS.ketchup)
		surfaceText(logo, Enum.NormalId.Front, "M", COLORS.mustard)
	else
		part(model, "Thing", Vector3.new(1, 1, 1), CFrame.new(0, 0.5, 0), COLORS.white)
	end
	root.CFrame = CFrame.new()
	return finalize(model, false)
end

---------------------------------------------------------------------------
-- Weird-event props
---------------------------------------------------------------------------

function ModelFactory.buildRaccoon(): Model
	local model = newModel("Raccoon")
	part(model, "Body", Vector3.new(1.4, 1, 2.2), CFrame.new(0, 0.6, 0), Color3.fromRGB(120, 120, 125))
	local head = part(model, "Head", Vector3.new(1.1, 0.9, 1), CFrame.new(0, 1.0, -1.3), Color3.fromRGB(140, 140, 145))
	part(model, "Mask", Vector3.new(1.12, 0.3, 1.02), head.CFrame * CFrame.new(0, 0.1, 0), COLORS.black)
	for i = 0, 3 do
		part(model, "Tail", Vector3.new(0.45, 0.45, 0.5), CFrame.new(0, 0.9 + i * 0.1, 1.3 + i * 0.45), if i % 2 == 0 then COLORS.black else Color3.fromRGB(150, 150, 155))
	end
	for _, x in { -0.3, 0.3 } do
		part(model, "Eye", Vector3.new(0.15, 0.15, 0.05), head.CFrame * CFrame.new(x, 0.1, -0.53), COLORS.white, Enum.Material.Neon)
	end
	return finalize(model, false)
end

function ModelFactory.buildEar(): Part
	local p = Instance.new("Part")
	p.Name = "RainEar"
	p.Size = Vector3.new(0.5, 0.9, 0.3)
	p.Color = Color3.fromRGB(241, 194, 125)
	p.Material = SMOOTH
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

function ModelFactory.buildDoily(): Part
	local p = Instance.new("Part")
	p.Name = "Doily"
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(0.05, 1.8, 1.8)
	p.Color = Color3.fromRGB(250, 250, 250)
	p.Material = Enum.Material.Fabric
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	return p
end

function ModelFactory.buildStickyNote(text: string): Part
	local p = Instance.new("Part")
	p.Name = "StickyNote"
	p.Size = Vector3.new(1.4, 1.4, 0.05)
	p.Color = Color3.fromRGB(255, 240, 120)
	p.Anchored = true
	p.CanCollide = false
	surfaceText(p, Enum.NormalId.Front, text, Color3.fromRGB(40, 40, 40), Enum.Font.PatrickHand)
	return p
end

function ModelFactory.buildGoldStar(): Part
	local p = Instance.new("Part")
	p.Name = "GoldStar"
	p.Size = Vector3.new(1.2, 1.2, 0.05)
	p.Transparency = 1
	p.Anchored = true
	p.CanCollide = false
	surfaceText(p, Enum.NormalId.Top, "★", COLORS.mustard, Enum.Font.GothamBlack)
	return p
end

return ModelFactory
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Night Shift: Drive-Thru — tuning knobs.
-- Everything a designer might want to tweak lives here. Values are in real seconds unless noted.

local Config = {}

---------------------------------------------------------------------------
-- Pacing profile
---------------------------------------------------------------------------
-- "Test"   = short nights (~6 real minutes) for quick playtesting.
-- "Design" = the design doc's target (~15 real minutes per night).
Config.Profile = "Test"

local SECONDS_PER_GAME_HOUR = { Test = 30, Design = 75 }
Config.SecondsPerGameHour = SECONDS_PER_GAME_HOUR[Config.Profile] or 30
-- Ratio vs. design length. Used to shrink "macro" timers (ghost respawn, scare spacing).
Config.TimeScale = Config.SecondsPerGameHour / 75

Config.NightStartMinute = 0 -- 6:00 PM
Config.NightEndMinute = 12 * 60 -- 6:00 AM (minutes after 6 PM)

Config.PreShiftSeconds = 25
Config.ReportSeconds = 60
Config.MaxCrew = 4

---------------------------------------------------------------------------
-- Hosting: "Auto" uses reserved shift servers when published, and runs the
-- shift in the same server (in-place) in Studio or when teleport fails.
---------------------------------------------------------------------------
Config.HostingMode = "Auto" -- "Auto" | "InPlace" | "Reserved"
Config.BoothCountdown = 15
Config.ReservedWaitForCrew = 20 -- seconds a shift server waits for the crew to arrive
Config.RejoinWindowSeconds = 30 * 60

---------------------------------------------------------------------------
-- Customers & lane
---------------------------------------------------------------------------
Config.CarSpeed = 16
Config.MaxCarsInLane = 6
Config.Patience = {
	Speaker = 45, -- waiting for someone to take the order
	Window = 75, -- waiting at the window for food
}
-- Seconds between car arrivals for a solo crew; divided by a crew-size factor.
Config.CarInterval = { 30, 27, 25, 23, 20 }
Config.RushMultiplier = 0.6 -- interval multiplier during rush hours
Config.CrewIntervalFactor = 0.3 -- each extra crew member speeds arrivals by 30%

---------------------------------------------------------------------------
-- Cooking
---------------------------------------------------------------------------
Config.Cook = {
	PattySideA = 4, -- seconds until "FLIP!"
	FlipWindow = 4, -- seconds to flip before it burns
	PattySideB = 3.5,
	DoneWindow = 7, -- seconds to take it before it burns
	GrillSpots = 4,

	FryTime = 6,
	FryDoneWindow = 7,
	FryFireAfter = 6, -- seconds after burning before a (comedic) fry fire
	FryPortions = 4,

	DrinkFillSeconds = 2.5,
	ShakeFillSeconds = 3.5,
	PerfectFillMin = 0.8,
	StickySeconds = 8,
	StickySpeed = 7,
}

---------------------------------------------------------------------------
-- Scoring
---------------------------------------------------------------------------
Config.Stars = {
	Start = 3,
	Max = 5,
	Perfect = 0.3,
	Okay = 0.1,
	WrongOrder = -0.4,
	RefusedNormal = -0.75,
	LeftAngry = -0.5,
	CaughtLate = 0.2,
}
Config.Weird = {
	ServedLate = 20,
	LateLeft = 5,
	OverflowResetTo = 50,
	WeirdLightsAt = 50,
	-- Passive growth over a full night, by night number.
	PassivePerNight = { 10, 15, 20, 25, 30 },
}

---------------------------------------------------------------------------
-- Scares
---------------------------------------------------------------------------
Config.GhostRespawnDesign = { 90, 90, 90, 75, 60 } -- design-length seconds, by night
Config.MinGhostRespawn = 15

Config.Scare = {
	WarningSeconds = { 5, 5, 5, 4, 3 },
	RushHourActive = 24, -- seconds Mr. Munch takes to walk his loop (Nights 3-4)
	RushHourActiveNight5 = 18,
	MinGapDesign = { 90, 90, 90, 90, 45 },
	MinGapFloor = 25,
	NoScareFirstDesign = 240,
	MaxPerNight = { 0, 0, 2, 3, 5 },
}

Config.Munch = {
	WalkSpeed = 9,
	ChaseSpeed = 19,
	Night5SpeedMultiplier = 1.35,
	ViewRange = 55,
	ViewAngle = 120, -- degrees, full cone
	HearRange = 7, -- sees you at any angle this close
	BoopDistance = 4.5,
	LoseSightSeconds = 1.5,
	KnockCheckRange = 11, -- Night 4+: checks hiding spots this close to his path (horizontal)
	KnockChance = 0.6,
}

Config.HighBeams = {
	SweepSeconds = 4.5,
	BeamWidth = 7,
	WindowLine = 4.4, -- head height (studs above floor) that the beam catches
	CrouchCampSeconds = 15,
}

Config.Hide = {
	CampWarnSeconds = 20,
	CampMaxSeconds = 32, -- long enough to hide through a whole Rush Hour, not a whole night
	RehideCooldown = 4,
	HoldBreathWindow = 6,
	HoldBreathHits = 3,
}

Config.Crouch = {
	HipHeightDrop = 1.6,
	WalkSpeed = 7,
}

---------------------------------------------------------------------------
-- Ghosts & Gizmo
---------------------------------------------------------------------------
Config.Ghost = {
	WalkSpeed = 20,
	PointCooldown = 8,
	PointDuration = 3,
	BooCooldown = 4,
}

Config.Gizmo = {
	SoloEfficiency = 0.6,
	CoverEfficiency = 0.3,
	MistakeChance = 0.08,
	MoveSpeed = 14,
}

---------------------------------------------------------------------------
-- Rewards
---------------------------------------------------------------------------
Config.Pay = {
	Base = 20,
	PerStar = 10,
	PerCatch = 5,
	PerPerfect = 2,
	GoldBonus = 25,
}

---------------------------------------------------------------------------
-- Persistence
---------------------------------------------------------------------------
Config.DataStoreName = "NightShift_v1"
Config.LeaderboardStoreName = "NightShift_LateCaught_v1"
Config.AutosaveSeconds = 120

---------------------------------------------------------------------------
-- Monetization (cosmetic only — see design doc §11.3). 0 = not configured.
-- Create the developer products / game pass on the Creator Dashboard and paste the IDs here.
---------------------------------------------------------------------------
Config.DevProducts = {
	hat_bun = 0,
	hat_tophat = 0,
	apron_neon = 0,
	ghost_gold = 0,
	ghost_ketchup = 0,
	trail_sparkle = 0,
}
Config.SupporterPassId = 0

-- Internal badge id -> Roblox BadgeService id. 0 = internal only (still tracked & shown in-game).
Config.RobloxBadgeIds = {}

---------------------------------------------------------------------------
-- Debug
---------------------------------------------------------------------------
-- The debug panel only ever appears in Studio.
Config.DebugPanelInStudio = true

---------------------------------------------------------------------------
-- Audio. Built-in Studio sounds are used as placeholders; swap in Creator Store
-- asset ids ("rbxassetid://123") for the real jingle, squeaks, sizzles, etc.
---------------------------------------------------------------------------
Config.Sounds = {
	Ding = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.5 },
	Note = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.35 },
	Squeak = { id = "rbxasset://sounds/action_footsteps_plastic.mp3", volume = 0.9, speed = 1.7 },
	Boop = { id = "rbxasset://sounds/action_jump.mp3", volume = 0.8, speed = 1.6 },
	Pwoomp = { id = "rbxasset://sounds/action_falling.mp3", volume = 0.5, speed = 1.4 },
	KaChunk = { id = "rbxasset://sounds/action_jump_land.mp3", volume = 0.9, speed = 0.8 },
	Shutter = { id = "rbxasset://sounds/action_jump_land.mp3", volume = 1, speed = 0.5 },
	Gotcha = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.6, speed = 0.5 },
	Sizzle = { id = "rbxasset://sounds/action_swim.mp3", volume = 0.25, speed = 2 },
	Splash = { id = "rbxasset://sounds/impact_water.mp3", volume = 0.5 },
	Engine = { id = "rbxasset://sounds/action_falling.mp3", volume = 0.7, speed = 0.4 },
	Knock = { id = "rbxasset://sounds/action_jump_land.mp3", volume = 1, speed = 1.2 },
	Click = { id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.2, speed = 2 },
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="9">
        <Properties>
          <string name="Name">Data</string>
        </Properties>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Anomalies</string>
            <string name="Source"><![CDATA[-- Late Customers (anomalies). Design doc §5.1–5.2 and §10.4 (Field Guide cards).
--
-- Each entry is data only; ModelFactory reads `modifiers`, the Window/Mirror/Lane Cam/Receipt/UV
-- views read `mirrorTell`, `receipt`, and the UV/Cam modifiers. Adding an anomaly = adding a row.
--
-- Fields
--   minNight        first night it can show up at random
--   photo           (†) a former employee: their "usual" frees them on Night 5 after the reveal
--   person / car    overrides for the generated person and car
--   modifiers       visual tells built onto the model (see ModelFactory.applyModifiers)
--   mirrorTell      what the convex mirror shows ("LateWave", "MunchReflection", "Crying", ...)
--   speaker         lines heard at the order station; `captions` are background-sound tells
--   order           what they actually order (lines)
--   receipt         receipt overrides (name / total / note)
--   weirdEvent      what happens if you serve them

local Anomalies = {}

Anomalies.List = {
	{
		id = "EarlOfEars",
		number = 1,
		name = "Earl of Ears",
		minNight = 1,
		danger = 0,
		look = "Tall guy in a bowling shirt",
		photo = {
			employee = "Marv",
			year = 1991,
			job = "Night Grill",
			usual = { { item = "munchstack", mods = { "NoPickles", "ExtraSauce" } } },
			usualText = "#4, no pickles, extra sauce.",
		},
		person = {
			skin = Color3.fromRGB(224, 172, 105),
			hairStyle = "Bald",
			shirt = Color3.fromRGB(40, 160, 160),
			name = "Earl",
		},
		car = { kind = "Sedan", color = Color3.fromRGB(110, 90, 160) },
		modifiers = { "ExtraEars", "UVTag:MARV" },
		tells = {
			{ channel = "Window", text = "Three ears. Two on one side." },
			{ channel = "UV", text = "A name tag that says MARV under his coat." },
		},
		speaker = {
			"Good evening. One hamburger per ear, please.",
			"...For balance.",
		},
		captions = {},
		order = { { item = "burger" }, { item = "burger" }, { item = "burger" } },
		receipt = { name = "EARL", note = "3x for balance" },
		refusedLine = "*tips his hat. With an ear.* Very well.",
		servedLine = "Splendid. All three of us thank you.",
		weirdEvent = "EarRain",
		debNote = "Nice guy. Do not serve. Do not count ears out loud.",
		freedLine = "...It's me. Marv. Night grill, '91. Thank you. Tell Deb I said hi.",
	},
	{
		id = "TotallyNormalFamily",
		number = 2,
		name = "The Totally Normal Family",
		minNight = 1,
		danger = 0,
		look = "A trench coat with three heads stacked on top",
		person = { shirt = Color3.fromRGB(120, 100, 70), name = "Dad" },
		car = { kind = "Minivan", color = Color3.fromRGB(150, 140, 120) },
		modifiers = { "TrenchStack" },
		tells = {
			{ channel = "Window", text = "Three faces, stacked. One trench coat." },
			{ channel = "Speaker", text = "Three voices. One of them chitters." },
			{ channel = "LaneCam", text = "On camera it's one very tall guy." },
		},
		speaker = {
			"Four kids' meals for my four normal children. Yes.",
			"(a second, higher voice) We are children.",
			"(a third voice, from lower down) ...chitter.",
		},
		captions = { "[three voices — one is chittering]" },
		order = { { item = "fries" }, { item = "fries" }, { item = "fries" }, { item = "fries" } },
		receipt = { name = "NORMAL FAMILY", note = "4 KIDS (NORMAL)" },
		refusedLine = "*The trench coat falls over. Three raccoons run out.*",
		servedLine = "Thank you. We will eat this. As humans.",
		weirdEvent = "Raccoons",
		debNote = "Not a family. Three raccoons. Don't feed them, they come back.",
	},
	{
		id = "MirrorMandy",
		number = 3,
		name = "Mirror Mandy",
		minNight = 2,
		danger = 1,
		look = "Cheerful woman in a convertible",
		photo = {
			employee = "Mandy",
			year = 1996,
			job = "Window",
			usual = { { item = "cheeseburger", mods = { "ExtraCheese" } }, { item = "shake" } },
			usualText = "#2 with extra cheese and a #6.",
		},
		person = {
			skin = Color3.fromRGB(255, 224, 189),
			hairStyle = "Long",
			hairColor = Color3.fromRGB(196, 156, 82),
			shirt = Color3.fromRGB(240, 130, 170),
			name = "Mandy",
		},
		car = { kind = "Convertible", color = Color3.fromRGB(240, 240, 235) },
		modifiers = {},
		mirrorTell = "LateWave",
		tells = {
			{ channel = "Mirror", text = "Her reflection is waving. She isn't." },
		},
		speaker = {
			"Hiii! I'll have whatever I had last time.",
			"You remember.",
		},
		captions = {},
		order = { { item = "cheeseburger", mods = { "ExtraCheese" } }, { item = "shake" } },
		receipt = { name = "MANDY", note = "\"you remember\"" },
		refusedLine = "Oh. Okay! *Her reflection stays parked after she leaves.*",
		servedLine = "You DID remember!",
		weirdEvent = "MirrorMess",
		debNote = "Always check the mirror. Mandy's reflection runs late.",
		freedLine = "Mandy. Window, '96. ...You really did remember. Thank you.",
	},
	{
		id = "SirFingersALot",
		number = 4,
		name = "Sir Fingers-a-Lot",
		minNight = 2,
		danger = 0,
		look = "A businessman with a briefcase",
		person = {
			hairStyle = "Short",
			shirt = Color3.fromRGB(60, 60, 70),
			name = "Sir",
		},
		car = { kind = "Sedan", color = Color3.fromRGB(40, 40, 45) },
		modifiers = { "SevenFingers" },
		tells = {
			{ channel = "Window", text = "Seven fingers on one hand. The count changes." },
		},
		speaker = {
			"A burger and a drink. I'll pay in... exact change.",
		},
		captions = {},
		order = { { item = "burger" }, { item = "drink" } },
		receipt = { name = "SIR", note = "PAID: 13 PENNIES + 1 TOOTH-SHAPED MINT" },
		refusedLine = "*Waves goodbye. Waves. Waves. Still waving.*",
		servedLine = "*counts out pennies with far too many fingers*",
		weirdEvent = "GrabbyHands",
		debNote = "Count the fingers. Then count them again.",
	},
	{
		id = "UpsideDownOrder",
		number = 5,
		name = "The Upside-Down Order",
		minNight = 2,
		danger = 0,
		look = "A normal teen in a sedan",
		person = {
			hairStyle = "Cap",
			shirt = Color3.fromRGB(70, 150, 90),
			name = "Teen",
		},
		car = { kind = "Hatchback", color = Color3.fromRGB(230, 120, 40) },
		modifiers = { "UpsideDownHat" },
		tells = {
			{ channel = "Speaker", text = "Orders the menu backwards." },
			{ channel = "Window", text = "Their cap is upside down." },
		},
		speaker = {
			"Eno regrub, owt seirf, dna eno knird.",
			"Sknaht!",
		},
		captions = { "[the words sound... backwards]" },
		order = { { item = "burger" }, { item = "fries" }, { item = "fries" }, { item = "drink" } },
		receipt = { name = "NEET", note = "LATOT" },
		refusedLine = "Ko. *The car reverses away. It keeps reversing.*",
		servedLine = "Uoy knaht!",
		weirdEvent = "GravityFries",
		debNote = "If you understood that order, you've been here too long.",
	},
	{
		id = "GrandmaGumdrop",
		number = 6,
		name = "Grandma Gumdrop",
		minNight = 3,
		danger = 0,
		look = "Sweet old lady in a tiny car",
		photo = {
			employee = "Dot",
			year = 1988,
			job = "Fry Cook",
			usual = { { item = "shake" }, { item = "fries" } },
			usualText = "A #6 and a #3. \"A little treat.\"",
		},
		person = {
			skin = Color3.fromRGB(241, 194, 125),
			hairStyle = "Bun",
			hairColor = Color3.fromRGB(215, 215, 215),
			shirt = Color3.fromRGB(130, 90, 170),
			glasses = true,
			name = "Dot",
		},
		car = { kind = "Compact", color = Color3.fromRGB(120, 180, 210) },
		modifiers = { "NoShadowCam", "LipstickHI", "UVHandprints" },
		tells = {
			{ channel = "LaneCam", text = "Every car has a shadow on camera. Hers doesn't." },
			{ channel = "Window", text = "Lipstick on her teeth spells HI." },
			{ channel = "UV", text = "Handprints inside the windshield." },
		},
		speaker = {
			"Is Bartholomew working tonight? Tell him Dot says hello.",
			"And a little shake and some fries, dear.",
		},
		captions = {},
		order = { { item = "shake" }, { item = "fries" } },
		receipt = { name = "DOT", note = "tell bart hello" },
		refusedLine = "Oh. Tell him anyway, dear.",
		servedLine = "Such a nice young person. Bart would be proud.",
		weirdEvent = "Doilies",
		debNote = "Sweetest lady. No shadow. Do not serve.",
		freedLine = "Dot. Fryer, '88. Tell Bart... no. Don't tell Bart anything. Thank you, dear.",
	},
	{
		id = "DriverlessDelivery",
		number = 7,
		name = "The Driver-less Delivery",
		minNight = 3,
		danger = 1,
		look = "A delivery scooter. Nobody on it.",
		person = { name = "Pickup" },
		car = { kind = "Scooter", color = Color3.fromRGB(200, 60, 60) },
		modifiers = { "NoDriver" },
		tells = {
			{ channel = "Window", text = "Nobody's there. The speaker still orders." },
		},
		speaker = {
			"Order for... pickup.",
			"One Munch Stack. For... pickup.",
		},
		captions = { "[no engine sound]" },
		order = { { item = "munchstack" } },
		receipt = { name = "PICKUP", note = "LEAVE AT WINDOW" },
		refusedLine = "*The scooter tips over. Sadly.*",
		servedLine = "*The bag floats up off the window ledge and drives away.*",
		weirdEvent = "GhostRider",
		debNote = "If nobody's driving, nobody's eating. Refuse.",
	},
	{
		id = "SmileySteve",
		number = 8,
		name = "Smiley Steve",
		minNight = 3,
		danger = 1,
		look = "Guy with a huge grin",
		photo = {
			employee = "Steve",
			year = 2003,
			job = "Order Taker",
			usual = { { item = "burger", mods = { "NoLettuce" } }, { item = "drink" } },
			usualText = "#1, no lettuce. And a #5.",
		},
		person = {
			skin = Color3.fromRGB(198, 134, 66),
			hairStyle = "Spiky",
			hairColor = Color3.fromRGB(35, 25, 18),
			shirt = Color3.fromRGB(240, 200, 80),
			name = "Steve",
		},
		car = { kind = "Pickup", color = Color3.fromRGB(210, 170, 60) },
		modifiers = { "NeverBlinks", "GrowingSmile", "CamPaintedFace" },
		tells = {
			{ channel = "Window", text = "Never blinks. The smile gets wider when you look away." },
			{ channel = "LaneCam", text = "On camera his face is painted on, like a mascot." },
		},
		speaker = {
			"Smile! It's mandatory!",
			"Two cheeseburgers! Smile!",
		},
		captions = {},
		order = { { item = "cheeseburger" }, { item = "cheeseburger" } },
		receipt = { name = "STEVE :)", note = "SMILING IS MANDATORY" },
		refusedLine = "*The smile drops to a normal frown.* ...Ok.",
		servedLine = "SMILE!",
		weirdEvent = "MandatoryFun",
		debNote = "Corporate made that poster. Steve took it personally.",
		freedLine = "Steve. Order taker, '03. I can stop smiling now. ...Thanks.",
	},
	{
		id = "StaticStan",
		number = 9,
		name = "Static Stan",
		minNight = 4,
		danger = 0,
		look = "A man made of slightly TV-static skin",
		person = { name = "Stan", shirt = Color3.fromRGB(150, 150, 160), hairStyle = "Short" },
		car = { kind = "Sedan", color = Color3.fromRGB(150, 150, 160) },
		modifiers = { "StaticSkin" },
		tells = {
			{ channel = "Receipt", text = "The receipt prints STAN STAN STAN." },
			{ channel = "Speaker", text = "The speaker crackles every time he talks." },
			{ channel = "Window", text = "His skin is... fuzzy." },
		},
		speaker = {
			"Bzzzt. Large fries. Bzzt.",
		},
		captions = { "[heavy static]" },
		order = { { item = "fries" } },
		receipt = { name = "STAN STAN STAN", note = "STAN STAN STAN STAN" },
		refusedLine = "*He changes channel and becomes a weatherman.* ...Clear skies tonight.",
		servedLine = "Bzzzt. Thank bzzzt you.",
		weirdEvent = "ChannelSurf",
		debNote = "Check receipts. Stan can't help printing himself.",
	},
	{
		id = "MrNotMunch",
		number = 10,
		name = "Mr. Not-Munch",
		minNight = 4,
		danger = 1,
		look = "A guy in a cheap knockoff Mr. Munch costume",
		person = { name = "Mascot", shirt = Color3.fromRGB(200, 40, 40) },
		car = { kind = "Sedan", color = Color3.fromRGB(200, 40, 40) },
		modifiers = { "KnockoffMunch" },
		mirrorTell = "MunchReflection",
		tells = {
			{ channel = "Window", text = "Five-fingered gloves. The real Mr. Munch has four." },
			{ channel = "Mirror", text = "His reflection is the REAL Mr. Munch." },
		},
		speaker = {
			"I am the mascot. I would like a mascot meal.",
			"(A Munch Stack, fries, and a shake. Mascot-style.)",
		},
		captions = {},
		order = { { item = "munchstack" }, { item = "fries" }, { item = "shake" } },
		receipt = { name = "MR MUNCH", note = "OFFICIAL MASCOT (REAL)" },
		refusedLine = "*Takes off the head. It's Trucker Ray?? No... another costume underneath.*",
		servedLine = "The mascot thanks you. Officially.",
		weirdEvent = "MascotMob",
		debNote = "Count the fingers on the gloves. FOUR. Always four.",
	},
	{
		id = "TheTwins",
		number = 11,
		name = "The Twins",
		minNight = 4,
		danger = 1,
		look = "Two identical kids in one booster seat",
		photo = {
			employee = "Jo & Mo",
			year = 2008,
			job = "Baggers",
			usual = { { item = "shake" }, { item = "shake" }, { item = "fries" } },
			usualText = "Two #6s and one #3. We share.",
		},
		person = {
			skin = Color3.fromRGB(161, 102, 50),
			hairStyle = "Curly",
			hairColor = Color3.fromRGB(20, 20, 22),
			shirt = Color3.fromRGB(90, 190, 200),
			name = "Jo",
		},
		car = { kind = "Hatchback", color = Color3.fromRGB(70, 140, 80) },
		modifiers = { "Twins", "UVText:TELL DEB" },
		tells = {
			{ channel = "Speaker", text = "They speak in perfect unison... except once." },
			{ channel = "UV", text = "TELL DEB is written on the car door." },
		},
		speaker = {
			"We want what we wanted.",
			"We want what we wan-ted.",
		},
		captions = { "[two voices in unison — then one is a beat late]" },
		order = { { item = "shake" }, { item = "shake" }, { item = "fries" } },
		receipt = { name = "JO & MO", note = "WE WANT WHAT WE WANTED" },
		refusedLine = "*They both wave. With the same hand.*",
		servedLine = "Thank you. Thank you.",
		weirdEvent = "DoubleTrouble",
		debNote = "Two kids, one booster seat, zero parents. Refuse.",
		freedLine = "Jo and Mo. Baggers, '08. We can go home now. We can go home now.",
	},
}

Anomalies.ById = {}
for _, entry in Anomalies.List do
	Anomalies.ById[entry.id] = entry
end

function Anomalies.photoEmployees()
	local out = {}
	for _, entry in Anomalies.List do
		if entry.photo then
			table.insert(out, entry)
		end
	end
	return out
end

return Anomalies
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Badges</string>
            <string name="Source"><![CDATA[-- In-game badges (design doc §7.7: "Badges: 60+ at launch"; MVP target 30).
-- These are always tracked in the player's save. Map an id to a real Roblox badge in
-- Config.RobloxBadgeIds to also award it through BadgeService.

local Badges = {}

Badges.List = {
	{ id = "clocked_in", name = "Clocked In", desc = "Start your first shift." },
	{ id = "night1", name = "Welcome to the Team", desc = "Survive Night 1." },
	{ id = "night2", name = "A Regular", desc = "Survive Night 2." },
	{ id = "night3", name = "Passed Inspection", desc = "Survive Night 3." },
	{ id = "night4", name = "Where's Deb?", desc = "Survive Night 4." },
	{ id = "night5", name = "Closing Time", desc = "Finish Night 5." },
	{ id = "gotcha", name = "GOTCHA!", desc = "Refuse your first Late Customer." },
	{ id = "refused_raccoon", name = "Refused a Raccoon", desc = "Refuse the Totally Normal Family." },
	{ id = "served_late", name = "The Customer Is Always Right?", desc = "Serve a Late Customer." },
	{ id = "booped", name = "Booped by Mr. Munch", desc = "Get booped by Mr. Munch." },
	{ id = "deer", name = "Deer in Headlights", desc = "Get caught by the High Beams." },
	{ id = "untouchable", name = "Never Hid, Never Booped", desc = "Finish Night 3+ without hiding or getting booped." },
	{ id = "hendersons9", name = "Nine Kids' Meals", desc = "Serve the Hendersons all 9 kids' meals." },
	{ id = "not_anomalies", name = "NOT Anomalies!", desc = "Refuse the Hendersons. (They were normal.)" },
	{ id = "hold_the_seven", name = "Number Seven, Hold the Seven", desc = "Serve Gerald exactly what he ordered." },
	{ id = "perfect", name = "Order Up!", desc = "Serve a perfect order." },
	{ id = "perfect10", name = "Short-Order Legend", desc = "10 perfect orders in one night." },
	{ id = "gold", name = "Employee Badge: Gold", desc = "Earn a Gold badge on any night." },
	{ id = "all_gold", name = "Golden Visor", desc = "Earn Gold on all five nights." },
	{ id = "ghost_point", name = "Helpful Haunt", desc = "Ghost Point at something." },
	{ id = "ghost_boo", name = "oooOOOooo", desc = "Boo! as a Shift Ghost." },
	{ id = "spook_gizmo", name = "Spooked the Robot", desc = "Boo! near Gizmo." },
	{ id = "held_breath", name = "Hold Your Breath", desc = "Pass Mr. Munch's hiding-spot check." },
	{ id = "freezer", name = "They Don't Like the Cold", desc = "Hide in the freezer during Rush Hour." },
	{ id = "uv", name = "Black Light", desc = "Use the UV flashlight." },
	{ id = "vhs", name = "Be Kind, Rewind", desc = "Watch a VHS training tape." },
	{ id = "freed", name = "Last Call", desc = "Free a photo-employee with their usual." },
	{ id = "ending_company", name = "Employee of the Month", desc = "See the Company ending." },
	{ id = "ending_freed", name = "Clocked Out", desc = "See the Last Call ending." },
	{ id = "ending_fired", name = "Fired!", desc = "Get fired on Night 5." },
	{ id = "secret_mascot", name = "The Mascot", desc = "???" },
	{ id = "ghost_town", name = "Ghost Town", desc = "The whole crew got booped at once." },
	{ id = "field_guide10", name = "Field Researcher", desc = "Collect 10 Field Guide cards." },
	{ id = "well_done", name = "Well Done. Too Well.", desc = "Burn 3 patties in one night." },
	{ id = "this_is_fine", name = "This Is Fine", desc = "Put out a fry fire." },
	{ id = "sticky", name = "Sticky Situation", desc = "Overflow a drink." },
	{ id = "fax", name = "Fax Machine Operator", desc = "Redeem a code." },
	{ id = "peak_weird", name = "Peak Weird", desc = "The Weird Meter hit 100%." },
	{ id = "perfect_raccoon", name = "Perfect Burger for a Raccoon", desc = "Make a perfect order for a Late Customer, then refuse them." },
}

Badges.ById = {}
for _, badge in Badges.List do
	Badges.ById[badge.id] = badge
end

return Badges
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Codes</string>
            <string name="Source"><![CDATA[-- Fax machine codes (design doc §11.4). Codes are case-insensitive.
-- reward: { paychecks = n } and/or { cosmetic = "id" }. expires: optional os.time() cutoff.
-- Live-ops can add more without an update via the "LiveCodes" DataStore key (see Codes service).

return {
	OPENLATE = { reward = { paychecks = 100 }, message = "Welcome to Munchie's! +100 Paychecks" },
	OPENALWAYS = { reward = { paychecks = 50 }, message = "Open late. Open always. +50 Paychecks" },
	HOLDTHESEVEN = { reward = { cosmetic = "hat_paper_crown" }, message = "Gerald says hi. Paper Crown unlocked!" },
	FRYCOUNT = { reward = { paychecks = 75 }, message = "He only takes one. +75 Paychecks" },
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Cosmetics</string>
            <string name="Source"><![CDATA[-- Locker room cosmetics (design doc §7.7, §11.3). Cosmetic only — never stats, never revives.
-- price  = Paychecks (soft currency). robux = sold as a developer product (ids in Config.DevProducts).
-- default = everyone owns it. secret = unlocked by an ending / pass, not for sale.

local Cosmetics = {}

Cosmetics.Slots = { "Hat", "Apron", "Ghost", "Tag", "Trail" }

Cosmetics.List = {
	-- Hats
	{ id = "hat_visor_red", slot = "Hat", name = "Ketchup Visor", default = true, color = Color3.fromRGB(215, 38, 61), style = "Visor" },
	{ id = "hat_visor_mustard", slot = "Hat", name = "Mustard Visor", price = 50, color = Color3.fromRGB(244, 180, 0), style = "Visor" },
	{ id = "hat_visor_pickle", slot = "Hat", name = "Pickle Visor", price = 50, color = Color3.fromRGB(106, 153, 78), style = "Visor" },
	{ id = "hat_paper_crown", slot = "Hat", name = "Paper Crown", price = 120, color = Color3.fromRGB(255, 214, 92), style = "Crown" },
	{ id = "hat_trucker", slot = "Hat", name = "Ray's Trucker Cap", price = 150, color = Color3.fromRGB(40, 80, 160), style = "Cap" },
	{ id = "hat_bun", slot = "Hat", name = "Burger Bun Hat", robux = "hat_bun", color = Color3.fromRGB(222, 170, 98), style = "Bun" },
	{ id = "hat_tophat", slot = "Hat", name = "Tiny Top Hat & Monocle", robux = "hat_tophat", color = Color3.fromRGB(25, 25, 25), style = "TopHat" },
	{ id = "hat_munch", slot = "Hat", name = "Mr. Munch Head", secret = true, hint = "Find 'The Mascot' secret ending.", color = Color3.fromRGB(214, 140, 69), style = "MunchHead" },
	-- Aprons (uniform)
	{ id = "apron_red", slot = "Apron", name = "Classic Apron", default = true, color = Color3.fromRGB(215, 38, 61) },
	{ id = "apron_mustard", slot = "Apron", name = "Mustard Apron", price = 80, color = Color3.fromRGB(244, 180, 0) },
	{ id = "apron_pickle", slot = "Apron", name = "Pickle Apron", price = 80, color = Color3.fromRGB(106, 153, 78) },
	{ id = "apron_midnight", slot = "Apron", name = "Midnight Apron", price = 150, color = Color3.fromRGB(29, 45, 80) },
	{ id = "apron_neon", slot = "Apron", name = "Neon Sign Apron", robux = "apron_neon", color = Color3.fromRGB(255, 60, 200), neon = true },
	-- Shift Ghost skins
	{ id = "ghost_white", slot = "Ghost", name = "Plain Sheet", default = true, color = Color3.fromRGB(245, 245, 255) },
	{ id = "ghost_mint", slot = "Ghost", name = "Mint Sheet", price = 100, color = Color3.fromRGB(170, 240, 210) },
	{ id = "ghost_pink", slot = "Ghost", name = "Strawberry Sheet", price = 100, color = Color3.fromRGB(255, 185, 215) },
	{ id = "ghost_midnight", slot = "Ghost", name = "Midnight Sheet", price = 150, color = Color3.fromRGB(70, 80, 140) },
	{ id = "ghost_gold", slot = "Ghost", name = "Gold Foil Sheet", robux = "ghost_gold", color = Color3.fromRGB(255, 200, 60) },
	{ id = "ghost_ketchup", slot = "Ghost", name = "Ketchup Packet", robux = "ghost_ketchup", color = Color3.fromRGB(215, 38, 61) },
	-- Name tags
	{ id = "tag_white", slot = "Tag", name = "Name Tag", default = true, color = Color3.fromRGB(245, 245, 245) },
	{ id = "tag_gold", slot = "Tag", name = "Golden Name Tag", secret = true, hint = "Supporter Pass.", color = Color3.fromRGB(255, 200, 60) },
	-- Ghost trails
	{ id = "trail_none", slot = "Trail", name = "No Trail", default = true },
	{ id = "trail_sparkle", slot = "Trail", name = "Sparkle Trail", robux = "trail_sparkle", color = Color3.fromRGB(255, 240, 150) },
}

Cosmetics.ById = {}
for _, item in Cosmetics.List do
	Cosmetics.ById[item.id] = item
end

function Cosmetics.defaults(): { [string]: string }
	local equipped = {}
	for _, item in Cosmetics.List do
		if item.default and not equipped[item.slot] then
			equipped[item.slot] = item.id
		end
	end
	return equipped
end

return Cosmetics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Menu</string>
            <string name="Source"><![CDATA[-- The Munchie's menu. Six items, numbered #1–#6 (there is no #7, no matter what Gerald says).
-- Burgers are physical stacks built bottom-to-top at the assembly board.

local Menu = {}

Menu.Items = {
	burger = {
		id = "burger",
		number = 1,
		name = "Munch Burger",
		short = "Burger",
		singular = "burger",
		plural = "burgers",
		kind = "Burger",
		price = 3.49,
		stack = { "BunBottom", "Patty", "Lettuce", "BunTop" },
		color = Color3.fromRGB(214, 140, 69),
	},
	cheeseburger = {
		id = "cheeseburger",
		number = 2,
		name = "Cheeseburger",
		short = "Cheese",
		singular = "cheeseburger",
		plural = "cheeseburgers",
		kind = "Burger",
		price = 3.99,
		stack = { "BunBottom", "Patty", "Cheese", "BunTop" },
		color = Color3.fromRGB(245, 196, 66),
	},
	fries = {
		id = "fries",
		number = 3,
		name = "Fries",
		short = "Fries",
		singular = "fries",
		plural = "fries",
		kind = "Fries",
		price = 1.99,
		color = Color3.fromRGB(255, 214, 92),
	},
	munchstack = {
		id = "munchstack",
		number = 4,
		name = "Munch Stack",
		short = "Stack",
		singular = "Munch Stack",
		plural = "Munch Stacks",
		kind = "Burger",
		price = 5.99,
		stack = { "BunBottom", "Patty", "Cheese", "Patty", "Pickles", "Sauce", "BunTop" },
		color = Color3.fromRGB(201, 64, 52),
	},
	drink = {
		id = "drink",
		number = 5,
		name = "Drink",
		short = "Drink",
		singular = "drink",
		plural = "drinks",
		kind = "Drink",
		price = 1.49,
		color = Color3.fromRGB(77, 160, 230),
	},
	shake = {
		id = "shake",
		number = 6,
		name = "Shake",
		short = "Shake",
		singular = "shake",
		plural = "shakes",
		kind = "Shake",
		price = 2.99,
		color = Color3.fromRGB(240, 150, 190),
	},
}

Menu.Order = { "burger", "cheeseburger", "fries", "munchstack", "drink", "shake" }

Menu.Toppings = {
	BunBottom = { label = "Bottom Bun", color = Color3.fromRGB(222, 170, 98), height = 0.45 },
	BunTop = { label = "Top Bun", color = Color3.fromRGB(230, 176, 100), height = 0.7 },
	Patty = { label = "Patty", color = Color3.fromRGB(110, 62, 35), height = 0.4 },
	Cheese = { label = "Cheese", color = Color3.fromRGB(255, 205, 40), height = 0.12 },
	Lettuce = { label = "Lettuce", color = Color3.fromRGB(110, 190, 70), height = 0.15 },
	Pickles = { label = "Pickles", color = Color3.fromRGB(80, 130, 50), height = 0.12 },
	Sauce = { label = "Sauce", color = Color3.fromRGB(220, 50, 40), height = 0.08 },
}

-- Buttons shown at the assembly board, in order.
Menu.ToppingButtons = { "Bun", "Patty", "Cheese", "Lettuce", "Pickles", "Sauce" }

Menu.Mods = {
	NoCheese = { label = "No Cheese", spoken = "no cheese", kind = "remove", topping = "Cheese" },
	NoLettuce = { label = "No Lettuce", spoken = "no lettuce", kind = "remove", topping = "Lettuce" },
	NoPickles = { label = "No Pickles", spoken = "no pickles", kind = "remove", topping = "Pickles" },
	NoSauce = { label = "No Sauce", spoken = "no sauce", kind = "remove", topping = "Sauce" },
	ExtraCheese = { label = "Extra Cheese", spoken = "extra cheese", kind = "extra", topping = "Cheese" },
	ExtraLettuce = { label = "Extra Lettuce", spoken = "extra lettuce", kind = "extra", topping = "Lettuce" },
	ExtraPickles = { label = "Extra Pickles", spoken = "extra pickles", kind = "extra", topping = "Pickles" },
	ExtraSauce = { label = "Extra Sauce", spoken = "extra sauce", kind = "extra", topping = "Sauce" },
}

-- Canonical order mods are applied / listed in.
Menu.ModOrder = {
	"NoCheese",
	"NoLettuce",
	"NoPickles",
	"NoSauce",
	"ExtraCheese",
	"ExtraLettuce",
	"ExtraPickles",
	"ExtraSauce",
}

return Menu
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Nights</string>
            <string name="Source"><![CDATA[-- The five-night campaign (design doc §3.4 and §10.2). Each night is a timeline the Shift Director
-- plays like a playlist. Times are in-game clock times ("03:00" = 3 AM).
--
-- Event kinds
--   radio     a line on the headset / CB radio      { who, text }
--   customer  a scripted car                         { id }  (anomaly id, regular id, "RandomLate", "Normal")
--   scare     a scare event                          { id, ifWeird? }  ("RushHour", "HighBeams", "LightsOutSafe")
--   beat      a story moment handled by Story        { id, param? }
--   note      a sticky note pops up on screen        { text }

local Nights = {}

Nights.List = {
	{
		number = 1,
		title = "Welcome to the Team!",
		stickyNote = "Fryer is fine.\nTake orders at the CRT.\nREFUSE anyone weird. (Big red button.)\n— Deb",
		intro = {
			"Welcome to Munchie's. I'm Deb, night manager. I'm sorry in advance.",
			"I'll be on your headset. Toby's here too. He's... in training.",
		},
		outro = "Great job. Don't look at the PlayPlace.",
		tutorial = true,
		debOnHeadset = true,
		lateChance = 0.12,
		latePool = { "EarlOfEars", "TotallyNormalFamily" },
		difficulty = { Normal = 0.85, Picky = 0.15, Custom = 0 },
		randomFrom = "20:00",
		scenery = { "Balloons" },
		events = {
			{ t = "18:00", kind = "customer", id = "Tutorial" },
			{ t = "19:30", kind = "customer", id = "EarlOfEars" },
			{ t = "22:00", kind = "radio", who = "Toby", text = "The fryer is hot! ...The fryer is HOT." },
			{ t = "23:00", kind = "customer", id = "Hendersons" },
			{ t = "01:00", kind = "customer", id = "TotallyNormalFamily" },
			{ t = "02:30", kind = "radio", who = "Deb", text = "If the bobblehead moves, it didn't." },
			{ t = "04:44", kind = "beat", id = "Bobblehead", param = "Player" },
		},
	},
	{
		number = 2,
		title = "The Regulars",
		stickyNote = "New: check the side MIRROR on the window screen.\nThe regulars are fine. Mostly.\nThe Hendersons are NORMAL. I checked.\n— Deb",
		intro = {
			"Night two. You came back! Nobody comes back.",
			"Tonight you meet the regulars. Be nice to Gerald.",
		},
		outro = "See? Nothing happened. ...This time. Same time tomorrow.",
		debOnHeadset = true,
		lateChance = 0.18,
		latePool = { "EarlOfEars", "TotallyNormalFamily", "SirFingersALot", "UpsideDownOrder" },
		difficulty = { Normal = 0.7, Picky = 0.3, Custom = 0 },
		randomFrom = "18:30",
		scenery = { "SafetyPoster", "PlayPlaceDark" },
		events = {
			{ t = "19:30", kind = "customer", id = "MirrorMandy" },
			{ t = "21:00", kind = "customer", id = "Gerald" },
			{ t = "23:00", kind = "customer", id = "OfficerBrisket" },
			{ t = "00:30", kind = "customer", id = "Hendersons" },
			{
				t = "02:00",
				kind = "radio",
				who = "Trucker Ray",
				text = "Breaker breaker, Munchie's. Ray here. Y'all know you're sittin' on the Thin Lane, right? Road that ain't quite here.",
			},
			{
				t = "02:05",
				kind = "radio",
				who = "Trucker Ray",
				text = "Some folks pull off it hungry. And the moon? Fake. Bigger than they say. Ray out.",
			},
			{ t = "04:30", kind = "scare", id = "LightsOutSafe" },
		},
	},
	{
		number = 3,
		title = "Mr. Munch Is Here for Inspection",
		stickyNote = "CORPORATE MEMO:\nMr. Munch will be visiting your store.\n\nIf the lights flicker: HIDE.\nFreezer, under the counter, ball pit, closet, bathroom.\n— Deb",
		intro = {
			"Corporate says Mr. Munch is 'visiting' tonight. Probably a guy in a suit. Be nice.",
			"If the lights flicker three times... just hide. Hide now, cry later.",
		},
		outro = "Weird night. Same time tomorrow?",
		debOnHeadset = true,
		lateChance = 0.22,
		latePool = { "EarlOfEars", "TotallyNormalFamily", "SirFingersALot", "UpsideDownOrder", "MirrorMandy", "GrandmaGumdrop", "DriverlessDelivery" },
		difficulty = { Normal = 0.6, Picky = 0.3, Custom = 0.1 },
		randomFrom = "18:30",
		scenery = { "VisitBanner", "GoldStars", "TobyPhoto" },
		events = {
			{ t = "19:00", kind = "customer", id = "SmileySteve" },
			{ t = "21:00", kind = "customer", id = "Gerald" },
			{ t = "22:30", kind = "beat", id = "PlayPlaceLight" },
			{ t = "23:15", kind = "customer", id = "Hendersons" },
			{ t = "00:00", kind = "beat", id = "StatueGone" },
			{ t = "01:00", kind = "customer", id = "RandomLate" },
			{ t = "01:10", kind = "customer", id = "RandomLate" },
			{
				t = "02:00",
				kind = "radio",
				who = "Trucker Ray",
				text = "You got the mascot tonight? Hide in the cold. They don't like the cold.",
			},
			{ t = "03:00", kind = "scare", id = "RushHour" },
			{ t = "04:44", kind = "beat", id = "Bobblehead", param = "Freezer" },
			{ t = "05:00", kind = "scare", id = "RushHour", ifWeird = 60 },
		},
	},
	{
		number = 4,
		title = "Where's Deb?",
		stickyNote = "DON'T REFUSE GERALD.\nTHE PHOTOS.\nFryer is fine??\nKeep heads DOWN if a car has its brights on.",
		intro = {},
		outro = "(A sticky note on the time clock:) If you're reading this, go home. Come back tomorrow. Bring the flashlight. — D",
		debOnHeadset = false,
		lateChance = 0.28,
		latePool = {
			"EarlOfEars",
			"TotallyNormalFamily",
			"SirFingersALot",
			"UpsideDownOrder",
			"MirrorMandy",
			"GrandmaGumdrop",
			"DriverlessDelivery",
			"SmileySteve",
			"StaticStan",
			"MrNotMunch",
		},
		difficulty = { Normal = 0.5, Picky = 0.35, Custom = 0.15 },
		randomFrom = "18:30",
		scenery = { "OfficeEmpty", "StickyNotes", "Fog", "TobyPhoto", "VHS" },
		events = {
			{ t = "18:00", kind = "radio", who = "Headset", text = "[static] ...Deb? ...Deb's headset is just static." },
			{ t = "19:00", kind = "customer", id = "Hendersons" },
			{ t = "20:00", kind = "customer", id = "TheTwins" },
			{ t = "21:00", kind = "customer", id = "Gerald" },
			{ t = "22:00", kind = "customer", id = "StaticStan" },
			{ t = "23:00", kind = "customer", id = "CastGuy" },
			{ t = "00:30", kind = "customer", id = "SpookyPriya" },
			{ t = "01:00", kind = "customer", id = "MrNotMunch" },
			{
				t = "01:50",
				kind = "radio",
				who = "Officer Brisket",
				text = "Dispatch to Munchie's. Car with its brights on, NO driver, headed your way. Keep your heads DOWN, kids.",
			},
			{ t = "02:00", kind = "scare", id = "HighBeams" },
			{ t = "03:30", kind = "scare", id = "RushHour" },
			{ t = "04:00", kind = "radio", who = "Speaker", text = "[whispering, from the drive-thru speaker] Clock out. Clock OUT." },
			{ t = "05:00", kind = "scare", id = "HighBeams", ifWeird = 60 },
		},
	},
	{
		number = 5,
		title = "Closing Time",
		stickyNote = "Serve the ones in the photos.\nThe real order is on the back.\n(UV.)\n— Deb",
		intro = {},
		outro = "",
		debOnHeadset = false,
		finale = true,
		lateChance = 0.3,
		latePool = {
			"TotallyNormalFamily",
			"SirFingersALot",
			"UpsideDownOrder",
			"DriverlessDelivery",
			"StaticStan",
			"MrNotMunch",
		},
		difficulty = { Normal = 0.45, Picky = 0.35, Custom = 0.2 },
		randomFrom = "18:30",
		scenery = { "Rain", "OpenAlways", "DebPhoto", "TobyPhoto", "VHS" },
		events = {
			{ t = "18:00", kind = "radio", who = "Headset", text = "[static]" },
			{ t = "18:30", kind = "customer", id = "Hendersons" },
			{ t = "19:30", kind = "customer", id = "Gerald" },
			{ t = "21:00", kind = "customer", id = "OfficerBrisket" },
			{ t = "22:00", kind = "scare", id = "HighBeams" },
			{ t = "23:00", kind = "scare", id = "RushHour" },
			{
				t = "00:00",
				kind = "radio",
				who = "Trucker Ray",
				text = "Ray here. Lane's real crowded tonight, Munchie's. Real crowded. Good luck, kids.",
			},
			{ t = "01:00", kind = "beat", id = "Reveal" },
			{ t = "01:20", kind = "customer", id = "EarlOfEars" },
			{ t = "01:50", kind = "customer", id = "MirrorMandy" },
			{ t = "02:30", kind = "customer", id = "GrandmaGumdrop" },
			{ t = "03:00", kind = "scare", id = "HighBeams" },
			{ t = "03:15", kind = "customer", id = "SmileySteve" },
			{ t = "04:00", kind = "beat", id = "FinalRush" },
			{ t = "04:10", kind = "customer", id = "TheTwins" },
		},
	},
}

function Nights.get(n: number)
	return Nights.List[math.clamp(n, 1, #Nights.List)]
end

Nights.Count = #Nights.List

return Nights
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">People</string>
            <string name="Source"><![CDATA[-- Palettes for building normal-looking customers procedurally (design doc §5.1: "Base person" + "Car").

local People = {}

People.SkinTones = {
	Color3.fromRGB(255, 224, 189),
	Color3.fromRGB(241, 194, 125),
	Color3.fromRGB(224, 172, 105),
	Color3.fromRGB(198, 134, 66),
	Color3.fromRGB(161, 102, 50),
	Color3.fromRGB(120, 74, 40),
	Color3.fromRGB(92, 58, 34),
	Color3.fromRGB(255, 205, 160),
}

People.HairColors = {
	Color3.fromRGB(35, 25, 18),
	Color3.fromRGB(90, 58, 30),
	Color3.fromRGB(196, 156, 82),
	Color3.fromRGB(20, 20, 22),
	Color3.fromRGB(150, 50, 30),
	Color3.fromRGB(215, 215, 215),
	Color3.fromRGB(110, 80, 150),
}

People.HairStyles = { "Short", "Long", "Bun", "Bald", "Cap", "Curly", "Spiky", "Beanie" }

People.ShirtColors = {
	Color3.fromRGB(52, 101, 164),
	Color3.fromRGB(200, 60, 60),
	Color3.fromRGB(70, 150, 90),
	Color3.fromRGB(240, 200, 80),
	Color3.fromRGB(130, 90, 170),
	Color3.fromRGB(60, 60, 70),
	Color3.fromRGB(240, 240, 240),
	Color3.fromRGB(230, 130, 60),
	Color3.fromRGB(90, 190, 200),
	Color3.fromRGB(180, 120, 90),
}

People.CarKinds = { "Sedan", "Hatchback", "Pickup", "Minivan", "Convertible", "Compact" }

People.CarColors = {
	Color3.fromRGB(180, 40, 40),
	Color3.fromRGB(40, 80, 160),
	Color3.fromRGB(230, 230, 230),
	Color3.fromRGB(40, 40, 45),
	Color3.fromRGB(70, 140, 80),
	Color3.fromRGB(210, 170, 60),
	Color3.fromRGB(150, 150, 160),
	Color3.fromRGB(120, 60, 140),
	Color3.fromRGB(230, 120, 40),
	Color3.fromRGB(120, 180, 210),
}

People.FirstNames = {
	"Alex", "Jordan", "Sam", "Priya", "Marcus", "Lena", "Diego", "Aisha", "Ben", "Chloe",
	"Hiro", "Maya", "Omar", "Rosa", "Tyler", "Nina", "Kwame", "Ivy", "Luis", "Grace",
	"Theo", "Zoe", "Ravi", "Hana", "Caleb", "Sofia", "Malik", "Ella", "Jin", "Ruby",
	"Andre", "Mei", "Felix", "Tara", "Noah", "Leah", "Owen", "Amara", "Eli", "Jade",
}

People.Greetings = {
	"Hi! Can I get %s?",
	"Hey, uh, I'll have %s.",
	"Hello! Could I get %s, please?",
	"Yeah, hi. %s. That's it.",
	"Hiii. Lemme get %s.",
	"Good evening! %s, please.",
	"Okay okay okay. Um. %s?",
	"Can I just get %s? Thanks.",
}

People.Thanks = {
	"Thanks!",
	"You're a lifesaver.",
	"Smells amazing.",
	"Have a good night!",
	"Cool, thanks.",
	"Perfect. Bye!",
}

People.Complaints = {
	"This isn't what I ordered...",
	"Uh. Where's the rest of it?",
	"I'm leaving a review. A long one.",
	"Seriously?",
}

local function pick(list, rng)
	return list[rng:NextInteger(1, #list)]
end

-- A random normal-looking person + car.
function People.random(rng)
	return {
		skin = pick(People.SkinTones, rng),
		hairColor = pick(People.HairColors, rng),
		hairStyle = pick(People.HairStyles, rng),
		shirt = pick(People.ShirtColors, rng),
		glasses = rng:NextNumber() < 0.25,
		name = pick(People.FirstNames, rng),
		car = { kind = pick(People.CarKinds, rng), color = pick(People.CarColors, rng) },
	}
end

People.pick = pick

return People
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
