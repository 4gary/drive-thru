        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Regulars</string>
            <string name="Source"><![CDATA[-- Recurring regulars and special customers (design doc §4.3). These are NOT Late Customers:
-- refusing them costs stars. (The Hendersons are the decoy everyone wants to refuse.)

local Regulars = {}

Regulars.ById = {
	Tutorial = {
		id = "Tutorial",
		name = "First Customer",
		person = {
			skin = Color3.fromRGB(241, 194, 125),
			hairStyle = "Short",
			hairColor = Color3.fromRGB(90, 58, 30),
			shirt = Color3.fromRGB(52, 101, 164),
			name = "Jamie",
		},
		car = { kind = "Hatchback", color = Color3.fromRGB(40, 80, 160) },
		speaker = { "Hi, uh, can I get a cheeseburger, fries, and a drink?", "Thanks! First night?" },
		order = { { item = "cheeseburger" }, { item = "fries" }, { item = "drink" } },
		patienceBonus = 600,
		servedLine = "Perfect! Have a good shift!",
		refusedLine = "...Rude.",
	},
	Gerald = {
		id = "Gerald",
		name = "Gerald Puddingston",
		person = {
			skin = Color3.fromRGB(255, 224, 189),
			hairStyle = "Bald",
			shirt = Color3.fromRGB(180, 160, 120),
			glasses = true,
			name = "Gerald",
		},
		car = { kind = "Buick", color = Color3.fromRGB(214, 196, 150) },
		speaker = {
			"Evening, young person. Number Seven, hold the seven.",
			"You know, Doris and I used to come here when it opened. 1987. She said the fries tasted like forever.",
		},
		speakerByNight = {
			[5] = {
				".neves eht dloh ,neveS rebmuN .nosrep gnuoy ,gninevE",
				".reverof ekil detsat seirf eht dias ehS .7891 .denepo ti nehw ereh emoc ot desu I dna siroD ,wonk uoY",
			},
		},
		captions = {},
		order = {}, -- there is no #7. An empty bag is exactly what he wants.
		alwaysHappy = true,
		receipt = { name = "GERALD", note = "#7 (HOLD THE 7)" },
		servedLine = "Perfect. Just how Doris liked it.",
		refusedLine = "Oh. Well. Same time tomorrow, then.",
	},
	OfficerBrisket = {
		id = "OfficerBrisket",
		name = "Officer Linda Brisket",
		person = {
			skin = Color3.fromRGB(120, 74, 40),
			hairStyle = "Bun",
			hairColor = Color3.fromRGB(20, 20, 22),
			shirt = Color3.fromRGB(30, 40, 80),
			name = "Linda",
		},
		car = { kind = "Police", color = Color3.fromRGB(240, 240, 240) },
		speaker = {
			"Black coffee. And one for my partner.",
			"Hey, kid. If a car comes through with no driver? Don't. Let. It. In.",
		},
		speakerByNight = {
			[4] = { "Two coffees. Me and my partner.", "Keep your heads down tonight, kids. I mean it." },
			[5] = { "Two coffees.", "...They're all lined up out there tonight. All of 'em. Stay inside." },
		},
		captions = { "[the passenger seat is empty]" },
		order = { { item = "drink" }, { item = "drink" } },
		receipt = { name = "OFC BRISKET", note = "1 FOR PARTNER" },
		servedLine = "Thanks, kid. Stay sharp.",
		refusedLine = "...Refusing a cop coffee? Bold.",
	},
	Hendersons = {
		id = "Hendersons",
		name = "The Hendersons",
		person = {
			skin = Color3.fromRGB(224, 172, 105),
			hairStyle = "Long",
			hairColor = Color3.fromRGB(150, 50, 30),
			shirt = Color3.fromRGB(70, 150, 90),
			name = "Mrs. Henderson",
		},
		car = { kind = "Minivan", color = Color3.fromRGB(70, 110, 160) },
		kidsByNight = { 3, 4, 6, 9, 9 },
		decoy = true,
		patienceBonus = 30,
		captions = { "[a LOT of kids in the background]" },
		receipt = { name = "HENDERSON", note = "KIDS MEALS" },
		servedLine = "Say thank you, kids! (THANK YOUUU)",
		servedLineByNight = { [5] = "(every kid, in perfect unison) THANK. YOU." },
		refusedLine = "*Mrs. Henderson leaves a 1-star review. Out loud.* ONE. STAR.",
	},
	KarenBot = {
		id = "KarenBot",
		name = "Karen-Bot",
		person = { name = "K-4R3N", shirt = Color3.fromRGB(150, 150, 160) },
		car = { kind = "Sedan", color = Color3.fromRGB(200, 200, 210) },
		modifiers = { "Robot" },
		difficulty = "Custom",
		bonusStars = 0.3,
		speakerPrefix = "MYSTERY SHOPPER UNIT K-4R3N. I WILL RATE YOUR SERVICE. I REQUIRE: ",
		captions = { "[servo noises]" },
		receipt = { name = "K-4R3N", note = "MYSTERY SHOPPER" },
		servedLine = "SERVICE RATING: FIVE STARS. TIP DISPENSED.",
		wrongLine = "SERVICE RATING: UNACCEPTABLE. I WILL BE SPEAKING TO A MANAGER.",
		refusedLine = "REFUSAL LOGGED. MANAGER NOTIFIED. HAVE A PLEASANT NIGHT.",
		gizmoLine = "GIZMO: ...she's here. act natural. ACT NATURAL.",
	},
	CastGuy = {
		id = "CastGuy",
		name = "Guy With a Cast",
		person = { hairStyle = "Short", shirt = Color3.fromRGB(230, 130, 60), name = "Dale" },
		car = { kind = "Pickup", color = Color3.fromRGB(70, 140, 80) },
		modifiers = { "Cast" },
		decoy = true,
		speaker = { "Uh, a cheeseburger and a drink. Sorry, hand's in a cast. Skateboarding." },
		captions = {},
		order = { { item = "cheeseburger" }, { item = "drink" } },
		receipt = { name = "DALE", note = "" },
		servedLine = "Thanks. Don't skateboard, kids.",
		refusedLine = "Because of the CAST?",
	},
	SpookyPriya = {
		id = "SpookyPriya",
		name = "SpookyPriya",
		onFoot = true,
		special = true,
		person = {
			skin = Color3.fromRGB(161, 102, 50),
			hairStyle = "Long",
			hairColor = Color3.fromRGB(20, 20, 22),
			shirt = Color3.fromRGB(110, 80, 150),
			name = "Priya",
		},
		car = { kind = "None" },
		speaker = {},
		order = {},
		windowLines = {
			"Hi!! I'm Priya, I'm LIVE right now, say hi chat!",
			"Can I use your bathroom? No? Okay. Here — you need this more than me.",
			"(She hands over a UV flashlight.) Point it at anything weird. Chat, this guy's SO bad at fries.",
		},
		servedLine = "Stay spooky!",
		refusedLine = "Fine, keep the flashlight anyway. Stay spooky!",
	},
}

function Regulars.hendersonKids(night: number): number
	local list = Regulars.ById.Hendersons.kidsByNight
	return list[math.clamp(night, 1, #list)]
end

return Regulars
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Story</string>
            <string name="Source"><![CDATA[-- Story text: the Employee of the Month wall, VHS tapes, endings, posters (design doc §3).

local Story = {}

-- Thirteen frames, 1987 to now. Photo-employees have a UV-only usual on the back.
Story.WallPhotos = {
	{ name = "Bart M.", year = 1987, job = "Founder", note = "Gerald is in the background." },
	{ name = "Dot", year = 1988, job = "Fry Cook", anomaly = "GrandmaGumdrop" },
	{ name = "Marv", year = 1991, job = "Night Grill", anomaly = "EarlOfEars" },
	{ name = "Lou", year = 1993, job = "Window" },
	{ name = "Mandy", year = 1996, job = "Window", anomaly = "MirrorMandy" },
	{ name = "Ray Jr.", year = 1999, job = "Lot" },
	{ name = "Steve", year = 2003, job = "Order Taker", anomaly = "SmileySteve" },
	{ name = "Jo & Mo", year = 2008, job = "Baggers", anomaly = "TheTwins" },
	{ name = "Kelly", year = 2012, job = "Shakes" },
	{ name = "Dev", year = 2017, job = "Fryer" },
	{ name = "Toby", year = 2026, job = "Trainee", showFromNight = 3 },
	{ name = "Deb", year = 2026, job = "Night Manager", showFromNight = 5 },
	{ name = "YOU?", year = nil, job = "", empty = true },
}

Story.VHSTapes = {
	{
		title = "TRAINING TAPE #1 — THE ALWAYS OPEN PROMISE (1987)",
		lines = {
			"[A man in a red tuxedo smiles too hard at the camera.]",
			"BART: Welcome to the Munchie's family! I'm Bart Munch.",
			"BART: Back in '87, this store was about to close. Then a very special customer pulled up to the speaker.",
			"BART: We made a deal. This store will never go out of business...",
			"BART: ...as long as it never, ever closes.",
			"BART: That's the Always Open Promise! Smile! It's mandatory!",
			"[The tape skips. For one frame, Bart is not smiling.]",
		},
	},
}

Story.Posters = {
	Normal = { "SMILING IS MANDATORY", "THE FREEZER IS NOT A NAP ROOM", "WASH HANDS. WASH THEM AGAIN." },
	Revealed = { "STAYING IS MANDATORY", "THE FREEZER IS NOT AN EXIT", "CLOCK IN. NEVER OUT." },
}

Story.Reveal = {
	"The power dies. Emergency lights only.",
	"The Munchie's jingle plays from every speaker at once. Slightly out of sync.",
	"Use the UV flashlight on the Employee of the Month wall. There's writing on the back of the photos.",
}

Story.Endings = {
	Company = {
		title = "EMPLOYEE OF THE MONTH",
		badge = "ending_company",
		lines = {
			"You refused them all. Just like the binder said.",
			"At 6 AM a laminated envelope slides out of the fax machine.",
			"Inside: shiny gold name tags. One for each of you.",
			"Mr. Munch gives everyone a hug. His gloves are very, very cold.",
			"On the Employee of the Month wall, four new photos. Smiling.",
			"",
			"The sign flickers: OPEN ALWAYS.",
		},
	},
	Freed = {
		title = "LAST CALL",
		badge = "ending_freed",
		lines = {
			"Dawn breaks over Exit 13.",
			"One by one, the cars in the lane turn back into ordinary old cars.",
			"Marv waves. Mandy waves. Her reflection waves too — on time.",
			"On the wall, the photos are just photos now.",
			"All except one.",
			"DEB: I'll hold the door. Come back for me.",
			"",
			"SECOND SHIFT — coming soon.",
		},
	},
	Fired = {
		title = "FIRED!",
		badge = "ending_fired",
		lines = {
			"The corporate hotline finally picks up.",
			"[smooth jazz]",
			"You are handed a cardboard box with your stuff in it,",
			"and a gift card for 1 (one) free small fry.",
			"",
			"Try Night 5 again?",
		},
	},
	Mascot = {
		title = "THE MASCOT",
		badge = "secret_mascot",
		lines = {
			"You hid inside the Mr. Munch costume during the Final Rush.",
			"It fits. It fits perfectly.",
			"For the rest of the night, the customers wave at you.",
			"Unlocked: Mr. Munch Head (cosmetic).",
		},
	},
}

Story.Credits = {
	"NIGHT SHIFT: DRIVE-THRU",
	"Design: Gary",
	"Greybox build: Claude Code",
	"Thank you for working the night shift.",
	"Open late. Open always.",
}

return Story
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">WeirdEvents</string>
            <string name="Source"><![CDATA[-- Weird events: the silly, disruptive (never scary) consequence of serving a Late Customer.
-- Design doc §7.6. "Serve a weird customer -> a funny problem."

local WeirdEvents = {}

WeirdEvents.ById = {
	EarRain = {
		name = "Ear Rain",
		duration = 25,
		banner = "EAR RAIN",
		description = "It's raining ears. Everyone wades through them slowly.",
	},
	Raccoons = {
		name = "Raccoon Infestation",
		duration = 40,
		banner = "RACCOONS!",
		description = "Raccoons are stealing food from the bags. Shoo them!",
	},
	MirrorMess = {
		name = "Mirror Mess",
		duration = 25,
		banner = "MIRROR MESS",
		description = "Left is right. Right is left. Good luck.",
	},
	GrabbyHands = {
		name = "Grabby Hands",
		duration = 25,
		banner = "GRABBY HANDS",
		description = "Tiny hands grabbed the topping bins. Shoo them off the board!",
	},
	GravityFries = {
		name = "Gravity Fries",
		duration = 12,
		banner = "GRAVITY FRIES",
		description = "All the fries float up to the ceiling. Make more.",
	},
	Doilies = {
		name = "Doilies",
		duration = 0, -- lasts the rest of the night, harmless
		banner = "DOILIES",
		description = "Everything gets a doily. Even the stars meter. Harmless. Deeply weird.",
	},
	GhostRider = {
		name = "Ghost Rider",
		duration = 30,
		banner = "GHOST RIDER",
		description = "An invisible 'helper' keeps bagging the wrong things.",
	},
	MandatoryFun = {
		name = "Mandatory Fun",
		duration = 15,
		banner = "SMILE! IT'S MANDATORY",
		description = "Everyone smiles. Everyone dances. Quick-chat is disabled.",
	},
	ChannelSurf = {
		name = "Channel Surf",
		duration = 30,
		banner = "CHANNEL SURF",
		description = "Tickets and the order screen turn to static.",
	},
	MascotMob = {
		name = "Mascot Mob",
		duration = 40,
		banner = "MASCOT MOB",
		description = "Knockoff Munches dance in the lane. The Lane Cam is useless.",
	},
	DoubleTrouble = {
		name = "Double Trouble",
		duration = 25,
		banner = "DOUBLE TROUBLE",
		description = "Everything you bag gets bagged twice. Bags overflow.",
	},
}

return WeirdEvents
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[-- Creates (server) or finds (client) every RemoteEvent / RemoteFunction the game uses.
--
-- Server -> Client events:
--   Notify(text, kind)            toast message
--   Radio(data)                   headset / CB radio line {who, text, duration}
--   Caption(data)                 captioned audio cue {text, pos?, duration?}
--   State(snapshot)               shift HUD snapshot
--   Effect(name, data)            client-side effect (lights, sounds, weird events, boop flash...)
--   OpenPanel(name, data)         open a UI panel
--   ClosePanel(name)              close a UI panel
--   Profile(summary)              saved progress summary for menus
--   Bubble(userId, text)          quick-chat bubble over a player
--   Ping(data)                    ping / ghost-point marker
--   LobbyState(data)              clock-in booths, rejoin info, lobby TV
-- Client -> Server events:
--   Action(name, data)            every gameplay input
-- Remote functions:
--   Request(name, data) -> result shop, codes, settings, rejoin, leaderboard

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	"Notify",
	"Radio",
	"Caption",
	"State",
	"Effect",
	"OpenPanel",
	"ClosePanel",
	"Profile",
	"Bubble",
	"Ping",
	"LobbyState",
	"Action",
}
local FUNCTIONS = { "Request" }

local Net = {}

local folder: Folder
if RunService:IsServer() then
	local existing = ReplicatedStorage:FindFirstChild("Remotes")
	if existing and existing:IsA("Folder") then
		folder = existing
	else
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end
	for _, name in EVENTS do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
	for _, name in FUNCTIONS do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
end

function Net.event(name: string): RemoteEvent
	return folder:WaitForChild(name) :: RemoteEvent
end

function Net.func(name: string): RemoteFunction
	return folder:WaitForChild(name) :: RemoteFunction
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">OrderLogic</string>
          <string name="Source"><![CDATA[-- Pure order logic (no game services): recipes, mods, matching bags against orders,
-- and turning orders into the words a customer says through the speaker.
--
-- A "line" is one thing on an order:     { item = "munchstack", mods = { "NoPickles", "ExtraSauce" } }
-- An "item" is one physical thing made:  { kind = "Burger", stack = { "BunBottom", ... } } or { kind = "Fries" }

local Menu = require(script.Parent.Data.Menu)

local OrderLogic = {}

export type Line = { item: string, mods: { string }? }
export type Item = { kind: string, stack: { string }?, label: string? }

local MOD_RANK = {}
for i, id in Menu.ModOrder do
	MOD_RANK[id] = i
end

local function contains(list: { string }, value: string): boolean
	return table.find(list, value) ~= nil
end

function OrderLogic.normalizeMods(mods: { string }?): { string }
	local out = {}
	if mods then
		for _, id in mods do
			if Menu.Mods[id] and not contains(out, id) then
				table.insert(out, id)
			end
		end
	end
	table.sort(out, function(a, b)
		return MOD_RANK[a] < MOD_RANK[b]
	end)
	return out
end

function OrderLogic.isBurger(itemId: string): boolean
	local def = Menu.Items[itemId]
	return def ~= nil and def.kind == "Burger"
end

-- Mods that make sense for an item (only burgers take mods; a mod must touch a topping it has).
function OrderLogic.validMods(itemId: string): { string }
	local def = Menu.Items[itemId]
	local out = {}
	if not def or def.kind ~= "Burger" then
		return out
	end
	for _, modId in Menu.ModOrder do
		local mod = Menu.Mods[modId]
		if contains(def.stack, mod.topping) then
			table.insert(out, modId)
		end
	end
	return out
end

function OrderLogic.buildStack(itemId: string, mods: { string }?): { string }
	local def = Menu.Items[itemId]
	assert(def and def.stack, "not a burger: " .. tostring(itemId))
	local stack = table.clone(def.stack)
	local normalized = OrderLogic.normalizeMods(mods)
	for _, modId in normalized do
		local mod = Menu.Mods[modId]
		if mod.kind == "remove" then
			for i = #stack, 1, -1 do
				if stack[i] == mod.topping then
					table.remove(stack, i)
				end
			end
		end
	end
	for _, modId in normalized do
		local mod = Menu.Mods[modId]
		if mod.kind == "extra" then
			for i = #stack, 1, -1 do
				if stack[i] == mod.topping then
					table.insert(stack, i + 1, mod.topping)
					break
				end
			end
		end
	end
	return stack
end

function OrderLogic.stackEquals(a: { string }?, b: { string }?): boolean
	if a == nil or b == nil then
		return false
	end
	if #a ~= #b then
		return false
	end
	for i = 1, #a do
		if a[i] ~= b[i] then
			return false
		end
	end
	return true
end

function OrderLogic.lineKey(line: Line): string
	return line.item .. "|" .. table.concat(OrderLogic.normalizeMods(line.mods), ",")
end

function OrderLogic.lineLabel(line: Line): string
	local def = Menu.Items[line.item]
	local name = if def then def.name else "???"
	local mods = OrderLogic.normalizeMods(line.mods)
	if #mods == 0 then
		return name
	end
	local parts = {}
	for _, modId in mods do
		table.insert(parts, Menu.Mods[modId].label)
	end
	return name .. " (" .. table.concat(parts, ", ") .. ")"
end

function OrderLogic.kindOf(itemId: string): string
	local def = Menu.Items[itemId]
	return if def then def.kind else "?"
end

-- The physical item a line asks for.
function OrderLogic.itemForLine(line: Line): Item
	local kind = OrderLogic.kindOf(line.item)
	if kind == "Burger" then
		return { kind = kind, stack = OrderLogic.buildStack(line.item, line.mods), label = OrderLogic.lineLabel(line) }
	end
	return { kind = kind, label = OrderLogic.lineLabel(line) }
end

function OrderLogic.itemMatchesLine(item: Item, line: Line): boolean
	local kind = OrderLogic.kindOf(line.item)
	if item.kind ~= kind then
		return false
	end
	if kind == "Burger" then
		return OrderLogic.stackEquals(item.stack, OrderLogic.buildStack(line.item, line.mods))
	end
	return true
end

-- Which menu line (if any) a finished burger stack is. Checks up to two mods.
function OrderLogic.identifyBurger(stack: { string }): Line?
	for _, itemId in Menu.Order do
		if OrderLogic.isBurger(itemId) then
			if OrderLogic.stackEquals(stack, OrderLogic.buildStack(itemId, nil)) then
				return { item = itemId, mods = {} }
			end
			local mods = OrderLogic.validMods(itemId)
			for i = 1, #mods do
				if OrderLogic.stackEquals(stack, OrderLogic.buildStack(itemId, { mods[i] })) then
					return { item = itemId, mods = { mods[i] } }
				end
			end
			for i = 1, #mods do
				for j = i + 1, #mods do
					local pair = { mods[i], mods[j] }
					if OrderLogic.stackEquals(stack, OrderLogic.buildStack(itemId, pair)) then
						return { item = itemId, mods = OrderLogic.normalizeMods(pair) }
					end
				end
			end
		end
	end
	return nil
end

function OrderLogic.makeBurgerItem(stack: { string }): Item
	local line = OrderLogic.identifyBurger(stack)
	return {
		kind = "Burger",
		stack = table.clone(stack),
		label = if line then OrderLogic.lineLabel(line) else "Mystery Burger",
	}
end

function OrderLogic.makeSimpleItem(kind: string): Item
	local labels = { Fries = "Fries", Drink = "Drink", Shake = "Shake", Patty = "Patty" }
	return { kind = kind, label = labels[kind] or kind }
end

-- Compare what a customer wanted (lines) with what is in the bag (items).
function OrderLogic.compare(lines: { Line }, items: { Item })
	local used = {}
	local missing = {}
	local matched = 0
	for _, line in lines do
		local found = false
		for i, item in items do
			if not used[i] and OrderLogic.itemMatchesLine(item, line) then
				used[i] = true
				found = true
				break
			end
		end
		if found then
			matched += 1
		else
			table.insert(missing, line)
		end
	end
	local extras = {}
	for i, item in items do
		if not used[i] then
			table.insert(extras, item)
		end
	end
	return {
		matched = matched,
		total = #lines,
		missing = missing,
		extras = extras,
		perfect = matched == #lines and #extras == 0,
	}
end

-- Lines in `lines` not yet covered by `items`.
function OrderLogic.unmetLines(lines: { Line }, items: { Item }): { Line }
	return OrderLogic.compare(lines, items).missing
end

-- Would adding `item` to a bag holding `items` satisfy one more line?
function OrderLogic.bagWants(lines: { Line }, items: { Item }, item: Item): boolean
	for _, line in OrderLogic.unmetLines(lines, items) do
		if OrderLogic.itemMatchesLine(item, line) then
			return true
		end
	end
	return false
end

function OrderLogic.sameOrder(a: { Line }, b: { Line }): boolean
	if #a ~= #b then
		return false
	end
	local keys = {}
	for _, line in a do
		local k = OrderLogic.lineKey(line)
		keys[k] = (keys[k] or 0) + 1
	end
	for _, line in b do
		local k = OrderLogic.lineKey(line)
		if not keys[k] or keys[k] == 0 then
			return false
		end
		keys[k] -= 1
	end
	return true
end

function OrderLogic.price(lines: { Line }): number
	local total = 0
	for _, line in lines do
		local def = Menu.Items[line.item]
		if def then
			total += def.price
		end
	end
	return total
end

---------------------------------------------------------------------------
-- Speech
---------------------------------------------------------------------------

local NUMBER_WORDS = { "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten" }

local function spokenItem(itemId: string, count: number): string
	local def = Menu.Items[itemId]
	if not def then
		return "something"
	end
	if count == 1 then
		if itemId == "fries" then
			return "fries"
		end
		return "a " .. def.singular
	end
	return (NUMBER_WORDS[count] or tostring(count)) .. " " .. def.plural
end

local function joinWords(parts: { string }): string
	if #parts == 0 then
		return "nothing"
	elseif #parts == 1 then
		return parts[1]
	elseif #parts == 2 then
		return parts[1] .. " and " .. parts[2]
	end
	return table.concat(parts, ", ", 1, #parts - 1) .. ", and " .. parts[#parts]
end

function OrderLogic.describe(lines: { Line }): string
	local groups = {}
	local orderKeys = {}
	for _, line in lines do
		local key = OrderLogic.lineKey(line)
		if not groups[key] then
			groups[key] = { line = line, count = 0 }
			table.insert(orderKeys, key)
		end
		groups[key].count += 1
	end
	local parts = {}
	for _, key in orderKeys do
		local group = groups[key]
		local phrase = spokenItem(group.line.item, group.count)
		local mods = OrderLogic.normalizeMods(group.line.mods)
		if #mods > 0 then
			local spoken = {}
			for _, modId in mods do
				table.insert(spoken, Menu.Mods[modId].spoken)
			end
			phrase ..= " with " .. joinWords(spoken)
		end
		table.insert(parts, phrase)
	end
	return joinWords(parts)
end

---------------------------------------------------------------------------
-- Random orders
---------------------------------------------------------------------------

local WEIGHTS = { burger = 3, cheeseburger = 3, munchstack = 2, fries = 4, drink = 3, shake = 2 }

local function weightedItem(rng): string
	local total = 0
	for _, w in WEIGHTS do
		total += w
	end
	local roll = rng:NextNumber() * total
	for _, itemId in Menu.Order do
		roll -= WEIGHTS[itemId]
		if roll <= 0 then
			return itemId
		end
	end
	return "fries"
end

local function randomBurgerId(rng): string
	local burgers = { "burger", "cheeseburger", "munchstack" }
	return burgers[rng:NextInteger(1, #burgers)]
end

-- difficulty: "Normal" | "Picky" | "Custom"
function OrderLogic.generate(rng, difficulty: string?): { Line }
	difficulty = difficulty or "Normal"
	local count
	if difficulty == "Custom" then
		count = rng:NextInteger(3, 4)
	elseif difficulty == "Picky" then
		count = rng:NextInteger(2, 3)
	else
		count = rng:NextInteger(1, 3)
	end
	local lines: { Line } = {}
	-- Most people want a burger.
	if rng:NextNumber() < 0.8 then
		table.insert(lines, { item = randomBurgerId(rng), mods = {} })
	end
	while #lines < count do
		table.insert(lines, { item = weightedItem(rng), mods = {} })
	end
	local modsWanted = if difficulty == "Custom" then 2 elseif difficulty == "Picky" then 1 else 0
	local guard = 0
	while modsWanted > 0 and guard < 20 do
		guard += 1
		local burgerLines = {}
		for _, line in lines do
			if OrderLogic.isBurger(line.item) then
				table.insert(burgerLines, line)
			end
		end
		if #burgerLines == 0 then
			table.insert(lines, { item = randomBurgerId(rng), mods = {} })
			continue
		end
		local line = burgerLines[rng:NextInteger(1, #burgerLines)]
		local options = OrderLogic.validMods(line.item)
		local modId = options[rng:NextInteger(1, #options)]
		local mods = line.mods or {}
		local conflicting = false
		for _, existing in mods do
			if Menu.Mods[existing].topping == Menu.Mods[modId].topping then
				conflicting = true
			end
		end
		if not conflicting and #mods < 2 then
			table.insert(mods, modId)
			line.mods = OrderLogic.normalizeMods(mods)
			modsWanted -= 1
		end
	end
	return lines
end

return OrderLogic
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[-- Minimal signal / event bus. Handlers run in their own thread so one error can't break the rest.

local Signal = {}
Signal.__index = Signal

export type Connection = { Disconnect: (Connection) -> () }

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(fn: (...any) -> ())
	local handlers = self._handlers
	local entry = { fn = fn, connected = true }
	table.insert(handlers, entry)
	return {
		Disconnect = function()
			entry.connected = false
			local index = table.find(handlers, entry)
			if index then
				table.remove(handlers, index)
			end
		end,
	}
end

function Signal:Fire(...: any)
	for _, entry in table.clone(self._handlers) do
		if entry.connected then
			task.spawn(entry.fn, ...)
		end
	end
end

-- Named-event bus: Bus:on("Booped", fn), Bus:fire("Booped", player)
local Bus = {}
Bus.__index = Bus

function Signal.bus()
	return setmetatable({ _signals = {} }, Bus)
end

function Bus:_get(name: string)
	local signal = self._signals[name]
	if not signal then
		signal = Signal.new()
		self._signals[name] = signal
	end
	return signal
end

function Bus:on(name: string, fn: (...any) -> ())
	return self:_get(name):Connect(fn)
end

function Bus:fire(name: string, ...: any)
	self:_get(name):Fire(...)
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[-- Small helpers shared by server and client.

local Util = {}

-- Create an instance, apply properties, then parent it last (cheaper replication).
function Util.make(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(inst :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Util.weld(a: BasePart, b: BasePart): WeldConstraint
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = a
	weld.Part1 = b
	weld.Parent = a
	return weld
end

function Util.clamp(x: number, lo: number, hi: number): number
	if x < lo then
		return lo
	elseif x > hi then
		return hi
	end
	return x
end

function Util.lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

function Util.shuffle<T>(list: { T }, rng: Random?): { T }
	local r = rng or Random.new()
	for i = #list, 2, -1 do
		local j = r:NextInteger(1, i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

function Util.pick<T>(list: { T }, rng: Random?): T
	local r = rng or Random.new()
	return list[r:NextInteger(1, #list)]
end

function Util.deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[Util.deepCopy(k)] = Util.deepCopy(v)
	end
	return copy
end

function Util.count(t: { [any]: any }): number
	local n = 0
	for _ in t do
		n += 1
	end
	return n
end

-- "03:00" -> minutes after 6:00 PM (540). Times before 18:00 belong to the next morning.
function Util.parseClock(text: string): number
	local hText, mText = string.match(text, "^(%d+):(%d+)$")
	local h, m = tonumber(hText), tonumber(mText)
	assert(h and m, "bad clock string " .. tostring(text))
	local total = h * 60 + m
	if h < 18 then
		total += 24 * 60
	end
	return total - 18 * 60
end

-- Minutes after 6:00 PM -> "3:14 AM"
function Util.formatClock(minutesAfterSix: number): string
	local total = 18 * 60 + math.floor(minutesAfterSix)
	local h = math.floor(total / 60) % 24
	local m = total % 60
	local h12 = h % 12
	if h12 == 0 then
		h12 = 12
	end
	return string.format("%d:%02d %s", h12, m, if h < 12 then "AM" else "PM")
end

function Util.formatSeconds(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

function Util.numberWord(n: number): string
	local words = { "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten" }
	return words[n] or tostring(n)
end

return Util
]]></string>
        </Properties>
