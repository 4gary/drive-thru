        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Characters</string>
            <string name="Source"><![CDATA[-- Spawning, crew cosmetics (visor / apron / name tag built from parts), crouching, walk speed
-- modifiers (sticky floors, ear rain) and collision groups (crew don't block each other; ghosts
-- only touch the ghost floor).

local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Cosmetics = require(Shared.Data.Cosmetics)
local Layout = require(Shared.Builders.Layout)
local ModelFactory = require(Shared.Builders.ModelFactory)
local ctx = require(script.Parent.Context)

local Characters = {}

local state: { [Player]: { crouch: boolean, stickyUntil: number, baseHip: number } } = {}
Characters.puddles = {} :: { { part: BasePart, expires: number } }

local GROUPS = { "Players", "Ghosts", "GhostFloor", "GhostBounds" }

local function setupCollisionGroups()
	for _, group in GROUPS do
		pcall(function()
			PhysicsService:RegisterCollisionGroup(group)
		end)
	end
	PhysicsService:CollisionGroupSetCollidable("Players", "Players", false)
	PhysicsService:CollisionGroupSetCollidable("Ghosts", "Default", false)
	PhysicsService:CollisionGroupSetCollidable("Ghosts", "Players", false)
	PhysicsService:CollisionGroupSetCollidable("Ghosts", "Ghosts", false)
	PhysicsService:CollisionGroupSetCollidable("GhostFloor", "Default", false)
	PhysicsService:CollisionGroupSetCollidable("GhostFloor", "Players", false)
	PhysicsService:CollisionGroupSetCollidable("GhostBounds", "Default", false)
	PhysicsService:CollisionGroupSetCollidable("GhostBounds", "Players", false)
	PhysicsService:CollisionGroupSetCollidable("Ghosts", "GhostFloor", true)
	PhysicsService:CollisionGroupSetCollidable("Ghosts", "GhostBounds", true)
	-- re-apply in case the map was built before the groups existed
	for _, p in CollectionService:GetTagged("GhostFloor") do
		if p:IsA("BasePart") then
			p.CollisionGroup = "GhostFloor"
		end
	end
	for _, p in CollectionService:GetTagged("GhostBounds") do
		if p:IsA("BasePart") then
			p.CollisionGroup = "GhostBounds"
		end
	end
end

function Characters.setGroup(character: Model, group: string)
	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = group
		end
	end
end

-- LoadCharacterAsync yields; callers shouldn't have to wait for it.
local function loadCharacter(player: Player)
	task.spawn(function()
		local ok, err = pcall(function()
			player:LoadCharacterAsync()
		end)
		if not ok then
			warn("[Characters] LoadCharacterAsync failed for " .. player.Name .. ": " .. tostring(err))
		end
	end)
end

local function torsoOf(character: Model): BasePart?
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	if torso and torso:IsA("BasePart") then
		return torso
	end
	return nil
end

local function attach(parent: Instance, p: BasePart, to: BasePart, offset: CFrame)
	p.CFrame = to.CFrame * offset
	p.Anchored = false
	p.Massless = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = to
	weld.Part1 = p
	weld.Parent = p
	p.Parent = parent
end

local function newPart(name: string, size: Vector3, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	return p
end

function Characters.applyCosmetics(player: Player)
	local character = player.Character
	local profile = ctx.PlayerData.get(player)
	if not character or not profile then
		return
	end
	local head = character:FindFirstChild("Head") :: BasePart?
	local torso = torsoOf(character)
	if not head or not torso then
		return
	end
	local old = character:FindFirstChild("CrewCosmetics")
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Model")
	folder.Name = "CrewCosmetics"
	folder.Parent = character
	local equipped = profile.equipped
	local hat = Cosmetics.ById[equipped.Hat or ""] or Cosmetics.ById.hat_visor_red
	local apron = Cosmetics.ById[equipped.Apron or ""] or Cosmetics.ById.apron_red
	local tag = Cosmetics.ById[equipped.Tag or ""] or Cosmetics.ById.tag_white
	local headTop = head.Size.Y / 2
	-- hat
	local style = hat.style
	if style == "Visor" then
		attach(folder, newPart("VisorBand", Vector3.new(head.Size.X + 0.15, 0.35, head.Size.Z + 0.15), hat.color), head, CFrame.new(0, headTop - 0.05, 0))
		attach(folder, newPart("VisorBill", Vector3.new(1.4, 0.1, 0.9), hat.color), head, CFrame.new(0, headTop - 0.15, -head.Size.Z / 2 - 0.4))
	elseif style == "Crown" then
		attach(folder, newPart("Crown", Vector3.new(head.Size.X + 0.1, 0.6, head.Size.Z + 0.1), hat.color), head, CFrame.new(0, headTop + 0.15, 0))
		for i = -1, 1 do
			local point = Instance.new("WedgePart")
			point.Name = "CrownPoint"
			point.Size = Vector3.new(0.4, 0.5, 0.2)
			point.Color = hat.color
			attach(folder, point, head, CFrame.new(i * 0.6, headTop + 0.7, -head.Size.Z / 2))
		end
	elseif style == "Cap" then
		attach(folder, newPart("Cap", Vector3.new(head.Size.X + 0.15, 0.5, head.Size.Z + 0.15), hat.color), head, CFrame.new(0, headTop + 0.05, 0))
		attach(folder, newPart("Brim", Vector3.new(1.3, 0.12, 1), hat.color), head, CFrame.new(0, headTop - 0.1, -head.Size.Z / 2 - 0.45))
	elseif style == "Bun" then
		local bun = newPart("Bun", Vector3.new(1.9, 1.0, 1.9), hat.color)
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = bun
		attach(folder, bun, head, CFrame.new(0, headTop + 0.3, 0))
	elseif style == "TopHat" then
		local brim = newPart("Brim", Vector3.new(0.12, 1.8, 1.8), hat.color)
		brim.Shape = Enum.PartType.Cylinder
		attach(folder, brim, head, CFrame.new(0, headTop + 0.05, 0) * CFrame.Angles(0, 0, math.rad(90)))
		local top = newPart("Top", Vector3.new(1.2, 1.1, 1.1), hat.color)
		top.Shape = Enum.PartType.Cylinder
		attach(folder, top, head, CFrame.new(0, headTop + 0.65, 0) * CFrame.Angles(0, 0, math.rad(90)))
		local monocle = newPart("Monocle", Vector3.new(0.05, 0.45, 0.45), Color3.fromRGB(244, 180, 0), Enum.Material.Metal)
		monocle.Shape = Enum.PartType.Cylinder
		monocle.Transparency = 0.3
		attach(folder, monocle, head, CFrame.new(0.3, 0.15, -head.Size.Z / 2 - 0.05) * CFrame.Angles(0, math.rad(90), 0))
	elseif style == "MunchHead" then
		local munch = ModelFactory.buildMunch({ scale = 0.38 })
		local headPart = munch:FindFirstChild("Head") :: Model
		if headPart then
			for _, d in headPart:GetDescendants() do
				if d:IsA("BasePart") then
					local offset = (munch.PrimaryPart :: BasePart).CFrame:ToObjectSpace(d.CFrame)
					local clone = d:Clone()
					for _, w in clone:GetChildren() do
						if w:IsA("WeldConstraint") then
							w:Destroy()
						end
					end
					attach(folder, clone, head, CFrame.new(0, -2.3, 0) * offset)
				end
			end
		end
		munch:Destroy()
	end
	-- apron
	local apronPart = newPart("Apron", Vector3.new(torso.Size.X * 0.8, torso.Size.Y * 0.95, 0.12), apron.color, if apron.neon then Enum.Material.Neon else Enum.Material.Fabric)
	attach(folder, apronPart, torso, CFrame.new(0, -0.1, -torso.Size.Z / 2 - 0.07))
	-- name tag
	local tagPart = newPart("NameTag", Vector3.new(0.9, 0.32, 0.05), tag.color)
	attach(folder, tagPart, torso, CFrame.new(-0.45, 0.45, -torso.Size.Z / 2 - 0.15))
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 80
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = player.DisplayName
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.TextColor3 = Color3.fromRGB(30, 30, 30)
	label.Parent = gui
	gui.Parent = tagPart
end

local function onCharacter(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if not humanoid or not root then
		return
	end
	state[player] = { crouch = false, stickyUntil = 0, baseHip = humanoid.HipHeight }
	player:SetAttribute("Crouching", false)
	player:SetAttribute("Hidden", nil)
	player:SetAttribute("Ghost", false)
	Characters.setGroup(character, "Players")
	character.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") and not player:GetAttribute("Ghost") then
			d.CollisionGroup = "Players"
		end
	end)
	Characters.applyCosmetics(player)
	local cf = if ctx.Shift then ctx.Shift.spawnCFrameFor(player) else nil
	if cf then
		task.defer(function()
			if character.Parent then
				character:PivotTo(cf)
			end
		end)
	end
	humanoid.Died:Connect(function()
		if ctx.Stations then
			ctx.Stations.dropHeld(player)
		end
		task.delay(3, function()
			if player.Parent and player.Character == character then
				loadCharacter(player)
			end
		end)
	end)
end

function Characters.respawn(player: Player)
	if player.Parent then
		loadCharacter(player)
	end
end

function Characters.moveTo(player: Player, cf: CFrame)
	local character = player.Character
	if character and character.PrimaryPart then
		character:PivotTo(cf)
	end
end

function Characters.setCrouch(player: Player, on: boolean)
	local s = state[player]
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not s or not humanoid then
		return
	end
	if s.crouch == on then
		return
	end
	s.crouch = on
	player:SetAttribute("Crouching", on)
	player:SetAttribute("CrouchSince", if on then os.clock() else nil)
	if humanoid.RigType == Enum.HumanoidRigType.R15 then
		humanoid.HipHeight = if on then math.max(0.1, s.baseHip - Config.Crouch.HipHeightDrop) else s.baseHip
	else
		-- R6 can't lower its hips; at least drop the camera so crouching feels like crouching
		humanoid.CameraOffset = if on then Vector3.new(0, -1.5, 0) else Vector3.zero
	end
end

function Characters.isCrouching(player: Player): boolean
	local s = state[player]
	return s ~= nil and s.crouch
end

function Characters.addPuddle(position: Vector3)
	local puddle = Instance.new("Part")
	puddle.Name = "StickyPuddle"
	puddle.Shape = Enum.PartType.Cylinder
	puddle.Size = Vector3.new(0.06, 7, 7)
	puddle.CFrame = CFrame.new(position.X, Layout.Floor + 0.04, position.Z) * CFrame.Angles(0, 0, math.rad(90))
	puddle.Color = Color3.fromRGB(110, 60, 30)
	puddle.Material = Enum.Material.Glass
	puddle.Transparency = 0.3
	puddle.Anchored = true
	puddle.CanCollide = false
	puddle.CanQuery = false
	puddle.Parent = ctx.map.Dynamic
	table.insert(Characters.puddles, { part = puddle, expires = os.clock() + 20 })
end

function Characters.clearPuddles()
	for _, p in Characters.puddles do
		p.part:Destroy()
	end
	table.clear(Characters.puddles)
end

local function speedFor(player: Player): number?
	local s = state[player]
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not s or not root then
		return nil
	end
	if player:GetAttribute("Ghost") then
		return Config.Ghost.WalkSpeed
	end
	if player:GetAttribute("Hidden") then
		return 0
	end
	local speed = 16
	if s.crouch then
		speed = Config.Crouch.WalkSpeed
	end
	local now = os.clock()
	for _, puddle in Characters.puddles do
		local offset = root.Position - puddle.part.Position
		if math.abs(offset.X) < 3.5 and math.abs(offset.Z) < 3.5 then
			s.stickyUntil = now + Config.Cook.StickySeconds
		end
	end
	if now < s.stickyUntil then
		speed = math.min(speed, Config.Cook.StickySpeed)
	end
	if ctx.WeirdEvents and ctx.WeirdEvents.isActive("EarRain") and root.Position.Z > Layout.KitchenZ.min then
		speed *= 0.6
	end
	return speed
end

function Characters.init()
	setupCollisionGroups()
	local function setupPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			onCharacter(player, character)
		end)
		if player.Character then
			task.spawn(onCharacter, player, player.Character)
		end
		task.spawn(function()
			ctx.PlayerData.waitFor(player)
			if player.Parent and not player.Character then
				loadCharacter(player)
			end
		end)
	end
	Players.PlayerAdded:Connect(setupPlayer)
	for _, player in Players:GetPlayers() do
		setupPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		state[player] = nil
	end)
	ctx.onAction("Crouch", function(player, data)
		Characters.setCrouch(player, data.on == true)
	end)
	task.spawn(function()
		while true do
			task.wait(0.2)
			local now = os.clock()
			for i = #Characters.puddles, 1, -1 do
				local p = Characters.puddles[i]
				if now > p.expires then
					p.part:Destroy()
					table.remove(Characters.puddles, i)
				end
			end
			for _, player in Players:GetPlayers() do
				local speed = speedFor(player)
				local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
				if speed and humanoid and humanoid.WalkSpeed ~= speed then
					humanoid.WalkSpeed = speed
				end
			end
		end
	end)
end

return Characters
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Chat</string>
            <string name="Source"><![CDATA[-- Callouts without voice (design doc §7.3): the quick-chat wheel and ping-on-object.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local QuickChat = require(Shared.Data.QuickChat)
local ctx = require(script.Parent.Context)

local Chat = {}

local lastChat: { [Player]: number } = {}
local lastPing: { [Player]: number } = {}

local byId = {}
for _, entry in QuickChat do
	byId[entry.id] = entry
end

local function sameRoom(player: Player): { Player }
	if ctx.Shift.isCrew(player) then
		return ctx.Shift.crewPlayers()
	end
	local out = {}
	for _, p in Players:GetPlayers() do
		if not ctx.Shift.isCrew(p) then
			table.insert(out, p)
		end
	end
	return out
end

function Chat.init()
	ctx.onAction("QuickChat", function(player, data)
		local entry = byId[tostring(data.id)]
		if not entry then
			return
		end
		local now = os.clock()
		if (lastChat[player] or 0) + 1.2 > now then
			return
		end
		lastChat[player] = now
		if ctx.Shift.isCrew(player) and ctx.WeirdEvents.isActive("MandatoryFun") then
			ctx.notify(player, "Mandatory Fun! No talking. Only smiling.", "warn")
			return
		end
		for _, p in sameRoom(player) do
			ctx.Remotes.Bubble:FireClient(p, player.UserId, entry.text)
		end
	end)
	ctx.onAction("Ping", function(player, data)
		if not ctx.Shift.canAct(player) or typeof(data.position) ~= "Vector3" then
			return
		end
		local now = os.clock()
		if (lastPing[player] or 0) + 2 > now then
			return
		end
		lastPing[player] = now
		for _, p in ctx.Shift.crewPlayers() do
			ctx.Remotes.Ping:FireClient(p, { position = data.position, name = player.DisplayName, ghost = false, duration = 3 })
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastChat[player] = nil
		lastPing[player] = nil
	end)
end

return Chat
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Codes</string>
            <string name="Source"><![CDATA[-- The corporate fax machine: redeem codes (design doc §11.4). Built-in codes live in Data/Codes;
-- live-ops can add more without an update by writing a table to the "LiveCodes" key of the
-- "NightShift_LiveOps" DataStore, e.g. { NEWCODE = { reward = { paychecks = 50 }, message = "..." } }.

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CodeData = require(Shared.Data.Codes)
local Cosmetics = require(Shared.Data.Cosmetics)
local ctx = require(script.Parent.Context)

local Codes = {}

local liveCodes: { [string]: any } = {}

local function lookup(code: string)
	return liveCodes[code] or CodeData[code]
end

function Codes.init()
	task.spawn(function()
		local ok, result = pcall(function()
			return DataStoreService:GetDataStore("NightShift_LiveOps"):GetAsync("LiveCodes")
		end)
		if ok and type(result) == "table" then
			for code, entry in result do
				if type(code) == "string" and type(entry) == "table" then
					liveCodes[string.upper(code)] = entry
				end
			end
		end
	end)

	ctx.onRequest("RedeemCode", function(player, data)
		local code = string.upper((string.gsub(tostring(data.code or ""), "%s", "")))
		if code == "" then
			return { ok = false, message = "The fax machine beeps at you." }
		end
		local entry = lookup(code)
		if not entry then
			return { ok = false, message = "INVALID CODE. Corporate is disappointed." }
		end
		if entry.expires and os.time() > entry.expires then
			return { ok = false, message = "That code has expired." }
		end
		if not ctx.PlayerData.markRedeemed(player, code) then
			return { ok = false, message = "You already redeemed that one." }
		end
		local reward = entry.reward or {}
		if reward.paychecks then
			ctx.PlayerData.addPaychecks(player, reward.paychecks)
		end
		if reward.cosmetic and Cosmetics.ById[reward.cosmetic] then
			ctx.PlayerData.own(player, reward.cosmetic)
		end
		ctx.Badges.award(player, "fax")
		return { ok = true, message = entry.message or "Code redeemed!" }
	end)
end

return Codes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Context</string>
            <string name="Source"><![CDATA[-- Shared server context. Every service registers itself here (ctx.Shift, ctx.Stations, ...) so
-- services can call each other at runtime without circular requires.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Signal)

local ctx: { [string]: any } = {}

ctx.Bus = Signal.bus()
ctx.Remotes = {
	Notify = Net.event("Notify"),
	Radio = Net.event("Radio"),
	Caption = Net.event("Caption"),
	State = Net.event("State"),
	Effect = Net.event("Effect"),
	OpenPanel = Net.event("OpenPanel"),
	ClosePanel = Net.event("ClosePanel"),
	Profile = Net.event("Profile"),
	Bubble = Net.event("Bubble"),
	Ping = Net.event("Ping"),
	LobbyState = Net.event("LobbyState"),
	Action = Net.event("Action"),
	Request = Net.func("Request"),
}

---------------------------------------------------------------------------
-- Client -> server dispatch with a simple per-player rate limit
---------------------------------------------------------------------------

local actionHandlers: { [string]: (Player, any) -> () } = {}
local requestHandlers: { [string]: (Player, any) -> any } = {}
local budget: { [Player]: { tokens: number, last: number } } = {}

local function allow(player: Player): boolean
	local now = os.clock()
	local b = budget[player]
	if not b then
		b = { tokens = 30, last = now }
		budget[player] = b
	end
	b.tokens = math.min(30, b.tokens + (now - b.last) * 15)
	b.last = now
	if b.tokens < 1 then
		return false
	end
	b.tokens -= 1
	return true
end

function ctx.onAction(name: string, handler: (Player, any) -> ())
	assert(not actionHandlers[name], "duplicate action " .. name)
	actionHandlers[name] = handler
end

function ctx.onRequest(name: string, handler: (Player, any) -> any)
	assert(not requestHandlers[name], "duplicate request " .. name)
	requestHandlers[name] = handler
end

ctx.Remotes.Action.OnServerEvent:Connect(function(player: Player, name: any, data: any)
	if type(name) ~= "string" or not allow(player) then
		return
	end
	local handler = actionHandlers[name]
	if handler then
		local ok, err = pcall(handler, player, if type(data) == "table" then data else {})
		if not ok then
			warn(("[Action %s] %s"):format(name, tostring(err)))
		end
	end
end)

ctx.Remotes.Request.OnServerInvoke = function(player: Player, name: any, data: any)
	if type(name) ~= "string" or not allow(player) then
		return { ok = false, message = "Slow down!" }
	end
	local handler = requestHandlers[name]
	if not handler then
		return { ok = false, message = "Unknown request" }
	end
	local ok, result = pcall(handler, player, if type(data) == "table" then data else {})
	if not ok then
		warn(("[Request %s] %s"):format(name, tostring(result)))
		return { ok = false, message = "Something went wrong." }
	end
	return result
end

Players.PlayerRemoving:Connect(function(player)
	budget[player] = nil
end)

---------------------------------------------------------------------------
-- Broadcast helpers
---------------------------------------------------------------------------

-- Players who should receive shift events (the crew), or everyone if no shift is running.
function ctx.audience(): { Player }
	if ctx.Shift and ctx.Shift.session then
		return ctx.Shift.crewPlayers()
	end
	return Players:GetPlayers()
end

local function each(players: { Player }?, fn: (Player) -> ())
	for _, p in players or ctx.audience() do
		if p.Parent == Players then
			fn(p)
		end
	end
end
ctx.each = each

function ctx.notify(player: Player, text: string, kind: string?)
	ctx.Remotes.Notify:FireClient(player, text, kind or "info")
end

function ctx.notifyCrew(text: string, kind: string?)
	each(nil, function(p)
		ctx.Remotes.Notify:FireClient(p, text, kind or "info")
	end)
end

-- Headset / CB radio line.
function ctx.radio(who: string, text: string, duration: number?)
	each(nil, function(p)
		ctx.Remotes.Radio:FireClient(p, { who = who, text = text, duration = duration or math.clamp(#text / 14, 3, 9) })
	end)
end

-- Captioned audio cue; `pos` lets clients show a direction ("— left").
function ctx.caption(text: string, pos: Vector3?, duration: number?)
	each(nil, function(p)
		ctx.Remotes.Caption:FireClient(p, { text = text, pos = pos, duration = duration or 3 })
	end)
end

function ctx.effect(name: string, data: any?, players: { Player }?)
	each(players, function(p)
		ctx.Remotes.Effect:FireClient(p, name, data or {})
	end)
end

function ctx.openPanel(player: Player, name: string, data: any?)
	ctx.Remotes.OpenPanel:FireClient(player, name, data or {})
end

function ctx.closePanel(player: Player, name: string)
	ctx.Remotes.ClosePanel:FireClient(player, name)
end

function ctx.sound(name: string, pos: Vector3?, players: { Player }?)
	ctx.effect("Sound", { name = name, pos = pos }, players)
end

function ctx.now(): number
	return os.clock()
end

return ctx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Customers</string>
            <string name="Source"><![CDATA[-- The drive-thru lane: spawns cars (normal people, regulars, Late Customers), moves them through
-- the queue slots (speaker -> hold -> window), tracks patience and makes them leave.
-- Design doc §5.1 ("Customer = Base person + Car + Order + Tells") and §7.2.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Layout = require(Shared.Builders.Layout)
local ModelFactory = require(Shared.Builders.ModelFactory)
local Anomalies = require(Shared.Data.Anomalies)
local Regulars = require(Shared.Data.Regulars)
local People = require(Shared.Data.People)
local OrderLogic = require(Shared.OrderLogic)
local ctx = require(script.Parent.Context)

local Customers = {}

Customers.lane = {} :: { any } -- front (window) to back
Customers.cars = {} :: { [number]: any }
local scripted: { string } = {}
local usedLate: { [string]: boolean } = {}
local nextId = 0
local carsFolder: Folder? = nil

local function folder(): Folder
	if not carsFolder or not carsFolder.Parent then
		local f = Instance.new("Folder")
		f.Name = "Cars"
		f.Parent = ctx.map.Dynamic
		carsFolder = f
	end
	return carsFolder :: Folder
end

local function slotCFrame(x: number): CFrame
	return CFrame.new(x, 0, Layout.LaneZ)
end

---------------------------------------------------------------------------
-- Speech bubbles over cars
---------------------------------------------------------------------------

function Customers.say(car, text: string, duration: number?)
	if not car.model or not car.model.Parent then
		return
	end
	local root = car.root :: BasePart
	local old = root:FindFirstChild("Bubble")
	if old then
		old:Destroy()
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "Bubble"
	gui.Size = UDim2.fromOffset(260, 80)
	gui.StudsOffset = Vector3.new(0, 9, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 90
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = Color3.fromRGB(255, 252, 240)
	label.TextColor3 = Color3.fromRGB(30, 30, 30)
	label.TextWrapped = true
	label.TextScaled = true
	label.Font = Enum.Font.FredokaOne
	label.Text = text
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = label
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 4)
	pad.Parent = label
	label.Parent = gui
	gui.Parent = root
	task.delay(duration or 4, function()
		if gui.Parent then
			gui:Destroy()
		end
	end)
end

---------------------------------------------------------------------------
-- Building a customer record
---------------------------------------------------------------------------

local function merge(base: { [string]: any }, over: { [string]: any }?)
	local out = table.clone(base)
	if over then
		for k, v in over do
			out[k] = v
		end
	end
	return out
end

local function pickDifficulty(s): string
	local weights = s.data.difficulty or { Normal = 1 }
	local roll = s.rng:NextNumber()
	local acc = 0
	for _, name in { "Normal", "Picky", "Custom" } do
		acc += weights[name] or 0
		if roll <= acc then
			return name
		end
	end
	return "Normal"
end

local function baseRecord(kind: string)
	nextId += 1
	return {
		id = nextId,
		kind = kind, -- "Normal" | "Late" | "Regular" | "Special"
		isLate = kind == "Late",
		ordered = false,
		state = "Arriving",
		slot = nil,
		targetSlot = nil,
		tween = nil,
		ticket = nil,
		decided = false,
		patienceBonus = 0,
		modifiers = {},
		captions = {},
	}
end

local function normalRecord(s)
	local car = baseRecord("Normal")
	local person = People.random(s.rng)
	car.person = person
	car.carSpec = person.car
	car.name = person.name
	car.order = OrderLogic.generate(s.rng, pickDifficulty(s))
	local greeting = People.pick(People.Greetings, s.rng)
	car.speaker = { string.format(greeting, OrderLogic.describe(car.order)) }
	if s.rng:NextNumber() < 0.4 then
		table.insert(car.speaker, People.pick(People.Thanks, s.rng))
	end
	car.receipt = { name = string.upper(person.name) }
	return car
end

local function lateRecord(s, def)
	local car = baseRecord("Late")
	car.def = def
	car.anomalyId = def.id
	local person = merge(People.random(s.rng), def.person)
	car.person = person
	car.carSpec = def.car or person.car
	car.name = def.name
	car.modifiers = table.clone(def.modifiers or {})
	car.captions = table.clone(def.captions or {})
	car.mirrorTell = def.mirrorTell
	car.order = table.clone(def.order or {})
	car.speaker = table.clone(def.speaker or {})
	car.receipt = table.clone(def.receipt or {})
	if s.night >= 4 and not car.receipt.total then
		car.receipt.total = "$13.13"
	end
	if s.flags.revealed and def.photo then
		-- Night 5, after the reveal: the photo-employees just want "the usual".
		car.wantsUsual = true
		car.order = table.clone(def.photo.usual)
		car.speaker = { "...", "Please. Just make me the usual." }
		if def.id == "EarlOfEars" then
			car.speaker = { "...It's me. Marv. Night grill, '91.", "Please. Just make me the usual." }
		end
		car.patienceBonus = 45
	end
	if s.night >= 5 and def.id == "MirrorMandy" then
		car.mirrorTell = "Crying"
	end
	return car
end

local function regularRecord(s, def)
	local car = baseRecord(if def.special then "Special" else "Regular")
	car.def = def
	car.regularId = def.id
	car.isDecoy = def.decoy == true
	local person = merge(People.random(s.rng), def.person)
	car.person = person
	car.carSpec = def.car or person.car
	car.name = def.name
	car.modifiers = table.clone(def.modifiers or {})
	car.captions = table.clone(def.captions or {})
	car.patienceBonus = def.patienceBonus or 0
	car.receipt = table.clone(def.receipt or { name = string.upper(person.name or "GUEST") })
	car.skipSpeaker = def.onFoot == true
	local speaker = (def.speakerByNight and def.speakerByNight[s.night]) or def.speaker or {}
	car.speaker = table.clone(speaker)
	if def.id == "Hendersons" then
		local kids = Regulars.hendersonKids(s.night)
		car.kids = kids
		car.order = {}
		for _ = 1, kids do
			table.insert(car.order, { item = "fries" })
		end
		table.insert(car.order, { item = "drink" })
		local words = { "one", "two", "three", "four" }
		local counting = table.concat(words, ", ", 1, math.min(kids, 4))
		car.speaker = {
			"Kids' meals for... (counting) " .. counting .. (if kids > 4 then "... uh... " .. kids .. "?!" else "."),
			("Kids' meals are fries, right? So %d fries. And a drink for me."):format(kids),
		}
		if s.night >= 5 then
			table.insert(car.modifiers, "IdenticalKids:" .. kids)
			car.speaker = { "Kids' meals for... nine.", "(nine identical voices) NINE FRIES. AND A DRINK. THANK. YOU." }
		else
			table.insert(car.modifiers, "Kids:" .. kids)
		end
	elseif def.id == "KarenBot" then
		car.order = OrderLogic.generate(s.rng, "Custom")
		car.speaker = { def.speakerPrefix .. string.upper(OrderLogic.describe(car.order)) .. "." }
	else
		car.order = table.clone(def.order or {})
	end
	return car
end

local function pickLateId(s): string?
	local pool = s.data.latePool or {}
	local fresh = {}
	for _, id in pool do
		if not usedLate[id] then
			table.insert(fresh, id)
		end
	end
	local list = if #fresh > 0 then fresh else pool
	if #list == 0 then
		return nil
	end
	return list[s.rng:NextInteger(1, #list)]
end

local function recordFor(s, id: string)
	if id == "RandomLate" then
		local lateId = pickLateId(s)
		if not lateId then
			return normalRecord(s)
		end
		id = lateId
	end
	if id == "Normal" then
		return normalRecord(s)
	end
	local anomaly = Anomalies.ById[id]
	if anomaly then
		usedLate[id] = true
		return lateRecord(s, anomaly)
	end
	local regular = Regulars.ById[id]
	if regular then
		return regularRecord(s, regular)
	end
	warn("[Customers] unknown customer id " .. id)
	return normalRecord(s)
end

local function randomRecord(s)
	local roll = s.rng:NextNumber()
	if roll < (s.data.lateChance or 0.15) then
		return recordFor(s, "RandomLate")
	end
	if s.night >= 2 and roll < (s.data.lateChance or 0.15) + 0.06 then
		return recordFor(s, "KarenBot")
	end
	if s.night >= 4 and roll < (s.data.lateChance or 0.15) + 0.1 then
		return recordFor(s, "CastGuy")
	end
	return normalRecord(s)
end

---------------------------------------------------------------------------
-- Lane movement
---------------------------------------------------------------------------

-- opts.z: drive along a different line (pulling out of the lane); opts.linear: constant speed
local function moveCar(car, x: number, speedMultiplier: number, onArrive: (() -> ())?, opts: { z: number?, linear: boolean? }?)
	if car.tween then
		car.tween:Cancel()
		car.tween = nil
	end
	local root = car.root :: BasePart
	local z = if opts and opts.z then opts.z else Layout.LaneZ
	local target = CFrame.new(x, 0, z)
	local distance = (root.Position - target.Position).Magnitude
	if distance < 0.05 then
		if onArrive then
			task.defer(onArrive)
		end
		return
	end
	local duration = distance / (Config.CarSpeed * speedMultiplier)
	local style = if opts and opts.linear then Enum.EasingStyle.Linear else Enum.EasingStyle.Quad
	local tween = TweenService:Create(root, TweenInfo.new(duration, style, Enum.EasingDirection.Out), {
		CFrame = target, -- cars always face down the lane (+X)
	})
	car.tween = tween
	tween.Completed:Connect(function(state)
		if state == Enum.PlaybackState.Completed and car.tween == tween then
			car.tween = nil
			if onArrive then
				onArrive()
			end
		end
	end)
	tween:Play()
end

local function arrive(car, slotIndex: number)
	if car.state == "Leaving" then
		return
	end
	car.slot = slotIndex
	local now = os.clock()
	if slotIndex == Layout.SpeakerSlot and not car.ordered and not car.skipSpeaker then
		car.state = "AtSpeaker"
		car.speakerDeadline = now + Config.Patience.Speaker + car.patienceBonus
		ctx.sound("Ding", Layout.SpeakerPost)
		ctx.caption("[drive-thru bell: ding-dong]", Layout.SpeakerPost, 2)
		ctx.Bus:fire("CarAtSpeaker", car)
	elseif slotIndex == Layout.WindowSlot then
		car.state = "AtWindow"
		car.windowDeadline = now + Config.Patience.Window + car.patienceBonus
		ctx.Bus:fire("CarAtWindow", car)
	end
end

function Customers.updateQueue()
	local prev = 0
	for _, car in Customers.lane do
		local minSlot = prev + 1
		local desired
		if car.ordered or car.skipSpeaker then
			desired = minSlot
		else
			desired = math.max(minSlot, Layout.SpeakerSlot)
		end
		desired = math.min(desired, #Layout.Slots)
		if car.targetSlot ~= desired then
			car.targetSlot = desired
			if car.state == "AtSpeaker" and desired ~= Layout.SpeakerSlot then
				car.state = "Ordered"
			end
			moveCar(car, Layout.Slots[desired].x, 1, function()
				arrive(car, desired)
			end)
		end
		prev = desired
	end
end

---------------------------------------------------------------------------
-- Spawning
---------------------------------------------------------------------------

function Customers.canSpawn(): boolean
	if #Customers.lane >= Config.MaxCarsInLane then
		return false
	end
	local back = Customers.lane[#Customers.lane]
	if back and (back.targetSlot or #Layout.Slots) >= #Layout.Slots then
		return false
	end
	return true
end

function Customers.hasScripted(): boolean
	return #scripted > 0
end

function Customers.enqueueScripted(id: string)
	table.insert(scripted, id)
end

local function spawnRecord(car)
	local s = ctx.Shift.session
	local model = ModelFactory.buildCustomer({ person = car.person, car = car.carSpec, modifiers = car.modifiers })
	model.Name = "Car" .. car.id
	model:SetAttribute("CarId", car.id)
	model:SetAttribute("MirrorTell", car.mirrorTell or "None")
	model:SetAttribute("CustomerName", car.name or "")
	car.model = model
	car.root = model.PrimaryPart
	model:PivotTo(slotCFrame(Layout.LaneStartX))
	model.Parent = folder()
	Customers.cars[car.id] = car
	table.insert(Customers.lane, car)
	car.spawnedAt = os.clock()
	car.night = if s then s.night else 1
	Customers.updateQueue()
	return car
end

function Customers.spawnNext(scriptedOnly: boolean?): boolean
	local s = ctx.Shift.session
	if not s or s.phase ~= "Running" or not Customers.canSpawn() then
		return false
	end
	local car
	if #scripted > 0 then
		car = recordFor(s, table.remove(scripted, 1) :: string)
	elseif scriptedOnly then
		return false
	else
		car = randomRecord(s)
	end
	spawnRecord(car)
	return true
end

function Customers.spawnById(id: string)
	local s = ctx.Shift.session
	if not s then
		return nil
	end
	return spawnRecord(recordFor(s, id))
end

---------------------------------------------------------------------------
-- Leaving
---------------------------------------------------------------------------

function Customers.leave(car, speedMultiplier: number?)
	if car.state == "Leaving" then
		return
	end
	car.state = "Leaving"
	local index = table.find(Customers.lane, car)
	if index then
		table.remove(Customers.lane, index)
	end
	if ctx.Orders then
		ctx.Orders.closeTicketFor(car)
	end
	ctx.Bus:fire("CarLeaving", car)
	Customers.updateQueue()
	if not car.root or not car.root.Parent then
		Customers.cars[car.id] = nil
		return
	end
	local function gone()
		if car.model then
			car.model:Destroy()
		end
		Customers.cars[car.id] = nil
	end
	local speed = speedMultiplier or 1.6
	if index == 1 or not index then
		moveCar(car, Layout.LaneEndX, speed, gone, { linear = true })
	else
		-- not at the front: pull out of the lane first instead of driving through the queue
		local exitZ = Layout.LaneZ + 11
		moveCar(car, car.root.Position.X, speed, function()
			moveCar(car, Layout.LaneEndX, speed, gone, { z = exitZ, linear = true })
		end, { z = exitZ })
	end
end

function Customers.leaveAngry(car, where: string)
	local s = ctx.Shift.session
	if not s or car.state == "Leaving" then
		return
	end
	if car.isLate then
		s.stats.lateMissed += 1
		ctx.Shift.addWeird(Config.Weird.LateLeft)
		Customers.say(car, "...")
		ctx.caption("[a car drives off. Its headlights stay behind for a second.]", car.root.Position, 3)
	elseif car.kind ~= "Special" then
		s.stats.leftAngry += 1
		ctx.Shift.addStars(Config.Stars.LeftAngry, "Customer left")
		Customers.say(car, if where == "speaker" then "Hello?? Is anyone there?!" else "Forget it! I'm leaving!")
		ctx.notifyCrew(("A customer left angry (%s)."):format(if where == "speaker" then "nobody took the order" else "food took too long"), "bad")
	end
	Customers.leave(car)
end

---------------------------------------------------------------------------
-- Queries
---------------------------------------------------------------------------

function Customers.get(id: number)
	return Customers.cars[id]
end

function Customers.speakerCar()
	for _, car in Customers.lane do
		if car.state == "AtSpeaker" then
			return car
		end
	end
	return nil
end

function Customers.windowCar()
	local front = Customers.lane[1]
	if front and front.state == "AtWindow" then
		return front
	end
	return nil
end

function Customers.snapshot()
	local out = {}
	for _, car in Customers.lane do
		table.insert(out, {
			id = car.id,
			slot = car.slot,
			state = car.state,
			ticket = if car.ticket then car.ticket.number else nil,
		})
	end
	return out
end

-- Cars ordered front-to-back (used for bagging priority).
function Customers.position(car): number
	return table.find(Customers.lane, car) or 999
end

---------------------------------------------------------------------------
-- Lifecycle
---------------------------------------------------------------------------

function Customers.reset()
	Customers.cleanup()
	table.clear(scripted)
	table.clear(usedLate)
end

function Customers.stop()
	table.clear(scripted)
	for _, car in table.clone(Customers.lane) do
		Customers.leave(car, 2.2)
	end
end

function Customers.cleanup()
	for _, car in Customers.cars do
		if car.tween then
			car.tween:Cancel()
		end
		if car.model then
			car.model:Destroy()
		end
	end
	table.clear(Customers.cars)
	table.clear(Customers.lane)
	if carsFolder then
		carsFolder:ClearAllChildren()
	end
end

function Customers.init()
	task.spawn(function()
		while true do
			task.wait(0.5)
			local s = ctx.Shift.session
			if s and s.phase == "Running" then
				local now = os.clock()
				for _, car in table.clone(Customers.lane) do
					if car.state == "AtSpeaker" and not ctx.Orders.activeTaker(car) and car.speakerDeadline and now > car.speakerDeadline then
						Customers.leaveAngry(car, "speaker")
					elseif car.state == "AtWindow" and not car.decided and car.windowDeadline and now > car.windowDeadline then
						if ctx.Window.inspecting(car) and now < car.windowDeadline + 20 then
							continue -- someone is looking right at them; give a little grace
						end
						Customers.leaveAngry(car, "window")
					end
				end
			end
		end
	end)
end

return Customers
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Debug</string>
            <string name="Source"><![CDATA[-- Studio-only debug commands (the client shows a small DEBUG panel in Studio).
-- Ignored entirely in a live game.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local ctx = require(script.Parent.Context)

local Debug = {}

local commands: { [string]: (Player, any) -> () } = {
	skip = function()
		ctx.Shift.debugSkip(60)
	end,
	rush = function()
		ctx.Scares.forceStart("RushHour")
	end,
	beams = function()
		ctx.Scares.forceStart("HighBeams")
	end,
	lightsout = function()
		ctx.Scares.forceStart("LightsOutSafe")
	end,
	late = function(_, arg)
		ctx.Customers.spawnById(if type(arg) == "string" and arg ~= "" then arg else "RandomLate")
	end,
	normal = function()
		ctx.Customers.spawnById("Normal")
	end,
	weird = function()
		ctx.Shift.addWeird(100)
	end,
	starsUp = function()
		ctx.Shift.addStars(1, "Debug")
	end,
	starsDown = function()
		ctx.Shift.addStars(-1, "Debug")
	end,
	win = function()
		ctx.Shift.debugSkip(Config.NightEndMinute)
	end,
	fail = function()
		ctx.Shift.fail("CorporateCalled")
	end,
	boop = function(player)
		ctx.Ghosts.boop(player, "Munch")
	end,
	unlock = function(player)
		ctx.PlayerData.unlockNight(player, 5)
	end,
	pay = function(player)
		ctx.PlayerData.addPaychecks(player, 500)
	end,
	reveal = function()
		ctx.Story.beat("Reveal")
	end,
	uv = function()
		ctx.Story.giveUV()
	end,
	event = function(_, arg)
		if type(arg) == "string" then
			ctx.WeirdEvents.trigger(arg, nil)
		end
	end,
	start = function(player, arg)
		if ctx.Shift.session then
			ctx.Shift.endSession()
			task.wait(0.5)
		end
		ctx.Shift.start({ players = { player }, night = tonumber(arg) or 1, leaderUserId = player.UserId, mode = "InPlace" })
	end,
	endShift = function()
		ctx.Shift.endSession()
	end,
}

function Debug.init()
	ctx.onAction("Debug", function(player, data)
		if not RunService:IsStudio() or not Config.DebugPanelInStudio then
			return
		end
		local command = commands[tostring(data.cmd)]
		if command then
			print(("[Debug] %s ran %s %s"):format(player.Name, tostring(data.cmd), tostring(data.arg or "")))
			command(player, data.arg)
		end
	end)
end

return Debug
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Ghosts</string>
            <string name="Source"><![CDATA[-- Getting booped -> Shift Ghost (design doc §7.4). A booped crew member floats around as a cute
-- sheet ghost with a visible respawn timer, can Ghost Point and Boo!, and can't touch anything.
-- Respawn can never be bought or skipped. If the whole crew is ghosts at once: "Ghost Town".

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Cosmetics = require(Shared.Data.Cosmetics)
local Layout = require(Shared.Builders.Layout)
local ModelFactory = require(Shared.Builders.ModelFactory)
local Util = require(Shared.Util)
local ctx = require(script.Parent.Context)

local Ghosts = {}

local pointCooldown: { [Player]: number } = {}
local booCooldown: { [Player]: number } = {}

function Ghosts.respawnSeconds(night: number): number
	local design = Config.GhostRespawnDesign[night] or 90
	return math.max(Config.MinGhostRespawn, design * Config.TimeScale)
end

local function makeGhost(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not character or not humanoid or not root or not player:GetAttribute("Ghost") then
		return
	end
	humanoid.PlatformStand = false
	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") then
			d.Transparency = 1
			d.CollisionGroup = "Ghosts"
		elseif d:IsA("Decal") then
			d.Transparency = 1
		elseif d:IsA("SurfaceGui") then
			d.Enabled = false
		end
	end
	local profile = ctx.PlayerData.get(player)
	local equipped = profile and profile.equipped or {}
	local skin = Cosmetics.ById[equipped.Ghost or ""] or Cosmetics.ById.ghost_white
	local hat = Cosmetics.ById[equipped.Hat or ""] or Cosmetics.ById.hat_visor_red
	local sheet = ModelFactory.buildGhostSheet(skin.color, hat.color, player.DisplayName)
	local sheetRoot = sheet.PrimaryPart :: BasePart
	for _, d in sheet:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = "Ghosts"
			d.Massless = true
		end
	end
	sheet:PivotTo(root.CFrame * CFrame.new(0, 0.3, 0))
	sheetRoot.Anchored = false
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = sheetRoot
	weld.Parent = sheetRoot
	if equipped.Trail == "trail_sparkle" then
		local sparkle = Instance.new("ParticleEmitter")
		sparkle.Rate = 15
		sparkle.Lifetime = NumberRange.new(0.6, 1)
		sparkle.Speed = NumberRange.new(0.5, 1.5)
		sparkle.Size = NumberSequence.new(0.25)
		sparkle.LightEmission = 1
		sparkle.Color = ColorSequence.new(Color3.fromRGB(255, 240, 150))
		sparkle.Parent = sheetRoot
	end
	sheet.Parent = character
	humanoid.HipHeight += 1.2
	humanoid.JumpPower = 0
	local gui = Instance.new("BillboardGui")
	gui.Name = "GhostTimer"
	gui.Size = UDim2.fromOffset(150, 40)
	gui.StudsOffset = Vector3.new(0, 4.2, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 120
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = Color3.fromRGB(40, 40, 70)
	label.BackgroundTransparency = 0.2
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = "BACK IN --"
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = label
	label.Parent = gui
	gui.Parent = root
	character:PivotTo(root.CFrame + Vector3.new(0, 1.5, 0))
end

function Ghosts.boop(player: Player, source: string)
	local s = ctx.Shift.session
	local member = ctx.Shift.member(player)
	if not s or not member or member.ghost or s.phase ~= "Running" then
		return
	end
	if player:GetAttribute("Hidden") then
		ctx.Hiding.leave(player, "boop")
	end
	ctx.Stations.dropHeld(player)
	ctx.Stations.forgetViewer(player)
	ctx.Orders.releaseTaker(player)
	ctx.Characters.setCrouch(player, false)
	local seconds = Ghosts.respawnSeconds(s.night)
	member.ghost = true
	member.boops += 1
	member.respawnAt = os.clock() + 1.2 + seconds
	player:SetAttribute("Ghost", true)
	player:SetAttribute("RespawnAt", workspace:GetServerTimeNow() + 1.2 + seconds)
	ctx.PlayerData.addStat(player, "boops", 1)
	if source == "Munch" then
		ctx.Badges.award(player, "booped")
	elseif source == "HighBeams" then
		ctx.Badges.award(player, "deer")
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local pos = if root then root.Position else Layout.RespawnPoint
	ctx.effect("Booped", { source = source, seconds = seconds }, { player })
	ctx.effect("CrewBooped", { name = player.DisplayName, userId = player.UserId, source = source, pos = pos })
	ctx.Shift.moment(("%s got booped by %s at %s."):format(player.DisplayName, if source == "Munch" then "Mr. Munch" else "the High Beams", Util.formatClock(s.minutes)), 60)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.PlatformStand = true
	end
	task.delay(1.2, makeGhost, player)
	ctx.Bus:fire("Booped", player, source)
	-- Ghost Town only applies to a real crew; solo, Gizmo keeps the lights on while you're a ghost.
	if #ctx.Shift.activeMembers() > 1 and #ctx.Shift.livingMembers() == 0 then
		task.delay(1.5, function()
			if ctx.Shift.session == s and #ctx.Shift.activeMembers() > 1 and #ctx.Shift.livingMembers() == 0 then
				ctx.Shift.fail("GhostTown")
			end
		end)
	end
end

function Ghosts.respawn(member)
	local player = member.player
	member.ghost = false
	member.respawnAt = nil
	member.respawning = true
	player:SetAttribute("Ghost", false)
	player:SetAttribute("RespawnAt", nil)
	ctx.Characters.respawn(player)
	ctx.sound("KaChunk", Layout.Stations.TimeClock)
	ctx.caption(("[ka-chunk — %s clocked back in]"):format(player.DisplayName), Layout.Stations.TimeClock, 3)
	ctx.Bus:fire("Respawned", player)
end

-- Bring every ghost back (end of night). With skipRespawn the caller reloads characters itself.
function Ghosts.stop(_session: any?, skipRespawn: boolean?)
	for _, member in ctx.Shift.activeMembers() do
		if member.ghost then
			if skipRespawn then
				member.ghost = false
				member.respawnAt = nil
				member.player:SetAttribute("Ghost", false)
				member.player:SetAttribute("RespawnAt", nil)
			else
				Ghosts.respawn(member)
			end
		end
	end
end

function Ghosts.reset()
	table.clear(pointCooldown)
	table.clear(booCooldown)
end

local function isGhost(player: Player): boolean
	local member = ctx.Shift.member(player)
	return member ~= nil and member.ghost
end

function Ghosts.init()
	ctx.onAction("GhostPoint", function(player, data)
		if not isGhost(player) then
			return
		end
		local now = os.clock()
		if (pointCooldown[player] or 0) > now then
			return
		end
		local pos = data.position
		if typeof(pos) ~= "Vector3" then
			return
		end
		if pos.X < Layout.PlayPlace.minX - 5 or pos.X > Layout.Building.maxX + 30 or pos.Z < Layout.Building.minZ - 5 or pos.Z > Layout.LaneZ + 15 then
			return
		end
		pointCooldown[player] = now + Config.Ghost.PointCooldown
		for _, p in ctx.Shift.crewPlayers() do
			ctx.Remotes.Ping:FireClient(p, { position = pos, name = player.DisplayName, ghost = true, duration = Config.Ghost.PointDuration })
		end
		ctx.Badges.award(player, "ghost_point")
	end)
	ctx.onAction("GhostBoo", function(player)
		if not isGhost(player) then
			return
		end
		local now = os.clock()
		if (booCooldown[player] or 0) > now then
			return
		end
		booCooldown[player] = now + Config.Ghost.BooCooldown
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root then
			return
		end
		ctx.effect("Boo", { pos = root.Position, name = player.DisplayName })
		ctx.Badges.award(player, "ghost_boo")
		if ctx.Gizmo.spook(root.Position) then
			ctx.Badges.award(player, "spook_gizmo")
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		pointCooldown[player] = nil
		booCooldown[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(0.25)
			local s = ctx.Shift.session
			if s and s.phase == "Running" then
				local now = os.clock()
				for _, member in ctx.Shift.activeMembers() do
					if member.ghost and member.respawnAt then
						local character = member.player.Character
						local root = character and character:FindFirstChild("HumanoidRootPart")
						local gui = root and root:FindFirstChild("GhostTimer")
						local label = gui and gui:FindFirstChild("Label") :: TextLabel?
						if label then
							label.Text = "BACK IN " .. Util.formatSeconds(member.respawnAt - now)
						end
						if now >= member.respawnAt then
							Ghosts.respawn(member)
						end
					end
				end
			end
		end
	end)
end

return Ghosts
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Gizmo</string>
            <string name="Source"><![CDATA[-- Gizmo, the Fry-Bot 3000 (design doc §4.1): fills empty stations. Solo it covers the fryer and
-- drinks at ~60%; in co-op it covers the Fry station if nobody has it, and any booped teammate's
-- station at ~30%. Hides badly (behind a napkin), always gets booped, narrates its failures.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Layout = require(Shared.Builders.Layout)
local ModelFactory = require(Shared.Builders.ModelFactory)
local Menu = require(Shared.Data.Menu)
local OrderLogic = require(Shared.OrderLogic)
local ctx = require(script.Parent.Context)

local Gizmo = {}
Gizmo.boops = 0

local model: Model? = nil
local root: BasePart? = nil
local ghostModel: Model? = nil
local state: string = "Off" -- Off | Idle | Working | Hiding | Ghost
local ghostUntil = 0
local carried: Model? = nil
local covering = { fry = nil :: number?, grill = nil :: number?, order = nil :: number? }
local generation = 0

local FAILS = {
	"FRY ERROR. I HAVE MADE A SOUP.",
	"OOPS. I BAGGED MY OWN HAND.",
	"ERROR 404: FRIES NOT FOUND.",
	"I DROPPED IT. IT IS THE FLOOR'S NOW.",
}

local function say(text: string, face: string?)
	if not root then
		return
	end
	local old = root:FindFirstChild("Bubble")
	if old then
		old:Destroy()
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "Bubble"
	gui.Size = UDim2.fromOffset(220, 56)
	gui.StudsOffset = Vector3.new(0, 6, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 70
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = Color3.fromRGB(20, 30, 30)
	label.TextColor3 = Color3.fromRGB(80, 255, 140)
	label.Font = Enum.Font.Arcade
	label.TextScaled = true
	label.TextWrapped = true
	label.Text = text
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = label
	label.Parent = gui
	gui.Parent = root
	task.delay(3.5, function()
		if gui.Parent then
			gui:Destroy()
		end
	end)
	if face and model then
		local screen = model:FindFirstChild("Screen")
		local screenGui = screen and screen:FindFirstChild("ScreenGui")
		local faceLabel = screenGui and screenGui:FindFirstChild("Label") :: TextLabel?
		if faceLabel then
			faceLabel.Text = face
		end
	end
end
Gizmo.say = say

local function setVisible(visible: boolean)
	if not model then
		return
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "Root" then
			d.Transparency = if visible then 0 else 1
		elseif d:IsA("SurfaceGui") then
			d.Enabled = visible
		end
	end
end

local function moveTo(target: Vector3, gen: number): boolean
	if not root then
		return false
	end
	local from = root.Position
	local goal = Vector3.new(target.X, Layout.Floor, target.Z)
	local distance = (goal - from).Magnitude
	if distance < 0.3 then
		return true
	end
	local facing = goal + (goal - from).Unit
	local tween = TweenService:Create(root, TweenInfo.new(distance / Config.Gizmo.MoveSpeed, Enum.EasingStyle.Linear), {
		CFrame = CFrame.lookAt(goal, Vector3.new(facing.X, Layout.Floor, facing.Z)),
	})
	tween:Play()
	while tween.PlaybackState == Enum.PlaybackState.Playing do
		task.wait(0.05)
		if generation ~= gen or state ~= "Working" then
			tween:Cancel()
			return false
		end
	end
	return true
end

local function faceKitchenFront()
	if root then
		local p = root.Position
		root.CFrame = CFrame.lookAt(p, p + Vector3.new(0, 0, 1))
	end
end

local function work(seconds: number, efficiency: number, gen: number): boolean
	local finish = os.clock() + seconds / math.max(0.1, efficiency)
	while os.clock() < finish do
		task.wait(0.1)
		if generation ~= gen or state ~= "Working" then
			return false
		end
	end
	return true
end

local function carry(kind: string?, data: any?)
	if carried then
		carried:Destroy()
		carried = nil
	end
	if kind and root then
		local item = ModelFactory.buildItem(kind, data)
		item:PivotTo(root.CFrame * CFrame.new(1.4, 2.2, -1.2))
		local itemRoot = item.PrimaryPart :: BasePart
		itemRoot.Anchored = false
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = itemRoot
		weld.Parent = itemRoot
		item.Parent = model
		carried = item
	end
end

local function front(pos: Vector3): Vector3
	return Vector3.new(pos.X, Layout.Floor, 4.6)
end

local function mistake(): boolean
	if math.random() < Config.Gizmo.MistakeChance then
		say(FAILS[math.random(1, #FAILS)], "X_X")
		carry(nil)
		return true
	end
	return false
end

-- Count unmet ticket lines by item kind.
local function needed()
	local counts = { Fries = 0, Drink = 0, Shake = 0, Burger = 0 }
	local burgerLines = {}
	for _, entry in ctx.Orders.neededLines() do
		local kind = OrderLogic.kindOf(entry.line.item)
		counts[kind] = (counts[kind] or 0) + 1
		if kind == "Burger" then
			table.insert(burgerLines, entry)
		end
	end
	return counts, burgerLines
end

local function bagItem(item, gen: number, efficiency: number): boolean
	if not moveTo(front(Layout.Stations.BagCounter), gen) then
		return false
	end
	if not work(0.6, efficiency, gen) then
		return false
	end
	local ticket = ctx.Orders.findTicketFor(item)
	carry(nil)
	if ticket then
		ctx.Orders.addToBag(ticket, item, "Gizmo")
		return true
	end
	say("NOBODY WANTS THIS. I WILL KEEP IT IN MY HEART.", ":|")
	return false
end

---------------------------------------------------------------------------
-- Jobs
---------------------------------------------------------------------------

local function fryJob(eff: number, gen: number): boolean
	local counts = needed()
	for i, pos in Layout.Stations.Fryers do
		local fs = ctx.Stations.fryerState(i)
		if fs == "Fire" then
			if moveTo(front(pos), gen) and work(2, eff, gen) then
				ctx.Stations.fryerExtinguish(i, "Gizmo")
				say("FIRE EXTINGUISHED. I AM A HERO.", ":D")
			end
			return true
		elseif fs == "Done" or fs == "Burnt" then
			if moveTo(front(pos), gen) and work(0.8, eff, gen) then
				if ctx.Stations.fryerState(i) == "Burnt" then
					say("THESE FRIES ARE... CRISPY.", ":S")
				end
				ctx.Stations.fryerPull(i, "Gizmo")
			end
			return true
		end
	end
	if counts.Fries > 0 and ctx.Stations.fryPortions() > 0 then
		if moveTo(front(Layout.Stations.FryBin), gen) and work(0.8, eff, gen) then
			local item = ctx.Stations.scoopFries()
			if item then
				carry("Fries")
				if not mistake() then
					bagItem(item, gen, eff)
				end
			end
		end
		return true
	end
	local cooking = 0
	for i in Layout.Stations.Fryers do
		if ctx.Stations.fryerState(i) == "Cooking" then
			cooking += 1
		end
	end
	if counts.Fries > ctx.Stations.fryPortions() + cooking * Config.Cook.FryPortions then
		for i, pos in Layout.Stations.Fryers do
			if ctx.Stations.fryerState(i) == "Empty" then
				if moveTo(front(pos), gen) and work(0.6, eff, gen) then
					ctx.Stations.fryerDrop(i, "Gizmo")
				end
				return true
			end
		end
	end
	for _, kind in { "Drink", "Shake" } do
		if counts[kind] > 0 then
			local pos = if kind == "Drink" then Layout.Stations.SodaFountain else Layout.Stations.ShakeMachine
			local seconds = if kind == "Shake" then Config.Cook.ShakeFillSeconds else Config.Cook.DrinkFillSeconds
			if moveTo(front(pos), gen) and work(seconds, eff, gen) then
				carry(kind)
				if not mistake() then
					bagItem(ctx.Stations.instantPour(kind), gen, eff)
				end
			end
			return true
		end
	end
	return false
end

local TOPPING_OPS = { BunBottom = "Bun", BunTop = "Bun", Patty = "Patty", Cheese = "Cheese", Lettuce = "Lettuce", Pickles = "Pickles", Sauce = "Sauce" }

local function grillJob(eff: number, gen: number): boolean
	local _, burgerLines = needed()
	local grillState = ctx.Stations.grillSummary()
	if grillState.Flip > 0 then
		if moveTo(front(Layout.Stations.Grill), gen) and work(0.5, eff, gen) then
			ctx.Stations.grillFlipAny("Gizmo")
		end
		return true
	end
	if grillState.Burnt > 0 then
		if moveTo(front(Layout.Stations.Grill), gen) and work(0.8, eff, gen) then
			ctx.Stations.grillScrapeAny()
		end
		return true
	end
	if #burgerLines == 0 then
		return false
	end
	local pattiesNeeded = 0
	for _, entry in burgerLines do
		for _, layer in OrderLogic.buildStack(entry.line.item, entry.line.mods) do
			if layer == "Patty" then
				pattiesNeeded += 1
			end
		end
	end
	local cookingPatties = grillState.SideA + grillState.SideB + grillState.Flip
	if grillState.Done == 0 and cookingPatties < math.min(pattiesNeeded, 2) and grillState.Empty > 0 then
		if moveTo(front(Layout.Stations.Grill), gen) and work(0.5, eff, gen) then
			ctx.Stations.grillPlace("Gizmo")
		end
		return true
	end
	-- assemble the first burger that needs making (only on an empty plate)
	if #ctx.Stations.plateStack() > 0 or grillState.Done == 0 then
		return false
	end
	local entry = burgerLines[1]
	local stack = OrderLogic.buildStack(entry.line.item, entry.line.mods)
	local pattyCount = 0
	for _, layer in stack do
		if layer == "Patty" then
			pattyCount += 1
		end
	end
	if grillState.Done < pattyCount then
		return false
	end
	if not moveTo(front(Layout.Stations.Grill), gen) or not work(0.5, eff, gen) then
		return true
	end
	for _ = 1, pattyCount do
		ctx.Stations.grillTakeAny("Gizmo")
	end
	carry("Patty")
	if not moveTo(front(Layout.Stations.AssemblyPlate), gen) then
		return true
	end
	carry(nil)
	for _, layer in stack do
		if not work(0.45, eff, gen) then
			return true
		end
		ctx.Stations.plateAdd(TOPPING_OPS[layer], "Gizmo")
	end
	local item = ctx.Stations.plateTake()
	if item then
		carry("Burger", { stack = item.stack, toppings = Menu.Toppings })
		if not mistake() then
			bagItem(item, gen, eff)
		end
	end
	return true
end

local function orderJob(eff: number, gen: number): boolean
	local car = ctx.Customers.speakerCar()
	if not car or ctx.Orders.activeTaker(car) then
		return false
	end
	if not moveTo(front(Layout.Stations.OrderConsole), gen) or not work(3, eff, gen) then
		return true
	end
	car = ctx.Customers.speakerCar()
	if not car or ctx.Orders.activeTaker(car) then
		return true
	end
	local lines = table.clone(car.order or {})
	if #lines > 0 and math.random() < Config.Gizmo.MistakeChance * 2 then
		lines[math.random(1, #lines)] = { item = Menu.Order[math.random(1, #Menu.Order)], mods = {} }
		say("ORDER TAKEN. PROBABLY.", ":)")
	else
		say("ORDER TAKEN. BEEP.", ":)")
	end
	ctx.Orders.createTicket(car, lines, false, nil)
	return true
end

local function updateCoverage()
	local members = ctx.Shift.activeMembers()
	covering.fry, covering.grill, covering.order = nil, nil, nil
	if #members <= 1 then
		covering.fry = Config.Gizmo.SoloEfficiency
	else
		local fryHolder = ctx.Shift.roleHolder("Fry")
		if not fryHolder then
			covering.fry = Config.Gizmo.SoloEfficiency
		elseif fryHolder.ghost then
			covering.fry = Config.Gizmo.CoverEfficiency
		end
	end
	local grillHolder = ctx.Shift.roleHolder("Grill")
	if grillHolder and grillHolder.ghost then
		covering.grill = Config.Gizmo.CoverEfficiency
	end
	local orderHolder = ctx.Shift.roleHolder("Order")
	if orderHolder and orderHolder.ghost then
		covering.order = Config.Gizmo.CoverEfficiency
	end
end

local function brain(gen: number)
	while generation == gen do
		task.wait(0.3)
		if not ctx.Shift.isRunning() then
			continue
		end
		local now = os.clock()
		if state == "Ghost" and now >= ghostUntil then
			if ghostModel then
				ghostModel:Destroy()
				ghostModel = nil
			end
			setVisible(true)
			if root then
				root.CFrame = CFrame.new(Layout.GizmoHome)
			end
			state = "Idle"
			say("REBOOTED. I AM FINE. EVERYTHING IS FINE.", ":)")
		end
		if state ~= "Idle" or ctx.Scares.active() then
			continue
		end
		updateCoverage()
		state = "Working"
		local did = false
		local ok, err = pcall(function()
			if covering.order then
				did = orderJob(covering.order, gen)
			end
			if not did and covering.fry then
				did = fryJob(covering.fry, gen)
			end
			if not did and covering.grill then
				did = grillJob(covering.grill, gen)
			end
		end)
		if not ok then
			warn("[Gizmo] " .. tostring(err))
		end
		if Gizmo.state() == "Working" then
			state = "Idle"
			carry(nil)
			if not did and root and (root.Position - Layout.GizmoHome).Magnitude > 2 then
				state = "Working"
				moveTo(Layout.GizmoHome, gen)
				if Gizmo.state() == "Working" then
					state = "Idle"
				end
				faceKitchenFront()
			end
		end
	end
end

---------------------------------------------------------------------------
-- Scares
---------------------------------------------------------------------------

function Gizmo.isHidingNear(pos: Vector3, range: number): boolean
	return state == "Hiding" and root ~= nil and (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(pos.X, 0, pos.Z)).Magnitude < range
end

function Gizmo.boop(_source: string)
	if state == "Ghost" or state == "Off" or not root then
		return
	end
	state = "Ghost"
	carry(nil)
	Gizmo.boops += 1
	local s = ctx.Shift.session
	ghostUntil = os.clock() + ctx.Ghosts.respawnSeconds(if s then s.night else 3)
	local pos = root.Position
	say("GIZMO.EXE HAS STOPPED WORKING", "X_X")
	setVisible(false)
	ctx.caption("[sad beeping — Gizmo got booped]", pos, 3)
	local ghost = ModelFactory.buildGizmoGhost()
	ghost:PivotTo(CFrame.new(pos))
	ghost.Parent = ctx.map.Dynamic
	ghostModel = ghost
	local ghostRoot = ghost.PrimaryPart :: BasePart
	TweenService:Create(ghostRoot, TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
		CFrame = CFrame.new(pos + Vector3.new(0, 1.2, 0)),
	}):Play()
end

function Gizmo.spook(pos: Vector3): boolean
	if not root or state == "Ghost" or state == "Off" then
		return false
	end
	if (root.Position - pos).Magnitude > 14 then
		return false
	end
	say("EEP!", ":O")
	if carried then
		carry(nil)
		say("EEP! I DROPPED A FRY. A GHOST DID IT.", ":O")
	end
	local start = root.CFrame
	local up = TweenService:Create(root, TweenInfo.new(0.15), { CFrame = start + Vector3.new(0, 1.5, 0) })
	up:Play()
	up.Completed:Connect(function()
		if root then
			TweenService:Create(root, TweenInfo.new(0.2), { CFrame = start }):Play()
		end
	end)
	return true
end

function Gizmo.state(): string
	return state
end

function Gizmo.snapshot()
	return {
		state = state,
		fry = covering.fry ~= nil,
		grill = covering.grill ~= nil,
		order = covering.order ~= nil,
	}
end

---------------------------------------------------------------------------
-- Lifecycle
---------------------------------------------------------------------------

function Gizmo.cleanup()
	generation += 1
	state = "Off"
	carry(nil)
	if model then
		model:Destroy()
		model = nil
		root = nil
	end
	if ghostModel then
		ghostModel:Destroy()
		ghostModel = nil
	end
end

function Gizmo.reset()
	Gizmo.cleanup()
	Gizmo.boops = 0
	local built = ModelFactory.buildGizmo()
	built:PivotTo(CFrame.lookAt(Layout.GizmoHome, Layout.GizmoHome + Vector3.new(0, 0, 1)))
	built.Parent = ctx.map.Dynamic
	model = built
	root = built.PrimaryPart
	state = "Idle"
	generation += 1
	task.spawn(brain, generation)
end

function Gizmo.stop()
	if state == "Off" then
		return
	end
	carry(nil)
	if ghostModel then
		ghostModel:Destroy()
		ghostModel = nil
	end
	setVisible(true)
	if root then
		root.CFrame = CFrame.lookAt(Layout.GizmoHome, Layout.GizmoHome + Vector3.new(0, 0, 1))
	end
	state = "Idle"
end

function Gizmo.init()
	ctx.Bus:on("ScareWarning", function(kind)
		if state == "Ghost" or state == "Off" then
			return
		end
		state = "Hiding"
		carry(nil)
		if root then
			local spot = Layout.GizmoNapkin
			TweenService:Create(root, TweenInfo.new(1), { CFrame = CFrame.lookAt(spot, spot + Vector3.new(0, 0, 1)) }):Play()
		end
		say(if kind == "LightsOutSafe" then "HIDING. I AM A NAPKIN." else "HIDING BEHIND THIS NAPKIN. I AM INVISIBLE.", ":|")
	end)
	ctx.Bus:on("ScareEnded", function(kind)
		if state == "Hiding" then
			if kind ~= "LightsOutSafe" then
				Gizmo.boop(kind)
			else
				state = "Idle"
				say("THE NAPKIN WORKED.", ":D")
			end
		end
	end)
	ctx.Bus:on("WeirdEvent", function(id)
		if id == "Raccoons" then
			say("RACCOONS. MY NATURAL ENEMY.", ">:(")
		end
	end)
	ctx.Bus:on("CarAtSpeaker", function(car)
		if car.regularId == "KarenBot" then
			say("...SHE'S HERE. ACT NATURAL. ACT NATURAL.", "<3")
		end
	end)
end

return Gizmo
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Hiding</string>
            <string name="Source"><![CDATA[-- Hiding spots (design doc §5.3–5.4): capacity per spot, a peephole view, anti-camping (spots get
-- cold / smelly / loud and pop you out), and Night 4+ "hold your breath" when Mr. Munch knocks.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Layout = require(Shared.Builders.Layout)
local ctx = require(script.Parent.Context)

local Hiding = {}

local occupants: { [string]: { Player } } = {}
local hidden: { [Player]: { spot: string, since: number, warned: boolean, saved: { [Instance]: number } } } = {}
local cooldowns: { [Player]: { spot: string, untilTime: number } } = {}
local breath: { [Player]: boolean? } = {}
local prompts: { [string]: ProximityPrompt } = {}

function Hiding.spotOf(player: Player): string?
	local h = hidden[player]
	return h and h.spot
end

function Hiding.occupants(spotId: string): { Player }
	return occupants[spotId] or {}
end

local function refreshPrompt(spotId: string)
	local prompt = prompts[spotId]
	local spot = Layout.HidingSpots[spotId]
	if prompt then
		local n = #(occupants[spotId] or {})
		prompt.ActionText = ("Hide (%d/%d)"):format(n, spot.capacity)
		prompt.Enabled = n < spot.capacity
	end
end

local function setCharacterHidden(player: Player, on: boolean, saved: { [Instance]: number })
	local character = player.Character
	if not character then
		return
	end
	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") or d:IsA("Decal") then
			if on then
				saved[d] = d.Transparency
				d.Transparency = 1
			elseif saved[d] ~= nil then
				d.Transparency = saved[d]
			end
		elseif d:IsA("SurfaceGui") or d:IsA("BillboardGui") then
			d.Enabled = not on
		end
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		root.Anchored = on
	end
end

function Hiding.hide(player: Player, spotId: string): boolean
	local spot = Layout.HidingSpots[spotId]
	if not spot or hidden[player] then
		return false
	end
	if not ctx.Shift.canAct(player) then
		return false
	end
	local list = occupants[spotId] or {}
	occupants[spotId] = list
	if #list >= spot.capacity then
		ctx.notify(player, spot.label .. " is full!")
		return false
	end
	local cd = cooldowns[player]
	if cd and cd.spot == spotId and os.clock() < cd.untilTime then
		ctx.notify(player, "You just got out of there. Find another spot!")
		return false
	end
	ctx.Stations.dropHeld(player)
	ctx.Stations.forgetViewer(player)
	ctx.Orders.releaseTaker(player)
	ctx.Characters.setCrouch(player, false)
	local record = { spot = spotId, since = os.clock(), warned = false, saved = {} }
	hidden[player] = record
	table.insert(list, player)
	setCharacterHidden(player, true, record.saved)
	ctx.Characters.moveTo(player, CFrame.new(spot.inside))
	player:SetAttribute("Hidden", spotId)
	local member = ctx.Shift.member(player)
	if member then
		member.hid = true
	end
	refreshPrompt(spotId)
	ctx.notify(player, spot.message or "Hidden.")
	ctx.Bus:fire("Hid", player, spotId)
	return true
end

function Hiding.leave(player: Player, reason: string?)
	local record = hidden[player]
	if not record then
		return
	end
	hidden[player] = nil
	local spot = Layout.HidingSpots[record.spot]
	local list = occupants[record.spot]
	if list then
		local index = table.find(list, player)
		if index then
			table.remove(list, index)
		end
	end
	setCharacterHidden(player, false, record.saved)
	local outward = Vector3.new(spot.peekTo.X - spot.prompt.X, 0, spot.peekTo.Z - spot.prompt.Z)
	local exit = Vector3.new(spot.prompt.X, Layout.Floor + 3, spot.prompt.Z) + (if outward.Magnitude > 0 then outward.Unit * 3 else Vector3.zero)
	ctx.Characters.moveTo(player, CFrame.lookAt(exit, exit + (if outward.Magnitude > 0 then outward.Unit else Vector3.new(0, 0, 1))))
	player:SetAttribute("Hidden", nil)
	cooldowns[player] = { spot = record.spot, untilTime = os.clock() + Config.Hide.RehideCooldown }
	refreshPrompt(record.spot)
	ctx.closePanel(player, "HoldBreath")
	if reason == "camp" then
		ctx.notify(player, ("You got popped out of the %s!"):format(spot.label), "bad")
		ctx.caption(("[%s tumbles out of the %s]"):format(player.DisplayName, spot.label), spot.prompt, 2)
	end
	ctx.Bus:fire("Unhid", player, record.spot)
end

function Hiding.forget(player: Player)
	local record = hidden[player]
	if record then
		local list = occupants[record.spot]
		if list then
			local index = table.find(list, player)
			if index then
				table.remove(list, index)
			end
		end
		refreshPrompt(record.spot)
	end
	hidden[player] = nil
	cooldowns[player] = nil
	breath[player] = nil
end

-- Mr. Munch knocks: everyone inside plays the hold-your-breath minigame. Returns who failed.
function Hiding.knock(spotId: string): { Player }
	local inside = table.clone(occupants[spotId] or {})
	if #inside == 0 then
		return {}
	end
	local spot = Layout.HidingSpots[spotId]
	ctx.sound("Knock", spot.prompt)
	ctx.caption("[KNOCK. KNOCK.]", spot.prompt, 2)
	for _, p in inside do
		breath[p] = nil
		ctx.openPanel(p, "HoldBreath", { seconds = Config.Hide.HoldBreathWindow, hits = Config.Hide.HoldBreathHits })
	end
	local started = os.clock()
	local deadline = started + Config.Hide.HoldBreathWindow + 1
	while os.clock() < deadline do
		local waiting = false
		for _, p in inside do
			if breath[p] == nil and hidden[p] then
				waiting = true
			end
		end
		if not waiting then
			break
		end
		task.wait(0.1)
	end
	-- Mr. Munch stood still while knocking; don't let that count toward anti-camping
	local paused = os.clock() - started
	for _, record in hidden do
		record.since += paused
	end
	local failed = {}
	for _, p in inside do
		if hidden[p] and hidden[p].spot == spotId then
			if breath[p] == true then
				ctx.Badges.award(p, "held_breath")
				ctx.notify(p, "...He moved on.", "good")
			else
				table.insert(failed, p)
			end
		end
		ctx.closePanel(p, "HoldBreath")
		breath[p] = nil
	end
	return failed
end

function Hiding.stop()
	for player in table.clone(hidden) do
		Hiding.leave(player, "stop")
	end
end

function Hiding.reset()
	Hiding.stop()
	table.clear(cooldowns)
	for spotId in Layout.HidingSpots do
		occupants[spotId] = {}
		refreshPrompt(spotId)
	end
end

function Hiding.init()
	local folder = ctx.map.HidingSpots
	for spotId, spot in Layout.HidingSpots do
		occupants[spotId] = {}
		local part = folder:FindFirstChild(spotId)
		if part then
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "HidePrompt"
			prompt.ActionText = "Hide"
			prompt.ObjectText = spot.label
			prompt.KeyboardKeyCode = Enum.KeyCode.F
			prompt.Exclusivity = Enum.ProximityPromptExclusivity.AlwaysShow
			prompt.RequiresLineOfSight = false
			prompt.MaxActivationDistance = 8
			prompt.Parent = part
			prompt:SetAttribute("HidingSpot", spotId)
			prompts[spotId] = prompt
			prompt.Triggered:Connect(function(player)
				Hiding.hide(player, spotId)
			end)
			refreshPrompt(spotId)
		end
	end
	ctx.onAction("LeaveHide", function(player)
		Hiding.leave(player, "manual")
	end)
	ctx.onAction("HoldBreath", function(player, data)
		if hidden[player] then
			breath[player] = data.success == true
		end
	end)
	Players.PlayerRemoving:Connect(Hiding.forget)
	task.spawn(function()
		while true do
			task.wait(0.25)
			local now = os.clock()
			for player, record in table.clone(hidden) do
				local elapsed = now - record.since
				local spot = Layout.HidingSpots[record.spot]
				if not record.warned and elapsed >= Config.Hide.CampWarnSeconds then
					record.warned = true
					ctx.effect("CampWarn", { spot = record.spot, message = spot.campMessage or "It's getting cramped in here...", left = Config.Hide.CampMaxSeconds - elapsed }, { player })
				end
				if elapsed >= Config.Hide.CampMaxSeconds then
					Hiding.leave(player, "camp")
				end
			end
		end
	end)
end

return Hiding
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Lobby</string>
            <string name="Source"><![CDATA[-- The Munchie's Parking Lot (design doc §7.1, §7.10): clock-in booths (party up, pick a night,
-- Solo / Friends / Public), sending crews to a private shift server (reserved servers when the game
-- is published; in-place in Studio), reconnect, Quick Start, the leaderboard and the lobby TV.

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Layout = require(Shared.Builders.Layout)
local Nights = require(Shared.Data.Nights)
local Util = require(Shared.Util)
local ctx = require(script.Parent.Context)

local Lobby = {}

local booths: { [string]: any } = {}
local playerBooth: { [Player]: string } = {}
local rejected: { [Player]: string } = {}
local friendCache: { [string]: boolean } = {}
local shiftServer = false
local reserved: any = nil
local nameCache: { [number]: string } = {}
local lastSent: { [Player]: string } = {}
local lastSentAt: { [Player]: number } = {}

function Lobby.isShiftServer(): boolean
	return shiftServer
end

local function hosting(): string
	if Config.HostingMode == "InPlace" or RunService:IsStudio() then
		return "InPlace"
	end
	return "Reserved"
end

local function unlockedFor(player: Player): number
	local profile = ctx.PlayerData.get(player)
	return if profile then profile.nightsUnlocked else 1
end

local friendPending: { [string]: boolean } = {}

-- true / false, or nil while the (yielding) lookup runs in the background.
local function isFriend(a: Player, b: Player): boolean?
	if RunService:IsStudio() then
		return true -- Studio test clients have fake ids; treat everyone as friends
	end
	local key = math.min(a.UserId, b.UserId) .. ":" .. math.max(a.UserId, b.UserId)
	if friendCache[key] == nil and not friendPending[key] then
		friendPending[key] = true
		task.spawn(function()
			local ok, result = pcall(function()
				return a:IsFriendsWithAsync(b.UserId)
			end)
			friendCache[key] = ok and result == true
			friendPending[key] = nil
		end)
	end
	return friendCache[key]
end

---------------------------------------------------------------------------
-- Booths
---------------------------------------------------------------------------

local function resetBooth(booth)
	booth.members = {}
	booth.leader = nil
	booth.countdownEnd = nil
	booth.privacy = "Public"
	booth.night = 1
end

local function leaveBooth(player: Player)
	local id = playerBooth[player]
	if not id then
		return
	end
	playerBooth[player] = nil
	local booth = booths[id]
	local index = table.find(booth.members, player)
	if index then
		table.remove(booth.members, index)
	end
	if #booth.members == 0 then
		resetBooth(booth)
	elseif booth.leader == player then
		booth.leader = booth.members[1]
		booth.night = math.min(booth.night, unlockedFor(booth.leader))
		ctx.notify(booth.leader, "You're the shift leader now.")
	end
end

-- Returns "joined", "rejected" or "pending" (waiting on a friends check).
local function joinBooth(player: Player, booth): string
	if #booth.members == 0 then
		booth.members = { player }
		booth.leader = player
		booth.night = unlockedFor(player)
		booth.privacy = "Public"
		booth.countdownEnd = os.clock() + Config.BoothCountdown
		playerBooth[player] = booth.id
		return "joined"
	end
	if #booth.members >= Config.MaxCrew or booth.privacy == "Solo" then
		return "rejected"
	end
	if booth.privacy == "Friends" then
		local friend = isFriend(player, booth.leader)
		if friend == nil then
			return "pending"
		elseif not friend then
			return "rejected"
		end
	end
	table.insert(booth.members, player)
	playerBooth[player] = booth.id
	booth.countdownEnd = math.max(booth.countdownEnd or 0, os.clock() + 6)
	return "joined"
end

local function launchInPlace(players: { Player }, night: number, leader: Player?, fastStart: boolean): boolean
	if ctx.Shift.session then
		for _, p in players do
			ctx.notify(p, "Another crew is on shift in this server's kitchen. Hang tight!", "warn")
		end
		return false
	end
	return ctx.Shift.start({
		players = players,
		night = night,
		leaderUserId = if leader then leader.UserId else nil,
		mode = "InPlace",
		fastStart = fastStart,
	})
end

local function launchReserved(players: { Player }, night: number, leader: Player?, fastStart: boolean)
	local ok, code = pcall(function()
		return TeleportService:ReserveServer(game.PlaceId)
	end)
	if not ok then
		warn("[Lobby] ReserveServer failed, running in-place: " .. tostring(code))
		launchInPlace(players, night, leader, fastStart)
		return
	end
	local crew = {}
	for _, p in players do
		table.insert(crew, p.UserId)
		ctx.PlayerData.setActiveShift(p, { code = code, night = night, expires = os.time() + Config.RejoinWindowSeconds })
		ctx.notify(p, "Clocking in... heading to your private shift.", "good")
	end
	local options = Instance.new("TeleportOptions")
	options.ReservedServerAccessCode = code
	options:SetTeleportData({ night = night, crew = crew, leader = if leader then leader.UserId else crew[1], fastStart = fastStart })
	local tpOk, err = pcall(function()
		TeleportService:TeleportAsync(game.PlaceId, players, options)
	end)
	if not tpOk then
		warn("[Lobby] teleport failed, running in-place: " .. tostring(err))
		for _, p in players do
			ctx.PlayerData.setActiveShift(p, nil)
		end
		launchInPlace(players, night, leader, fastStart)
	end
end

local function launch(booth)
	local players = {}
	for _, p in booth.members do
		if p.Parent == Players then
			table.insert(players, p)
		end
	end
	local night = booth.night
	local leader = booth.leader
	if #players == 0 then
		resetBooth(booth)
		return
	end
	local leaderProfile = leader and ctx.PlayerData.get(leader)
	local fastStart = leaderProfile ~= nil and leaderProfile.settings.fastStart == true
	if hosting() == "InPlace" then
		if launchInPlace(players, night, leader, fastStart) then
			for _, p in players do
				playerBooth[p] = nil
			end
			resetBooth(booth)
		else
			booth.countdownEnd = os.clock() + Config.BoothCountdown
		end
	else
		for _, p in players do
			playerBooth[p] = nil
		end
		resetBooth(booth)
		task.spawn(launchReserved, players, night, leader, fastStart)
	end
end

local function boothDisplay(booth)
	local display = ctx.map.Lobby:FindFirstChild("Booth" .. booth.id .. "Display")
	local gui = display and display:FindFirstChild("Display")
	local label = gui and gui:FindFirstChild("Label") :: TextLabel?
	if not label then
		return
	end
	if #booth.members == 0 then
		label.Text = "CLOCK IN " .. booth.id .. "\nStep on the pad to start a shift"
		return
	end
	local names = {}
	for _, p in booth.members do
		table.insert(names, p.DisplayName)
	end
	local nightData = Nights.get(booth.night)
	local remaining = math.max(0, math.ceil((booth.countdownEnd or os.clock()) - os.clock()))
	label.Text = ("NIGHT %d: %s\n%s (%d/%d) • %s\nClocking in: %ds"):format(booth.night, nightData.title, table.concat(names, ", "), #booth.members, Config.MaxCrew, booth.privacy, remaining)
end

local function updateBooths()
	local now = os.clock()
	for _, player in Players:GetPlayers() do
		if ctx.Shift.isCrew(player) or shiftServer then
			if playerBooth[player] then
				leaveBooth(player)
			end
			continue
		end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local inside: string? = nil
		if root then
			for _, b in Layout.Lobby.Booths do
				local offset = root.Position - b.position
				if math.abs(offset.X) < Layout.Lobby.BoothSize / 2 and math.abs(offset.Z) < Layout.Lobby.BoothSize / 2 and offset.Y < 12 then
					inside = b.id
				end
			end
		end
		local current = playerBooth[player]
		if current ~= inside then
			if current then
				leaveBooth(player)
			end
			if inside then
				if rejected[player] ~= inside then
					if joinBooth(player, booths[inside]) == "rejected" then
						rejected[player] = inside
						local booth = booths[inside]
						ctx.notify(player, if booth.privacy == "Solo" then "That crew is going solo." elseif #booth.members >= Config.MaxCrew then "That crew is full." else "That crew is friends-only.", "warn")
					end
				end
			else
				rejected[player] = nil
			end
		end
	end
	for _, booth in booths do
		if #booth.members > 0 and booth.countdownEnd and now >= booth.countdownEnd then
			launch(booth)
		end
		boothDisplay(booth)
	end
end

---------------------------------------------------------------------------
-- Lobby state for menus
---------------------------------------------------------------------------

local function lobbyState(player: Player)
	local list = {}
	for _, b in Layout.Lobby.Booths do
		local booth = booths[b.id]
		local names = {}
		for _, p in booth.members do
			table.insert(names, p.DisplayName)
		end
		table.insert(list, {
			id = booth.id,
			members = names,
			leader = if booth.leader then booth.leader.DisplayName else nil,
			isMember = playerBooth[player] == booth.id,
			isLeader = booth.leader == player,
			night = booth.night,
			nightTitle = Nights.get(booth.night).title,
			privacy = booth.privacy,
			countdown = if booth.countdownEnd then math.max(0, math.ceil(booth.countdownEnd - os.clock())) else nil,
		})
	end
	local profile = ctx.PlayerData.get(player)
	local s = ctx.Shift.session
	return {
		booths = list,
		myBooth = playerBooth[player],
		unlocked = if profile then profile.nightsUnlocked else 1,
		kitchenBusy = s ~= nil and s.mode == "InPlace",
		shiftServer = shiftServer,
		waitingForCrew = shiftServer and s == nil,
		rejoin = if profile and profile.activeShift and profile.activeShift.expires and profile.activeShift.expires > os.time()
			then { night = profile.activeShift.night }
			else nil,
		firstJoin = profile ~= nil and profile.firstJoin == true,
		hosting = hosting(),
	}
end

local tvIndex = 0
local TEASERS = {
	"MUNCHIE'S TV\n♪ Munch munch munchie's, the late-night lunchie's ♪",
	"TONIGHT ON MUNCHIE'S TV:\nThe Hendersons have... more kids?",
	"CORPORATE REMINDER:\nSMILING IS MANDATORY",
	"NEWS AT 11:\nLocal water tower: 'We're still here.'",
	"LATE CUSTOMER POLICY:\nDo not serve them.",
}

local function updateTV()
	local tv = ctx.map.Lobby:FindFirstChild("LobbyTV")
	local gui = tv and tv:FindFirstChild("Screen")
	local label = gui and gui:FindFirstChild("Label") :: TextLabel?
	if not label then
		return
	end
	local s = ctx.Shift.session
	if s and s.phase == "Running" then
		local names = {}
		for _, m in ctx.Shift.activeMembers() do
			table.insert(names, m.name .. (if m.ghost then " 👻" else ""))
		end
		label.Text = ("LIVE FROM THE KITCHEN\nNight %d: %s\n%s — %.1f★\n%s"):format(s.night, s.data.title, Util.formatClock(s.minutes), s.stars, table.concat(names, ", "))
	else
		tvIndex += 1
		label.Text = TEASERS[((tvIndex - 1) % #TEASERS) + 1]
	end
end

local function nameFor(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		nameCache[userId] = player.DisplayName
		return player.DisplayName
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	nameCache[userId] = if ok then name else ("Crew #" .. userId)
	return nameCache[userId]
end

local function updateLeaderboard()
	local board = ctx.map.Lobby:FindFirstChild("Leaderboard")
	local gui = board and board:FindFirstChild("Board")
	local label = gui and gui:FindFirstChild("Label") :: TextLabel?
	if not label then
		return
	end
	local rows = {}
	local ok = pcall(function()
		local store = DataStoreService:GetOrderedDataStore(Config.LeaderboardStoreName)
		local page = store:GetSortedAsync(false, 10):GetCurrentPage()
		for i, entry in page do
			local userId = tonumber(string.match(entry.key, "%d+") or "0") or 0
			table.insert(rows, ("%d. %s — %d"):format(i, nameFor(userId), entry.value))
		end
	end)
	if not ok or #rows == 0 then
		local list = {}
		for _, p in Players:GetPlayers() do
			local profile = ctx.PlayerData.get(p)
			table.insert(list, { name = p.DisplayName, value = if profile then profile.stats.lateCaught or 0 else 0 })
		end
		table.sort(list, function(a, b)
			return a.value > b.value
		end)
		for i, entry in list do
			if i > 10 then
				break
			end
			table.insert(rows, ("%d. %s — %d"):format(i, entry.name, entry.value))
		end
	end
	label.Text = "TOP LATE-CUSTOMER CATCHERS\n" .. (if #rows > 0 then table.concat(rows, "\n") else "Be the first!")
end

---------------------------------------------------------------------------
-- Reserved shift servers
---------------------------------------------------------------------------

local function onShiftServerJoin(player: Player)
	local data = player:GetJoinData()
	local tpData = data and data.TeleportData
	if not reserved and type(tpData) == "table" then
		reserved = {
			night = tonumber(tpData.night) or 1,
			crew = if type(tpData.crew) == "table" then tpData.crew else {},
			leader = tpData.leader,
			fastStart = tpData.fastStart == true,
			startAt = os.clock() + Config.ReservedWaitForCrew,
			arrived = {},
		}
	end
	if ctx.Shift.session then
		if not ctx.Shift.addLateMember(player) then
			ctx.notify(player, "This shift is full. Sending you back to the lot...")
			task.delay(3, function()
				pcall(function()
					TeleportService:TeleportAsync(game.PlaceId, { player })
				end)
			end)
		end
		return
	end
	if reserved then
		table.insert(reserved.arrived, player)
		return
	end
	-- No crew info and no shift (e.g. rejoining a shift that already closed): back to the lot.
	task.delay(10, function()
		if player.Parent and not ctx.Shift.session and not reserved then
			ctx.notify(player, "That shift has closed. Heading back to the parking lot...")
			ctx.PlayerData.setActiveShift(player, nil)
			pcall(function()
				TeleportService:TeleportAsync(game.PlaceId, { player })
			end)
		end
	end)
end

local function shiftServerTick()
	if ctx.Shift.session or not reserved then
		return
	end
	local arrived = {}
	for _, p in reserved.arrived do
		if p.Parent == Players then
			table.insert(arrived, p)
		end
	end
	if #arrived == 0 then
		return
	end
	local everyone = #arrived >= #reserved.crew
	if everyone or os.clock() >= reserved.startAt then
		ctx.Shift.start({ players = arrived, night = reserved.night, leaderUserId = reserved.leader, mode = "Reserved", fastStart = reserved.fastStart })
		reserved.arrived = {}
	end
end

---------------------------------------------------------------------------

function Lobby.init()
	shiftServer = game.PrivateServerId ~= "" and game.PrivateServerOwnerId == 0
	for _, b in Layout.Lobby.Booths do
		local booth = { id = b.id }
		resetBooth(booth)
		booths[b.id] = booth
	end
	Players.PlayerRemoving:Connect(function(player)
		leaveBooth(player)
		rejected[player] = nil
		lastSent[player] = nil
		lastSentAt[player] = nil
	end)
	TeleportService.TeleportInitFailed:Connect(function(player, result, message)
		warn(("[Lobby] teleport failed for %s: %s %s"):format(player.Name, tostring(result), tostring(message)))
		if shiftServer then
			return
		end
		ctx.PlayerData.setActiveShift(player, nil)
		ctx.notify(player, "Couldn't reach your shift server. Try clocking in again.", "bad")
	end)
	if shiftServer then
		Players.PlayerAdded:Connect(onShiftServerJoin)
		for _, p in Players:GetPlayers() do
			onShiftServerJoin(p)
		end
	end

	-- lobby prompts
	local lobby = ctx.map.Lobby
	local function lobbyPrompt(partName: string, action: string, object: string, panel: string)
		local part = lobby:FindFirstChild(partName)
		if not part then
			return
		end
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = action
		prompt.ObjectText = object
		prompt.RequiresLineOfSight = false
		prompt.MaxActivationDistance = 10
		prompt.Parent = part
		prompt.Triggered:Connect(function(player)
			if not ctx.Shift.isCrew(player) then
				ctx.openPanel(player, panel, ctx.PlayerData.summary(player))
			end
		end)
	end
	lobbyPrompt("Locker", "Open Locker", "Locker Room", "Locker")
	lobbyPrompt("Fax", "Use Fax", "Corporate Fax", "Fax")
	lobbyPrompt("FieldGuideKiosk", "Read", "Field Guide & Badges", "FieldGuide")

	ctx.onAction("Booth", function(player, data)
		local id = playerBooth[player]
		local booth = id and booths[id]
		if not booth or booth.leader ~= player then
			return
		end
		if data.op == "night" then
			local n = math.floor(tonumber(data.value) or 1)
			if n >= 1 and n <= math.min(Nights.Count, unlockedFor(player)) then
				booth.night = n
			end
		elseif data.op == "privacy" and (data.value == "Solo" or data.value == "Friends" or data.value == "Public") then
			booth.privacy = data.value
			if data.value == "Solo" then
				for _, p in table.clone(booth.members) do
					if p ~= player then
						leaveBooth(p)
						rejected[p] = id
						ctx.notify(p, "The leader switched to Solo.")
					end
				end
			end
			table.clear(rejected)
		elseif data.op == "start" then
			booth.countdownEnd = os.clock()
		end
	end)

	ctx.onRequest("QuickStart", function(player, data)
		if ctx.Shift.isCrew(player) then
			return { ok = false }
		end
		leaveBooth(player)
		local profile = ctx.PlayerData.get(player)
		local night = math.clamp(math.floor(tonumber(data.night) or (if profile and profile.firstJoin then 1 else unlockedFor(player))), 1, unlockedFor(player))
		local fastStart = profile ~= nil and profile.settings.fastStart == true
		if hosting() == "InPlace" then
			local ok = launchInPlace({ player }, night, player, fastStart)
			return { ok = ok, message = if ok then nil else "The kitchen is busy. Try a clock-in pad, or wait a moment." }
		end
		task.spawn(launchReserved, { player }, night, player, fastStart)
		return { ok = true }
	end)

	ctx.onRequest("Rejoin", function(player)
		local profile = ctx.PlayerData.get(player)
		local info = profile and profile.activeShift
		if not info or not info.code or (info.expires or 0) < os.time() then
			return { ok = false, message = "No shift to rejoin." }
		end
		local options = Instance.new("TeleportOptions")
		options.ReservedServerAccessCode = info.code
		local ok, err = pcall(function()
			TeleportService:TeleportAsync(game.PlaceId, { player }, options)
		end)
		if not ok then
			ctx.PlayerData.setActiveShift(player, nil)
			return { ok = false, message = "That shift has closed. (" .. tostring(err) .. ")" }
		end
		return { ok = true }
	end)

	task.spawn(function()
		local lastSlow = 0
		while true do
			task.wait(0.25)
			local ok, err = pcall(function()
				if shiftServer then
					shiftServerTick()
				else
					updateBooths()
				end
				for _, player in Players:GetPlayers() do
					if not ctx.Shift.isCrew(player) then
						local state = lobbyState(player)
						local encoded = HttpService:JSONEncode(state)
						if lastSent[player] ~= encoded or os.clock() - (lastSentAt[player] or 0) > 5 then
							lastSent[player] = encoded
							lastSentAt[player] = os.clock()
							ctx.Remotes.LobbyState:FireClient(player, state)
						end
					else
						lastSent[player] = nil
					end
				end
			end)
			if not ok then
				warn("[Lobby] " .. tostring(err))
			end
			if os.clock() - lastSlow > 8 then
				lastSlow = os.clock()
				task.spawn(updateTV)
			end
		end
	end)
	task.spawn(function()
		while true do
			pcall(updateLeaderboard)
			task.wait(60)
		end
	end)
end

return Lobby
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Orders</string>
            <string name="Source"><![CDATA[-- Order & Ticket system (design doc §8.1): the CRT order console, tickets, receipts and bags.
-- Bagging uses a snap assist: an item goes into the bag (nearest the window first) that still
-- needs exactly that item. Hand-out compares the bag against what the customer REALLY said.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Layout = require(Shared.Builders.Layout)
local ModelFactory = require(Shared.Builders.ModelFactory)
local Menu = require(Shared.Data.Menu)
local OrderLogic = require(Shared.OrderLogic)
local Util = require(Shared.Util)
local ctx = require(script.Parent.Context)

local Orders = {}

Orders.tickets = {} :: { any }
local ticketNumber = 100
local bagFolder: Folder? = nil
local consolePrompt: ProximityPrompt? = nil

local function bags(): Folder
	if not bagFolder or not bagFolder.Parent then
		local f = Instance.new("Folder")
		f.Name = "Bags"
		f.Parent = ctx.map.Dynamic
		bagFolder = f
	end
	return bagFolder :: Folder
end

-- Open tickets in bagging priority: the car closest to the window first.
function Orders.sorted(): { any }
	local list = table.clone(Orders.tickets)
	table.sort(list, function(a, b)
		local pa, pb = ctx.Customers.position(a.car), ctx.Customers.position(b.car)
		if pa ~= pb then
			return pa < pb
		end
		return a.number < b.number
	end)
	return list
end

local function lineStatus(ticket)
	local used = {}
	local out = {}
	for _, line in ticket.lines do
		local done = false
		for i, item in ticket.bag do
			if not used[i] and OrderLogic.itemMatchesLine(item, line) then
				used[i] = true
				done = true
				break
			end
		end
		table.insert(out, { label = OrderLogic.lineLabel(line), item = line.item, done = done, stack = if OrderLogic.isBurger(line.item) then OrderLogic.buildStack(line.item, line.mods) else nil })
	end
	local extras = 0
	for i in ticket.bag do
		if not used[i] then
			extras += 1
		end
	end
	return out, extras
end

function Orders.refreshBags()
	local folder = bags()
	folder:ClearAllChildren()
	for i, ticket in Orders.sorted() do
		local spot = Layout.Stations.BagSpots[i]
		if not spot then
			break
		end
		local model = ModelFactory.buildItem("Bag")
		model.Name = "Bag" .. ticket.number
		model:PivotTo(CFrame.new(spot - Vector3.new(0, 0.6, 0)))
		local status, extras = lineStatus(ticket)
		local done = 0
		for _, l in status do
			if l.done then
				done += 1
			end
		end
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(90, 44)
		gui.StudsOffset = Vector3.new(0, 2.6, 0)
		gui.MaxDistance = 40
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundColor3 = if done == #status and extras == 0 then Color3.fromRGB(80, 170, 90) else Color3.fromRGB(40, 40, 45)
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextScaled = true
		label.Font = Enum.Font.GothamBold
		label.Text = ("#%d  %d/%d%s"):format(ticket.number, done, #status, if extras > 0 then ("  +%d?!"):format(extras) else "")
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 8)
		corner.Parent = label
		label.Parent = gui
		gui.Parent = model.PrimaryPart
		model.Parent = folder
	end
end

local function buildReceipt(car, lines, number: number)
	local s = ctx.Shift.session
	local labels = {}
	for _, line in lines do
		table.insert(labels, OrderLogic.lineLabel(line))
	end
	local receipt = car.receipt or {}
	return {
		number = number,
		time = if s then Util.formatClock(s.minutes) else "",
		name = receipt.name or "GUEST",
		lines = labels,
		total = receipt.total or string.format("$%.2f", OrderLogic.price(lines)),
		note = receipt.note,
		warm = car.isLate and s ~= nil and s.night >= 4,
	}
end

function Orders.createTicket(car, lines, flagged: boolean, byPlayer: Player?)
	ticketNumber += 1
	local ticket = {
		id = ticketNumber,
		number = ticketNumber,
		car = car,
		carId = car.id,
		lines = lines,
		flagged = flagged,
		createdAt = os.clock(),
		bag = {},
		closed = false,
	}
	ticket.receipt = buildReceipt(car, lines, ticket.number)
	car.ticket = ticket
	car.orderTaker = nil
	car.ordered = true
	car.state = "Ordered"
	table.insert(Orders.tickets, ticket)
	ctx.Customers.updateQueue()
	ctx.sound("Click", Layout.Stations.ReceiptPrinter)
	if flagged then
		ctx.notifyCrew(("Ticket #%d flagged SUSPICIOUS ⚠"):format(ticket.number), "warn")
	end
	ctx.Bus:fire("OrderTaken", ticket, byPlayer)
	Orders.refreshBags()
	return ticket
end

function Orders.closeTicketFor(car)
	local ticket = car.ticket
	if not ticket or ticket.closed then
		return
	end
	ticket.closed = true
	local index = table.find(Orders.tickets, ticket)
	if index then
		table.remove(Orders.tickets, index)
	end
	Orders.refreshBags()
end

function Orders.findTicketFor(item)
	for _, ticket in Orders.sorted() do
		if OrderLogic.bagWants(ticket.lines, ticket.bag, item) then
			return ticket
		end
	end
	return nil
end

function Orders.addToBag(ticket, item, by: any?)
	table.insert(ticket.bag, item)
	if ctx.WeirdEvents.isActive("DoubleTrouble") then
		table.insert(ticket.bag, table.clone(item))
		ctx.notifyCrew(("Double Trouble! #%d got TWO %s."):format(ticket.number, item.label or item.kind), "warn")
	end
	Orders.refreshBags()
	ctx.Bus:fire("ItemBagged", ticket, item, by)
end

-- Remove one random item from a random bag (raccoons!). Returns the label or nil.
function Orders.stealFromBag(): (string?, number?)
	local candidates = {}
	for _, ticket in Orders.tickets do
		if #ticket.bag > 0 then
			table.insert(candidates, ticket)
		end
	end
	if #candidates == 0 then
		return nil, nil
	end
	local ticket = candidates[math.random(1, #candidates)]
	local item = table.remove(ticket.bag, math.random(1, #ticket.bag))
	Orders.refreshBags()
	return item.label or item.kind, ticket.number
end

function Orders.fixBags(): number
	local removed = 0
	for _, ticket in Orders.tickets do
		local result = OrderLogic.compare(ticket.lines, ticket.bag)
		for _, extra in result.extras do
			local index = table.find(ticket.bag, extra)
			if index then
				table.remove(ticket.bag, index)
				removed += 1
			end
		end
	end
	if removed > 0 then
		Orders.refreshBags()
	end
	return removed
end

-- Unmet ticket lines, highest priority first: { { ticket, line } }
function Orders.neededLines()
	local out = {}
	for _, ticket in Orders.sorted() do
		for _, line in OrderLogic.unmetLines(ticket.lines, ticket.bag) do
			table.insert(out, { ticket = ticket, line = line })
		end
	end
	return out
end

function Orders.snapshot()
	local out = {}
	local now = os.clock()
	for _, ticket in Orders.sorted() do
		local status, extras = lineStatus(ticket)
		table.insert(out, {
			number = ticket.number,
			carId = ticket.carId,
			flagged = ticket.flagged,
			age = now - ticket.createdAt,
			lines = status,
			extras = extras,
			atWindow = ticket.car.state == "AtWindow",
		})
	end
	return out
end

---------------------------------------------------------------------------
-- Order console
---------------------------------------------------------------------------

function Orders.openOrder(player: Player)
	if not ctx.Shift.canAct(player) then
		return
	end
	local car = ctx.Customers.speakerCar()
	if not car then
		ctx.notify(player, "No car at the speaker yet.")
		return
	end
	local taker = Orders.activeTaker(car)
	if taker and taker ~= player then
		ctx.notify(player, taker.DisplayName .. " is already taking this order.")
		return
	end
	car.orderTaker = player
	local s = ctx.Shift.session
	ctx.openPanel(player, "Order", {
		carId = car.id,
		lines = car.speaker,
		captions = car.captions,
		night = s.night,
		voiceSeed = car.id * 37 % 100,
		static = car.anomalyId == "StaticStan",
		reversed = car.anomalyId == "UpsideDownOrder",
		unison = car.anomalyId == "TheTwins",
		wantsUsual = car.wantsUsual == true,
	})
	ctx.Bus:fire("OrderOpened", car, player)
end

-- A player stops taking an order (booped, hid, left). Frees the speaker car for others / Gizmo.
function Orders.releaseTaker(player: Player)
	for _, car in ctx.Customers.lane do
		if car.orderTaker == player then
			car.orderTaker = nil
		end
	end
	if player.Parent then
		ctx.closePanel(player, "Order")
	end
end

-- The player taking this car's order, if they can still finish it.
function Orders.activeTaker(car): Player?
	local taker = car.orderTaker
	if taker and taker.Parent and ctx.Shift.canAct(taker) then
		return taker
	end
	car.orderTaker = nil
	return nil
end

local function sanitizeLines(raw: any): { any }?
	if type(raw) ~= "table" or #raw > 14 then
		return nil
	end
	local lines = {}
	for _, entry in raw do
		if type(entry) ~= "table" or type(entry.item) ~= "string" or not Menu.Items[entry.item] then
			return nil
		end
		local mods = {}
		if type(entry.mods) == "table" then
			local valid = OrderLogic.validMods(entry.item)
			for _, m in entry.mods do
				if type(m) == "string" and table.find(valid, m) then
					table.insert(mods, m)
				end
			end
		end
		table.insert(lines, { item = entry.item, mods = OrderLogic.normalizeMods(mods) })
	end
	return lines
end

function Orders.reset()
	Orders.cleanup()
	ticketNumber = 100
end

function Orders.cleanup()
	table.clear(Orders.tickets)
	if bagFolder then
		bagFolder:ClearAllChildren()
	end
end

function Orders.init()
	local kitchen = ctx.map.Kitchen
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "OrderPrompt"
	prompt.ActionText = "Take Order"
	prompt.ObjectText = "Order Station"
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Enabled = false
	prompt.Parent = kitchen.OrderConsole
	consolePrompt = prompt
	prompt.Triggered:Connect(Orders.openOrder)

	local bagPrompt = Instance.new("ProximityPrompt")
	bagPrompt.Name = "BagPrompt"
	bagPrompt.ActionText = "Bag Item"
	bagPrompt.ObjectText = "Bag Counter"
	bagPrompt.MaxActivationDistance = 9
	bagPrompt.RequiresLineOfSight = false
	bagPrompt.Parent = kitchen.BagCounter
	bagPrompt.Triggered:Connect(function(player)
		if not ctx.Shift.canAct(player) then
			return
		end
		local held = ctx.Stations.held(player)
		if not held then
			ctx.notify(player, "Bring food here to bag it.")
			return
		end
		if held.kind == "Patty" then
			ctx.notify(player, "A plain patty? Build it into a burger first.")
			return
		end
		local ticket = Orders.findTicketFor(held)
		if not ticket then
			if held.kind == "Burger" then
				ctx.notify(player, ("No ticket needs a %s. Check the stack on the ticket!"):format(held.label or "burger"), "bad")
			else
				ctx.notify(player, ("No order needs %s right now."):format(held.label or held.kind), "bad")
			end
			return
		end
		local item = ctx.Stations.takeHeld(player)
		Orders.addToBag(ticket, item, player)
		ctx.notify(player, ("Bagged %s → #%d"):format(item.label or item.kind, ticket.number), "good")
	end)

	local fixPrompt = Instance.new("ProximityPrompt")
	fixPrompt.Name = "FixPrompt"
	fixPrompt.ActionText = "Remove Extras"
	fixPrompt.ObjectText = "Fix Bags"
	fixPrompt.HoldDuration = 0.6
	fixPrompt.MaxActivationDistance = 7
	fixPrompt.RequiresLineOfSight = false
	fixPrompt.Parent = kitchen.BagFix
	fixPrompt.Triggered:Connect(function(player)
		if not ctx.Shift.canAct(player) then
			return
		end
		local removed = Orders.fixBags()
		ctx.notify(player, if removed > 0 then ("Removed %d extra item(s) from the bags."):format(removed) else "The bags look right.")
	end)

	ctx.onAction("SubmitOrder", function(player, data)
		local car = ctx.Customers.get(tonumber(data.carId) or -1)
		if not car or car.state ~= "AtSpeaker" then
			ctx.notify(player, "That car isn't at the speaker anymore.", "warn")
			ctx.closePanel(player, "Order")
			return
		end
		if not ctx.Shift.canAct(player) then
			return
		end
		local taker = Orders.activeTaker(car)
		if taker and taker ~= player then
			ctx.notify(player, taker.DisplayName .. " already took this order.", "warn")
			return
		end
		local lines = sanitizeLines(data.lines)
		if not lines then
			return
		end
		Orders.createTicket(car, lines, data.flagged == true, player)
		ctx.closePanel(player, "Order")
	end)
	ctx.onAction("CancelOrder", function(player, data)
		local car = ctx.Customers.get(tonumber(data.carId) or -1)
		if car and car.orderTaker == player then
			car.orderTaker = nil
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.25)
			local car = if ctx.Shift.isRunning() then ctx.Customers.speakerCar() else nil
			local enabled = car ~= nil and Orders.activeTaker(car) == nil
			if consolePrompt and consolePrompt.Enabled ~= enabled then
				consolePrompt.Enabled = enabled
			end
		end
	end)
end

return Orders
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">PlayerData</string>
            <string name="Source"><![CDATA[-- Saved progress per player (design doc §7.7, §9.1 "Saves"): nights unlocked, Paychecks, cosmetics,
-- Field Guide, badges, endings, settings, stats. Uses DataStoreService when available and falls
-- back to in-memory saves (with a warning) in Studio without API access.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Cosmetics = require(Shared.Data.Cosmetics)
local Util = require(Shared.Util)
local ctx = require(script.Parent.Context)

local PlayerData = {}

local VERSION = 1

local function template()
	local owned = {}
	for _, item in Cosmetics.List do
		if item.default then
			owned[item.id] = true
		end
	end
	return {
		version = VERSION,
		nightsUnlocked = 1,
		nightResults = {}, -- [tostring(n)] = { grade, stars }
		paychecks = 0,
		owned = owned,
		equipped = Cosmetics.defaults(),
		fieldGuide = {}, -- [anomalyId] = "caught" | "seen"
		badges = {},
		endings = {},
		redeemed = {},
		purchases = {},
		freed = {},
		stats = { lateCaught = 0, boops = 0, served = 0, perfect = 0, nights = 0, fryCount = 0 },
		settings = { reducedFlashing = false, captions = true, fastStart = false },
		activeShift = nil,
		firstJoin = true,
	}
end

local function reconcile(data, base)
	for key, value in base do
		if data[key] == nil then
			data[key] = Util.deepCopy(value)
		elseif type(value) == "table" and type(data[key]) == "table" and next(value) ~= nil and #value == 0 then
			reconcile(data[key], value)
		end
	end
	return data
end

local store: DataStore? = nil
local memoryOnly = false
local profiles: { [Player]: any } = {}
local loaded: { [Player]: boolean } = {}
local dirty: { [Player]: boolean } = {}

local function key(userId: number): string
	return "p_" .. tostring(userId)
end

local function tryStore()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		memoryOnly = true
		warn("[PlayerData] DataStores unavailable — progress will NOT save this session. (" .. tostring(result) .. ")")
		if RunService:IsStudio() then
			warn("[PlayerData] In Studio: Game Settings > Security > Enable Studio Access to API Services (after publishing) to test saving.")
		end
	end
end

local function load(player: Player)
	local data = nil
	if store and not memoryOnly then
		for attempt = 1, 3 do
			local ok, result = pcall(function()
				return (store :: DataStore):GetAsync(key(player.UserId))
			end)
			if ok then
				data = result
				break
			else
				local message = string.lower(tostring(result))
				if string.find(message, "403") or string.find(message, "studio") or string.find(message, "api") or string.find(message, "publish") then
					memoryOnly = true
					warn("[PlayerData] No API access — saves are in-memory only this session. (" .. tostring(result) .. ")")
					break
				end
				task.wait(attempt)
			end
		end
	end
	if type(data) ~= "table" then
		data = template()
	else
		data = reconcile(data, template())
		data.firstJoin = false
	end
	profiles[player] = data
	loaded[player] = true
	PlayerData.push(player)
end

local function save(player: Player): boolean
	local data = profiles[player]
	if not data or memoryOnly or not store then
		return false
	end
	local copy = Util.deepCopy(data)
	copy.firstJoin = nil
	local ok, err = pcall(function()
		(store :: DataStore):SetAsync(key(player.UserId), copy, { player.UserId })
	end)
	if not ok then
		warn("[PlayerData] save failed for " .. player.Name .. ": " .. tostring(err))
	else
		dirty[player] = nil
	end
	local saved = ok
	-- leaderboard (all-time Late Customers caught)
	pcall(function()
		local board = DataStoreService:GetOrderedDataStore(Config.LeaderboardStoreName)
		board:SetAsync(key(player.UserId), data.stats.lateCaught or 0)
	end)
	return saved
end

function PlayerData.get(player: Player)
	return profiles[player]
end

function PlayerData.waitFor(player: Player)
	local start = os.clock()
	while not loaded[player] and player.Parent and os.clock() - start < 20 do
		task.wait(0.1)
	end
	return profiles[player]
end

function PlayerData.isMemoryOnly(): boolean
	return memoryOnly
end

-- What the client menus need.
function PlayerData.summary(player: Player)
	local data = profiles[player]
	if not data then
		return nil
	end
	return {
		nightsUnlocked = data.nightsUnlocked,
		nightResults = data.nightResults,
		paychecks = data.paychecks,
		owned = data.owned,
		equipped = data.equipped,
		fieldGuide = data.fieldGuide,
		badges = data.badges,
		endings = data.endings,
		freed = data.freed,
		stats = data.stats,
		settings = data.settings,
		firstJoin = data.firstJoin,
		memoryOnly = memoryOnly,
		rejoin = if data.activeShift and data.activeShift.expires and data.activeShift.expires > os.time()
			then { night = data.activeShift.night }
			else nil,
	}
end

local pushQueued: { [Player]: boolean } = {}
function PlayerData.push(player: Player)
	if pushQueued[player] then
		return
	end
	pushQueued[player] = true
	task.delay(0.2, function()
		pushQueued[player] = nil
		if player.Parent then
			ctx.Remotes.Profile:FireClient(player, PlayerData.summary(player))
		end
	end)
end

local function changed(player: Player)
	dirty[player] = true
	PlayerData.push(player)
end

function PlayerData.addPaychecks(player: Player, amount: number)
	local data = profiles[player]
	if data then
		data.paychecks = math.max(0, data.paychecks + math.floor(amount))
		changed(player)
	end
end

function PlayerData.unlockNight(player: Player, night: number)
	local data = profiles[player]
	if data and night > data.nightsUnlocked then
		data.nightsUnlocked = math.min(night, 5)
		changed(player)
	end
end

local GRADE_RANK = { Bronze = 1, Silver = 2, Gold = 3 }
function PlayerData.recordNight(player: Player, night: number, grade: string, stars: number)
	local data = profiles[player]
	if not data then
		return
	end
	local k = tostring(night)
	local prev = data.nightResults[k]
	if not prev or (GRADE_RANK[grade] or 0) > (GRADE_RANK[prev.grade] or 0) then
		data.nightResults[k] = { grade = grade, stars = math.floor(stars * 10) / 10 }
	end
	data.stats.nights += 1
	changed(player)
end

function PlayerData.addFieldGuide(player: Player, anomalyId: string, how: string)
	local data = profiles[player]
	if not data then
		return false
	end
	local current = data.fieldGuide[anomalyId]
	if current == "caught" or current == how then
		return false
	end
	data.fieldGuide[anomalyId] = how
	changed(player)
	return current == nil
end

function PlayerData.markBadge(player: Player, badgeId: string): boolean
	local data = profiles[player]
	if not data or data.badges[badgeId] then
		return false
	end
	data.badges[badgeId] = os.time()
	changed(player)
	return true
end

function PlayerData.addStat(player: Player, stat: string, amount: number?)
	local data = profiles[player]
	if data then
		data.stats[stat] = (data.stats[stat] or 0) + (amount or 1)
		dirty[player] = true
	end
end

function PlayerData.markEnding(player: Player, endingId: string)
	local data = profiles[player]
	if data and not data.endings[endingId] then
		data.endings[endingId] = os.time()
		changed(player)
	end
end

function PlayerData.markFreed(player: Player, anomalyId: string)
	local data = profiles[player]
	if data and not data.freed[anomalyId] then
		data.freed[anomalyId] = true
		changed(player)
	end
end

function PlayerData.own(player: Player, cosmeticId: string)
	local data = profiles[player]
	if data and not data.owned[cosmeticId] then
		data.owned[cosmeticId] = true
		changed(player)
	end
end

function PlayerData.equip(player: Player, slot: string, cosmeticId: string)
	local data = profiles[player]
	if data then
		data.equipped[slot] = cosmeticId
		changed(player)
	end
end

function PlayerData.setSetting(player: Player, settingKey: string, value: any)
	local data = profiles[player]
	if data and data.settings[settingKey] ~= nil and type(value) == type(data.settings[settingKey]) then
		data.settings[settingKey] = value
		changed(player)
		return true
	end
	return false
end

function PlayerData.setActiveShift(player: Player, info: any)
	local data = profiles[player]
	if data then
		data.activeShift = info
		changed(player)
		task.spawn(save, player)
	end
end

function PlayerData.markRedeemed(player: Player, code: string): boolean
	local data = profiles[player]
	if not data or data.redeemed[code] then
		return false
	end
	data.redeemed[code] = os.time()
	changed(player)
	return true
end

function PlayerData.markPurchase(player: Player, purchaseId: string): boolean
	local data = profiles[player]
	if not data or data.purchases[purchaseId] then
		return false
	end
	data.purchases[purchaseId] = os.time()
	changed(player)
	return true
end

function PlayerData.saveNow(player: Player): boolean
	return save(player)
end

function PlayerData.init()
	tryStore()
	Players.PlayerAdded:Connect(load)
	for _, p in Players:GetPlayers() do
		task.spawn(load, p)
	end
	Players.PlayerRemoving:Connect(function(player)
		save(player)
		profiles[player] = nil
		loaded[player] = nil
		dirty[player] = nil
	end)
	game:BindToClose(function()
		if RunService:IsStudio() and memoryOnly then
			return
		end
		for _, p in Players:GetPlayers() do
			task.spawn(save, p)
		end
		task.wait(2)
	end)
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveSeconds)
			for player in dirty do
				task.spawn(save, player)
			end
		end
	end)
	ctx.onRequest("SetSetting", function(player, data)
		local ok = PlayerData.setSetting(player, tostring(data.key), data.value)
		return { ok = ok }
	end)
	ctx.onRequest("GetProfile", function(player)
		PlayerData.waitFor(player)
		return PlayerData.summary(player)
	end)
end

return PlayerData
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Scares</string>
            <string name="Source"><![CDATA[-- The Scare Director + scare events (design doc §5.3):
--   Rush Hour      Mr. Munch walks the floor. Hide or get booped. (Night 3+; checks hiding spots Night 4+)
--   High Beams     a driverless car's headlights sweep the kitchen. Crouch below the window line. (Night 4+)
--   LightsOutSafe  Night 2's tutorial "hide!" that turns out to be nothing.
-- Pacing rules: a clear warning, never two scares too close together, none in the first minutes,
-- a hard max per night, and a comedy beat after each one.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Layout = require(Shared.Builders.Layout)
local ModelFactory = require(Shared.Builders.ModelFactory)
local ctx = require(script.Parent.Context)

local Scares = {}

local current: any = nil
local queue: { any } = {}
local lastScareEnd = -math.huge
local countThisNight = 0
local generation = 0
local spawned: { Instance } = {}
local hiddenStatue: { [BasePart]: number } = {}

function Scares.active(): boolean
	return current ~= nil
end

function Scares.snapshot()
	if not current then
		return nil
	end
	return { kind = current.kind, phase = current.phase }
end

function Scares.request(id: string, opts: { [string]: any }?)
	table.insert(queue, { id = id, opts = opts or {}, at = os.clock() })
end

---------------------------------------------------------------------------
-- Statue helpers
---------------------------------------------------------------------------

local function statue(): Model?
	return ctx.map.Rooms:FindFirstChild("MunchStatue") :: Model?
end

function Scares.setStatueVisible(visible: boolean)
	local model = statue()
	if not model then
		return
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "Root" then
			if not visible then
				if hiddenStatue[d] == nil then
					hiddenStatue[d] = d.Transparency
				end
				d.Transparency = 1
			elseif hiddenStatue[d] ~= nil then
				d.Transparency = hiddenStatue[d]
				hiddenStatue[d] = nil
			end
		elseif d:IsA("SurfaceGui") then
			d.Enabled = visible
		end
	end
end

local function cleanupSpawned()
	for _, inst in spawned do
		if inst.Parent then
			inst:Destroy()
		end
	end
	table.clear(spawned)
end

---------------------------------------------------------------------------
-- Vision
---------------------------------------------------------------------------

local function rayParams(exclude: { Instance }): RaycastParams
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local list = table.clone(exclude)
	table.insert(list, ctx.map.Dynamic)
	table.insert(list, ctx.map.Lights)
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	params.FilterDescendantsInstances = list
	return params
end

local function canSee(eye: Vector3, facing: Vector3, player: Player, params: RaycastParams): boolean
	if player:GetAttribute("Hidden") or player:GetAttribute("Ghost") then
		return false
	end
	local character = player.Character
	local head = character and character:FindFirstChild("Head") :: BasePart?
	if not head then
		return false
	end
	local toTarget = head.Position - eye
	local distance = toTarget.Magnitude
	if distance > Config.Munch.ViewRange then
		return false
	end
	local flat = Vector3.new(toTarget.X, 0, toTarget.Z)
	if distance > Config.Munch.HearRange and flat.Magnitude > 0.01 then
		local dot = math.clamp(flat.Unit:Dot(facing), -1, 1)
		if math.deg(math.acos(dot)) > Config.Munch.ViewAngle / 2 then
			return false
		end
	end
	return workspace:Raycast(eye, toTarget, params) == nil
end

---------------------------------------------------------------------------
-- Rush Hour (Mr. Munch)
---------------------------------------------------------------------------

local function nearestWaypointAhead(pos: Vector3, fromIndex: number): number
	local best, bestDist = fromIndex, math.huge
	for i = fromIndex, #Layout.MunchPath do
		local d = (Layout.MunchPath[i] - pos).Magnitude
		if d < bestDist then
			best, bestDist = i, d
		end
	end
	return best
end

local function runMunch(s, gen: number)
	local speedMult = if s.night >= 5 then Config.Munch.Night5SpeedMultiplier else 1
	-- walk the loop in about RushHourActive seconds so hiding through it is fair (anti-camping)
	local pathLength = 0
	for i = 2, #Layout.MunchPath do
		pathLength += (Layout.MunchPath[i] - Layout.MunchPath[i - 1]).Magnitude
	end
	local active = if s.night >= 5 then Config.Scare.RushHourActiveNight5 else Config.Scare.RushHourActive
	local walkSpeed = math.max(Config.Munch.WalkSpeed * speedMult, pathLength / active)
	local chaseSpeed = math.max(Config.Munch.ChaseSpeed * speedMult, walkSpeed * 1.4)
	local munch = ModelFactory.buildMunch({ realMouth = s.flags.revealed == true })
	munch.Name = "MrMunch"
	local root = munch.PrimaryPart :: BasePart
	local path = Layout.MunchPath
	local pos = path[1]
	local facing = (path[2] - path[1]).Unit
	munch:PivotTo(CFrame.lookAt(pos, pos + facing))
	munch.Parent = ctx.map.Dynamic
	table.insert(spawned, munch)
	Scares.setStatueVisible(false)
	local params = rayParams({ munch })
	local nextParams = 0
	local index = 2
	local chasing: Player? = nil
	local lastSeen = 0
	local nextScan = 0
	local nextStep = 0
	local pauseUntil = 0
	local knocked: { [string]: boolean } = {}
	local t = 0
	local started = os.clock()
	local freezerHiders: { [Player]: boolean } = {}

	while current and current.gen == gen and ctx.Shift.isRunning() and os.clock() - started < 75 do
		local dt = RunService.Heartbeat:Wait()
		t += dt
		local now = os.clock()
		if now < pauseUntil then
			continue
		end
		local eye = pos + Vector3.new(0, 8.2, 0)

		-- look for crew
		if now >= nextScan then
			nextScan = now + 0.1
			if now >= nextParams then
				-- characters respawn / reconnect mid-walk; keep them out of the ray filter
				nextParams = now + 1
				params = rayParams({ munch })
			end
			for _, player in ctx.Shift.crewPlayers() do
				if ctx.Hiding.spotOf(player) == "Freezer" then
					freezerHiders[player] = true
				end
			end
			if chasing then
				if canSee(eye, facing, chasing, params) then
					lastSeen = now
				elseif now - lastSeen > Config.Munch.LoseSightSeconds then
					chasing = nil
					index = nearestWaypointAhead(pos, math.max(1, index - 1))
					ctx.caption("[squeak... squeak... slower now]", pos, 2)
				end
			else
				for _, member in ctx.Shift.livingMembers() do
					if canSee(eye, facing, member.player, params) then
						chasing = member.player
						lastSeen = now
						ctx.effect("Spotted", { pos = pos }, { member.player })
						ctx.caption("[SQUEAK-SQUEAK-SQUEAK]", pos, 2)
						break
					end
				end
			end
			-- Night 4+: he checks hiding spots he passes
			if not chasing and s.night >= 4 then
				for _, spotId in Layout.HidingOrder do
					local spot = Layout.HidingSpots[spotId]
					local flat = Vector3.new(spot.prompt.X - pos.X, 0, spot.prompt.Z - pos.Z)
					if not knocked[spotId] and flat.Magnitude < Config.Munch.KnockCheckRange then
						knocked[spotId] = true
						if #ctx.Hiding.occupants(spotId) > 0 and s.rng:NextNumber() < Config.Munch.KnockChance then
							facing = if flat.Magnitude > 0.01 then flat.Unit else facing
							root.CFrame = CFrame.lookAt(pos, pos + facing)
							local failed = ctx.Hiding.knock(spotId)
							for _, p in failed do
								ctx.Ghosts.boop(p, "Munch")
							end
							pauseUntil = os.clock() + 0.8
						end
					end
				end
			end
			-- Gizmo always hides badly
			if ctx.Gizmo.isHidingNear(pos, 7) then
				ctx.Gizmo.boop("Munch")
			end
		end

		-- move
		local target: Vector3
		local speed: number
		if chasing then
			local character = chasing.Character
			local targetRoot = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if not targetRoot or chasing:GetAttribute("Ghost") or chasing:GetAttribute("Hidden") then
				chasing = nil
				index = nearestWaypointAhead(pos, math.max(1, index - 1))
				continue
			end
			target = Vector3.new(targetRoot.Position.X, Layout.Floor, targetRoot.Position.Z)
			speed = chaseSpeed
			if (target - pos).Magnitude < Config.Munch.BoopDistance then
				local victim = chasing
				chasing = nil
				facing = (target - pos).Magnitude > 0.01 and (target - pos).Unit or facing
				root.CFrame = CFrame.lookAt(pos, pos + facing)
				ctx.Ghosts.boop(victim, "Munch")
				pauseUntil = os.clock() + 1.5
				index = nearestWaypointAhead(pos, math.max(1, index - 1))
				continue
			end
		else
			if index > #path then
				break
			end
			target = path[index]
			speed = walkSpeed
			if (target - pos).Magnitude < 0.6 then
				index += 1
				continue
			end
		end
		local delta = target - pos
		local step = math.min(delta.Magnitude, speed * dt)
		if delta.Magnitude > 0.01 then
			facing = Vector3.new(delta.X, 0, delta.Z).Unit
			pos += delta.Unit * step
		end
		local bob = math.abs(math.sin(t * 7)) * 0.35
		root.CFrame = CFrame.lookAt(pos, pos + facing) * CFrame.new(0, bob, 0)
		if now >= nextStep then
			nextStep = now + (if chasing then 0.28 else 0.55)
			ctx.effect("Squeak", { pos = pos, fast = chasing ~= nil })
		end
	end

	munch:Destroy()
	Scares.setStatueVisible(true)
	for player in freezerHiders do
		if player.Parent then
			ctx.Badges.award(player, "freezer")
		end
	end
end

local function rushHour(s, gen: number, opts)
	local warning = Config.Scare.WarningSeconds[s.night] or 4
	current.phase = "Warning"
	ctx.effect("ScareWarning", { kind = "RushHour", seconds = warning })
	ctx.caption("[the lights flicker... the jingle plays, slowly]", nil, warning)
	if s.data.debOnHeadset and not opts.quiet then
		ctx.radio("Deb", "Lights! HIDE! Hide now, cry later!", 3)
	end
	ctx.Bus:fire("ScareWarning", "RushHour")
	task.wait(warning)
	if not current or current.gen ~= gen then
		return
	end
	current.phase = "Active"
	ctx.effect("ScareActive", { kind = "RushHour" })
	runMunch(s, gen)
end

---------------------------------------------------------------------------
-- High Beams
---------------------------------------------------------------------------

local function highBeams(s, gen: number)
	current.phase = "Warning"
	ctx.effect("ScareWarning", { kind = "HighBeams", seconds = 3 })
	ctx.caption("[an engine revs outside — brights on]", Vector3.new(-60, 3, Layout.LaneZ), 3)
	ctx.sound("Engine", Vector3.new(-60, 3, Layout.LaneZ))
	ctx.Bus:fire("ScareWarning", "HighBeams")
	task.wait(3)
	if not current or current.gen ~= gen then
		return
	end
	current.phase = "Active"
	ctx.effect("ScareActive", { kind = "HighBeams" })
	local K = Layout.KitchenZ
	local beam = Instance.new("Part")
	beam.Name = "HighBeam"
	beam.Size = Vector3.new(Config.HighBeams.BeamWidth, 7, K.max - K.min)
	beam.Color = Color3.fromRGB(255, 240, 160)
	beam.Material = Enum.Material.Neon
	beam.Transparency = 0.72
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.CanTouch = false
	beam.CastShadow = false
	local light = Instance.new("SpotLight")
	light.Face = Enum.NormalId.Back
	light.Range = 40
	light.Brightness = 5
	light.Color = Color3.fromRGB(255, 240, 180)
	light.Parent = beam
	beam.Parent = ctx.map.Dynamic
	table.insert(spawned, beam)
	local car = ModelFactory.buildCustomer({ person = {}, car = { kind = "Vintage", color = Color3.fromRGB(30, 30, 35) }, modifiers = { "NoDriver" } })
	car.Name = "HighBeamsCar"
	car.Parent = ctx.map.Dynamic
	table.insert(spawned, car)
	local duration = Config.HighBeams.SweepSeconds * (if s.flags.beamsFast then 0.7 else 1)
	local fromX, toX = Layout.HighBeams.fromX, Layout.HighBeams.toX
	local beamY = Layout.Floor + Config.HighBeams.WindowLine + 3.5
	local start = os.clock()
	local honked = false
	while current and current.gen == gen and ctx.Shift.isRunning() do
		local alpha = (os.clock() - start) / duration
		if alpha > 1 then
			break
		end
		local x = fromX + (toX - fromX) * alpha
		beam.CFrame = CFrame.new(x, beamY, (K.min + K.max) / 2)
		car:PivotTo(CFrame.new(x, 0, Layout.LaneZ + 2))
		for _, member in ctx.Shift.livingMembers() do
			local player = member.player
			local character = player.Character
			local head = character and character:FindFirstChild("Head") :: BasePart?
			local rootPart = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if head and rootPart and not player:GetAttribute("Hidden") then
				local p = rootPart.Position
				local inKitchen = p.Z > K.min and p.Z < K.max and math.abs(p.X) < 56
				if inKitchen and math.abs(p.X - x) < Config.HighBeams.BeamWidth / 2 then
					-- crouching keeps you under the window line, whatever your avatar's size or rig
					if not ctx.Characters.isCrouching(player) then
						ctx.effect("Frozen", {}, { player })
						ctx.Ghosts.boop(player, "HighBeams")
					end
				end
				local since = player:GetAttribute("CrouchSince")
				if not honked and since and os.clock() - since > Config.HighBeams.CrouchCampSeconds then
					honked = true
					s.flags.beamsFast = true
					ctx.caption("[HOOOONK — the car doesn't like campers]", Vector3.new(x, 3, Layout.LaneZ), 3)
				end
			end
		end
		if ctx.Gizmo.isHidingNear(Vector3.new(x, 0, 4), Config.HighBeams.BeamWidth) then
			ctx.Gizmo.boop("HighBeams")
		end
		task.wait(0.05)
	end
	beam:Destroy()
	car:Destroy()
end

---------------------------------------------------------------------------
-- Night 2: the safe Lights Out
---------------------------------------------------------------------------

local function lightsOutSafe(s, gen: number)
	current.phase = "Active"
	ctx.effect("ScareWarning", { kind = "LightsOut", seconds = 10, safe = true })
	ctx.caption("[the menu board goes dark. The jingle plays... slowly.]", nil, 4)
	if s.data.debOnHeadset then
		ctx.radio("Deb", "UNDER THE COUNTER. NOW.", 3)
	end
	ctx.Bus:fire("ScareWarning", "LightsOutSafe")
	task.wait(10)
	if not current or current.gen ~= gen then
		return
	end
	if s.data.debOnHeadset then
		ctx.radio("Deb", "...Huh. Nothing happened. Okay. Back to work.", 4)
	end
end

---------------------------------------------------------------------------
-- Director
---------------------------------------------------------------------------

local COMEDY = {
	"Mr. Munch took exactly one fry. He left a gold star sticker on the grill.",
	"A sticky note appears on the stars meter: 'pls don't tell corporate.'",
	"Mr. Munch straightened the napkins on his way out.",
	"The bobblehead is facing the freezer now. It wasn't before.",
}

local function resolve(s, kind: string)
	ctx.effect("ScareEnd", { kind = kind })
	ctx.Bus:fire("ScareEnded", kind)
	if kind == "RushHour" then
		local took = ctx.Stations.removePortions(1)
		for _, p in ctx.Shift.crewPlayers() do
			ctx.PlayerData.addStat(p, "fryCount", 1)
		end
		local line = COMEDY[((countThisNight - 1) % #COMEDY) + 1]
		if took == 0 and countThisNight % #COMEDY == 1 then
			line = "Mr. Munch looked for a fry. There were none. He looked disappointed. Politely."
		end
		ctx.radio("Shift Report", line, 5)
		local star = ModelFactory.buildGoldStar()
		star.CFrame = CFrame.new(Layout.Stations.Grill + Vector3.new(s.rng:NextNumber(-4, 4), 0.2, 0))
		star.Parent = ctx.map.Dynamic
		table.insert(spawned, star)
	elseif kind == "HighBeams" then
		ctx.radio("Shift Report", "The car with no driver idles at the exit... then it's just gone.", 4)
	end
end

local function start(req)
	local s = ctx.Shift.session
	generation += 1
	local gen = generation
	current = { kind = req.id, phase = "Starting", gen = gen }
	if req.id ~= "LightsOutSafe" then
		countThisNight += 1
	end
	task.spawn(function()
		local ok, err = pcall(function()
			if req.id == "RushHour" then
				rushHour(s, gen, req.opts)
			elseif req.id == "HighBeams" then
				highBeams(s, gen)
			elseif req.id == "LightsOutSafe" then
				lightsOutSafe(s, gen)
			end
		end)
		if not ok then
			warn("[Scares] " .. tostring(err))
		end
		if current and current.gen == gen then
			if ctx.Shift.isRunning() then
				resolve(s, req.id)
			end
			lastScareEnd = os.clock()
			current = nil
		end
	end)
end

local function directorTick()
	local s = ctx.Shift.session
	if not s or s.phase ~= "Running" or current then
		return
	end
	local now = os.clock()
	-- Night 5 final rush: Mr. Munch keeps walking until 6 AM
	if s.flags.finalRush and #queue == 0 then
		local gap = math.max(Config.Scare.MinGapFloor, 72 * Config.TimeScale)
		if now - lastScareEnd > gap then
			Scares.request(if countThisNight % 2 == 0 then "RushHour" else "HighBeams", { finalRush = true })
		end
	end
	if #queue == 0 then
		return
	end
	local req = queue[1]
	local forced = req.opts.forced == true
	if req.id ~= "LightsOutSafe" then
		local maxPerNight = Config.Scare.MaxPerNight[s.night] or 0
		if countThisNight >= maxPerNight and not forced then
			table.remove(queue, 1)
			return
		end
		local gapDesign = Config.Scare.MinGapDesign[s.night] or 90
		local gap = math.max(Config.Scare.MinGapFloor, gapDesign * Config.TimeScale)
		if now - lastScareEnd < gap then
			return
		end
		local noFirst = Config.Scare.NoScareFirstDesign * Config.TimeScale
		if now - s.runStart < noFirst and not forced then
			return
		end
	end
	if now - req.at > 90 and not forced then
		table.remove(queue, 1)
		return
	end
	table.remove(queue, 1)
	start(req)
end

function Scares.stop()
	generation += 1
	if current then
		current = nil
		ctx.effect("ScareEnd", { kind = "Stopped" })
	end
	table.clear(queue)
	cleanupSpawned()
	Scares.setStatueVisible(true)
end

function Scares.reset()
	Scares.stop()
	countThisNight = 0
	lastScareEnd = -math.huge
end

function Scares.forceStart(id: string)
	table.insert(queue, 1, { id = id, opts = { forced = true }, at = os.clock() })
	lastScareEnd = -math.huge
end

function Scares.init()
	task.spawn(function()
		while true do
			task.wait(0.25)
			local ok, err = pcall(directorTick)
			if not ok then
				warn("[Scares] director: " .. tostring(err))
			end
		end
	end)
end

return Scares
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Shift</string>
            <string name="Source"><![CDATA[-- The Shift Director (design doc §8.1): runs a night from pre-shift to the Shift Report.
-- Owns the clock, the night timeline, car spawning, stars, the Weird Meter, crew membership,
-- fail states, grades/rewards and the "next night / retry / lobby" choice.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Nights = require(Shared.Data.Nights)
local Util = require(Shared.Util)
local Layout = require(Shared.Builders.Layout)
local ctx = require(script.Parent.Context)

local Shift = {}
Shift.session = nil :: any

local ROLES = { "Order", "Grill", "Fry", "Window" }
Shift.Roles = ROLES

---------------------------------------------------------------------------
-- Crew helpers
---------------------------------------------------------------------------

function Shift.member(player: Player)
	local s = Shift.session
	if not s then
		return nil
	end
	local m = s.members[player.UserId]
	if m and not m.left then
		return m
	end
	return nil
end

function Shift.isCrew(player: Player): boolean
	return Shift.member(player) ~= nil
end

function Shift.crewPlayers(): { Player }
	local out = {}
	local s = Shift.session
	if not s then
		return out
	end
	for _, m in s.order do
		if not m.left and m.player.Parent == Players then
			table.insert(out, m.player)
		end
	end
	return out
end

function Shift.activeMembers()
	local out = {}
	local s = Shift.session
	if not s then
		return out
	end
	for _, m in s.order do
		if not m.left then
			table.insert(out, m)
		end
	end
	return out
end

function Shift.livingMembers()
	local out = {}
	for _, m in Shift.activeMembers() do
		if not m.ghost then
			table.insert(out, m)
		end
	end
	return out
end

-- Can this player use stations right now?
function Shift.canAct(player: Player): boolean
	local s = Shift.session
	local m = Shift.member(player)
	if not s or not m or m.ghost then
		return false
	end
	if s.phase ~= "Running" then
		return false
	end
	if player:GetAttribute("Hidden") then
		return false
	end
	return player.Character ~= nil
end

function Shift.isRunning(): boolean
	return Shift.session ~= nil and Shift.session.phase == "Running"
end

function Shift.night(): number
	return if Shift.session then Shift.session.night else 0
end

function Shift.roleHolder(role: string)
	for _, m in Shift.activeMembers() do
		if m.role == role then
			return m
		end
	end
	return nil
end

function Shift.spawnCFrameFor(player: Player): CFrame?
	local s = Shift.session
	if not s then
		if ctx.Lobby and ctx.Lobby.isShiftServer() then
			return CFrame.new(Layout.KitchenSpawns[1])
		end
		return nil
	end
	local m = Shift.member(player)
	if not m then
		return nil
	end
	if m.respawning then
		m.respawning = false
		return CFrame.lookAt(Layout.RespawnPoint, Layout.RespawnPoint + Vector3.new(0, 0, 10))
	end
	local index = table.find(s.order, m) or 1
	local pos = Layout.KitchenSpawns[((index - 1) % #Layout.KitchenSpawns) + 1]
	return CFrame.lookAt(pos, pos + Vector3.new(0, 0, 10))
end

---------------------------------------------------------------------------
-- Score
---------------------------------------------------------------------------

function Shift.addStars(delta: number, reason: string?)
	local s = Shift.session
	if not s or s.phase ~= "Running" then
		return
	end
	s.stars = Util.clamp(s.stars + delta, 0, Config.Stars.Max)
	ctx.effect("Stars", { delta = delta, reason = reason })
	if s.stars <= 0 then
		task.defer(Shift.fail, "CorporateCalled")
	end
end

function Shift.addWeird(amount: number)
	local s = Shift.session
	if not s or s.phase ~= "Running" then
		return
	end
	s.weird = Util.clamp(s.weird + amount, 0, 100)
	if s.weird >= 100 then
		s.weird = Config.Weird.OverflowResetTo
		ctx.Badges.awardCrew("peak_weird")
		ctx.radio("Deb", if s.data.debOnHeadset then "The Weird Meter's maxed. Oh no. Oh no no." else "[the speaker hums the jingle. slowly.]")
		if s.night >= 3 then
			ctx.Scares.request("RushHour", { forced = true })
		else
			ctx.Scares.request("LightsOutSafe", { forced = true })
		end
	end
end

function Shift.moment(text: string, priority: number)
	local s = Shift.session
	if s and (not s.momentPriority or priority >= s.momentPriority) then
		s.moment = text
		s.momentPriority = priority
	end
end

---------------------------------------------------------------------------
-- Lifecycle
---------------------------------------------------------------------------

local function newMember(player: Player, role: string)
	return {
		player = player,
		userId = player.UserId,
		name = player.DisplayName,
		role = role,
		ghost = false,
		respawnAt = nil,
		respawning = false,
		boops = 0,
		hid = false,
		left = false,
		ready = false,
	}
end

local function sortedEvents(nightData)
	local events = {}
	for _, e in nightData.events do
		local copy = table.clone(e)
		copy.minute = Util.parseClock(e.t)
		table.insert(events, copy)
	end
	table.sort(events, function(a, b)
		return a.minute < b.minute
	end)
	return events
end

-- params: { players, night, leaderUserId?, mode?, fastStart? }
function Shift.start(params)
	if Shift.session then
		return false
	end
	local night = math.clamp(params.night or 1, 1, Nights.Count)
	local nightData = Nights.get(night)
	local s = {
		id = HttpService:GenerateGUID(false),
		night = night,
		data = nightData,
		members = {},
		order = {},
		leaderUserId = params.leaderUserId,
		mode = params.mode or "InPlace",
		phase = "PreShift",
		preShiftEnd = os.clock() + Config.PreShiftSeconds,
		runStart = 0,
		minutes = 0,
		minuteOffset = 0,
		stars = Config.Stars.Start,
		weird = 0,
		events = sortedEvents(nightData),
		eventIndex = 1,
		nextCarAt = 0,
		randomFrom = Util.parseClock(nightData.randomFrom or "18:30"),
		rng = Random.new(),
		flags = {},
		stats = {
			served = 0,
			perfect = 0,
			wrong = 0,
			caught = 0,
			lateServed = 0,
			lateMissed = 0,
			refusedNormal = 0,
			leftAngry = 0,
			burnt = 0,
			friesBurnt = 0,
			fires = 0,
			freed = {},
			companyRefusals = 0,
			firstCatch = nil,
		},
		fastStart = params.fastStart == true,
		moment = nil,
	}
	Shift.session = s
	for i, player in params.players do
		if player.Parent == Players and #s.order < Config.MaxCrew then
			local m = newMember(player, ROLES[((i - 1) % #ROLES) + 1])
			s.members[player.UserId] = m
			table.insert(s.order, m)
		end
	end
	if #s.order == 0 then
		Shift.session = nil
		return false
	end
	s.leaderUserId = s.leaderUserId or s.order[1].userId
	if s.fastStart then
		s.preShiftEnd = os.clock() + 6
	end

	-- reset the world for this night
	for _, name in { "Stations", "Orders", "Customers", "Window", "Scares", "Hiding", "WeirdEvents", "Ghosts", "Gizmo", "Story" } do
		local service = ctx[name]
		if service and service.reset then
			local ok, err = pcall(service.reset, s)
			if not ok then
				warn(("[Shift] %s.reset failed: %s"):format(name, tostring(err)))
			end
		end
	end

	for _, m in s.order do
		local player = m.player
		player:SetAttribute("Crew", s.id)
		player:SetAttribute("Role", m.role)
		player:SetAttribute("Ghost", false)
		local profile = ctx.PlayerData.get(player)
		if profile then
			profile.firstJoin = false
		end
		ctx.Badges.award(player, "clocked_in")
		ctx.Characters.respawn(player)
	end
	task.delay(0.6, function()
		if Shift.session ~= s or s.phase ~= "PreShift" then
			return
		end
		for _, m in s.order do
			if not m.left and m.player.Parent == Players then
				ctx.openPanel(m.player, "PreShift", Shift.preShiftData())
			end
		end
	end)
	ctx.Bus:fire("ShiftStarted", s)
	return true
end

function Shift.preShiftData()
	local s = Shift.session
	local roles = {}
	for _, m in s.order do
		table.insert(roles, { userId = m.userId, name = m.name, role = m.role, ready = m.ready })
	end
	return {
		night = s.night,
		title = s.data.title,
		note = s.data.stickyNote,
		roles = roles,
		endsIn = math.max(0, s.preShiftEnd - os.clock()),
		allRoles = ROLES,
		leader = s.leaderUserId,
	}
end

local function refreshPreShift()
	local s = Shift.session
	if not s or s.phase ~= "PreShift" then
		return
	end
	for _, m in s.order do
		if not m.left then
			ctx.Remotes.OpenPanel:FireClient(m.player, "PreShift", Shift.preShiftData())
		end
	end
end

function Shift.begin()
	local s = Shift.session
	if not s or s.phase ~= "PreShift" then
		return
	end
	s.phase = "Running"
	s.runStart = os.clock()
	s.nextCarAt = os.clock() + 4
	for _, m in s.order do
		ctx.closePanel(m.player, "PreShift")
	end
	if s.data.debOnHeadset then
		for i, line in s.data.intro do
			task.delay((i - 1) * 4, function()
				if Shift.session == s then
					ctx.radio("Deb", line)
				end
			end)
		end
	end
	ctx.effect("ShiftBegin", { night = s.night, title = s.data.title })
	ctx.Bus:fire("ShiftRunning", s)
end

local function gradeFor(s): string
	local lateTotal = s.stats.caught + s.stats.lateServed + s.stats.lateMissed
	local ratio = if lateTotal > 0 then s.stats.caught / lateTotal else 1
	if s.stars >= 4.2 and ratio >= 0.8 then
		return "Gold"
	elseif s.stars >= 3 and ratio >= 0.5 then
		return "Silver"
	end
	return "Bronze"
end

local function boopTitles(s)
	local list = {}
	for _, m in s.order do
		table.insert(list, { name = m.name, boops = m.boops })
	end
	table.sort(list, function(a, b)
		return a.boops > b.boops
	end)
	local titles = {}
	if list[1] and list[1].boops > 0 then
		table.insert(titles, ("Most Booped: %s (%d)"):format(list[1].name, list[1].boops))
	end
	if s.stats.burnt + s.stats.friesBurnt > 0 then
		table.insert(titles, ("Most Haunted Fryer: %d things burnt"):format(s.stats.burnt + s.stats.friesBurnt))
	end
	if ctx.Gizmo and ctx.Gizmo.boops and ctx.Gizmo.boops > 0 then
		table.insert(titles, ("Gizmo got booped %d time%s. Again."):format(ctx.Gizmo.boops, if ctx.Gizmo.boops == 1 then "" else "s"))
	end
	return titles, list
end

-- skipRespawn: the caller is about to reload every character itself (avoid double loads).
local function stopWorld(s, skipRespawn: boolean?)
	for _, name in { "Scares", "WeirdEvents", "Customers", "Gizmo", "Hiding", "Ghosts" } do
		local service = ctx[name]
		if service and service.stop then
			pcall(service.stop, s, skipRespawn)
		end
	end
	for _, m in s.order do
		if not m.left then
			ctx.Stations.dropHeld(m.player)
		end
	end
end

local function finishReport(s, success: boolean, reason: string?, endingId: string?)
	s.phase = "Report"
	s.reportDeadline = os.clock() + 120
	local grade = if success then gradeFor(s) else "None"
	local titles, boops = boopTitles(s)
	for _, m in s.order do
		if not m.left and m.player.Parent then
			local player = m.player
			local pay = 0
			if success then
				pay = Config.Pay.Base
					+ Config.Pay.PerStar * math.floor(s.stars)
					+ Config.Pay.PerCatch * s.stats.caught
					+ Config.Pay.PerPerfect * s.stats.perfect
					+ (if grade == "Gold" then Config.Pay.GoldBonus else 0)
				ctx.PlayerData.unlockNight(player, s.night + 1)
				ctx.PlayerData.recordNight(player, s.night, grade, s.stars)
				ctx.Badges.award(player, "night" .. s.night)
				if grade == "Gold" then
					ctx.Badges.award(player, "gold")
					local profile = ctx.PlayerData.get(player)
					if profile then
						local allGold = true
						for n = 1, 5 do
							local r = profile.nightResults[tostring(n)]
							if not r or r.grade ~= "Gold" then
								allGold = false
							end
						end
						if allGold then
							ctx.Badges.award(player, "all_gold")
						end
					end
				end
				if s.night >= 3 and m.boops == 0 and not m.hid then
					ctx.Badges.award(player, "untouchable")
				end
				if s.stats.perfect >= 10 then
					ctx.Badges.award(player, "perfect10")
				end
				if s.stats.burnt >= 3 then
					ctx.Badges.award(player, "well_done")
				end
			else
				pay = math.floor(Config.Pay.Base / 2)
			end
			ctx.PlayerData.addPaychecks(player, pay)
			ctx.PlayerData.setActiveShift(player, nil)
			ctx.openPanel(player, "Report", {
				success = success,
				reason = reason,
				ending = endingId,
				night = s.night,
				title = s.data.title,
				stars = s.stars,
				grade = grade,
				stats = {
					served = s.stats.served,
					perfect = s.stats.perfect,
					caught = s.stats.caught,
					lateServed = s.stats.lateServed,
					lateMissed = s.stats.lateMissed,
					refusedNormal = s.stats.refusedNormal,
					leftAngry = s.stats.leftAngry,
					freed = Util.count(s.stats.freed),
				},
				titles = titles,
				boops = boops,
				bestCatch = s.stats.firstCatch,
				moment = s.moment,
				paychecks = pay,
				canNext = success and s.night < Nights.Count,
				isLeader = m.userId == s.leaderUserId,
				outro = s.data.outro,
			})
		end
	end
	if success and s.data.outro and s.data.outro ~= "" then
		ctx.radio(if s.data.debOnHeadset then "Deb" else "Sticky Note", s.data.outro, 6)
	end
	ctx.Bus:fire("ShiftEnded", s, success)
end

function Shift.complete()
	local s = Shift.session
	if not s or s.phase ~= "Running" then
		return
	end
	s.phase = "Ending"
	stopWorld(s)
	if s.data.finale then
		local endingId = ctx.Story.ending(s, "survived")
		task.delay(14, function()
			if Shift.session == s then
				finishReport(s, true, nil, endingId)
			end
		end)
	else
		finishReport(s, true)
	end
end

function Shift.fail(reason: string)
	local s = Shift.session
	if not s or s.phase ~= "Running" then
		return
	end
	s.phase = "Ending"
	stopWorld(s)
	if reason == "GhostTown" then
		ctx.Badges.awardCrew("ghost_town")
		ctx.effect("GhostTown", {})
	end
	if s.data.finale and reason == "CorporateCalled" then
		local endingId = ctx.Story.ending(s, "fired")
		task.delay(12, function()
			if Shift.session == s then
				finishReport(s, false, reason, endingId)
			end
		end)
		return
	end
	ctx.effect("ShiftFailed", { reason = reason })
	task.delay(4, function()
		if Shift.session == s then
			finishReport(s, false, reason)
		end
	end)
end

-- Ends the session and sends the crew back to the lobby (or teleports them out of a shift server).
function Shift.endSession()
	local s = Shift.session
	if not s then
		return
	end
	stopWorld(s, true)
	Shift.session = nil
	local players = {}
	for _, m in s.order do
		if not m.left and m.player.Parent == Players then
			local player = m.player
			player:SetAttribute("Crew", nil)
			player:SetAttribute("Role", nil)
			player:SetAttribute("Ghost", false)
			ctx.closePanel(player, "All")
			table.insert(players, player)
		end
	end
	for _, name in { "Customers", "Gizmo", "Orders", "Stations", "Story" } do
		local service = ctx[name]
		if service and service.cleanup then
			pcall(service.cleanup)
		end
	end
	ctx.Bus:fire("SessionEnded", s)
	if s.mode == "Reserved" and #players > 0 then
		task.spawn(function()
			local ok, err = pcall(function()
				TeleportService:TeleportAsync(game.PlaceId, players)
			end)
			if not ok then
				warn("[Shift] teleport back to lobby failed: " .. tostring(err))
				for _, p in players do
					ctx.Characters.respawn(p)
				end
			end
		end)
	else
		for _, p in players do
			ctx.Characters.respawn(p)
		end
	end
end

function Shift.restart(night: number)
	local s = Shift.session
	if not s then
		return
	end
	local players = Shift.crewPlayers()
	local leader = s.leaderUserId
	local mode = s.mode
	stopWorld(s, true)
	Shift.session = nil
	for _, name in { "Customers", "Gizmo", "Orders", "Stations", "Story" } do
		local service = ctx[name]
		if service and service.cleanup then
			pcall(service.cleanup)
		end
	end
	for _, p in players do
		ctx.closePanel(p, "All")
	end
	Shift.start({ players = players, night = night, leaderUserId = leader, mode = mode })
end

function Shift.choose(player: Player?, choice: string)
	local s = Shift.session
	if not s or s.phase ~= "Report" then
		return
	end
	if player and player.UserId ~= s.leaderUserId then
		local leader = s.members[s.leaderUserId]
		if leader and not leader.left then
			ctx.notify(player, "Waiting for the shift leader to choose...")
			return
		end
	end
	if choice == "next" and s.night < Nights.Count and s.lastSuccess then
		Shift.restart(s.night + 1)
	elseif choice == "retry" then
		Shift.restart(s.night)
	else
		Shift.endSession()
	end
end

---------------------------------------------------------------------------
-- Joining / leaving mid-shift
---------------------------------------------------------------------------

function Shift.addLateMember(player: Player): boolean
	local s = Shift.session
	if not s then
		return false
	end
	local existing = s.members[player.UserId]
	if existing then
		existing.player = player
		existing.left = false
		existing.ghost = false
		player:SetAttribute("Crew", s.id)
		player:SetAttribute("Role", existing.role)
		ctx.Characters.respawn(player)
		ctx.notifyCrew(existing.name .. " clocked back in! (reconnected)")
		return true
	end
	if #Shift.activeMembers() >= Config.MaxCrew then
		return false
	end
	local m = newMember(player, ROLES[(#s.order % #ROLES) + 1])
	s.members[player.UserId] = m
	table.insert(s.order, m)
	player:SetAttribute("Crew", s.id)
	player:SetAttribute("Role", m.role)
	ctx.Characters.respawn(player)
	ctx.notifyCrew(m.name .. " joined the shift!")
	return true
end

local function onPlayerRemoving(player: Player)
	local s = Shift.session
	if not s then
		return
	end
	local m = s.members[player.UserId]
	if not m or m.left then
		return
	end
	m.left = true
	ctx.Stations.dropHeld(player)
	ctx.Stations.forgetViewer(player)
	ctx.Orders.releaseTaker(player)
	if ctx.Hiding then
		ctx.Hiding.forget(player)
	end
	if #Shift.activeMembers() == 0 then
		task.defer(function()
			if Shift.session == s then
				stopWorld(s)
				Shift.session = nil
				for _, name in { "Customers", "Gizmo", "Orders", "Stations", "Story" } do
					local service = ctx[name]
					if service and service.cleanup then
						pcall(service.cleanup)
					end
				end
				ctx.Bus:fire("SessionEnded", s)
			end
		end)
		return
	end
	if s.leaderUserId == player.UserId then
		s.leaderUserId = Shift.activeMembers()[1].userId
	end
	ctx.notifyCrew(m.name .. " left the shift. Gizmo will cover.")
end

---------------------------------------------------------------------------
-- Tick
---------------------------------------------------------------------------

local function carInterval(s): number
	local base = Config.CarInterval[s.night] or 25
	local minutes = s.minutes
	local rush = (minutes >= 60 and minutes <= 120) or (minutes >= 420 and minutes <= 480)
	if rush then
		base *= Config.RushMultiplier
	end
	local crew = math.max(1, #Shift.activeMembers())
	base /= 1 + Config.CrewIntervalFactor * (crew - 1)
	return base * s.rng:NextNumber(0.85, 1.15)
end

local function handleEvent(s, e)
	if e.kind == "radio" then
		ctx.radio(e.who, e.text)
	elseif e.kind == "note" then
		ctx.effect("StickyNote", { text = e.text })
	elseif e.kind == "customer" then
		ctx.Customers.enqueueScripted(e.id)
	elseif e.kind == "scare" then
		if e.ifWeird and s.weird < e.ifWeird then
			return
		end
		ctx.Scares.request(e.id, { scheduled = true })
	elseif e.kind == "beat" then
		ctx.Story.beat(e.id, e.param)
	end
end

local lastBroadcast = 0
local function tick(dt: number)
	local s = Shift.session
	if not s then
		return
	end
	local now = os.clock()
	if s.phase == "PreShift" then
		local allReady = true
		for _, m in Shift.activeMembers() do
			if not m.ready then
				allReady = false
			end
		end
		if now >= s.preShiftEnd or allReady then
			Shift.begin()
		end
	elseif s.phase == "Running" then
		s.minutes = math.min(Config.NightEndMinute, (now - s.runStart) / Config.SecondsPerGameHour * 60 + s.minuteOffset)
		while s.events[s.eventIndex] and s.events[s.eventIndex].minute <= s.minutes do
			local e = s.events[s.eventIndex]
			s.eventIndex += 1
			task.spawn(handleEvent, s, e)
		end
		if s.minutes >= s.randomFrom and now >= s.nextCarAt then
			if ctx.Customers.spawnNext() then
				s.nextCarAt = now + carInterval(s)
			else
				s.nextCarAt = now + 2
			end
		elseif s.minutes < s.randomFrom and ctx.Customers.hasScripted() and now >= s.nextCarAt then
			ctx.Customers.spawnNext(true)
			s.nextCarAt = now + 2
		end
		local passive = (Config.Weird.PassivePerNight[s.night] or 10) / (12 * Config.SecondsPerGameHour)
		s.weird = math.min(99, s.weird + passive * dt)
		if s.minutes >= Config.NightEndMinute then
			Shift.complete()
		end
	elseif s.phase == "Report" then
		if now > (s.reportDeadline or math.huge) then
			Shift.endSession()
		end
	end
	if Shift.session and now - lastBroadcast > 0.25 then
		lastBroadcast = now
		local snapshot = Shift.snapshot()
		for _, p in Shift.crewPlayers() do
			ctx.Remotes.State:FireClient(p, snapshot)
		end
	end
end

function Shift.snapshot()
	local s = Shift.session
	local now = os.clock()
	local crew = {}
	for _, m in s.order do
		if not m.left then
			table.insert(crew, {
				userId = m.userId,
				name = m.name,
				role = m.role,
				ghost = m.ghost,
				respawnIn = if m.respawnAt then math.max(0, m.respawnAt - now) else nil,
				hidden = m.player:GetAttribute("Hidden"),
			})
		end
	end
	return {
		phase = s.phase,
		night = s.night,
		title = s.data.title,
		clock = Util.formatClock(s.minutes),
		minutes = s.minutes,
		stars = s.stars,
		weird = s.weird,
		crew = crew,
		leader = s.leaderUserId,
		tickets = ctx.Orders.snapshot(),
		lane = ctx.Customers.snapshot(),
		scare = ctx.Scares.snapshot(),
		weirdEvents = ctx.WeirdEvents.snapshot(),
		flags = { uv = s.flags.uv == true, revealed = s.flags.revealed == true, doilies = s.flags.doilies == true, finalRush = s.flags.finalRush == true },
		gizmo = if ctx.Gizmo then ctx.Gizmo.snapshot() else nil,
		fryBin = ctx.Stations.fryPortions(),
	}
end

function Shift.debugSkip(minutes: number)
	local s = Shift.session
	if s and s.phase == "Running" then
		s.minuteOffset += minutes
	end
end

function Shift.init()
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	ctx.onAction("PickRole", function(player, data)
		local s = Shift.session
		local m = Shift.member(player)
		if s and m and table.find(ROLES, data.role) then
			m.role = data.role
			player:SetAttribute("Role", m.role)
			refreshPreShift()
		end
	end)
	ctx.onAction("Ready", function(player)
		local m = Shift.member(player)
		if m then
			m.ready = true
			refreshPreShift()
		end
	end)
	ctx.onAction("Choose", function(player, data)
		if Shift.isCrew(player) then
			Shift.choose(player, tostring(data.choice))
		end
	end)
	ctx.Bus:on("ShiftEnded", function(s, success)
		s.lastSuccess = success
	end)
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(0.1)
			local now = os.clock()
			local ok, err = pcall(tick, now - last)
			if not ok then
				warn("[Shift] tick error: " .. tostring(err))
			end
			last = now
		end
	end)
end

return Shift
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Shop</string>
            <string name="Source"><![CDATA[-- Locker room shop (design doc §11.3): cosmetics only. Paychecks (earned) or Robux (developer
-- products), plus a one-time Supporter Pass. Never revives, never stats, never mid-shift.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Cosmetics = require(Shared.Data.Cosmetics)
local ctx = require(script.Parent.Context)

local Shop = {}

local productToCosmetic: { [number]: string } = {}

local function inShift(player: Player): boolean
	return ctx.Shift.isCrew(player)
end

local function updateCredits()
	local wall = ctx.map.Lobby:FindFirstChild("CreditsWall")
	local gui = wall and wall:FindFirstChild("Credits")
	local label = gui and gui:FindFirstChild("Label") :: TextLabel?
	if not label then
		return
	end
	local names = {}
	for _, p in Players:GetPlayers() do
		local profile = ctx.PlayerData.get(p)
		if profile and profile.owned.tag_gold then
			table.insert(names, p.DisplayName)
		end
	end
	label.Text = "THANK YOU, SUPPORTERS!\n" .. (if #names > 0 then table.concat(names, "\n") else "(your name here?)")
end

local function checkSupporter(player: Player)
	if Config.SupporterPassId == 0 then
		return
	end
	local ok, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, Config.SupporterPassId)
	end)
	if ok and owns then
		ctx.PlayerData.own(player, "tag_gold")
		updateCredits()
	end
end

function Shop.init()
	for cosmeticKey, productId in Config.DevProducts do
		if productId ~= 0 then
			productToCosmetic[productId] = cosmeticKey
		end
	end

	ctx.onRequest("BuyCosmetic", function(player, data)
		if inShift(player) then
			return { ok = false, message = "The shop is in the lobby locker room. No purchases during shifts. Ever." }
		end
		local item = Cosmetics.ById[tostring(data.id)]
		local profile = ctx.PlayerData.get(player)
		if not item or not profile then
			return { ok = false, message = "Unknown item." }
		end
		if profile.owned[item.id] then
			return { ok = false, message = "You already own that." }
		end
		if item.secret or item.default then
			return { ok = false, message = item.hint or "Not for sale." }
		end
		if item.price then
			if profile.paychecks < item.price then
				return { ok = false, message = ("You need %d more Paychecks."):format(item.price - profile.paychecks) }
			end
			ctx.PlayerData.addPaychecks(player, -item.price)
			ctx.PlayerData.own(player, item.id)
			return { ok = true, message = "Bought " .. item.name .. "!" }
		end
		if item.robux then
			local productId = Config.DevProducts[item.robux] or 0
			if productId == 0 then
				return { ok = false, message = "Not on sale yet. (Developer: add a product id in Config.DevProducts.)" }
			end
			MarketplaceService:PromptProductPurchase(player, productId)
			return { ok = true, prompted = true }
		end
		return { ok = false, message = "Not for sale." }
	end)

	ctx.onRequest("Equip", function(player, data)
		local item = Cosmetics.ById[tostring(data.id)]
		local profile = ctx.PlayerData.get(player)
		if not item or not profile or not profile.owned[item.id] then
			return { ok = false, message = "You don't own that." }
		end
		ctx.PlayerData.equip(player, item.slot, item.id)
		if not player:GetAttribute("Ghost") and not player:GetAttribute("Hidden") then
			ctx.Characters.applyCosmetics(player)
		end
		return { ok = true }
	end)

	ctx.onRequest("BuySupporter", function(player)
		if inShift(player) then
			return { ok = false, message = "Not during a shift." }
		end
		if Config.SupporterPassId == 0 then
			return { ok = false, message = "Supporter Pass isn't set up yet. (Developer: Config.SupporterPassId.)" }
		end
		MarketplaceService:PromptGamePassPurchase(player, Config.SupporterPassId)
		return { ok = true, prompted = true }
	end)

	MarketplaceService.ProcessReceipt = function(info)
		local player = Players:GetPlayerByUserId(info.PlayerId)
		if not player then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local profile = ctx.PlayerData.waitFor(player)
		if not profile then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local key = tostring(info.PurchaseId)
		if profile.purchases[key] then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
		local cosmeticId = productToCosmetic[info.ProductId]
		if not cosmeticId then
			warn("[Shop] unknown product " .. tostring(info.ProductId))
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		ctx.PlayerData.own(player, cosmeticId)
		ctx.PlayerData.markPurchase(player, key)
		if not ctx.PlayerData.saveNow(player) and not ctx.PlayerData.isMemoryOnly() then
			-- not saved yet: Roblox will retry the receipt; markPurchase keeps it idempotent
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		ctx.notify(player, "Thank you! " .. (Cosmetics.ById[cosmeticId] and Cosmetics.ById[cosmeticId].name or cosmeticId) .. " is in your locker.", "good")
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if purchased and passId == Config.SupporterPassId then
			ctx.PlayerData.own(player, "tag_gold")
			ctx.notify(player, "Thank you for supporting Munchie's! Golden name tag unlocked.", "good")
			updateCredits()
		end
	end)

	Players.PlayerAdded:Connect(function(player)
		ctx.PlayerData.waitFor(player)
		checkSupporter(player)
		updateCredits()
	end)
	Players.PlayerRemoving:Connect(function()
		task.defer(updateCredits)
	end)
end

return Shop
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Stations</string>
            <string name="Source"><![CDATA[-- Kitchen stations (design doc §6.4) with "carry & snap" cooking:
--   Grill:     place patty -> FLIP! at the sizzle -> take it when DONE (or it burns)
--   Assembly:  build the burger bottom-to-top on the plate (snap stacking), carry it away
--   Fryers:    drop basket -> pull at the DING -> fry bin -> scoop a carton
--   Drinks:    HOLD to pour, release in the green zone (overflow = sticky floor)
-- Players carry one item at a time to the bag counter. Gizmo uses the same API.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Layout = require(Shared.Builders.Layout)
local ModelFactory = require(Shared.Builders.ModelFactory)
local Menu = require(Shared.Data.Menu)
local OrderLogic = require(Shared.OrderLogic)
local ctx = require(script.Parent.Context)

local Stations = {}

local Cook = Config.Cook
local held: { [Player]: any } = {}
local grill = {} :: { any }
local plate = { stack = {} :: { string }, finished = false, model = nil :: Model? }
local fryers = {} :: { any }
local fryPortions = 0
local pours = {} :: { [string]: any }
local assemblyViewers: { [Player]: boolean } = {}
local dynamic: Folder? = nil
local prompts: { [string]: ProximityPrompt } = {}

local function folder(): Folder
	if not dynamic or not dynamic.Parent then
		local f = Instance.new("Folder")
		f.Name = "Stations"
		f.Parent = ctx.map.Dynamic
		dynamic = f
	end
	return dynamic :: Folder
end

local function makePrompt(parent: Instance, name: string, action: string, object: string, props: { [string]: any }?): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = name
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.MaxActivationDistance = 8
	prompt.RequiresLineOfSight = false
	if props then
		for k, v in props do
			(prompt :: any)[k] = v
		end
	end
	prompt.Parent = parent
	prompts[name] = prompt
	return prompt
end

local function billboard(part: BasePart, text: string, color: Color3): BillboardGui
	local gui = Instance.new("BillboardGui")
	gui.Name = "Status"
	gui.Size = UDim2.fromOffset(110, 34)
	gui.StudsOffset = Vector3.new(0, 1.6, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 45
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = color
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = label
	label.Parent = gui
	gui.Parent = part
	return gui
end

local function setStatus(part: BasePart?, text: string?, color: Color3?)
	if not part then
		return
	end
	local gui = part:FindFirstChild("Status") :: BillboardGui?
	if not text then
		if gui then
			gui:Destroy()
		end
		return
	end
	if not gui then
		gui = billboard(part, text, color or Color3.fromRGB(40, 40, 45))
	end
	local label = (gui :: BillboardGui):FindFirstChild("Label") :: TextLabel
	label.Text = text
	label.BackgroundColor3 = color or Color3.fromRGB(40, 40, 45)
end

local function smoke(part: BasePart, on: boolean)
	local existing = part:FindFirstChild("Smoke")
	if on and not existing then
		local s = Instance.new("Smoke")
		s.Color = Color3.fromRGB(60, 60, 60)
		s.Size = 2
		s.RiseVelocity = 4
		s.Opacity = 0.4
		s.Parent = part
	elseif not on and existing then
		existing:Destroy()
	end
end

---------------------------------------------------------------------------
-- Held items
---------------------------------------------------------------------------

function Stations.held(player: Player)
	return held[player]
end

local function attachModel(player: Player, item)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local model = ModelFactory.buildItem(item.kind, { stack = item.stack, toppings = Menu.Toppings })
	model.Name = "HeldItem"
	local itemRoot = model.PrimaryPart :: BasePart
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Massless = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
		end
	end
	model:PivotTo(root.CFrame * CFrame.new(0, -0.1, -1.7))
	itemRoot.Anchored = false
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = itemRoot
	weld.Parent = itemRoot
	model.Parent = character
	item.model = model
end

function Stations.give(player: Player, item): boolean
	if held[player] then
		return false
	end
	held[player] = item
	attachModel(player, item)
	player:SetAttribute("Holding", item.label or item.kind)
	return true
end

function Stations.takeHeld(player: Player)
	local item = held[player]
	if not item then
		return nil
	end
	held[player] = nil
	if item.model then
		item.model:Destroy()
		item.model = nil
	end
	player:SetAttribute("Holding", nil)
	return item
end

function Stations.dropHeld(player: Player)
	local item = Stations.takeHeld(player)
	if item and player.Parent then
		ctx.notify(player, ("You dropped the %s."):format(item.label or item.kind), "bad")
	end
end

-- Weird events can make specific held things vanish (Gravity Fries).
function Stations.dropHeldOfKind(kind: string): number
	local n = 0
	for player, item in held do
		if item.kind == kind then
			Stations.takeHeld(player)
			n += 1
		end
	end
	return n
end

local function handsFree(player: Player): boolean
	if held[player] then
		ctx.notify(player, ("Your hands are full (%s). Bag it or trash it."):format(held[player].label or "item"))
		return false
	end
	return true
end

---------------------------------------------------------------------------
-- Grill
---------------------------------------------------------------------------

local PATTY_COLORS = {
	SideA = Color3.fromRGB(225, 120, 120),
	Flip = Color3.fromRGB(200, 105, 95),
	SideB = Color3.fromRGB(140, 80, 50),
	Done = Color3.fromRGB(105, 60, 34),
	Burnt = Color3.fromRGB(30, 25, 22),
}

local function setPatty(spot, state: string)
	spot.state = state
	spot.t0 = os.clock()
	if state == "Empty" then
		if spot.part then
			spot.part:Destroy()
			spot.part = nil
		end
		return
	end
	if not spot.part then
		local p = Instance.new("Part")
		p.Name = "GrillPatty"
		p.Shape = Enum.PartType.Cylinder
		p.Size = Vector3.new(0.4, 1.8, 1.8)
		p.CFrame = CFrame.new(spot.position) * CFrame.Angles(0, 0, math.rad(90))
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.Parent = folder()
		spot.part = p
	end
	spot.part.Color = PATTY_COLORS[state] or PATTY_COLORS.Done
	smoke(spot.part, state == "Burnt")
	if state == "Flip" then
		setStatus(spot.part, "FLIP!", Color3.fromRGB(230, 120, 30))
	elseif state == "Done" then
		setStatus(spot.part, "DONE!", Color3.fromRGB(70, 160, 80))
	elseif state == "Burnt" then
		setStatus(spot.part, "BURNT", Color3.fromRGB(60, 60, 60))
	else
		setStatus(spot.part, nil)
	end
end

function Stations.grillPlace(by: any): boolean
	for _, spot in grill do
		if spot.state == "Empty" then
			setPatty(spot, "SideA")
			spot.bonus = if typeof(by) == "Instance" and by:GetAttribute("Role") == "Grill" then 1.5 else 0
			ctx.sound("Sizzle", spot.position)
			ctx.Bus:fire("PattyPlaced", by)
			return true
		end
	end
	return false
end

function Stations.grillFlipAny(by: any): boolean
	for _, spot in grill do
		if spot.state == "Flip" then
			setPatty(spot, "SideB")
			ctx.sound("Sizzle", spot.position)
			ctx.Bus:fire("PattyFlipped", by)
			return true
		end
	end
	return false
end

function Stations.grillTakeAny(by: any)
	for _, spot in grill do
		if spot.state == "Done" then
			setPatty(spot, "Empty")
			ctx.Bus:fire("PattyTaken", by)
			return { kind = "Patty", label = "Cooked Patty" }
		end
	end
	return nil
end

function Stations.grillScrapeAny(): boolean
	for _, spot in grill do
		if spot.state == "Burnt" then
			setPatty(spot, "Empty")
			return true
		end
	end
	return false
end

function Stations.grillSummary()
	local summary = { Empty = 0, SideA = 0, Flip = 0, SideB = 0, Done = 0, Burnt = 0 }
	for _, spot in grill do
		summary[spot.state] += 1
	end
	return summary
end

local function grillAction(): string?
	local sum = Stations.grillSummary()
	if sum.Flip > 0 then
		return "Flip"
	elseif sum.Done > 0 then
		return "Take"
	elseif sum.Burnt > 0 then
		return "Scrape"
	elseif sum.Empty > 0 then
		return "Place"
	end
	return nil
end

local function onGrill(player: Player)
	if not ctx.Shift.canAct(player) then
		return
	end
	local action = grillAction()
	if action == "Flip" then
		Stations.grillFlipAny(player)
	elseif action == "Take" then
		if handsFree(player) then
			local item = Stations.grillTakeAny(player)
			if item then
				Stations.give(player, item)
			end
		end
	elseif action == "Scrape" then
		Stations.grillScrapeAny()
		ctx.notify(player, "Scraped a burnt patty into the trash.")
	elseif action == "Place" then
		Stations.grillPlace(player)
	end
end

local function updateGrill(now: number)
	local s = ctx.Shift.session
	for _, spot in grill do
		local elapsed = now - spot.t0
		if spot.state == "SideA" and elapsed >= Cook.PattySideA then
			setPatty(spot, "Flip")
			ctx.caption("[sizzle — FLIP!]", spot.position, 1.5)
		elseif spot.state == "SideB" and elapsed >= Cook.PattySideB then
			setPatty(spot, "Done")
		elseif
			(spot.state == "Flip" and elapsed >= Cook.FlipWindow + (spot.bonus or 0))
			or (spot.state == "Done" and elapsed >= Cook.DoneWindow)
		then
			setPatty(spot, "Burnt")
			if s then
				s.stats.burnt += 1
			end
			ctx.Bus:fire("PattyBurnt")
		end
	end
	local prompt = prompts.Grill
	if prompt then
		local action = grillAction()
		local texts = { Flip = "Flip Patty", Take = "Take Patty", Scrape = "Scrape Burnt", Place = "Place Patty" }
		prompt.ActionText = if action then texts[action] else "Grill Full"
		prompt.Enabled = action ~= nil
	end
end

---------------------------------------------------------------------------
-- Assembly plate
---------------------------------------------------------------------------

local function rebuildPlate()
	if plate.model then
		plate.model:Destroy()
		plate.model = nil
	end
	if #plate.stack > 0 then
		local model = ModelFactory.buildStack(plate.stack, Menu.Toppings)
		model.Name = "PlateStack"
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				d.Anchored = true
			end
		end
		model:PivotTo(CFrame.new(Layout.Stations.AssemblyPlate + Vector3.new(0, 0.1, 0)))
		model.Parent = folder()
		plate.model = model
	end
	local prompt = prompts.Assembly
	if prompt then
		prompt.ActionText = if plate.finished then "Take Burger" else "Build Burger"
	end
end

function Stations.plateData(player: Player?)
	local line = if #plate.stack > 0 then OrderLogic.identifyBurger(plate.stack) else nil
	return {
		stack = plate.stack,
		finished = plate.finished,
		label = if line then OrderLogic.lineLabel(line) elseif plate.finished then "Mystery Burger" else nil,
		holdingPatty = player ~= nil and held[player] ~= nil and held[player].kind == "Patty",
		grabby = ctx.WeirdEvents.isActive("GrabbyHands"),
	}
end

local function pushAssembly()
	for viewer in assemblyViewers do
		if viewer.Parent and ctx.Shift.canAct(viewer) then
			ctx.Remotes.OpenPanel:FireClient(viewer, "Assembly", Stations.plateData(viewer))
		else
			assemblyViewers[viewer] = nil
		end
	end
end

-- Stop pushing assembly updates to a player (booped, hid, left).
function Stations.forgetViewer(player: Player)
	if assemblyViewers[player] then
		assemblyViewers[player] = nil
		if player.Parent then
			ctx.closePanel(player, "Assembly")
		end
	end
	for _, station in pours do
		if station.holder == player then
			station.holder = nil
			if player.Parent then
				ctx.effect("PourEnd", {}, { player })
			end
		end
	end
end

function Stations.plateStack(): { string }
	return plate.stack
end

function Stations.plateFinished(): boolean
	return plate.finished
end

-- Adds a layer. Returns ok, message.
function Stations.plateAdd(op: string, by: any): (boolean, string?)
	if plate.finished then
		return false, "This burger is finished — take it first."
	end
	if op == "Bun" then
		if #plate.stack == 0 then
			table.insert(plate.stack, "BunBottom")
		else
			table.insert(plate.stack, "BunTop")
			plate.finished = true
		end
	elseif op == "Patty" then
		if #plate.stack == 0 then
			return false, "Start with a bottom bun."
		end
		table.insert(plate.stack, "Patty")
	elseif op == "Cheese" or op == "Lettuce" or op == "Pickles" or op == "Sauce" then
		if #plate.stack == 0 then
			return false, "Start with a bottom bun."
		end
		if ctx.WeirdEvents.isActive("GrabbyHands") then
			return false, "Tiny hands are holding the topping bins! Shoo them!"
		end
		table.insert(plate.stack, op)
	else
		return false, nil
	end
	rebuildPlate()
	pushAssembly()
	if plate.finished then
		ctx.Bus:fire("BurgerBuilt", plate.stack, by)
	end
	return true, nil
end

function Stations.plateTake()
	if not plate.finished then
		return nil
	end
	local item = OrderLogic.makeBurgerItem(plate.stack)
	plate.stack = {}
	plate.finished = false
	rebuildPlate()
	pushAssembly()
	return item
end

function Stations.plateClear()
	plate.stack = {}
	plate.finished = false
	rebuildPlate()
	pushAssembly()
end

local function onAssemblyAction(player: Player, data)
	if not ctx.Shift.canAct(player) then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root or (root.Position - Layout.Stations.AssemblyPlate).Magnitude > 14 then
		ctx.closePanel(player, "Assembly")
		assemblyViewers[player] = nil
		return
	end
	local op = tostring(data.op)
	if op == "Patty" then
		local item = held[player]
		if not item or item.kind ~= "Patty" then
			ctx.notify(player, "Grab a cooked patty from the grill first.")
			return
		end
		if #plate.stack == 0 then
			ctx.notify(player, "Start with a bottom bun.")
			return
		end
		Stations.takeHeld(player)
		Stations.plateAdd("Patty", player)
	elseif op == "Take" then
		if not plate.finished then
			ctx.notify(player, "Finish it with a top bun first.")
			return
		end
		if handsFree(player) then
			local item = Stations.plateTake()
			if item then
				Stations.give(player, item)
				ctx.closePanel(player, "Assembly")
				assemblyViewers[player] = nil
			end
		end
	elseif op == "Clear" then
		Stations.plateClear()
	elseif op == "Close" then
		assemblyViewers[player] = nil
	else
		local ok, message = Stations.plateAdd(op, player)
		if not ok and message then
			ctx.notify(player, message)
		end
	end
	pushAssembly()
end

---------------------------------------------------------------------------
-- Fryers + fry bin
---------------------------------------------------------------------------

local function fryerPart(i: number): BasePart
	return ctx.map.Kitchen:FindFirstChild("FryerBasket" .. i) :: BasePart
end

local function setFryer(i: number, state: string)
	local f = fryers[i]
	f.state = state
	f.t0 = os.clock()
	local basket = fryerPart(i)
	local fire = basket:FindFirstChild("FryFire")
	if state == "Fire" and not fire then
		local flames = Instance.new("Fire")
		flames.Name = "FryFire"
		flames.Size = 6
		flames.Heat = 9
		flames.Parent = basket
	elseif state ~= "Fire" and fire then
		fire:Destroy()
	end
	smoke(basket, state == "Burnt")
	basket.CFrame = CFrame.new(Layout.Stations.Fryers[i] + Vector3.new(0, if state == "Cooking" then -0.4 else 0.4, 0))
	if state == "Cooking" then
		setStatus(basket, "Frying...", Color3.fromRGB(200, 150, 40))
	elseif state == "Done" then
		setStatus(basket, "DING! Pull!", Color3.fromRGB(70, 160, 80))
	elseif state == "Burnt" then
		setStatus(basket, "BURNT", Color3.fromRGB(60, 60, 60))
	elseif state == "Fire" then
		setStatus(basket, "FIRE!", Color3.fromRGB(220, 60, 30))
	else
		setStatus(basket, nil)
	end
end

function Stations.fryerState(i: number): string
	return fryers[i].state
end

function Stations.fryerDrop(i: number, by: any): boolean
	if fryers[i].state ~= "Empty" then
		return false
	end
	setFryer(i, "Cooking")
	ctx.sound("Sizzle", Layout.Stations.Fryers[i])
	ctx.Bus:fire("FriesDropped", by)
	return true
end

function Stations.fryerPull(i: number, by: any): boolean
	local state = fryers[i].state
	if state == "Done" then
		fryPortions += Cook.FryPortions
		setFryer(i, "Empty")
		ctx.Bus:fire("FriesPulled", by)
		return true
	elseif state == "Burnt" then
		setFryer(i, "Empty")
		return true
	end
	return false
end

function Stations.fryerExtinguish(i: number, by: any): boolean
	if fryers[i].state ~= "Fire" then
		return false
	end
	setFryer(i, "Empty")
	ctx.caption("[fwoosh — fire's out]", Layout.Stations.Fryers[i], 2)
	if typeof(by) == "Instance" and by:IsA("Player") then
		ctx.Badges.award(by, "this_is_fine")
	end
	ctx.Bus:fire("FireOut", by)
	return true
end

function Stations.fryPortions(): number
	return fryPortions
end

function Stations.removePortions(n: number): number
	local removed = math.min(fryPortions, n)
	fryPortions -= removed
	return removed
end

function Stations.scoopFries(): any
	if fryPortions <= 0 then
		return nil
	end
	fryPortions -= 1
	return OrderLogic.makeSimpleItem("Fries")
end

local function onFryer(i: number, player: Player)
	if not ctx.Shift.canAct(player) then
		return
	end
	local state = fryers[i].state
	if state == "Empty" then
		Stations.fryerDrop(i, player)
	elseif state == "Done" then
		Stations.fryerPull(i, player)
		ctx.notify(player, ("+%d fries in the fry bin."):format(Cook.FryPortions), "good")
	elseif state == "Burnt" then
		Stations.fryerPull(i, player)
		ctx.notify(player, "Dumped burnt fries.", "bad")
	elseif state == "Fire" then
		Stations.fryerExtinguish(i, player)
	end
end

local function updateFryers(now: number)
	local s = ctx.Shift.session
	for i, f in fryers do
		local elapsed = now - f.t0
		if f.state == "Cooking" and elapsed >= Cook.FryTime then
			setFryer(i, "Done")
			ctx.sound("Ding", Layout.Stations.Fryers[i])
			ctx.caption("[fryer: DING!]", Layout.Stations.Fryers[i], 2)
		elseif f.state == "Done" and elapsed >= Cook.FryDoneWindow then
			setFryer(i, "Burnt")
			if s then
				s.stats.friesBurnt += 1
			end
			ctx.Bus:fire("FriesBurnt")
		elseif f.state == "Burnt" and elapsed >= Cook.FryFireAfter then
			setFryer(i, "Fire")
			if s then
				s.stats.fires += 1
			end
			ctx.caption("[FRY FIRE!]", Layout.Stations.Fryers[i], 3)
			ctx.Shift.addStars(-0.2, "Fry fire!")
			ctx.Bus:fire("FryFire")
		end
		local prompt = prompts["Fryer" .. i]
		if prompt then
			local texts = { Empty = "Drop Basket", Cooking = "Frying...", Done = "Pull Fries", Burnt = "Dump Burnt Fries", Fire = "Put Out Fire" }
			prompt.ActionText = texts[f.state]
			prompt.Enabled = f.state ~= "Cooking"
			prompt.HoldDuration = if f.state == "Fire" then 1.5 else 0
		end
	end
	local binPrompt = prompts.FryBin
	if binPrompt then
		binPrompt.ActionText = ("Scoop Fries (%d)"):format(fryPortions)
		binPrompt.Enabled = fryPortions > 0
	end
end

---------------------------------------------------------------------------
-- Drinks & shakes: hold to pour
---------------------------------------------------------------------------

local function fillSeconds(kind: string): number
	return if kind == "Shake" then Cook.ShakeFillSeconds else Cook.DrinkFillSeconds
end

function Stations.instantPour(kind: string)
	return OrderLogic.makeSimpleItem(kind)
end

local function setupPour(kind: string, part: BasePart)
	local station = { fill = 0, holder = nil :: Player?, start = 0 }
	pours[kind] = station
	local seconds = fillSeconds(kind)
	-- The hold auto-completes at 130% (a full overflow). Releasing between PerfectFillMin and 100%
	-- is a perfect pour; past 100% it overflows. Decided on release so the order in which Roblox fires
	-- PromptButtonHoldEnded / Triggered doesn't matter.
	local prompt = makePrompt(part, kind, "Hold to Pour", if kind == "Shake" then "Shake Machine" else "Soda Fountain", {
		HoldDuration = seconds * 1.3,
	})

	local function overflow(player: Player)
		station.fill = 0
		Stations.give(player, OrderLogic.makeSimpleItem(kind))
		ctx.Characters.addPuddle(part.Position + Vector3.new(0, 0, -5.5))
		ctx.notify(player, "OVERFLOW! The floor is sticky now.", "bad")
		ctx.caption("[splorsh — sticky floor]", part.Position, 2)
		ctx.Badges.award(player, "sticky")
		ctx.Bus:fire("DrinkPoured", player, kind, true)
	end

	local function finish(player: Player, completed: boolean)
		if station.holder ~= player then
			return
		end
		station.holder = nil
		ctx.effect("PourEnd", { kind = kind }, { player })
		if not ctx.Shift.canAct(player) or held[player] then
			return
		end
		local fill = if completed then 1.3 else station.fill + (os.clock() - station.start) / seconds
		if fill > 1 then
			overflow(player)
		elseif fill >= Cook.PerfectFillMin then
			station.fill = 0
			Stations.give(player, OrderLogic.makeSimpleItem(kind))
			ctx.notify(player, ("Perfect pour! (%d%%)"):format(math.floor(fill * 100)), "good")
			ctx.Bus:fire("DrinkPoured", player, kind, false)
		else
			station.fill = fill
			ctx.notify(player, ("Keep pouring... %d%% full"):format(math.floor(fill * 100)))
		end
	end

	prompt.PromptButtonHoldBegan:Connect(function(player)
		if not ctx.Shift.canAct(player) then
			return
		end
		if held[player] then
			ctx.notify(player, "Your hands are full.")
			return
		end
		local current = station.holder
		if current and current ~= player and current.Parent and ctx.Shift.canAct(current) then
			ctx.notify(player, current.DisplayName .. " is using that machine.")
			return
		end
		station.holder = player
		station.start = os.clock()
		ctx.effect("Pour", { kind = kind, fill = station.fill, seconds = seconds, perfect = Cook.PerfectFillMin }, { player })
	end)
	prompt.PromptButtonHoldEnded:Connect(function(player)
		local completed = station.holder == player and (os.clock() - station.start) >= seconds * 1.3 - 0.05
		finish(player, completed)
	end)
	prompt.Triggered:Connect(function(player)
		finish(player, true)
	end)
end

---------------------------------------------------------------------------
-- Lifecycle
---------------------------------------------------------------------------

function Stations.reset()
	Stations.cleanup()
end

function Stations.cleanup()
	for player in held do
		Stations.takeHeld(player)
	end
	for _, spot in grill do
		setPatty(spot, "Empty")
	end
	plate.stack = {}
	plate.finished = false
	rebuildPlate()
	for i in fryers do
		setFryer(i, "Empty")
	end
	fryPortions = 0
	for _, station in pours do
		station.fill = 0
		station.holder = nil
	end
	table.clear(assemblyViewers)
	if dynamic then
		dynamic:ClearAllChildren()
	end
	ctx.Characters.clearPuddles()
end

function Stations.init()
	local kitchen = ctx.map.Kitchen
	for i, pos in Layout.Stations.GrillSpots do
		grill[i] = { position = pos, state = "Empty", t0 = 0, part = nil, bonus = 0 }
	end
	local grillPrompt = makePrompt(kitchen.Grill, "Grill", "Place Patty", "Grill", { MaxActivationDistance = 9 })
	grillPrompt.Triggered:Connect(onGrill)

	local assembly = makePrompt(kitchen.AssemblyPlate, "Assembly", "Build Burger", "Assembly Board")
	assembly.Triggered:Connect(function(player)
		if not ctx.Shift.canAct(player) then
			return
		end
		if plate.finished and not held[player] then
			local item = Stations.plateTake()
			if item then
				Stations.give(player, item)
				return
			end
		end
		assemblyViewers[player] = true
		ctx.openPanel(player, "Assembly", Stations.plateData(player))
	end)
	ctx.onAction("Assembly", onAssemblyAction)

	for i in Layout.Stations.Fryers do
		fryers[i] = { state = "Empty", t0 = 0 }
		local prompt = makePrompt(kitchen:FindFirstChild("Fryer" .. i), "Fryer" .. i, "Drop Basket", "Fryer " .. i)
		prompt.Triggered:Connect(function(player)
			onFryer(i, player)
		end)
	end
	local bin = makePrompt(kitchen.FryBin, "FryBin", "Scoop Fries", "Fry Bin")
	bin.Triggered:Connect(function(player)
		if not ctx.Shift.canAct(player) or not handsFree(player) then
			return
		end
		local item = Stations.scoopFries()
		if item then
			Stations.give(player, item)
		end
	end)

	setupPour("Drink", kitchen.SodaFountain)
	setupPour("Shake", kitchen.ShakeMachine)

	for i in Layout.Stations.Trash do
		local trash = makePrompt(kitchen:FindFirstChild("Trash" .. i), "Trash" .. i, "Trash Item", "Trash", { MaxActivationDistance = 7 })
		trash.Triggered:Connect(function(player)
			local item = Stations.takeHeld(player)
			if item then
				ctx.notify(player, ("Trashed the %s."):format(item.label or item.kind))
			end
		end)
	end

	Players.PlayerRemoving:Connect(function(player)
		held[player] = nil
		assemblyViewers[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(0.1)
			local now = os.clock()
			if ctx.Shift.isRunning() then
				local ok, err = pcall(function()
					updateGrill(now)
					updateFryers(now)
				end)
				if not ok then
					warn("[Stations] " .. tostring(err))
				end
			end
		end
	end)
end

return Stations
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">Story</string>
            <string name="Source"><![CDATA[-- Story & lore (design doc §3, §6.2, §7.9): per-night scenery, the Employee of the Month wall
-- (with UV-only writing on the photos), Toby the trainee, Deb's guided first shift, story beats
-- (bobblehead, statue, PlayPlace light), the Night 5 reveal + Final Rush, VHS tapes and endings.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Layout = require(Shared.Builders.Layout)
local ModelFactory = require(Shared.Builders.ModelFactory)
local Anomalies = require(Shared.Data.Anomalies)
local StoryData = require(Shared.Data.Story)
local ctx = require(script.Parent.Context)

local Story = {}

local spawned: { Instance } = {}
local saved: { [Instance]: any } = {}
local tutorial: { [string]: boolean } = {}
local tobyThread: thread? = nil
local defaultFog = { start = 0, finish = 100000, color = Color3.fromRGB(192, 192, 192) }

local function track(inst: Instance)
	table.insert(spawned, inst)
	return inst
end

-- Show/hide a map instance tree without destroying it.
local function setVisible(inst: Instance, visible: boolean)
	local list = inst:GetDescendants()
	table.insert(list, inst)
	for _, d in list do
		if d:IsA("BasePart") then
			if not visible then
				if saved[d] == nil then
					saved[d] = d.Transparency
				end
				d.Transparency = 1
			elseif saved[d] ~= nil then
				d.Transparency = saved[d]
				saved[d] = nil
			end
		elseif d:IsA("SurfaceGui") or d:IsA("BillboardGui") or d:IsA("Light") or d:IsA("ParticleEmitter") then
			if d:IsA("ParticleEmitter") then
				continue
			end
			d.Enabled = visible
		end
	end
end

local function sceneryItem(name: string): Instance?
	return ctx.map.Scenery:FindFirstChild(name)
end

local function setLabel(part: Instance?, guiName: string, text: string)
	local gui = part and part:FindFirstChild(guiName)
	local label = gui and gui:FindFirstChild("Label") :: TextLabel?
	if label then
		label.Text = text
	end
end

---------------------------------------------------------------------------
-- Employee of the Month wall
---------------------------------------------------------------------------

local function photoContent(part: BasePart, photo, night: number)
	for _, child in part:GetChildren() do
		if child:IsA("SurfaceGui") then
			child:Destroy()
		end
	end
	local gui = Instance.new("SurfaceGui")
	gui.Name = "PhotoGui"
	gui.Face = Enum.NormalId.Back
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 60
	gui.LightInfluence = 0.5
	gui.Parent = part
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(0.86, 0.86)
	frame.Position = UDim2.fromScale(0.07, 0.05)
	frame.BackgroundColor3 = Color3.fromRGB(230, 225, 210)
	frame.BorderSizePixel = 0
	frame.Parent = gui
	local visible = not photo.showFromNight or night >= photo.showFromNight
	if photo.empty or not visible then
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = if photo.empty then "YOU?" else ""
		label.TextColor3 = Color3.fromRGB(150, 140, 120)
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.Parent = frame
		return
	end
	local skin = Color3.fromRGB(224, 172, 105)
	local hair = Color3.fromRGB(60, 40, 30)
	local anomaly = photo.anomaly and Anomalies.ById[photo.anomaly]
	if anomaly and anomaly.person then
		skin = anomaly.person.skin or skin
		hair = anomaly.person.hairColor or hair
	elseif photo.name == "Deb" then
		skin = Color3.fromRGB(241, 194, 125)
		hair = Color3.fromRGB(150, 150, 155)
	elseif photo.name == "Toby" then
		skin = Color3.fromRGB(255, 224, 189)
		hair = Color3.fromRGB(196, 156, 82)
	end
	local faceHolder = Instance.new("Frame")
	faceHolder.Size = UDim2.fromScale(0.7, 0.55)
	faceHolder.Position = UDim2.fromScale(0.15, 0.12)
	faceHolder.BackgroundTransparency = 1
	faceHolder.Parent = frame
	local hairBar = Instance.new("Frame")
	hairBar.Size = UDim2.fromScale(0.74, 0.12)
	hairBar.Position = UDim2.fromScale(0.13, 0.06)
	hairBar.BackgroundColor3 = hair
	hairBar.BorderSizePixel = 0
	hairBar.Parent = frame
	ModelFactory.drawFace(faceHolder, skin, nil)
	local plate = Instance.new("TextLabel")
	plate.Size = UDim2.fromScale(1, 0.26)
	plate.Position = UDim2.fromScale(0, 0.72)
	plate.BackgroundTransparency = 1
	plate.TextColor3 = Color3.fromRGB(90, 80, 70)
	plate.TextTransparency = 0.35 -- every name plate is slightly faded
	plate.Font = Enum.Font.GothamBold
	plate.TextScaled = true
	plate.Text = ("%s\n%s"):format(photo.name, if photo.year then tostring(photo.year) else "")
	plate.Parent = frame
end

local function uvContent(part: BasePart, photo)
	for _, child in part:GetChildren() do
		if child:IsA("SurfaceGui") then
			child:Destroy()
		end
	end
	local text
	local anomaly = photo.anomaly and Anomalies.ById[photo.anomaly]
	if anomaly and anomaly.photo then
		text = ("THE USUAL:\n%s\n— %s, %d"):format(anomaly.photo.usualText, anomaly.photo.employee, anomaly.photo.year)
	elseif photo.name == "Bart M." then
		text = "THE PROMISE WAS A MISTAKE"
	elseif photo.name == "Toby" then
		text = "NOT A SICK DAY"
	elseif photo.name == "Deb" then
		text = "I'LL HOLD THE DOOR"
	elseif photo.empty then
		text = "CLOCK OUT"
	else
		text = "STILL HERE"
	end
	ModelFactory.surfaceText(part, Enum.NormalId.Back, text, Color3.fromRGB(255, 255, 255), Enum.Font.Arcade)
	ModelFactory.channel(part, "UVOnly")
end

function Story.setupWall(night: number)
	local wall = ctx.map.Rooms:FindFirstChild("EmployeeWall")
	if not wall then
		return
	end
	for i, photo in StoryData.WallPhotos do
		local part = wall:FindFirstChild("Photo" .. i) :: BasePart?
		if part then
			photoContent(part, photo, night)
		end
		local uv = wall:FindFirstChild("PhotoUV" .. i) :: BasePart?
		if uv then
			uvContent(uv, photo)
		end
	end
end

---------------------------------------------------------------------------
-- UV flashlight & VHS
---------------------------------------------------------------------------

function Story.giveUV()
	local s = ctx.Shift.session
	if not s or s.flags.uv then
		return
	end
	s.flags.uv = true
	ctx.notifyCrew("You got SpookyPriya's UV flashlight! Press U (or tap UV) to reveal hidden marks.", "good")
	ctx.effect("UVUnlocked", {})
end

local vhsPrompt: ProximityPrompt? = nil

local function setupVHS()
	local tape = ctx.map.Rooms:FindFirstChild("VHSTape")
	if not tape then
		return
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Watch Tape"
	prompt.ObjectText = "VHS: Training Tape #1"
	prompt.RequiresLineOfSight = false
	prompt.MaxActivationDistance = 9
	prompt.Enabled = false
	prompt.Parent = tape
	vhsPrompt = prompt
	prompt.Triggered:Connect(function(player)
		if not ctx.Shift.canAct(player) then
			return
		end
		local tapeData = StoryData.VHSTapes[1]
		ctx.openPanel(player, "VHS", { title = tapeData.title, lines = tapeData.lines })
		ctx.Badges.award(player, "vhs")
	end)
end

---------------------------------------------------------------------------
-- Toby (Night 1)
---------------------------------------------------------------------------

local TOBY_LINES = {
	"Hi! I'm Toby! I'm in training! ...I'm Toby. In training.",
	"Flip at the sizzle! At the SIZZLE!",
	"Refuse the weird ones! The WEIRD ones!",
	"Deb says don't look at the PlayPlace. I looked. I'm fine. I'm fine.",
	"Hold to pour, let go in the green! Let go. In the green.",
	"Check the mirror at the window! The MIRROR!",
}

local function spawnToby()
	local toby = ModelFactory.buildCustomer({
		person = {
			skin = Color3.fromRGB(255, 224, 189),
			hairStyle = "Short",
			hairColor = Color3.fromRGB(196, 156, 82),
			shirt = Color3.fromRGB(215, 38, 61),
		},
		car = { kind = "None" },
		modifiers = {},
	})
	toby.Name = "Toby"
	local pos = Vector3.new(22, 0, -5)
	toby:PivotTo(CFrame.lookAt(pos, pos + Vector3.new(0, 0, 1)) * CFrame.Angles(0, math.rad(180), 0))
	local torso = toby:FindFirstChild("Torso") :: BasePart?
	if torso then
		local pin = Instance.new("Part")
		pin.Size = Vector3.new(1, 0.4, 0.05)
		pin.Color = Color3.fromRGB(244, 180, 0)
		pin.CFrame = torso.CFrame * CFrame.new(0.4, 0.5, -0.6)
		pin.Anchored = true
		pin.CanCollide = false
		ModelFactory.surfaceText(pin, Enum.NormalId.Front, "IN TRAINING", Color3.fromRGB(30, 30, 30), Enum.Font.GothamBold)
		pin.Parent = toby
	end
	toby.Parent = ctx.map.Dynamic
	track(toby)
	tobyThread = task.spawn(function()
		local i = 0
		while toby.Parent do
			task.wait(28)
			i += 1
			local root = toby.PrimaryPart
			if root and ctx.Shift.isRunning() then
				local fake = { model = toby, root = root }
				ctx.Customers.say(fake, TOBY_LINES[((i - 1) % #TOBY_LINES) + 1], 5)
			end
		end
	end)
end

---------------------------------------------------------------------------
-- Per-night setup
---------------------------------------------------------------------------

local STICKY_NOTES = {
	[4] = {
		{ "Fryer is fine??", Vector3.new(5, 2.6, 6.3) },
		{ "DON'T REFUSE GERALD", Vector3.new(-46, 6.6, 7.1) },
		{ "THE PHOTOS.", Vector3.new(22, 6, -22.6) },
		{ "CLOCK OUT?", Vector3.new(52, 6.4, -12.8) },
		{ "DON'T LOOK AT THE PLAYPLACE", Vector3.new(-56.6, 6, -18) },
	},
	[5] = {
		{ "SERVE THE ONES IN THE PHOTOS", Vector3.new(-46, 6.6, 7.1) },
		{ "THE REAL ORDER IS ON THE BACK (UV)", Vector3.new(22, 6, -22.6) },
		{ "DON'T LOOK AT FRYER", Vector3.new(5, 2.6, 6.3) },
		{ "I'll hold the door. — D", Vector3.new(52, 6.4, -12.8) },
	},
}

local function placeNotes(night: number)
	for _, note in STICKY_NOTES[night] or {} do
		local part = ModelFactory.buildStickyNote(note[1])
		local pos = note[2]
		-- face whichever way is "into the room" from the wall it sits on
		local facing = if pos.Z > 5 then Vector3.new(0, 0, -1) elseif pos.X < -56 then Vector3.new(1, 0, 0) else Vector3.new(0, 0, 1)
		part.CFrame = CFrame.lookAt(pos, pos + facing)
		part.Parent = ctx.map.Dynamic
		track(part)
	end
end

local function setPosters(revealed: boolean)
	local posters = ctx.map.Kitchen:FindFirstChild("Posters")
	if not posters then
		return
	end
	local texts = if revealed then StoryData.Posters.Revealed else StoryData.Posters.Normal
	for i, text in texts do
		setLabel(posters:FindFirstChild("Poster" .. i), "Text", text)
	end
end

local function setOpenSign(text: string)
	local sign = ctx.map.Lane:FindFirstChild("OpenSign")
	setLabel(sign, "OpenText", text)
	setLabel(sign, "OpenTextBack", text)
end

function Story.reset(s)
	Story.cleanup()
	local night = s.night
	local scenery = {}
	for _, name in s.data.scenery or {} do
		scenery[name] = true
	end
	for _, name in { "Balloons", "SafetyPoster", "VisitBanner" } do
		local item = sceneryItem(name)
		if item then
			setVisible(item, scenery[name] == true)
		end
	end
	local rain = sceneryItem("Rain")
	local emitter = rain and rain:FindFirstChild("RainEmitter") :: ParticleEmitter?
	if emitter then
		emitter.Enabled = scenery.Rain == true
	end
	if scenery.Fog or scenery.Rain then
		Lighting.FogStart = 30
		Lighting.FogEnd = if scenery.Rain then 220 else 160
		Lighting.FogColor = Color3.fromRGB(70, 75, 90)
	end
	setOpenSign(if scenery.OpenAlways then "OPEN ALWAYS." else "OPEN LATE. OPEN ALWAYS.")
	setPosters(false)
	Story.setupWall(night)
	placeNotes(night)
	local playLight = ctx.map.Lights:FindFirstChild("PlayPlaceLight")
	local light = playLight and playLight:FindFirstChildOfClass("PointLight")
	if light then
		light.Enabled = false
	end
	if scenery.OfficeEmpty or night >= 4 then
		local coffee = ctx.map.Rooms:FindFirstChild("DebCoffee")
		if coffee and coffee:IsA("BasePart") then
			local steam = Instance.new("Smoke")
			steam.Name = "Steam"
			steam.Size = 0.5
			steam.Opacity = 0.2
			steam.RiseVelocity = 2
			steam.Color = Color3.fromRGB(230, 230, 230)
			steam.Parent = coffee
			track(steam)
		end
	end
	if vhsPrompt then
		vhsPrompt.Enabled = night >= 4
	end
	if night >= 5 then
		s.flags.uv = true
	end
	if night == 1 then
		spawnToby()
	end
	table.clear(tutorial)
	s.flags.tutorial = s.data.tutorial == true and not s.fastStart
end

function Story.cleanup()
	for _, inst in spawned do
		if inst.Parent then
			inst:Destroy()
		end
	end
	table.clear(spawned)
	if tobyThread then
		pcall(task.cancel, tobyThread)
		tobyThread = nil
	end
	Lighting.FogStart = defaultFog.start
	Lighting.FogEnd = defaultFog.finish
	Lighting.FogColor = defaultFog.color
	setPosters(false)
	local rain = sceneryItem("Rain")
	local emitter = rain and rain:FindFirstChild("RainEmitter") :: ParticleEmitter?
	if emitter then
		emitter.Enabled = false
	end
end

---------------------------------------------------------------------------
-- Beats
---------------------------------------------------------------------------

local function bobbleheadFace(target: Vector3)
	local bobble = ctx.map.Kitchen:FindFirstChild("Bobblehead") :: Model?
	if not bobble or not bobble.PrimaryPart then
		return
	end
	local pos = bobble.PrimaryPart.Position
	bobble:PivotTo(CFrame.lookAt(pos, Vector3.new(target.X, pos.Y, target.Z)))
end

local function statueAtWindow(seconds: number)
	ctx.Scares.setStatueVisible(false)
	local statue = ModelFactory.buildMunch({ statue = true, anchored = true, realMouth = true, scale = 0.85 })
	statue.Name = "StatueAtWindow"
	statue:PivotTo(CFrame.lookAt(Layout.StatueAtWindow, Layout.StatueAtWindow + Vector3.new(0, 0, -10)))
	statue.Parent = ctx.map.Dynamic
	track(statue)
	task.delay(seconds, function()
		statue:Destroy()
		ctx.Scares.setStatueVisible(true)
	end)
end

function Story.beat(id: string, param: any?)
	local s = ctx.Shift.session
	if not s then
		return
	end
	if id == "Bobblehead" then
		ctx.effect("Blink", {})
		local target = Vector3.new(-45, 0, -22) -- the freezer
		if param == "Player" then
			local crew = ctx.Shift.crewPlayers()
			local player = crew[s.rng:NextInteger(1, math.max(1, #crew))]
			local root = player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root then
				target = root.Position
			end
		end
		bobbleheadFace(target)
		ctx.caption("[...the bobblehead turned.]", Layout.Stations.Bobblehead, 3)
	elseif id == "StatueGone" then
		ctx.Scares.setStatueVisible(false)
		ctx.caption("[something in the PlayPlace is... missing]", Layout.StatuePosition, 3)
	elseif id == "PlayPlaceLight" then
		local playLight = ctx.map.Lights:FindFirstChild("PlayPlaceLight")
		local light = playLight and playLight:FindFirstChildOfClass("PointLight")
		if light then
			light.Enabled = true
		end
		ctx.radio("Deb", "Is the PlayPlace light on? ...It shouldn't be.", 4)
	elseif id == "Reveal" then
		s.flags.revealed = true
		s.flags.uv = true
		ctx.effect("PowerOut", { seconds = 25 })
		ctx.effect("Jingle", { mode = "chorus" })
		for i, line in StoryData.Reveal do
			task.delay((i - 1) * 4, function()
				if ctx.Shift.session == s and s.phase == "Running" then
					ctx.radio("...", line, 4)
				end
			end)
		end
		setPosters(true)
		task.delay(9, function()
			if ctx.Shift.session ~= s or s.phase ~= "Running" then
				return
			end
			statueAtWindow(10)
			ctx.caption("[behind the window. its smile is not painted on.]", Layout.StatueAtWindow, 4)
		end)
	elseif id == "FinalRush" then
		s.flags.finalRush = true
		ctx.radio("Every Speaker", "OPEN. ALWAYS. OPEN. ALWAYS.", 4)
		ctx.caption("[the lane floods with headlights]", nil, 4)
		for _, player in ctx.Shift.crewPlayers() do
			if ctx.Hiding.spotOf(player) == "CostumeCloset" then
				s.flags.mascot = player
			end
		end
	end
end

---------------------------------------------------------------------------
-- Endings
---------------------------------------------------------------------------

function Story.ending(s, outcome: string): string
	local id
	if outcome == "fired" then
		id = "Fired"
	else
		local freed = 0
		for _ in s.stats.freed do
			freed += 1
		end
		id = if freed >= 3 then "Freed" else "Company"
	end
	local data = StoryData.Endings[id]
	local lines = table.clone(data.lines)
	local mascot: Player? = s.flags.mascot
	for _, player in ctx.Shift.crewPlayers() do
		ctx.PlayerData.markEnding(player, id)
		ctx.Badges.award(player, data.badge)
		local personal = table.clone(lines)
		if mascot == player then
			ctx.PlayerData.markEnding(player, "Mascot")
			ctx.PlayerData.own(player, "hat_munch")
			ctx.Badges.award(player, "secret_mascot")
			table.insert(personal, "")
			table.insert(personal, "— SECRET: " .. StoryData.Endings.Mascot.title .. " —")
			for _, line in StoryData.Endings.Mascot.lines do
				table.insert(personal, line)
			end
		end
		ctx.openPanel(player, "Ending", { id = id, title = data.title, lines = personal, credits = StoryData.Credits })
	end
	ctx.effect("EndingScene", { id = id })
	return id
end

---------------------------------------------------------------------------
-- Night 1 guided tutorial (Deb on the headset + station beacons)
---------------------------------------------------------------------------

local function once(key: string): boolean
	if tutorial[key] then
		return false
	end
	tutorial[key] = true
	return true
end

local function tutorialOn(): boolean
	local s = ctx.Shift.session
	return s ~= nil and s.flags.tutorial == true and s.phase == "Running"
end

local function beacon(target: string?)
	ctx.effect("Beacon", { target = target })
end

local function hookTutorial()
	ctx.Bus:on("CarAtSpeaker", function(car)
		if tutorialOn() and car.regularId == "Tutorial" and once("speaker") then
			ctx.radio("Deb", "Car's here. Take the order at the CRT — walk up and press E. You got this.", 5)
			beacon("OrderConsole")
		end
	end)
	ctx.Bus:on("OrderTaken", function(ticket)
		if tutorialOn() and ticket.car.regularId == "Tutorial" and once("ordered") then
			ctx.radio("Deb", "Now cook. Patty on the grill. FLIP it at the sizzle, then take it when it's DONE.", 6)
			beacon("Grill")
		end
	end)
	ctx.Bus:on("PattyTaken", function()
		if tutorialOn() and once("patty") then
			ctx.radio("Deb", "Build it on the plate. Bottom bun, patty, then follow the ticket stack. Top bun last.", 6)
			beacon("AssemblyPlate")
		end
	end)
	ctx.Bus:on("BurgerBuilt", function()
		if tutorialOn() and once("burger") then
			ctx.radio("Deb", "Carry it to the bag counter and bag it. Then fries: drop a basket, pull at the DING.", 6)
			beacon("BagCounter")
		end
	end)
	ctx.Bus:on("ItemBagged", function(_ticket, item)
		if not tutorialOn() then
			return
		end
		if item.kind == "Burger" and once("bagBurger") then
			beacon("Fryer1")
		elseif item.kind == "Fries" and once("bagFries") then
			ctx.radio("Deb", "Drinks: HOLD to pour at the soda fountain. Let go in the green. Don't flood my floor.", 6)
			beacon("SodaFountain")
		elseif item.kind == "Drink" and once("bagDrink") then
			ctx.radio("Deb", "Bag's done! When the car's at the window: inspect them... then HAND OUT.", 6)
			beacon("WindowStation")
		end
	end)
	ctx.Bus:on("FriesPulled", function()
		if tutorialOn() and once("pulled") then
			beacon("FryBin")
		end
	end)
	ctx.Bus:on("CarAtWindow", function(car)
		local s = ctx.Shift.session
		if not s or s.phase ~= "Running" then
			return
		end
		if s.night == 1 and car.anomalyId == "EarlOfEars" and once("earl") then
			ctx.radio("Deb", "...Uh. Look closely.", 4)
			beacon("WindowStation")
		elseif s.night == 2 and car.anomalyId == "MirrorMandy" and once("mandy") then
			ctx.radio("Deb", "Check the side MIRROR on the window screen for this one. Trust me.", 5)
		elseif s.night == 4 and car.regularId == "SpookyPriya" and once("priya") then
			ctx.radio("SpookyPriya", "Hiii! Come to the window! I have something for you!", 4)
		end
	end)
	ctx.Bus:on("Decision", function(car, decision, result)
		local s = ctx.Shift.session
		if not s then
			return
		end
		if car.regularId == "Tutorial" and tutorialOn() then
			beacon(nil)
			if result == "perfect" then
				ctx.radio("Deb", "Ding! A tip! See? Easy. ...Mostly.", 4)
			else
				ctx.radio("Deb", "Close enough. Read the ticket next time, rookie.", 4)
			end
		elseif car.anomalyId == "EarlOfEars" and s.night == 1 then
			beacon(nil)
			if decision == "refuse" then
				ctx.radio("Deb", "GOTCHA. That's a Late Customer. We refuse 'em. Don't count ears out loud.", 6)
			else
				ctx.radio("Deb", "...Okay. We don't serve those. You'll see why.", 5)
			end
		end
	end)
end

function Story.init()
	setupVHS()
	defaultFog = { start = Lighting.FogStart, finish = Lighting.FogEnd, color = Lighting.FogColor }
	hookTutorial()
	ctx.onAction("UsedUV", function(player)
		local s = ctx.Shift.session
		if s and s.flags.uv and ctx.Shift.isCrew(player) then
			ctx.Badges.award(player, "uv")
		end
	end)
	-- show the lobby-facing look (night 1 scenery) when no shift is running
	task.defer(function()
		Story.setupWall(1)
	end)
end

return Story
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">WeirdEvents</string>
            <string name="Source"><![CDATA[-- Weird events (design doc §7.6): the silly, disruptive consequence of serving a Late Customer.
-- "Serve a weird customer -> a funny problem." Never scary on their own.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Layout = require(Shared.Builders.Layout)
local ModelFactory = require(Shared.Builders.ModelFactory)
local Data = require(Shared.Data.WeirdEvents)
local OrderLogic = require(Shared.OrderLogic)
local ctx = require(script.Parent.Context)

local WeirdEvents = {}

local active: { [string]: { ends: number, props: { Instance } } } = {}
local propsFolder: Folder? = nil
local menuBoardText: string? = nil

local function props(): Folder
	if not propsFolder or not propsFolder.Parent then
		local f = Instance.new("Folder")
		f.Name = "WeirdProps"
		f.Parent = ctx.map.Dynamic
		propsFolder = f
	end
	return propsFolder :: Folder
end

function WeirdEvents.isActive(id: string): boolean
	local a = active[id]
	return a ~= nil and (a.ends == 0 or os.clock() < a.ends)
end

function WeirdEvents.snapshot()
	local out = {}
	local now = os.clock()
	for id, a in active do
		table.insert(out, { id = id, name = Data.ById[id].name, remaining = if a.ends == 0 then nil else math.max(0, a.ends - now) })
	end
	return out
end

local function kitchenPoint(rng: Random): Vector3
	return Vector3.new(rng:NextNumber(-50, 50), Layout.Floor, rng:NextNumber(-10, 4))
end

local function menuBoardLabel(): TextLabel?
	local board = ctx.map.Lane:FindFirstChild("MenuBoard")
	local gui = board and board:FindFirstChild("Menu")
	return gui and gui:FindFirstChild("Label") :: TextLabel?
end

local function finish(id: string)
	local a = active[id]
	if not a then
		return
	end
	active[id] = nil
	for _, inst in a.props do
		if inst.Parent then
			inst:Destroy()
		end
	end
	if id == "ChannelSurf" then
		local label = menuBoardLabel()
		if label and menuBoardText then
			label.Text = menuBoardText
		end
	end
	ctx.effect("WeirdEventEnd", { id = id })
end
WeirdEvents.finish = finish

---------------------------------------------------------------------------
-- Raccoons
---------------------------------------------------------------------------

local function spawnRaccoon(record, start: Vector3, target: Vector3)
	local raccoon = ModelFactory.buildRaccoon()
	raccoon:PivotTo(CFrame.lookAt(start, target))
	raccoon.Parent = props()
	table.insert(record.props, raccoon)
	local root = raccoon.PrimaryPart :: BasePart
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Shoo!"
	prompt.ObjectText = "Raccoon"
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.F
	prompt.Exclusivity = Enum.ProximityPromptExclusivity.AlwaysShow
	prompt.Parent = root
	local shooed = false
	prompt.Triggered:Connect(function(player)
		if shooed or not ctx.Shift.canAct(player) then
			return
		end
		shooed = true
		prompt:Destroy()
		ctx.caption("[angry raccoon chittering]", root.Position, 2)
		local exit = Vector3.new(root.Position.X, Layout.Floor, -20)
		local tween = TweenService:Create(root, TweenInfo.new(1.2), { CFrame = CFrame.lookAt(exit, exit + (exit - root.Position)) })
		tween:Play()
		tween.Completed:Wait()
		raccoon:Destroy()
		local remaining = 0
		for _, p in record.props do
			if p.Parent and p:IsA("Model") then
				remaining += 1
			end
		end
		if remaining == 0 then
			finish("Raccoons")
			ctx.notifyCrew("All raccoons shooed!", "good")
		end
	end)
	TweenService:Create(root, TweenInfo.new(2.5, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(target, target + (target - start)) }):Play()
	task.spawn(function()
		task.wait(3)
		while raccoon.Parent and WeirdEvents.isActive("Raccoons") do
			local label, number = ctx.Orders.stealFromBag()
			if label then
				ctx.notifyCrew(("A raccoon stole the %s from #%d!"):format(label, number), "bad")
				ctx.caption("[rustling bag]", root.Position, 2)
			end
			task.wait(6)
		end
	end)
end

function WeirdEvents.raccoonsFlee(car)
	if not car.root then
		return
	end
	local start = car.root.Position
	for i = 1, 3 do
		local raccoon = ModelFactory.buildRaccoon()
		local from = start + Vector3.new(i - 2, 0, -3)
		local to = from + Vector3.new(40 + i * 6, 0, 8)
		raccoon:PivotTo(CFrame.lookAt(from, to))
		raccoon.Parent = props()
		local tween = TweenService:Create(raccoon.PrimaryPart :: BasePart, TweenInfo.new(2.2, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(to, to + (to - from)) })
		tween:Play()
		task.delay(2.3, function()
			raccoon:Destroy()
		end)
	end
end

---------------------------------------------------------------------------
-- Handlers
---------------------------------------------------------------------------

local handlers = {}

handlers.EarRain = function(record)
	local rng = Random.new()
	for _ = 1, 40 do
		local ear = ModelFactory.buildEar()
		local landing = kitchenPoint(rng)
		ear.CFrame = CFrame.new(landing.X, 15, landing.Z) * CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), 0)
		ear.Anchored = true
		ear.Parent = props()
		table.insert(record.props, ear)
		TweenService:Create(ear, TweenInfo.new(rng:NextNumber(0.8, 2.5), Enum.EasingStyle.Bounce), {
			CFrame = CFrame.new(landing.X, Layout.Floor + 0.3, landing.Z) * CFrame.Angles(math.rad(90), rng:NextNumber(0, 6), 0),
		}):Play()
	end
	ctx.caption("[it is raining... ears]", nil, 3)
end

handlers.Raccoons = function(record)
	for i = 1, 3 do
		local start = Vector3.new(36 + i * 2, Layout.Floor, -16)
		local target = Vector3.new(28 + i * 4, Layout.Floor, 4.5)
		spawnRaccoon(record, start, target)
	end
	ctx.caption("[chittering from the hallway]", Vector3.new(40, 3, -16), 3)
end

handlers.GrabbyHands = function(record)
	local kitchen = ctx.map.Kitchen
	for i = 1, 5 do
		local hand = Instance.new("Part")
		hand.Name = "GrabbyHand"
		hand.Size = Vector3.new(0.6, 0.8, 0.5)
		hand.Color = Color3.fromRGB(241, 194, 125)
		hand.CFrame = CFrame.new(-15 + (i - 1) * 1.9, Layout.FrontCounter.top + 0.9, 10)
		hand.Anchored = true
		hand.CanCollide = false
		hand.Parent = props()
		table.insert(record.props, hand)
	end
	local board = kitchen:FindFirstChild("CuttingBoard") :: BasePart
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Shoo the Hands"
	prompt.ObjectText = "Grabby Hands"
	prompt.KeyboardKeyCode = Enum.KeyCode.F
	prompt.Exclusivity = Enum.ProximityPromptExclusivity.AlwaysShow
	prompt.HoldDuration = 1
	prompt.RequiresLineOfSight = false
	prompt.MaxActivationDistance = 9
	prompt.Parent = board
	table.insert(record.props, prompt)
	prompt.Triggered:Connect(function(player)
		if ctx.Shift.canAct(player) then
			finish("GrabbyHands")
			ctx.notifyCrew(player.DisplayName .. " shooed the grabby hands!", "good")
		end
	end)
end

handlers.GravityFries = function(record)
	local lost = ctx.Stations.removePortions(999)
	local dropped = ctx.Stations.dropHeldOfKind("Fries")
	local rng = Random.new()
	for _ = 1, 24 do
		local fry = Instance.new("Part")
		fry.Name = "FloatingFry"
		fry.Size = Vector3.new(0.2, 1.1, 0.2)
		fry.Color = Color3.fromRGB(255, 214, 92)
		fry.Anchored = true
		fry.CanCollide = false
		local start = Layout.Stations.FryBin + Vector3.new(rng:NextNumber(-2, 2), 0.5, rng:NextNumber(-1, 1))
		fry.CFrame = CFrame.new(start)
		fry.Parent = props()
		table.insert(record.props, fry)
		TweenService:Create(fry, TweenInfo.new(rng:NextNumber(2, 4), Enum.EasingStyle.Sine), {
			CFrame = CFrame.new(start.X + rng:NextNumber(-10, 10), 15.6, start.Z + rng:NextNumber(-6, 4)) * CFrame.Angles(0, 0, math.rad(90)),
		}):Play()
	end
	ctx.notifyCrew(("The fries floated to the ceiling! (-%d fries)"):format(lost + dropped), "bad")
end

handlers.Doilies = function()
	local s = ctx.Shift.session
	if s then
		s.flags.doilies = true
	end
	local spots = {
		Vector3.new(-50, 0, 8.5),
		Vector3.new(-38, 0, 8.5),
		Vector3.new(-17, 0, 9.5),
		Vector3.new(-5, 0, 8),
		Vector3.new(15, 0, 9.8),
		Vector3.new(30, 0, 8),
		Vector3.new(42, 0, 8),
		Vector3.new(54, 0, 8.5),
		Vector3.new(-20, 0, -11.5),
		Vector3.new(20, 0, -11.5),
	}
	for _, spot in spots do
		local doily = ModelFactory.buildDoily()
		doily.CFrame = CFrame.new(spot.X, Layout.FrontCounter.top + 0.04, spot.Z) * CFrame.Angles(0, 0, math.rad(90))
		doily.Parent = props()
	end
	-- doilies stay for the rest of the night (cleaned up on reset)
end

handlers.GhostRider = function(record)
	task.spawn(function()
		while WeirdEvents.isActive("GhostRider") and active.GhostRider == record do
			task.wait(7)
			if not WeirdEvents.isActive("GhostRider") or active.GhostRider ~= record or not ctx.Shift.isRunning() then
				break
			end
			local tickets = ctx.Orders.tickets
			if #tickets > 0 then
				local ticket = tickets[math.random(1, #tickets)]
				local kinds = { "Drink", "Shake", "Fries" }
				local item = OrderLogic.makeSimpleItem(kinds[math.random(1, #kinds)])
				table.insert(ticket.bag, item)
				ctx.Orders.refreshBags()
				ctx.notifyCrew(("An invisible helper bagged a %s into #%d. Use Fix Bags!"):format(item.label, ticket.number), "bad")
			end
		end
	end)
end

handlers.ChannelSurf = function()
	local label = menuBoardLabel()
	if label then
		menuBoardText = menuBoardText or label.Text
		label.Text = "▒▓░ CH 3 ░▓▒\n▓░ SATURDAY ░▓\n░▒ CARTOONS ▒░"
	end
end

handlers.MascotMob = function(record)
	for i = 1, 4 do
		local mob = ModelFactory.buildMunch({ scale = 0.55, anchored = true, knockoff = true })
		local pos = Vector3.new(10 + i * 7, 0, Layout.LaneZ + 8)
		mob:PivotTo(CFrame.lookAt(pos, pos - Vector3.new(0, 0, 10)))
		mob.Parent = props()
		table.insert(record.props, mob)
	end
	task.spawn(function()
		local t = 0
		while active.MascotMob == record do
			t += 0.15
			for i, m in record.props do
				if m:IsA("Model") and m.Parent then
					local base = Vector3.new(10 + i * 7, math.abs(math.sin(t * 4 + i)) * 1.5, Layout.LaneZ + 8)
					m:PivotTo(CFrame.new(base) * CFrame.Angles(0, t * 3 + i, 0))
				end
			end
			task.wait(0.15)
		end
	end)
end

---------------------------------------------------------------------------

function WeirdEvents.trigger(id: string, _car: any?)
	local def = Data.ById[id]
	if not def then
		warn("[WeirdEvents] unknown event " .. tostring(id))
		return
	end
	if active[id] then
		finish(id)
	end
	local record = { ends = if def.duration > 0 then os.clock() + def.duration else 0, props = {} }
	active[id] = record
	ctx.effect("WeirdEvent", { id = id, name = def.name, banner = def.banner, description = def.description, duration = def.duration })
	ctx.Bus:fire("WeirdEvent", id)
	local handler = handlers[id]
	if handler then
		local ok, err = pcall(handler, record)
		if not ok then
			warn("[WeirdEvents] " .. id .. ": " .. tostring(err))
		end
	end
end

function WeirdEvents.stop()
	for id in table.clone(active) do
		finish(id)
	end
	if propsFolder then
		propsFolder:ClearAllChildren() -- doilies, fleeing raccoons, floating fries...
	end
end

function WeirdEvents.reset()
	WeirdEvents.stop()
	if propsFolder then
		propsFolder:ClearAllChildren()
	end
	local label = menuBoardLabel()
	if label and menuBoardText then
		label.Text = menuBoardText
	end
end

function WeirdEvents.init()
	task.spawn(function()
		while true do
			task.wait(0.25)
			local now = os.clock()
			for id, a in table.clone(active) do
				if a.ends ~= 0 and now >= a.ends then
					finish(id)
				end
			end
		end
	end)
end

return WeirdEvents
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">Window</string>
            <string name="Source"><![CDATA[-- Inspection & Decision (design doc §5.1, §7.2, §7.5): the pickup window. Players inspect the car
-- (Window / Mirror / Lane Cam / Receipt / UV), then HAND OUT or REFUSE (slam the shutter).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Layout = require(Shared.Builders.Layout)
local OrderLogic = require(Shared.OrderLogic)
local People = require(Shared.Data.People)
local Util = require(Shared.Util)
local ctx = require(script.Parent.Context)

local Window = {}

local viewers: { [Player]: number } = {} -- player -> carId being inspected
local prompt: ProximityPrompt? = nil
local shutter: BasePart? = nil
local shutterOpen: CFrame? = nil

function Window.inspecting(car): boolean
	for _, carId in viewers do
		if carId == car.id then
			return true
		end
	end
	return false
end

local function slamShutter()
	if not shutter or not shutterOpen then
		return
	end
	local closed = (shutterOpen :: CFrame) * CFrame.new(0, -4.8, 0)
	local down = TweenService:Create(shutter, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = closed })
	down:Play()
	ctx.sound("Shutter", Layout.Stations.Window)
	ctx.caption("[SLAM — 'SORRY, WE'RE CLOSED']", Layout.Stations.Window, 2)
	task.delay(2.2, function()
		TweenService:Create(shutter :: BasePart, TweenInfo.new(0.6), { CFrame = shutterOpen :: CFrame }):Play()
	end)
end

function Window.openFor(player: Player)
	if not ctx.Shift.canAct(player) then
		return
	end
	local car = ctx.Customers.windowCar()
	if not car then
		ctx.notify(player, "No car at the window yet.")
		return
	end
	local s = ctx.Shift.session
	viewers[player] = car.id
	local bagStatus = nil
	if car.ticket then
		local result = OrderLogic.compare(car.ticket.lines, car.ticket.bag)
		bagStatus = {
			number = car.ticket.number,
			bagged = #car.ticket.bag,
			ticketLines = #car.ticket.lines,
			ticketMatched = result.matched,
			flagged = car.ticket.flagged,
		}
	end
	ctx.openPanel(player, "Window", {
		carId = car.id,
		car = car.model,
		receipt = if car.ticket then car.ticket.receipt else nil,
		bag = bagStatus,
		mirrorTell = car.mirrorTell or "None",
		uv = s.flags.uv == true,
		night = s.night,
		onFoot = car.skipSpeaker == true,
		revealed = s.flags.revealed == true,
		wantsUsual = car.wantsUsual == true,
		tutorialRefuse = s.night == 1 and car.anomalyId == "EarlOfEars",
	})
	ctx.Bus:fire("WindowOpened", car, player)
end

local function closeViewersOf(car)
	for viewer, carId in viewers do
		if carId == car.id then
			viewers[viewer] = nil
			if viewer.Parent then
				ctx.closePanel(viewer, "Window")
			end
		end
	end
end

local function fieldGuide(car, how: string)
	if not car.anomalyId then
		return
	end
	for _, p in ctx.Shift.crewPlayers() do
		local new = ctx.PlayerData.addFieldGuide(p, car.anomalyId, how)
		if new then
			ctx.effect("FieldGuideCard", { id = car.anomalyId, how = how }, { p })
		end
		local profile = ctx.PlayerData.get(p)
		if profile then
			local n = 0
			for _ in profile.fieldGuide do
				n += 1
			end
			if n >= 10 then
				ctx.Badges.award(p, "field_guide10")
			end
		end
	end
end

local function handOut(player: Player, car)
	local s = ctx.Shift.session
	local bag = if car.ticket then car.ticket.bag else {}
	local def = car.def
	if car.kind == "Special" then
		-- SpookyPriya gives the crew her UV flashlight either way.
		ctx.Story.giveUV()
		ctx.Customers.say(car, def.servedLine or "Thanks!")
		return "special"
	end
	if car.isLate then
		if s.flags.revealed and def.photo and car.wantsUsual then
			local result = OrderLogic.compare(def.photo.usual, bag)
			if result.perfect then
				s.stats.freed[def.id] = true
				ctx.Customers.say(car, def.freedLine or "Thank you.", 6)
				ctx.effect("Freed", { carId = car.id, name = def.photo.employee, year = def.photo.year })
				ctx.radio(def.photo.employee, def.freedLine or "Thank you.", 6)
				ctx.Shift.addWeird(-10)
				ctx.Shift.addStars(0.3, "Freed " .. def.photo.employee)
				for _, p in ctx.Shift.crewPlayers() do
					ctx.PlayerData.markFreed(p, def.id)
					ctx.Badges.award(p, "freed")
				end
				ctx.Shift.moment(("%s handed %s their usual. %s drove off into the morning light."):format(player.DisplayName, def.photo.employee, def.photo.employee), 90)
				ctx.Bus:fire("Freed", car, player)
				fieldGuide(car, "caught")
				return "freed"
			end
			ctx.Customers.say(car, "...That's not my usual.", 4)
		else
			ctx.Customers.say(car, def.servedLine or "...Thank you.")
		end
		s.stats.lateServed += 1
		ctx.Shift.addWeird(Config.Weird.ServedLate)
		fieldGuide(car, "seen")
		ctx.Badges.award(player, "served_late")
		ctx.WeirdEvents.trigger(def.weirdEvent, car)
		ctx.Shift.moment(("%s served %s. Then: %s."):format(player.DisplayName, def.name, def.weirdEvent), 40)
		return "servedLate"
	end
	-- normal humans and regulars
	local result = OrderLogic.compare(car.order or {}, bag)
	s.stats.served += 1
	if def and def.alwaysHappy then
		ctx.Shift.addStars(if result.perfect then Config.Stars.Perfect else Config.Stars.Okay, "Gerald")
		ctx.Customers.say(car, def.servedLine)
		if result.perfect then
			s.stats.perfect += 1
			ctx.Badges.award(player, "hold_the_seven")
		end
		return "perfect"
	end
	if result.perfect then
		s.stats.perfect += 1
		ctx.Shift.addStars(Config.Stars.Perfect + ((def and def.bonusStars) or 0), "Perfect order")
		ctx.Badges.award(player, "perfect")
		local line = if def and def.servedLineByNight and def.servedLineByNight[s.night]
			then def.servedLineByNight[s.night]
			elseif def and def.servedLine then def.servedLine
			else People.pick(People.Thanks, s.rng)
		ctx.Customers.say(car, line)
		ctx.sound("Ding", Layout.Stations.Window)
		if def and def.id == "Hendersons" and car.kids and car.kids >= 9 then
			ctx.Badges.awardCrew("hendersons9")
		end
		for _, p in ctx.Shift.crewPlayers() do
			ctx.PlayerData.addStat(p, "perfect", 1)
		end
		return "perfect"
	end
	s.stats.wrong += 1
	local missing = #result.missing
	if result.matched > 0 and missing <= 1 and #result.extras <= 1 then
		ctx.Shift.addStars(Config.Stars.Okay * 0.5, "Close enough")
		ctx.Customers.say(car, if missing > 0 then "Hey, you forgot something... whatever." else "Uh, extra stuff? Okay.")
		return "okay"
	end
	ctx.Shift.addStars(Config.Stars.WrongOrder, "Wrong order")
	ctx.Customers.say(car, if def and def.wrongLine then def.wrongLine else People.pick(People.Complaints, s.rng))
	return "wrong"
end

local function refuse(player: Player, car)
	local s = ctx.Shift.session
	local def = car.def
	slamShutter()
	if car.kind == "Special" then
		ctx.Story.giveUV()
		ctx.Customers.say(car, def.refusedLine or "Okay!")
		return "special"
	end
	if car.isLate then
		s.stats.caught += 1
		if not s.stats.firstCatch then
			s.stats.firstCatch = ("%s refused %s at %s"):format(player.DisplayName, def.name, Util.formatClock(s.minutes))
		end
		if s.flags.revealed then
			s.stats.companyRefusals += 1
		end
		ctx.Shift.addStars(Config.Stars.CaughtLate, "GOTCHA!")
		ctx.effect("Gotcha", { name = def.name })
		ctx.sound("Gotcha", Layout.Stations.Window)
		ctx.Customers.say(car, def.refusedLine or "...")
		ctx.Badges.award(player, "gotcha")
		if def.id == "TotallyNormalFamily" then
			ctx.Badges.awardCrew("refused_raccoon")
			ctx.WeirdEvents.raccoonsFlee(car)
		end
		if car.ticket and OrderLogic.compare(car.order or {}, car.ticket.bag).perfect and #car.ticket.bag > 0 then
			ctx.Badges.award(player, "perfect_raccoon")
		end
		for _, p in ctx.Shift.crewPlayers() do
			ctx.PlayerData.addStat(p, "lateCaught", 1)
		end
		fieldGuide(car, "caught")
		ctx.Shift.moment(("%s caught %s at the window. GOTCHA!"):format(player.DisplayName, def.name), 30)
		return "caught"
	end
	s.stats.refusedNormal += 1
	ctx.Shift.addStars(Config.Stars.RefusedNormal, "Refused a normal customer")
	ctx.Customers.say(car, (def and def.refusedLine) or "What?! I didn't do anything!")
	if def and def.id == "Hendersons" then
		ctx.Badges.award(player, "not_anomalies")
		ctx.Shift.moment(("%s refused the Hendersons. They were normal."):format(player.DisplayName), 50)
	end
	return "refusedNormal"
end

function Window.decide(player: Player, carId: number, decision: string)
	if not ctx.Shift.canAct(player) then
		return
	end
	local car = ctx.Customers.get(carId)
	if not car or car.decided or car.state ~= "AtWindow" then
		ctx.closePanel(player, "Window")
		return
	end
	car.decided = true
	local result
	if decision == "handout" then
		result = handOut(player, car)
	else
		result = refuse(player, car)
	end
	closeViewersOf(car)
	ctx.Bus:fire("Decision", car, decision, result, player)
	task.delay(if decision == "refuse" then 1.4 else 0.6, function()
		ctx.Customers.leave(car)
	end)
end

function Window.reset()
	table.clear(viewers)
end

function Window.init()
	local kitchen = ctx.map.Kitchen
	shutter = kitchen:FindFirstChild("WindowShutter") :: BasePart?
	if shutter then
		shutterOpen = shutter.CFrame
	end
	local p = Instance.new("ProximityPrompt")
	p.Name = "WindowPrompt"
	p.ActionText = "Inspect Car"
	p.ObjectText = "Pickup Window"
	p.MaxActivationDistance = 9
	p.RequiresLineOfSight = false
	p.Enabled = false
	p.Parent = kitchen.WindowStation
	prompt = p
	p.Triggered:Connect(Window.openFor)
	ctx.onAction("Decide", function(player, data)
		Window.decide(player, tonumber(data.carId) or -1, if data.decision == "handout" then "handout" else "refuse")
	end)
	ctx.onAction("CloseWindow", function(player)
		viewers[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(0.25)
			local car = if ctx.Shift.isRunning() then ctx.Customers.windowCar() else nil
			local enabled = car ~= nil and not car.decided
			if prompt and prompt.Enabled ~= enabled then
				prompt.Enabled = enabled
			end
			for viewer, carId in viewers do
				local viewed = ctx.Customers.get(carId)
				if not viewer.Parent or not viewed or viewed.state ~= "AtWindow" then
					viewers[viewer] = nil
					if viewer.Parent then
						ctx.closePanel(viewer, "Window")
					end
				end
			end
		end
	end)
end

return Window
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="49">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterGui" referent="50">
    <Properties>
      <string name="Name">StarterGui</string>
      <bool name="ResetPlayerGuiOnSpawn">false</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="51">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">30</float>
      <float name="CharacterJumpPower">40</float>
      <bool name="CharacterUseJumpPower">true</bool>
      <float name="CharacterWalkSpeed">16</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="52">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="53">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="54">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">AssemblyPanel</string>
              <string name="Source"><![CDATA[-- The assembly board (design doc §6.4 "Grill: place on bun -> add toppings in order (ticket shows
-- stack)"). Pick a target from the ticket rail; the next layer you need is highlighted (snap assist).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Layout = require(Shared.Builders.Layout)
local Menu = require(Shared.Data.Menu)
local Kit = require(script.Parent.Parent.UI.Kit)
local State = require(script.Parent.State)
local Panels = require(script.Parent.Panels)

local T = Kit.Theme
local player = Players.LocalPlayer

local AssemblyPanel = {}

local layer: Frame
local targetList: Frame
local targetStack: Frame
local plateStack: Frame
local hint: TextLabel
local buttons: { [string]: TextButton } = {}
local takeButton: TextButton
local data: any = nil
local targetIndex = 1
local lastTargetSig = ""

local OP_FOR = { BunBottom = "Bun", BunTop = "Bun", Patty = "Patty", Cheese = "Cheese", Lettuce = "Lettuce", Pickles = "Pickles", Sauce = "Sauce" }

local function burgerTargets()
	local out = {}
	local shift = State.shift
	if not shift then
		return out
	end
	for _, ticket in shift.tickets or {} do
		for _, line in ticket.lines do
			if line.stack and not line.done then
				table.insert(out, { number = ticket.number, label = line.label, stack = line.stack })
			end
		end
	end
	return out
end

local function drawStack(container: Frame, stack: { string }, highlightIndex: number?)
	Kit.clear(container)
	for i = #stack, 1, -1 do
		local topping = stack[i]
		local info = Menu.Toppings[topping]
		local bar = Kit.label(container, (info and info.label or topping) .. (if i == highlightIndex then "  ◀ NEXT" else ""), {
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundTransparency = 0,
			BackgroundColor3 = if info then info.color else T.panelLight,
			TextColor3 = if topping == "Patty" or topping == "Pickles" then T.white else T.ink,
			Font = T.bold,
			LayoutOrder = #stack - i,
			MaxText = 16,
		})
		Kit.corner(bar, 8)
		if i == highlightIndex then
			Kit.stroke(bar, T.white, 3)
		end
	end
	if #stack == 0 then
		Kit.label(container, "(empty plate)", { Size = UDim2.new(1, 0, 0, 30), TextColor3 = T.muted, MaxText = 16 })
	end
end

local function render()
	if not data then
		return
	end
	local targets = burgerTargets()
	targetIndex = math.clamp(targetIndex, 1, math.max(1, #targets))
	-- only rebuild the target buttons when they actually change (never under the player's finger)
	local sigParts = { tostring(targetIndex) }
	for i, t in targets do
		if i <= 5 then
			table.insert(sigParts, t.number .. t.label)
		end
	end
	local sig = table.concat(sigParts, "|")
	if sig ~= lastTargetSig then
		lastTargetSig = sig
		Kit.clear(targetList)
		for i, t in targets do
			if i > 5 then
				break
			end
			Kit.button(targetList, ("#%d %s"):format(t.number, t.label), if i == targetIndex then T.ketchup else T.panelLight, function()
				targetIndex = i
				render()
			end, { Size = UDim2.new(1, 0, 0, 40), LayoutOrder = i, Font = T.bold })
		end
		if #targets == 0 then
			Kit.label(targetList, "No burgers on the tickets.", { Size = UDim2.new(1, 0, 0, 30), TextColor3 = T.muted, MaxText = 16 })
		end
	end
	local target = targets[targetIndex]
	local plate = data.stack or {}
	local nextIndex = nil
	local nextLayer = nil
	if target then
		local matches = #plate <= #target.stack
		for i, layerName in plate do
			if target.stack[i] ~= layerName then
				matches = false
			end
		end
		if matches and #plate < #target.stack then
			nextIndex = #plate + 1
			nextLayer = target.stack[nextIndex]
		end
		drawStack(targetStack, target.stack, nextIndex)
		if not matches then
			hint.Text = "⚠ The plate doesn't match this ticket. CLEAR it or pick another target."
			hint.TextColor3 = T.bad
		elseif nextLayer then
			hint.Text = "NEXT: " .. (Menu.Toppings[nextLayer] and Menu.Toppings[nextLayer].label or nextLayer)
			hint.TextColor3 = T.mustard
		else
			hint.Text = "Done! TAKE BURGER and bag it."
			hint.TextColor3 = T.good
		end
	else
		Kit.clear(targetStack)
		hint.Text = if data.finished then "Finished: " .. tostring(data.label) else "Build whatever you like."
		hint.TextColor3 = T.muted
	end
	if data.grabby then
		hint.Text = "✋ GRABBY HANDS are holding the topping bins! Shoo them (F at the board)."
		hint.TextColor3 = T.bad
	end
	drawStack(plateStack, plate, nil)
	local holdingPatty = player:GetAttribute("Holding") == "Cooked Patty"
	for op, button in buttons do
		local isNext = nextLayer ~= nil and OP_FOR[nextLayer] == op
		local enabled = not data.finished
		if op == "Patty" then
			enabled = enabled and holdingPatty
		elseif op ~= "Bun" then
			enabled = enabled and not data.grabby and #plate > 0
		end
		button.Active = enabled
		button.AutoButtonColor = enabled
		button.BackgroundColor3 = if not enabled then T.ink elseif isNext then T.mustard else T.panelLight
		button.TextColor3 = if isNext then T.ink else (if enabled then T.white else T.muted)
	end
	takeButton.Visible = data.finished == true
end

local function build()
	layer = Panels.layer("Assembly", 0.25)
	local _, content = Kit.panel(layer, "ASSEMBLY BOARD", UDim2.fromOffset(980, 560), function()
		State.action("Assembly", { op = "Close" })
		Panels.close("Assembly")
	end)
	local col1 = Kit.new("Frame", { Size = UDim2.new(0.3, -8, 1, 0), BackgroundTransparency = 1, Parent = content })
	Kit.label(col1, "TARGET TICKET", { Size = UDim2.new(1, 0, 0, 26), Font = T.title, TextColor3 = T.mustard, MaxText = 20 })
	targetList = Kit.new("Frame", { Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 220), BackgroundTransparency = 1, Parent = col1 })
	Kit.list(targetList, Enum.FillDirection.Vertical, 6)
	Kit.label(col1, "RECIPE (top → bottom)", { Position = UDim2.fromOffset(0, 254), Size = UDim2.new(1, 0, 0, 22), Font = T.bold, TextColor3 = T.muted, MaxText = 15 })
	targetStack = Kit.new("Frame", { Position = UDim2.fromOffset(0, 280), Size = UDim2.new(1, 0, 1, -280), BackgroundTransparency = 1, Parent = col1 })
	Kit.list(targetStack, Enum.FillDirection.Vertical, 3)

	local col2 = Kit.new("Frame", { Position = UDim2.new(0.3, 8, 0, 0), Size = UDim2.new(0.3, -8, 1, 0), BackgroundTransparency = 1, Parent = content })
	Kit.label(col2, "ON THE PLATE", { Size = UDim2.new(1, 0, 0, 26), Font = T.title, TextColor3 = T.mustard, MaxText = 20 })
	plateStack = Kit.new("Frame", { Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 1, -30), BackgroundTransparency = 1, Parent = col2 })
	Kit.list(plateStack, Enum.FillDirection.Vertical, 3)

	local col3 = Kit.new("Frame", { Position = UDim2.new(0.6, 8, 0, 0), Size = UDim2.new(0.4, -8, 1, 0), BackgroundTransparency = 1, Parent = content })
	hint = Kit.label(col3, "", { Size = UDim2.new(1, 0, 0, 56), Font = T.title, TextColor3 = T.mustard, MaxText = 22 })
	local grid = Kit.new("Frame", { Position = UDim2.fromOffset(0, 62), Size = UDim2.new(1, 0, 0, 250), BackgroundTransparency = 1, Parent = col3 })
	Kit.new("UIGridLayout", { CellSize = UDim2.new(0.5, -6, 0, 74), CellPadding = UDim2.fromOffset(8, 8), Parent = grid })
	for i, op in Menu.ToppingButtons do
		buttons[op] = Kit.button(grid, string.upper(op), T.panelLight, function()
			State.action("Assembly", { op = op })
		end, { LayoutOrder = i })
	end
	takeButton = Kit.button(col3, "TAKE BURGER", T.good, function()
		State.action("Assembly", { op = "Take" })
	end, { Position = UDim2.fromOffset(0, 330), Size = UDim2.new(1, 0, 0, 70), Visible = false })
	Kit.button(col3, "CLEAR PLATE", T.bad, function()
		State.action("Assembly", { op = "Clear" })
	end, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 56) })
end

function AssemblyPanel.open(d)
	if not layer then
		build()
	end
	if not data then
		lastTargetSig = ""
	end
	data = d
	layer.Visible = true
	render()
end

function AssemblyPanel.close()
	data = nil
	if layer then
		layer.Visible = false
	end
end

function AssemblyPanel.init()
	Panels.register("Assembly", AssemblyPanel)
	State.ShiftChanged:Connect(function()
		if data and layer and layer.Visible then
			render()
		end
	end)
	player:GetAttributeChangedSignal("Holding"):Connect(function()
		if data and layer and layer.Visible then
			render()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.5)
			if data and layer and layer.Visible then
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if root and (root.Position - Layout.Stations.AssemblyPlate).Magnitude > 14 then
					State.action("Assembly", { op = "Close" })
					Panels.close("Assembly")
				end
			end
		end
	end)
end

return AssemblyPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">Audio</string>
              <string name="Source"><![CDATA[-- Sounds + the Munchie's jingle. The jingle is played note-by-note from one sound so the scare
-- versions can be the same tune slowed, detuned or backwards (design doc §6.5).

local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local Audio = {}

local function spawnSound(def, volume: number, speed: number, pos: Vector3?): Sound?
	if not def or def.id == nil or def.id == "" then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.SoundId = def.id
	sound.Volume = volume
	sound.PlaybackSpeed = speed
	if pos then
		local attachment = Instance.new("Attachment")
		attachment.WorldPosition = pos
		attachment.Parent = workspace.Terrain
		sound.RollOffMaxDistance = 140
		sound.RollOffMinDistance = 8
		sound.Parent = attachment
		sound.Ended:Connect(function()
			attachment:Destroy()
		end)
		task.delay(12, function()
			if attachment.Parent then
				attachment:Destroy()
			end
		end)
	else
		sound.Parent = SoundService
		sound.Ended:Connect(function()
			sound:Destroy()
		end)
		task.delay(12, function()
			if sound.Parent then
				sound:Destroy()
			end
		end)
	end
	sound:Play()
	return sound
end

function Audio.play(name: string, opts: { [string]: any }?)
	local def = Config.Sounds[name]
	if not def then
		return
	end
	local o = opts or {}
	spawnSound(def, (o.volume or def.volume or 0.5), (o.speed or def.speed or 1), o.pos)
end

-- "♪ Munch munch munchie's, the late-night lunchie's ♪"
local MELODY = {
	{ 0, 0.18 },
	{ 0, 0.18 },
	{ 4, 0.18 },
	{ 7, 0.36 },
	{ 9, 0.18 },
	{ 7, 0.18 },
	{ 4, 0.18 },
	{ 5, 0.18 },
	{ 4, 0.18 },
	{ 0, 0.5 },
}

-- mode: "normal" | "slow" | "backwards" | "chorus"
function Audio.jingle(mode: string?)
	local m = mode or "normal"
	local notes = table.clone(MELODY)
	local tempo = 1
	local pitch = 1
	if m == "slow" then
		tempo = 1.9
		pitch = 0.62
	elseif m == "backwards" then
		local reversed = {}
		for i = #notes, 1, -1 do
			table.insert(reversed, notes[i])
		end
		notes = reversed
		tempo = 1.4
		pitch = 0.8
	end
	local voices = if m == "chorus" then { { 0, 1 }, { 0.07, 0.97 }, { 0.15, 1.03 } } else { { 0, 1 } }
	for _, voice in voices do
		task.delay(voice[1], function()
			for _, note in notes do
				local speed = pitch * voice[2] * 2 ^ (note[1] / 12)
				Audio.play("Note", { speed = speed * 1.2 })
				task.wait(note[2] * tempo)
			end
		end)
	end
end

-- Animal Crossing-style gibberish for speaker voices.
function Audio.blip(seed: number, weird: boolean?)
	local base = 0.9 + (seed % 10) / 12
	local speed = base * (0.92 + math.random() * 0.16)
	if weird then
		speed *= if math.random() < 0.5 then 0.55 else 1.6
	end
	Audio.play("Note", { speed = speed * 1.6, volume = 0.18 })
end

function Audio.init() end

return Audio
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">CameraView</string>
              <string name="Source"><![CDATA[-- A tiny stack of scripted camera views (pickup window, Lane Cam, hiding-spot peephole...).
-- When the stack empties the normal follow camera comes back.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local CameraView = {}

local stack: { { name: string, cframe: CFrame, fov: number } } = {}
local savedFov = 70
local activeTween: Tween? = nil

local function camera(): Camera
	return workspace.CurrentCamera :: Camera
end

local function apply()
	local cam = camera()
	local top = stack[#stack]
	if activeTween then
		activeTween:Cancel()
		activeTween = nil
	end
	if top then
		cam.CameraType = Enum.CameraType.Scriptable
		local tween = TweenService:Create(cam, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { CFrame = top.cframe, FieldOfView = top.fov })
		activeTween = tween
		tween:Play()
	else
		cam.CameraType = Enum.CameraType.Custom
		cam.FieldOfView = savedFov
		local character = Players.LocalPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			cam.CameraSubject = humanoid
		end
	end
end

function CameraView.push(name: string, cframe: CFrame, fov: number?)
	if #stack == 0 then
		savedFov = camera().FieldOfView
	end
	for i = #stack, 1, -1 do
		if stack[i].name == name then
			table.remove(stack, i)
		end
	end
	table.insert(stack, { name = name, cframe = cframe, fov = fov or 70 })
	apply()
end

function CameraView.pop(name: string)
	local changed = false
	for i = #stack, 1, -1 do
		if stack[i].name == name then
			table.remove(stack, i)
			changed = true
		end
	end
	if changed then
		apply()
	end
end

function CameraView.top(): string?
	local top = stack[#stack]
	return top and top.name
end

function CameraView.clear()
	table.clear(stack)
	apply()
end

function CameraView.init()
	Players.LocalPlayer.CharacterAdded:Connect(function()
		task.defer(function()
			if #stack == 0 then
				apply()
			end
		end)
	end)
end

return CameraView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">DebugPanel</string>
              <string name="Source"><![CDATA[-- Studio-only DEBUG panel for playtesting (never appears in a live game).

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local WeirdEvents = require(Shared.Data.WeirdEvents)
local Kit = require(script.Parent.Parent.UI.Kit)
local State = require(script.Parent.State)

local T = Kit.Theme

local DebugPanel = {}

function DebugPanel.init()
	if not RunService:IsStudio() or not Config.DebugPanelInStudio then
		return
	end
	local gui = Kit.screen("NightShiftDebug", 50, true)
	local root = Kit.root(gui)
	local panel = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 8, 0.6, 0),
		Size = UDim2.fromOffset(240, 420),
		BackgroundColor3 = T.ink,
		BackgroundTransparency = 0.1,
		Visible = false,
		Parent = root,
	})
	Kit.corner(panel, 10)
	local scroll = Kit.scroll(panel, { Size = UDim2.new(1, -8, 1, -8), Position = UDim2.fromOffset(4, 4) })
	Kit.new("UIGridLayout", { CellSize = UDim2.fromOffset(110, 36), CellPadding = UDim2.fromOffset(4, 4), Parent = scroll })
	Kit.button(root, "DEBUG", T.uv, function()
		panel.Visible = not panel.Visible
	end, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 8, 0.6, -240), Size = UDim2.fromOffset(110, 40) })
	local events = {}
	for id in WeirdEvents.ById do
		table.insert(events, id)
	end
	table.sort(events)
	local eventIndex = 0
	local commands = {
		{ "Night 1", "start", 1 },
		{ "Night 2", "start", 2 },
		{ "Night 3", "start", 3 },
		{ "Night 4", "start", 4 },
		{ "Night 5", "start", 5 },
		{ "+1 Hour", "skip" },
		{ "Win Night", "win" },
		{ "Fail Night", "fail" },
		{ "End Shift", "endShift" },
		{ "Rush Hour", "rush" },
		{ "High Beams", "beams" },
		{ "Lights Out", "lightsout" },
		{ "Late Car", "late" },
		{ "Normal Car", "normal" },
		{ "Hendersons", "late", "Hendersons" },
		{ "Gerald", "late", "Gerald" },
		{ "Weird 100%", "weird" },
		{ "Stars +1", "starsUp" },
		{ "Stars -1", "starsDown" },
		{ "Boop Me", "boop" },
		{ "Reveal", "reveal" },
		{ "Give UV", "uv" },
		{ "Unlock All", "unlock" },
		{ "+500 Pay", "pay" },
	}
	for i, c in commands do
		Kit.button(scroll, c[1], T.panelLight, function()
			State.action("Debug", { cmd = c[2], arg = c[3] })
		end, { LayoutOrder = i, Font = T.bold })
	end
	Kit.button(scroll, "Next Weird Event", T.uv, function()
		eventIndex = (eventIndex % #events) + 1
		State.action("Debug", { cmd = "event", arg = events[eventIndex] })
	end, { LayoutOrder = 100, Font = T.bold })
end

return DebugPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[-- Client effects: the three lighting states (normal / weird / scare) + power-out + dawn, light
-- flicker (with a reduced-flashing option), captions with direction, scare vignette, BOOP flash,
-- banners, beacons, pings, quick-chat bubbles, the pour meter and client-side weird events.
-- Design doc §6.2 (lighting states), §6.5 (accessibility: every audio cue has a visual twin).

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Anomalies = require(Shared.Data.Anomalies)
local Kit = require(script.Parent.Parent.UI.Kit)
local State = require(script.Parent.State)
local Audio = require(script.Parent.Audio)

local T = Kit.Theme
local player = Players.LocalPlayer

local Effects = {}

local gui: ScreenGui
local root: Frame
local captionList: Frame
local bannerFrame: Frame
local flash: Frame
local vignette: { Frame } = {}
local pourBar: Frame
local cc: ColorCorrectionEffect

---------------------------------------------------------------------------
-- Lighting
---------------------------------------------------------------------------

local lightState = "Normal"
local overrides: { [string]: number } = {} -- state -> until (os.clock)
local LIGHT_COLORS = {
	Normal = Color3.fromRGB(255, 240, 210),
	Weird = Color3.fromRGB(200, 255, 190),
	Scare = Color3.fromRGB(255, 50, 40),
	Out = Color3.fromRGB(200, 20, 20),
	Dawn = Color3.fromRGB(255, 200, 150),
}

local function interiorLights(): { BasePart }
	local out = {}
	for _, p in CollectionService:GetTagged("InteriorLight") do
		if p:IsA("BasePart") then
			table.insert(out, p)
		end
	end
	return out
end

local function setLights(color: Color3, brightness: number, on: boolean)
	for _, part in interiorLights() do
		local light = part:FindFirstChildOfClass("PointLight")
		if light then
			light.Color = color
			light.Brightness = brightness
			light.Enabled = on
		end
		part.Color = color
		part.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
	end
end

local function desiredState(): string
	local now = os.clock()
	for _, name in { "Dawn", "Out", "Scare" } do
		if (overrides[name] or 0) > now then
			return name
		end
	end
	local shift = State.shift
	if State.isCrew() and shift then
		if shift.scare and (shift.scare.phase == "Active" or shift.scare.phase == "Warning") then
			return "Scare"
		end
		if (shift.weird or 0) >= 50 or (shift.flags and shift.flags.revealed) then
			return "Weird"
		end
	end
	return "Normal"
end

local function applyLightState(stateName: string)
	lightState = stateName
	if stateName == "Normal" then
		setLights(LIGHT_COLORS.Normal, 1.15, true)
		TweenService:Create(cc, TweenInfo.new(1), { TintColor = Color3.new(1, 1, 1), Saturation = 0, Brightness = 0, Contrast = 0 }):Play()
	elseif stateName == "Weird" then
		setLights(LIGHT_COLORS.Weird, 1.0, true)
		TweenService:Create(cc, TweenInfo.new(2), { TintColor = Color3.fromRGB(225, 255, 225), Saturation = 0.15, Brightness = -0.03, Contrast = 0.05 }):Play()
	elseif stateName == "Scare" then
		setLights(LIGHT_COLORS.Scare, 0.8, true)
		TweenService:Create(cc, TweenInfo.new(0.4), { TintColor = Color3.fromRGB(255, 190, 190), Saturation = -0.2, Brightness = -0.08, Contrast = 0.15 }):Play()
	elseif stateName == "Out" then
		setLights(LIGHT_COLORS.Out, 0.5, true)
		TweenService:Create(cc, TweenInfo.new(0.2), { TintColor = Color3.fromRGB(255, 140, 140), Saturation = -0.4, Brightness = -0.2, Contrast = 0.2 }):Play()
	elseif stateName == "Dawn" then
		setLights(LIGHT_COLORS.Dawn, 0.6, true)
		TweenService:Create(cc, TweenInfo.new(3), { TintColor = Color3.fromRGB(255, 225, 190), Saturation = 0.1, Brightness = 0.1, Contrast = 0 }):Play()
	end
end

function Effects.flicker(count: number, interval: number?)
	local gap = interval or 0.12
	if State.setting("reducedFlashing") then
		-- a gentle dip instead of strobing
		setLights(LIGHT_COLORS[lightState] or LIGHT_COLORS.Normal, 0.3, true)
		task.delay(count * gap * 2, function()
			applyLightState(desiredState())
		end)
		return
	end
	task.spawn(function()
		for _ = 1, count do
			setLights(LIGHT_COLORS[lightState] or LIGHT_COLORS.Normal, 0, false)
			task.wait(gap)
			setLights(LIGHT_COLORS[lightState] or LIGHT_COLORS.Normal, 1.15, true)
			task.wait(gap * 1.5)
		end
		applyLightState(desiredState())
	end)
end

---------------------------------------------------------------------------
-- Overlays
---------------------------------------------------------------------------

local function directionText(pos: Vector3?): string
	local camera = workspace.CurrentCamera
	if not pos or not camera then
		return ""
	end
	local rel = camera.CFrame:PointToObjectSpace(pos)
	local distance = rel.Magnitude
	if distance < 6 then
		return " — right here"
	end
	local side
	if rel.Z > 0 and math.abs(rel.X) < rel.Z then
		side = "behind"
	elseif math.abs(rel.X) > math.abs(rel.Z) * 0.6 then
		side = if rel.X < 0 then "left" else "right"
	else
		side = "ahead"
	end
	return " — " .. side
end

function Effects.caption(text: string, pos: Vector3?, duration: number?)
	if not State.setting("captions") then
		return
	end
	local label = Kit.label(captionList, text .. directionText(pos), {
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundTransparency = 0.35,
		BackgroundColor3 = Color3.new(0, 0, 0),
		TextColor3 = Color3.fromRGB(255, 245, 210),
		Font = T.bold,
		MaxText = 22,
	})
	Kit.corner(label, 8)
	label.LayoutOrder = math.floor(os.clock() * 100)
	while #captionList:GetChildren() > 5 do
		local oldest: Instance? = nil
		for _, c in captionList:GetChildren() do
			if c:IsA("TextLabel") then
				oldest = c
				break
			end
		end
		if oldest then
			oldest:Destroy()
		else
			break
		end
	end
	task.delay(duration or 3, function()
		if label.Parent then
			Kit.fade(label, 1, 0.4)
			task.wait(0.45)
			label:Destroy()
		end
	end)
end

function Effects.banner(title: string, subtitle: string?, color: Color3?, duration: number?)
	Kit.clear(bannerFrame)
	local card = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(640, if subtitle then 130 else 90),
		BackgroundColor3 = color or T.ketchup,
		BackgroundTransparency = 0.05,
		Parent = bannerFrame,
	})
	Kit.corner(card, 18)
	Kit.stroke(card, T.mustard, 3)
	Kit.label(card, title, {
		Size = UDim2.new(1, -20, 0, 70),
		Position = UDim2.fromOffset(10, 6),
		Font = T.title,
		TextColor3 = T.white,
		MaxText = 56,
	})
	if subtitle then
		Kit.label(card, subtitle, {
			Size = UDim2.new(1, -20, 0, 44),
			Position = UDim2.fromOffset(10, 78),
			Font = T.bold,
			TextColor3 = T.paper,
			MaxText = 22,
		})
	end
	local scale = Kit.new("UIScale", { Scale = 0.6, Parent = card })
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	task.delay(duration or 2.8, function()
		if card.Parent then
			TweenService:Create(scale, TweenInfo.new(0.2), { Scale = 0.01 }):Play()
			task.wait(0.22)
			card:Destroy()
		end
	end)
end

function Effects.flash(color: Color3, text: string?, duration: number?)
	flash.BackgroundColor3 = color
	flash.BackgroundTransparency = 0
	local label = flash:FindFirstChild("Label") :: TextLabel
	label.Text = text or ""
	label.TextTransparency = 0
	TweenService:Create(flash, TweenInfo.new(duration or 0.9), { BackgroundTransparency = 1 }):Play()
	TweenService:Create(label, TweenInfo.new((duration or 0.9) + 0.3), { TextTransparency = 1 }):Play()
end

local vignetteTween: { Tween } = {}
function Effects.vignette(color: Color3?, on: boolean, pulse: boolean?)
	for _, t in vignetteTween do
		t:Cancel()
	end
	table.clear(vignetteTween)
	for _, f in vignette do
		local gradient = f:FindFirstChildOfClass("UIGradient")
		if gradient then
			gradient.Color = ColorSequence.new(color or T.bad)
		end
		f.BackgroundColor3 = color or T.bad
		f.Visible = on
		f.BackgroundTransparency = 0.2
		if on and pulse then
			local tween = TweenService:Create(f, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { BackgroundTransparency = 0.6 })
			tween:Play()
			table.insert(vignetteTween, tween)
		end
	end
end

---------------------------------------------------------------------------
-- Beacons, pings, bubbles
---------------------------------------------------------------------------

local beaconInstances: { Instance } = {}
function Effects.beacon(target: string?)
	for _, inst in beaconInstances do
		inst:Destroy()
	end
	table.clear(beaconInstances)
	if not target then
		return
	end
	local map = workspace:FindFirstChild("Munchies")
	local kitchen = map and map:FindFirstChild("Kitchen")
	local part = kitchen and kitchen:FindFirstChild(target)
	if not part or not part:IsA("BasePart") then
		return
	end
	local highlight = Instance.new("Highlight")
	highlight.FillColor = T.mustard
	highlight.FillTransparency = 0.5
	highlight.OutlineColor = T.white
	highlight.Adornee = part
	highlight.Parent = part
	table.insert(beaconInstances, highlight)
	local arrow = Instance.new("BillboardGui")
	arrow.Size = UDim2.fromOffset(120, 60)
	arrow.StudsOffset = Vector3.new(0, 4.5, 0)
	arrow.AlwaysOnTop = true
	arrow.Adornee = part
	local label = Kit.label(arrow, "▼ HERE", { Size = UDim2.fromScale(1, 1), Font = T.title, TextColor3 = T.mustard, TextStrokeTransparency = 0 })
	TweenService:Create(label, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Position = UDim2.fromOffset(0, 10) }):Play()
	arrow.Parent = part
	table.insert(beaconInstances, arrow)
end

local function showPing(data)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.new(1.2, 1.2, 1.2)
	part.Material = Enum.Material.Neon
	part.Color = if data.ghost then Color3.fromRGB(200, 220, 255) else T.mustard
	part.Position = data.position
	part.Parent = workspace:FindFirstChild("ClientFx") or workspace
	local bill = Instance.new("BillboardGui")
	bill.Size = UDim2.fromOffset(170, 44)
	bill.StudsOffset = Vector3.new(0, 2.5, 0)
	bill.AlwaysOnTop = true
	bill.Adornee = part
	Kit.label(bill, (if data.ghost then "👻 " else "📍 ") .. tostring(data.name), {
		Size = UDim2.fromScale(1, 1),
		Font = T.title,
		TextColor3 = part.Color,
		TextStrokeTransparency = 0.2,
	})
	bill.Parent = part
	TweenService:Create(part, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Size = Vector3.new(2, 2, 2) }):Play()
	task.delay(data.duration or 3, function()
		part:Destroy()
	end)
end

local function showBubble(userId: number, text: string)
	local other = Players:GetPlayerByUserId(userId)
	local head = other and other.Character and other.Character:FindFirstChild("Head")
	if not head then
		return
	end
	local old = head:FindFirstChild("QuickChatBubble")
	if old then
		old:Destroy()
	end
	local bill = Instance.new("BillboardGui")
	bill.Name = "QuickChatBubble"
	bill.Size = UDim2.fromOffset(220, 50)
	bill.StudsOffset = Vector3.new(0, 3.2, 0)
	bill.AlwaysOnTop = true
	bill.MaxDistance = 120
	local label = Kit.label(bill, text, {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 0,
		BackgroundColor3 = T.paper,
		TextColor3 = T.ink,
		Font = T.title,
	})
	Kit.corner(label, 12)
	bill.Parent = head
	task.delay(3.5, function()
		bill:Destroy()
	end)
	if other ~= player then
		Effects.caption(("%s: %s"):format(other.DisplayName, text), nil, 3)
	end
end

---------------------------------------------------------------------------
-- Pour meter
---------------------------------------------------------------------------

local pourToken = 0
local function startPour(data)
	pourToken += 1
	local token = pourToken
	pourBar.Visible = true
	local fill = pourBar:FindFirstChild("Fill") :: Frame
	local zone = pourBar:FindFirstChild("Zone") :: Frame
	local label = pourBar:FindFirstChild("Label") :: TextLabel
	local maxFill = 1.3
	zone.Position = UDim2.fromScale(data.perfect / maxFill, 0)
	zone.Size = UDim2.fromScale((1 - data.perfect) / maxFill, 1)
	label.Text = "HOLD... let go in the GREEN"
	local start = os.clock()
	task.spawn(function()
		while token == pourToken do
			local amount = data.fill + (os.clock() - start) / data.seconds
			fill.Size = UDim2.fromScale(math.min(1, amount / maxFill), 1)
			fill.BackgroundColor3 = if amount >= data.perfect and amount <= 1 then T.good elseif amount > 1 then T.bad else (if data.kind == "Shake" then Color3.fromRGB(240, 150, 190) else Color3.fromRGB(77, 160, 230))
			if amount > 1 then
				label.Text = "OVERFLOWING!"
			end
			RunService.RenderStepped:Wait()
		end
	end)
end

local function stopPour()
	pourToken += 1
	task.delay(0.4, function()
		pourBar.Visible = false
	end)
end

---------------------------------------------------------------------------
-- Weird events on the client
---------------------------------------------------------------------------

local mirrored = false
local controlsHooked = false
local function hookControls()
	if controlsHooked then
		return
	end
	controlsHooked = true
	task.spawn(function()
		local ok, err = pcall(function()
			local playerModule = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule") :: ModuleScript) :: any
			local controls = playerModule:GetControls()
			local original = controls.moveFunction
			if type(original) ~= "function" then
				return
			end
			controls.moveFunction = function(p, direction: Vector3, relative: boolean)
				if mirrored then
					direction = Vector3.new(-direction.X, direction.Y, direction.Z)
				end
				return original(p, direction, relative)
			end
		end)
		if not ok then
			warn("[Effects] couldn't hook controls for Mirror Mess: " .. tostring(err))
		end
	end)
end

local function weirdEvent(data)
	Effects.banner(data.banner or data.name, data.description, T.uv, 3.5)
	Audio.play("Gotcha", { speed = 0.35 })
	if data.duration and data.duration > 0 then
		State.flags[data.id] = os.clock() + data.duration
	else
		State.flags[data.id] = math.huge
	end
	if data.id == "MirrorMess" and State.isCrew() then
		hookControls()
		mirrored = true
		task.delay(data.duration, function()
			mirrored = false
		end)
	elseif data.id == "MandatoryFun" and State.isCrew() then
		-- the default R15 "dance" emote animation (forced fun)
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
		if animator and humanoid and humanoid.RigType == Enum.HumanoidRigType.R15 then
			pcall(function()
				local animation = Instance.new("Animation")
				animation.AnimationId = "rbxassetid://507771019"
				local track = animator:LoadAnimation(animation)
				track.Looped = true
				track:Play()
				task.delay(data.duration or 15, function()
					track:Stop()
					track:Destroy()
				end)
			end)
		end
	end
end

function Effects.flagActive(id: string): boolean
	return (State.flags[id] or 0) > os.clock()
end

local hidingHighlights: { Instance } = {}
function Effects.highlightHidingSpots(on: boolean)
	for _, h in hidingHighlights do
		h:Destroy()
	end
	table.clear(hidingHighlights)
	if not on or not State.isCrew() or State.isGhost() then
		return
	end
	local map = workspace:FindFirstChild("Munchies")
	local spots = map and map:FindFirstChild("HidingSpots")
	if not spots then
		return
	end
	for _, spot in spots:GetChildren() do
		if spot:IsA("BasePart") then
			local bill = Instance.new("BillboardGui")
			bill.Size = UDim2.fromOffset(110, 40)
			bill.AlwaysOnTop = true
			bill.MaxDistance = 80
			bill.Adornee = spot
			local label = Kit.label(bill, "HIDE", { Size = UDim2.fromScale(1, 1), Font = T.title, TextColor3 = T.bad, TextStrokeTransparency = 0 })
			TweenService:Create(label, TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { TextTransparency = 0.6 }):Play()
			bill.Parent = spot
			table.insert(hidingHighlights, bill)
		end
	end
end

---------------------------------------------------------------------------
-- Effect dispatch
---------------------------------------------------------------------------

local lastSqueakCaption = 0
local handlers = {}

handlers.Sound = function(data)
	Audio.play(data.name, { pos = data.pos })
end
handlers.Stars = function() end -- HUD shows these
handlers.ShiftBegin = function(data)
	Effects.banner(("NIGHT %d"):format(data.night), data.title, T.ketchup, 3.5)
	Audio.jingle("normal")
end
handlers.ShiftFailed = function(data)
	if data.reason == "CorporateCalled" then
		Effects.banner("CORPORATE CALLED", "The stars hit zero. Shift over.", T.bad, 4)
	end
end
handlers.GhostTown = function()
	Effects.banner("GHOST TOWN", "Store closed early. Everyone got booped.", T.navy, 4)
end
handlers.ScareWarning = function(data)
	if data.kind == "RushHour" then
		Effects.flicker(3)
		Audio.jingle("slow")
		Effects.vignette(T.bad, true, true)
		Effects.banner("HIDE!", "The lights flickered three times...", T.bad, 2.5)
	elseif data.kind == "HighBeams" then
		Effects.vignette(Color3.fromRGB(255, 220, 90), true, true)
		Effects.banner("HEADS DOWN!", "Crouch below the window line (C) or get out of the light", T.warn, 2.5)
	elseif data.kind == "LightsOut" then
		overrides.Out = os.clock() + (data.seconds or 10)
		Effects.flicker(2)
		Audio.jingle("slow")
		Effects.vignette(T.bad, true, true)
		Effects.banner("UNDER THE COUNTER!", "Hide! (F at a hiding spot)", T.bad, 3)
		task.delay(data.seconds or 10, function()
			Effects.vignette(nil, false)
		end)
	end
	Effects.highlightHidingSpots(true)
end
handlers.ScareActive = function(data)
	if data.kind == "RushHour" then
		Effects.caption("[squeak... squeak... big shoes]", nil, 3)
	end
end
handlers.ScareEnd = function()
	Effects.vignette(nil, false)
	Effects.highlightHidingSpots(false)
	task.defer(function()
		applyLightState(desiredState())
	end)
end
handlers.Squeak = function(data)
	Audio.play("Squeak", { pos = data.pos, speed = if data.fast then 2.1 else 1.7 })
	if os.clock() - lastSqueakCaption > 1.4 then
		lastSqueakCaption = os.clock()
		Effects.caption(if data.fast then "[SQUEAK-SQUEAK-SQUEAK]" else "[squeak... squeak...]", data.pos, 1.4)
	end
end
handlers.Spotted = function()
	Effects.flash(T.bad, "!", 0.5)
	Audio.play("Boop", { speed = 0.6 })
end
handlers.Frozen = function()
	Effects.flash(Color3.fromRGB(255, 240, 150), "FROZEN IN THE HEADLIGHTS", 1.2)
end
handlers.Booped = function(data)
	Effects.flash(Color3.new(1, 1, 1), "BOOP!", 1.4)
	Audio.play("Boop")
	task.delay(0.5, function()
		Audio.play("Pwoomp")
		Effects.banner("...oh no.", ("You're a Shift Ghost. Back in %d seconds."):format(math.floor(data.seconds or 30)), T.navy, 3.5)
	end)
end
handlers.CrewBooped = function(data)
	if data.userId ~= player.UserId then
		Audio.play("Pwoomp", { pos = data.pos })
		Effects.caption(("[slide whistle — %s got BOOPED]"):format(data.name), data.pos, 3)
	end
end
handlers.Boo = function(data)
	Audio.play("Note", { pos = data.pos, speed = 0.35, volume = 0.5 })
	Effects.caption(("[oooOOOooo — %s]"):format(data.name), data.pos, 2)
	-- flicker the nearest light, locally
	local nearest, best = nil, math.huge
	for _, part in interiorLights() do
		local d = (part.Position - data.pos).Magnitude
		if d < best then
			nearest, best = part, d
		end
	end
	if nearest and best < 40 then
		local light = nearest:FindFirstChildOfClass("PointLight")
		if light then
			light.Enabled = false
			task.delay(0.25, function()
				light.Enabled = true
			end)
		end
	end
end
handlers.Blink = function()
	Effects.flicker(1, 0.2)
end
handlers.PowerOut = function(data)
	overrides.Out = os.clock() + (data.seconds or 20)
	applyLightState("Out")
	Effects.banner("THE POWER DIES", "Emergency lights only.", T.bad, 4)
end
handlers.Jingle = function(data)
	Audio.jingle(data.mode)
end
handlers.Beacon = function(data)
	Effects.beacon(data.target)
end
handlers.Pour = startPour
handlers.PourEnd = stopPour
handlers.WeirdEvent = weirdEvent
handlers.WeirdEventEnd = function(data)
	State.flags[data.id] = nil
	if data.id == "MirrorMess" then
		mirrored = false
	end
end
handlers.Gotcha = function(data)
	Effects.banner("GOTCHA!", ("%s refused. Nice catch."):format(data.name), T.good, 2.5)
	Audio.play("Gotcha")
end
handlers.Freed = function(data)
	Effects.flash(Color3.fromRGB(255, 220, 140), "FREED", 1.5)
	Effects.banner(("FREED: %s (%d)"):format(data.name, data.year), "They drive off into the morning light.", T.mustard, 4)
end
handlers.FieldGuideCard = function(data)
	local entry = Anomalies.ById[data.id]
	if entry then
		Effects.caption(("📘 New Field Guide card: %s%s"):format(entry.name, if data.how == "caught" then " (caught!)" else ""), nil, 4)
	end
end
handlers.UVUnlocked = function()
	Effects.banner("UV FLASHLIGHT", "Press U (or tap UV) to reveal hidden marks.", T.uv, 3.5)
end
handlers.StickyNote = function(data)
	Effects.banner("Sticky Note", data.text, T.mustard, 5)
end
handlers.CampWarn = function(data)
	Effects.caption(("[%s]"):format(data.message), nil, 3)
	Effects.vignette(if data.spot == "Freezer" then Color3.fromRGB(160, 220, 255) else Color3.fromRGB(150, 200, 120), true, true)
	task.delay(math.max(1, data.left or 5), function()
		if not State.isHidden() then
			Effects.vignette(nil, false)
		end
	end)
end
handlers.EndingScene = function(data)
	if data.id == "Freed" then
		overrides.Dawn = os.clock() + 60
		applyLightState("Dawn")
	end
end

---------------------------------------------------------------------------


function Effects.init()
	cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "NightShiftCC"
	cc.Parent = Lighting
	local fx = Instance.new("Folder")
	fx.Name = "ClientFx"
	fx.Parent = workspace

	gui = Kit.screen("NightShiftEffects", 20)
	root = Kit.root(gui)
	-- vignette edges
	local edges = {
		{ UDim2.new(1, 0, 0.18, 0), UDim2.fromScale(0, 0), 90 },
		{ UDim2.new(1, 0, 0.18, 0), UDim2.fromScale(0, 0.82), 270 },
		{ UDim2.new(0.14, 0, 1, 0), UDim2.fromScale(0, 0), 0 },
		{ UDim2.new(0.14, 0, 1, 0), UDim2.fromScale(0.86, 0), 180 },
	}
	for _, e in edges do
		local f = Kit.new("Frame", { Size = e[1], Position = e[2], BackgroundColor3 = T.bad, Visible = false, Parent = root })
		Kit.new("UIGradient", {
			Rotation = e[3],
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) }),
			Parent = f,
		})
		table.insert(vignette, f)
	end
	flash = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, Parent = root })
	Kit.label(flash, "", { Name = "Label", Size = UDim2.fromScale(1, 0.3), Position = UDim2.fromScale(0, 0.35), Font = T.title, TextColor3 = T.ketchup, TextTransparency = 1, MaxText = 140 })
	bannerFrame = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 160), Position = UDim2.fromScale(0, 0.2), BackgroundTransparency = 1, Parent = root })
	captionList = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -200),
		Size = UDim2.fromOffset(620, 190),
		BackgroundTransparency = 1,
		Parent = root,
	})
	local layout = Kit.list(captionList, Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Center)
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	pourBar = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.62),
		Size = UDim2.fromOffset(420, 40),
		BackgroundColor3 = T.ink,
		Visible = false,
		Parent = root,
	})
	Kit.corner(pourBar, 10)
	Kit.stroke(pourBar, T.white, 2)
	Kit.new("Frame", { Name = "Zone", BackgroundColor3 = T.good, BackgroundTransparency = 0.6, Size = UDim2.fromScale(0.2, 1), Parent = pourBar })
	Kit.new("Frame", { Name = "Fill", BackgroundColor3 = Color3.fromRGB(77, 160, 230), Size = UDim2.fromScale(0, 1), Parent = pourBar })
	Kit.label(pourBar, "", { Name = "Label", Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, -30), Font = T.title })

	Net.event("Effect").OnClientEvent:Connect(function(name, data)
		local handler = handlers[name]
		if handler then
			local ok, err = pcall(handler, data or {})
			if not ok then
				warn("[Effects] " .. tostring(name) .. ": " .. tostring(err))
			end
		end
	end)
	Net.event("Caption").OnClientEvent:Connect(function(data)
		Effects.caption(data.text, data.pos, data.duration)
	end)
	Net.event("Ping").OnClientEvent:Connect(showPing)
	Net.event("Bubble").OnClientEvent:Connect(showBubble)

	-- keep lighting in sync with the shift state
	task.spawn(function()
		while true do
			task.wait(0.5)
			local wanted = desiredState()
			if wanted ~= lightState then
				applyLightState(wanted)
			end
		end
	end)
	player:GetAttributeChangedSignal("Ghost"):Connect(function()
		if State.isGhost() then
			stopPour()
			Effects.highlightHidingSpots(false)
		end
	end)
	player:GetAttributeChangedSignal("Crew"):Connect(function()
		if not State.isCrew() then
			stopPour()
			Effects.beacon(nil)
			Effects.vignette(nil, false)
			table.clear(overrides)
			table.clear(State.flags)
			mirrored = false
			applyLightState("Normal")
		end
	end)
	applyLightState("Normal")
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[-- The in-shift HUD (design doc §7.8): clock (top center), stars + Weird Meter (top left), crew with
-- ghost timers (top right), ticket rail (bottom), holding chip, radio box, toasts, and big buttons
-- for mobile (quick-chat, crouch, ping, UV, and Ghost Point / Boo! while booped).

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local QuickChat = require(Shared.Data.QuickChat)
local Util = require(Shared.Util)
local Kit = require(script.Parent.Parent.UI.Kit)
local State = require(script.Parent.State)
local World = require(script.Parent.World)
local Effects = require(script.Parent.Effects)

local T = Kit.Theme
local player = Players.LocalPlayer

local HUD = {}

local gui: ScreenGui
local always: ScreenGui
local root: Frame
local clockLabel: TextLabel
local nightLabel: TextLabel
local starsLabel: TextLabel
local weirdFill: Frame
local weirdLabel: TextLabel
local crewList: Frame
local rail: Frame
local holding: TextLabel
local scareLabel: TextLabel
local weirdChips: TextLabel
local gizmoChip: TextLabel
local fryChip: TextLabel
local toastList: Frame
local radioBox: Frame
local buttons: { [string]: TextButton } = {}
local chatPopup: Frame

local lastTicketSig = ""
local lastCrewSig = ""
local usedUV = false

---------------------------------------------------------------------------
-- Toasts & radio (visible everywhere)
---------------------------------------------------------------------------

local KIND_COLORS = {
	info = T.panel,
	good = T.good,
	bad = T.bad,
	warn = T.warn,
	badge = T.mustard,
}

function HUD.toast(text: string, kind: string?)
	local color = KIND_COLORS[kind or "info"] or T.panel
	local label = Kit.label(toastList, text, {
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundTransparency = 0.1,
		BackgroundColor3 = color,
		TextColor3 = if kind == "badge" then T.ink else T.white,
		Font = T.bold,
		MaxText = 20,
	})
	Kit.corner(label, 10)
	Kit.padding(label, 4)
	label.LayoutOrder = math.floor(os.clock() * 100)
	local count = 0
	for _, c in toastList:GetChildren() do
		if c:IsA("TextLabel") then
			count += 1
		end
	end
	if count > 4 then
		for _, c in toastList:GetChildren() do
			if c:IsA("TextLabel") then
				c:Destroy()
				break
			end
		end
	end
	task.delay(3.5, function()
		if label.Parent then
			Kit.fade(label, 1, 0.4)
			task.wait(0.45)
			label:Destroy()
		end
	end)
end

local radioQueue: { any } = {}
local radioBusy = false
local function playRadio()
	if radioBusy then
		return
	end
	local line = table.remove(radioQueue, 1)
	if not line then
		return
	end
	radioBusy = true
	radioBox.Visible = true
	local who = radioBox:FindFirstChild("Who") :: TextLabel
	local text = radioBox:FindFirstChild("Text") :: TextLabel
	who.Text = "📻 " .. string.upper(line.who)
	text.Text = ""
	task.spawn(function()
		local full = line.text
		for i = 1, #full, 2 do
			text.Text = string.sub(full, 1, i)
			task.wait(0.015)
		end
		text.Text = full
		task.wait(line.duration or 4)
		radioBox.Visible = false
		radioBusy = false
		playRadio()
	end)
end

function HUD.radio(data)
	table.insert(radioQueue, data)
	if #radioQueue > 6 then
		table.remove(radioQueue, 1)
	end
	Effects.caption(("%s: \"%s\""):format(data.who, data.text), nil, 1)
	playRadio()
end

---------------------------------------------------------------------------
-- Actions
---------------------------------------------------------------------------

local function aimPosition(): Vector3?
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	local point: Vector2
	if UserInputService.MouseEnabled and not UserInputService.TouchEnabled then
		point = UserInputService:GetMouseLocation()
	else
		point = camera.ViewportSize / 2
	end
	local ray = camera:ViewportPointToRay(point.X, point.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude: { Instance } = {}
	if player.Character then
		table.insert(exclude, player.Character)
	end
	local fx = workspace:FindFirstChild("ClientFx")
	if fx then
		table.insert(exclude, fx)
	end
	params.FilterDescendantsInstances = exclude
	local result = workspace:Raycast(ray.Origin, ray.Direction * 250, params)
	return if result then result.Position else ray.Origin + ray.Direction * 40
end

function HUD.toggleCrouch()
	if not State.isCrew() or State.isGhost() or State.isHidden() then
		return
	end
	State.action("Crouch", { on = not player:GetAttribute("Crouching") })
end

function HUD.ping()
	if not State.isCrew() then
		return
	end
	local pos = aimPosition()
	if not pos then
		return
	end
	if State.isGhost() then
		State.action("GhostPoint", { position = pos })
	else
		State.action("Ping", { position = pos })
	end
end

function HUD.boo()
	if State.isGhost() then
		State.action("GhostBoo")
	end
end

function HUD.toggleUV()
	local shift = State.shift
	if not State.isCrew() or not shift or not shift.flags or not shift.flags.uv then
		return
	end
	World.setUV(not World.uv)
	if World.uv and not usedUV then
		usedUV = true
		State.action("UsedUV")
	end
	if buttons.UV then
		buttons.UV.BackgroundColor3 = if World.uv then T.uv else T.panelLight
	end
end

function HUD.toggleChat()
	chatPopup.Visible = not chatPopup.Visible
end

---------------------------------------------------------------------------
-- Rendering
---------------------------------------------------------------------------

local function stars(value: number, knitted: boolean): string
	local full = math.floor(value + 0.001)
	local out = ""
	for i = 1, 5 do
		if i <= full then
			out ..= if knitted then "🧶" else "★"
		else
			out ..= "☆"
		end
	end
	return out .. ("  %.1f"):format(value)
end

local STATIC = { "▒", "▓", "░", "█", "#", "%", "?" }
local function noise(n: number): string
	local out = {}
	for _ = 1, n do
		table.insert(out, STATIC[math.random(1, #STATIC)])
	end
	return table.concat(out)
end

local function ticketColor(age: number): Color3
	if age < 25 then
		return T.good
	elseif age < 50 then
		return T.warn
	end
	return T.bad
end

local function renderTickets(tickets)
	local surf = Effects.flagActive("ChannelSurf")
	local sig = { if surf then "S" .. math.random() else "" }
	for _, t in tickets do
		local done = {}
		for _, l in t.lines do
			table.insert(done, if l.done then "1" else "0")
		end
		table.insert(sig, ("%d:%s:%d:%s:%s:%s"):format(t.number, table.concat(done), math.floor(t.age / 25), tostring(t.flagged), tostring(t.atWindow), tostring(t.extras)))
	end
	local signature = table.concat(sig, "|")
	if signature == lastTicketSig then
		return
	end
	lastTicketSig = signature
	Kit.clear(rail)
	for i, t in tickets do
		if i > 7 then
			break
		end
		local card = Kit.new("Frame", {
			Size = UDim2.fromOffset(160, 150),
			BackgroundColor3 = T.paper,
			LayoutOrder = i,
			Parent = rail,
		})
		Kit.corner(card, 10)
		local header = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = ticketColor(t.age), Parent = card })
		Kit.corner(header, 10)
		Kit.label(header, ("#%d%s%s"):format(t.number, if t.flagged then " ⚠" else "", if t.atWindow then " • WINDOW" else ""), {
			Size = UDim2.new(1, -10, 1, -4),
			Position = UDim2.fromOffset(5, 2),
			Font = T.title,
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxText = 18,
		})
		local body = Kit.new("Frame", { Size = UDim2.new(1, -10, 1, -34), Position = UDim2.fromOffset(5, 31), BackgroundTransparency = 1, Parent = card })
		Kit.list(body, Enum.FillDirection.Vertical, 1)
		if #t.lines == 0 then
			Kit.label(body, "(nothing — empty bag)", { Size = UDim2.new(1, 0, 0, 20), TextColor3 = T.ink, MaxText = 14 })
		end
		for j, line in t.lines do
			if j > 6 then
				Kit.label(body, "...", { Size = UDim2.new(1, 0, 0, 16), TextColor3 = T.ink, MaxText = 14 })
				break
			end
			local text = (if line.done then "✓ " else "• ") .. line.label
			if surf then
				text = noise(#line.label)
			end
			Kit.label(body, text, {
				Size = UDim2.new(1, 0, 0, 18),
				TextColor3 = if line.done then T.good else T.ink,
				Font = T.bold,
				TextXAlignment = Enum.TextXAlignment.Left,
				MaxText = 14,
			})
		end
		if t.extras and t.extras > 0 then
			Kit.label(body, ("+%d extra?! (Fix Bags)"):format(t.extras), { Size = UDim2.new(1, 0, 0, 16), TextColor3 = T.bad, Font = T.bold, MaxText = 13 })
		end
	end
end

local function renderCrew(crew)
	local sig = {}
	for _, m in crew do
		table.insert(sig, ("%d:%s:%s:%d:%s"):format(m.userId, m.role, tostring(m.ghost), math.ceil(m.respawnIn or 0), tostring(m.hidden)))
	end
	local signature = table.concat(sig, "|")
	if signature == lastCrewSig then
		return
	end
	lastCrewSig = signature
	Kit.clear(crewList)
	for i, m in crew do
		local status = m.role
		local color = T.panel
		if m.ghost then
			status = "👻 BACK IN " .. Util.formatSeconds(m.respawnIn or 0)
			color = T.navy
		elseif m.hidden then
			status = "HIDING"
			color = Color3.fromRGB(60, 60, 80)
		end
		local row = Kit.label(crewList, ("%s  •  %s"):format(m.name, status), {
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundTransparency = 0.15,
			BackgroundColor3 = color,
			Font = T.bold,
			TextXAlignment = Enum.TextXAlignment.Right,
			LayoutOrder = i,
			MaxText = 18,
		})
		Kit.corner(row, 8)
		Kit.padding(row, 6)
	end
end

local function render(shift)
	if not shift then
		return
	end
	clockLabel.Text = shift.clock
	nightLabel.Text = ("NIGHT %d — %s"):format(shift.night, shift.title)
	starsLabel.Text = stars(shift.stars, shift.flags and shift.flags.doilies)
	starsLabel.TextColor3 = if shift.stars < 1.5 then T.bad else T.mustard
	local weird = math.clamp(shift.weird or 0, 0, 100)
	weirdFill.Size = UDim2.fromScale(weird / 100, 1)
	weirdFill.BackgroundColor3 = T.pickle:Lerp(T.uv, weird / 100)
	weirdLabel.Text = ("WEIRD %d%%"):format(math.floor(weird))
	renderCrew(shift.crew or {})
	renderTickets(shift.tickets or {})
	if shift.scare then
		local names = { RushHour = "MR. MUNCH IS WALKING — HIDE!", HighBeams = "HIGH BEAMS — HEADS DOWN!", LightsOutSafe = "LIGHTS OUT — HIDE!" }
		scareLabel.Text = "⚠ " .. (names[shift.scare.kind] or "SOMETHING'S WRONG")
		scareLabel.Visible = true
	else
		scareLabel.Visible = false
	end
	local chips = {}
	for _, e in shift.weirdEvents or {} do
		table.insert(chips, if e.remaining then ("%s %ds"):format(e.name, math.ceil(e.remaining)) else e.name)
	end
	weirdChips.Text = table.concat(chips, "  •  ")
	weirdChips.Visible = #chips > 0
	local g = shift.gizmo
	if g then
		local covering = {}
		if g.order then
			table.insert(covering, "Order")
		end
		if g.fry then
			table.insert(covering, "Fryer & Drinks")
		end
		if g.grill then
			table.insert(covering, "Grill")
		end
		local status = if g.state == "Ghost" then "booped 👻" elseif g.state == "Hiding" then "hiding (badly)" elseif #covering > 0 then "covering " .. table.concat(covering, ", ") else "idle"
		gizmoChip.Text = "🤖 Gizmo: " .. status
	end
	fryChip.Text = ("🍟 Fry bin: %d"):format(shift.fryBin or 0)
	if buttons.UV then
		buttons.UV.Visible = shift.flags and shift.flags.uv and not State.isGhost()
	end
end

local function refreshMode()
	local crew = State.isCrew()
	gui.Enabled = crew
	local ghost = State.isGhost()
	local hidden = State.isHidden()
	if buttons.Point then
		buttons.Point.Visible = ghost
		buttons.Boo.Visible = ghost
		buttons.Crouch.Visible = not ghost
		buttons.Ping.Visible = not ghost
	end
	ProximityPromptService.Enabled = not (crew and (ghost or hidden))
	local text = player:GetAttribute("Holding")
	holding.Text = if text then "HOLDING: " .. tostring(text) else ""
	holding.Visible = text ~= nil
	if buttons.Crouch then
		buttons.Crouch.BackgroundColor3 = if player:GetAttribute("Crouching") then T.mustard else T.panelLight
	end
	if not crew or ghost then
		if World.uv then
			World.setUV(false)
		end
		chatPopup.Visible = false
	end
	if buttons.UV then
		buttons.UV.BackgroundColor3 = if World.uv then T.uv else T.panelLight
	end
end

local function starsFloat(data)
	if not State.isCrew() then
		return
	end
	local delta = data.delta or 0
	local label = Kit.label(root, ("%s%.1f★ %s"):format(if delta >= 0 then "+" else "", delta, data.reason or ""), {
		Size = UDim2.fromOffset(300, 28),
		Position = UDim2.fromOffset(20, 100),
		TextColor3 = if delta >= 0 then T.good else T.bad,
		Font = T.title,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextStrokeTransparency = 0.4,
		MaxText = 22,
	})
	TweenService:Create(label, TweenInfo.new(1.6), { Position = UDim2.fromOffset(20, 60), TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	task.delay(1.7, function()
		label:Destroy()
	end)
end

---------------------------------------------------------------------------

function HUD.init()
	-- always-on layer
	always = Kit.screen("NightShiftToasts", 30, true)
	local aroot = Kit.root(always)
	toastList = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 134),
		Size = UDim2.fromOffset(520, 200),
		BackgroundTransparency = 1,
		Parent = aroot,
	})
	Kit.list(toastList, Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Center)
	radioBox = Kit.new("Frame", {
		Position = UDim2.new(0, 16, 0.32, 0),
		Size = UDim2.fromOffset(380, 120),
		BackgroundColor3 = T.ink,
		BackgroundTransparency = 0.1,
		Visible = false,
		Parent = aroot,
	})
	Kit.corner(radioBox, 14)
	Kit.stroke(radioBox, T.mustard, 2)
	Kit.label(radioBox, "", { Name = "Who", Size = UDim2.new(1, -20, 0, 26), Position = UDim2.fromOffset(10, 6), Font = T.title, TextColor3 = T.mustard, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 20 })
	Kit.label(radioBox, "", { Name = "Text", Size = UDim2.new(1, -20, 1, -40), Position = UDim2.fromOffset(10, 34), Font = T.bold, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, MaxText = 20 })

	-- shift layer
	gui = Kit.screen("NightShiftHUD", 5, true)
	root = Kit.root(gui)
	local clockBox = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(300, 78),
		BackgroundColor3 = T.ink,
		BackgroundTransparency = 0.15,
		Parent = root,
	})
	Kit.corner(clockBox, 14)
	Kit.stroke(clockBox, T.ketchup, 2)
	clockLabel = Kit.label(clockBox, "6:00 PM", { Size = UDim2.new(1, 0, 0, 46), Position = UDim2.fromOffset(0, 4), Font = T.mono, TextColor3 = T.crtText, MaxText = 40 })
	nightLabel = Kit.label(clockBox, "", { Size = UDim2.new(1, -12, 0, 22), Position = UDim2.fromOffset(6, 50), Font = T.bold, TextColor3 = T.muted, MaxText = 15 })
	scareLabel = Kit.label(root, "", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 92),
		Size = UDim2.fromOffset(460, 34),
		BackgroundColor3 = T.bad,
		BackgroundTransparency = 0,
		Font = T.title,
		Visible = false,
		MaxText = 24,
	})
	Kit.corner(scareLabel, 10)
	TweenService:Create(scareLabel, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { BackgroundTransparency = 0.5 }):Play()

	local meters = Kit.new("Frame", {
		Position = UDim2.fromOffset(12, 8),
		Size = UDim2.fromOffset(330, 92),
		BackgroundColor3 = T.ink,
		BackgroundTransparency = 0.15,
		Parent = root,
	})
	Kit.corner(meters, 14)
	starsLabel = Kit.label(meters, "★★★☆☆", { Size = UDim2.new(1, -16, 0, 40), Position = UDim2.fromOffset(8, 4), Font = T.title, TextColor3 = T.mustard, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 32 })
	local weirdBack = Kit.new("Frame", { Size = UDim2.new(1, -16, 0, 26), Position = UDim2.fromOffset(8, 52), BackgroundColor3 = T.panelLight, Parent = meters })
	Kit.corner(weirdBack, 8)
	weirdFill = Kit.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = T.pickle, Parent = weirdBack })
	Kit.corner(weirdFill, 8)
	weirdLabel = Kit.label(weirdBack, "WEIRD 0%", { Size = UDim2.fromScale(1, 1), Font = T.bold, MaxText = 16, ZIndex = 2 })
	weirdChips = Kit.label(root, "", {
		Position = UDim2.fromOffset(12, 104),
		Size = UDim2.fromOffset(330, 26),
		BackgroundColor3 = T.uv,
		BackgroundTransparency = 0.1,
		Font = T.bold,
		Visible = false,
		MaxText = 15,
	})
	Kit.corner(weirdChips, 8)
	gizmoChip = Kit.label(root, "", { Position = UDim2.fromOffset(12, 134), Size = UDim2.fromOffset(330, 22), Font = T.bold, TextColor3 = T.crtText, TextXAlignment = Enum.TextXAlignment.Left, TextStrokeTransparency = 0.5, MaxText = 14 })
	fryChip = Kit.label(root, "", { Position = UDim2.fromOffset(12, 156), Size = UDim2.fromOffset(330, 22), Font = T.bold, TextColor3 = T.bun, TextXAlignment = Enum.TextXAlignment.Left, TextStrokeTransparency = 0.5, MaxText = 14 })

	crewList = Kit.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 8),
		Size = UDim2.fromOffset(300, 140),
		BackgroundTransparency = 1,
		Parent = root,
	})
	Kit.list(crewList, Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Right)

	rail = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, -8),
		Size = UDim2.new(1, -230, 0, 150),
		BackgroundTransparency = 1,
		Parent = root,
	})
	Kit.list(rail, Enum.FillDirection.Horizontal, 8)
	holding = Kit.label(root, "", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, -166),
		Size = UDim2.fromOffset(360, 34),
		BackgroundColor3 = T.mustard,
		BackgroundTransparency = 0,
		TextColor3 = T.ink,
		Font = T.title,
		Visible = false,
		MaxText = 20,
	})
	Kit.corner(holding, 10)

	-- big buttons (right side)
	-- on touch screens sit above the jump button
	local lift = if UserInputService.TouchEnabled then 140 else 12
	local column = Kit.new("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -12, 1, -lift),
		Size = UDim2.fromOffset(200, 360),
		BackgroundTransparency = 1,
		Parent = root,
	})
	local layout = Kit.list(column, Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Right)
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	local function bigButton(name: string, text: string, color: Color3, order: number, fn: () -> ())
		local b = Kit.button(column, text, color, fn, { Name = name, Size = UDim2.fromOffset(190, 58), LayoutOrder = order })
		buttons[name] = b
		return b
	end
	bigButton("UV", "UV  (U)", T.panelLight, 1, HUD.toggleUV).Visible = false
	bigButton("Chat", "CHAT  (Q)", T.navy, 2, HUD.toggleChat)
	bigButton("Ping", "PING  (G)", T.panelLight, 3, HUD.ping)
	bigButton("Crouch", "CROUCH  (C)", T.panelLight, 4, HUD.toggleCrouch)
	bigButton("Point", "👉 POINT  (G)", T.navy, 5, HUD.ping).Visible = false
	bigButton("Boo", "👻 BOO!  (B)", T.navy, 6, HUD.boo).Visible = false

	chatPopup = Kit.new("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -214, 1, -lift),
		Size = UDim2.fromOffset(420, 300),
		BackgroundColor3 = T.ink,
		BackgroundTransparency = 0.05,
		Visible = false,
		Parent = root,
	})
	Kit.corner(chatPopup, 14)
	Kit.padding(chatPopup, 8)
	Kit.new("UIGridLayout", { CellSize = UDim2.fromOffset(196, 48), CellPadding = UDim2.fromOffset(8, 8), Parent = chatPopup })
	for _, entry in QuickChat do
		Kit.button(chatPopup, entry.text, T.panelLight, function()
			chatPopup.Visible = false
			if Effects.flagActive("MandatoryFun") then
				HUD.toast("Mandatory Fun! Only smiling allowed.", "warn")
				return
			end
			State.action("QuickChat", { id = entry.id })
		end)
	end

	-- keyboard
	ContextActionService:BindAction("NS_Crouch", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			HUD.toggleCrouch()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.C, Enum.KeyCode.LeftControl)
	ContextActionService:BindAction("NS_Chat", function(_, inputState)
		if inputState == Enum.UserInputState.Begin and State.isCrew() then
			HUD.toggleChat()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.Q)
	ContextActionService:BindAction("NS_Ping", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			HUD.ping()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.G)
	ContextActionService:BindAction("NS_UV", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			HUD.toggleUV()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.U)
	ContextActionService:BindAction("NS_Boo", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			HUD.boo()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.B)

	Net.event("Notify").OnClientEvent:Connect(HUD.toast)
	Net.event("Radio").OnClientEvent:Connect(HUD.radio)
	Net.event("Effect").OnClientEvent:Connect(function(name, data)
		if name == "Stars" then
			starsFloat(data)
		end
	end)
	State.ShiftChanged:Connect(render)
	for _, attr in { "Crew", "Ghost", "Hidden", "Holding", "Crouching" } do
		player:GetAttributeChangedSignal(attr):Connect(refreshMode)
	end
	refreshMode()
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">Hide</string>
              <string name="Source"><![CDATA[-- Hiding-spot view (design doc §5.4): a peephole camera while hidden, the kitchen keeps going
-- without you, a LEAVE button (F), and a "getting cramped" meter for anti-camping.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Layout = require(Shared.Builders.Layout)
local Kit = require(script.Parent.Parent.UI.Kit)
local State = require(script.Parent.State)
local CameraView = require(script.Parent.CameraView)
local Effects = require(script.Parent.Effects)

local T = Kit.Theme
local player = Players.LocalPlayer

local Hide = {}

local gui: ScreenGui
local meterFill: Frame
local title: TextLabel
local hiddenSince = 0

local function leave()
	if State.isHidden() then
		State.action("LeaveHide")
	end
end

local function refresh()
	local spotId = player:GetAttribute("Hidden")
	if spotId and Layout.HidingSpots[spotId] then
		local spot = Layout.HidingSpots[spotId]
		hiddenSince = os.clock()
		CameraView.push("Hide", CFrame.lookAt(spot.peekFrom, spot.peekTo), 75)
		title.Text = ("HIDING: %s"):format(string.upper(spot.label))
		gui.Enabled = true
		ContextActionService:BindAction("NS_LeaveHide", function(_, inputState)
			if inputState == Enum.UserInputState.Begin then
				leave()
			end
			return Enum.ContextActionResult.Sink
		end, false, Enum.KeyCode.F)
	else
		CameraView.pop("Hide")
		gui.Enabled = false
		ContextActionService:UnbindAction("NS_LeaveHide")
		Effects.vignette(nil, false)
	end
end

function Hide.init()
	gui = Kit.screen("NightShiftHide", 8)
	gui.Enabled = false
	local root = Kit.root(gui)
	-- peephole: dark bars around a slot
	local shade = Color3.fromRGB(8, 8, 10)
	Kit.new("Frame", { Size = UDim2.fromScale(1, 0.3), BackgroundColor3 = shade, BackgroundTransparency = 0.05, Parent = root })
	Kit.new("Frame", { Position = UDim2.fromScale(0, 0.7), Size = UDim2.fromScale(1, 0.3), BackgroundColor3 = shade, BackgroundTransparency = 0.05, Parent = root })
	Kit.new("Frame", { Position = UDim2.fromScale(0, 0.3), Size = UDim2.fromScale(0.12, 0.4), BackgroundColor3 = shade, BackgroundTransparency = 0.2, Parent = root })
	Kit.new("Frame", { Position = UDim2.fromScale(0.88, 0.3), Size = UDim2.fromScale(0.12, 0.4), BackgroundColor3 = shade, BackgroundTransparency = 0.2, Parent = root })
	title = Kit.label(root, "HIDING", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 24), Size = UDim2.fromOffset(600, 40), Font = T.title, TextColor3 = T.mustard, MaxText = 32 })
	Kit.label(root, "Every second hidden is a second not cooking. Stay too long and you'll get popped out.", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 68),
		Size = UDim2.fromOffset(760, 28),
		TextColor3 = T.muted,
		MaxText = 16,
	})
	local meter = Kit.new("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -110), Size = UDim2.fromOffset(420, 22), BackgroundColor3 = T.panelLight, Parent = root })
	Kit.corner(meter, 8)
	meterFill = Kit.new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = T.warn, Parent = meter })
	Kit.corner(meterFill, 8)
	Kit.label(meter, "CRAMPED", { Size = UDim2.fromScale(1, 1), Font = T.bold, MaxText = 14 })
	Kit.button(root, "LEAVE (F)", T.ketchup, leave, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -24), Size = UDim2.fromOffset(280, 72) })

	player:GetAttributeChangedSignal("Hidden"):Connect(refresh)
	task.spawn(function()
		while true do
			task.wait(0.1)
			if gui.Enabled then
				local alpha = math.clamp((os.clock() - hiddenSince) / Config.Hide.CampMaxSeconds, 0, 1)
				meterFill.Size = UDim2.fromScale(alpha, 1)
				meterFill.BackgroundColor3 = T.good:Lerp(T.bad, alpha)
			end
		end
	end)
	refresh()
end

return Hide
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">Lobby</string>
              <string name="Source"><![CDATA[-- The parking-lot lobby HUD: Paychecks, menu buttons, the clock-in booth card (pick night,
-- Solo / Friends / Public, start), first-play Quick Start, and Rejoin after a crash (§7.1, §7.9).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Nights = require(Shared.Data.Nights)
local Kit = require(script.Parent.Parent.UI.Kit)
local State = require(script.Parent.State)
local Panels = require(script.Parent.Panels)

local T = Kit.Theme
local player = Players.LocalPlayer

local Lobby = {}

local gui: ScreenGui
local root: Frame
local money: TextLabel
local boothCard: Frame
local boothBody: Frame
local startCard: Frame
local notice: TextLabel
local lastBoothSig = ""
local countdownLabel: TextLabel? = nil
local quickStartBusy = false

local function toast(text: string, kind: string?)
	local HUD = require(script.Parent.HUD) :: any
	HUD.toast(text, kind)
end

local function renderBooth(lobby)
	local booth = nil
	for _, b in lobby.booths or {} do
		if b.isMember then
			booth = b
		end
	end
	if not booth then
		boothCard.Visible = false
		lastBoothSig = ""
		return
	end
	boothCard.Visible = true
	-- the countdown updates in place; buttons only rebuild when something else changes
	local sig = ("%s:%d:%s:%s:%s"):format(booth.id, booth.night, booth.privacy, tostring(booth.isLeader), table.concat(booth.members, ","))
	if sig == lastBoothSig then
		if countdownLabel then
			countdownLabel.Text = ("Clocking in: %ds"):format(math.ceil(booth.countdown or 0))
		end
		return
	end
	lastBoothSig = sig
	Kit.clear(boothBody)
	Kit.label(boothBody, ("CLOCK-IN %s"):format(booth.id), { Size = UDim2.new(1, 0, 0, 30), Font = T.title, TextColor3 = T.mustard, LayoutOrder = 1 })
	Kit.label(boothBody, ("NIGHT %d: %s"):format(booth.night, Nights.get(booth.night).title), { Size = UDim2.new(1, 0, 0, 28), Font = T.bold, LayoutOrder = 2, MaxText = 20 })
	Kit.label(boothBody, ("Crew (%d/4): %s"):format(#booth.members, table.concat(booth.members, ", ")), { Size = UDim2.new(1, 0, 0, 26), TextColor3 = T.muted, LayoutOrder = 3, MaxText = 16 })
	countdownLabel = Kit.label(boothBody, ("Clocking in: %ds"):format(math.ceil(booth.countdown or 0)), { Size = UDim2.new(1, 0, 0, 26), Font = T.bold, TextColor3 = T.good, LayoutOrder = 4, MaxText = 18 })
	if booth.isLeader then
		local nightRow = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 50), BackgroundTransparency = 1, LayoutOrder = 5, Parent = boothBody })
		Kit.list(nightRow, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center)
		local unlocked = lobby.unlocked or 1
		for n = 1, Nights.Count do
			local locked = n > unlocked
			Kit.button(nightRow, if locked then "🔒" else tostring(n), if n == booth.night then T.ketchup elseif locked then T.ink else T.panelLight, function()
				if not locked then
					State.action("Booth", { op = "night", value = n })
				else
					toast("Finish the previous night to unlock this one.")
				end
			end, { Size = UDim2.fromOffset(58, 48), LayoutOrder = n })
		end
		local privacyRow = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 50), BackgroundTransparency = 1, LayoutOrder = 6, Parent = boothBody })
		Kit.list(privacyRow, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center)
		for i, mode in { "Solo", "Friends", "Public" } do
			Kit.button(privacyRow, string.upper(mode), if mode == booth.privacy then T.navy else T.panelLight, function()
				State.action("Booth", { op = "privacy", value = mode })
			end, { Size = UDim2.fromOffset(110, 48), LayoutOrder = i })
		end
		Kit.button(boothBody, "CLOCK IN NOW ▶", T.good, function()
			State.action("Booth", { op = "start" })
		end, { Size = UDim2.new(1, 0, 0, 56), LayoutOrder = 7 })
	else
		Kit.label(boothBody, ("Leader: %s (%s)"):format(booth.leader or "?", booth.privacy), { Size = UDim2.new(1, 0, 0, 26), TextColor3 = T.muted, LayoutOrder = 5, MaxText = 16 })
	end
	Kit.label(boothBody, "Step off the pad to leave.", { Size = UDim2.new(1, 0, 0, 22), TextColor3 = T.muted, LayoutOrder = 9, MaxText = 14 })
end

local function render()
	local crew = State.isCrew()
	gui.Enabled = not crew
	if crew then
		return
	end
	local profile = State.profile
	money.Text = ("💵 %d Paychecks"):format(if profile then profile.paychecks or 0 else 0)
	local lobby = State.lobby
	if not lobby then
		return
	end
	renderBooth(lobby)
	local notes = {}
	if lobby.waitingForCrew then
		table.insert(notes, "Waiting for your crew to arrive...")
	end
	if lobby.kitchenBusy then
		table.insert(notes, "A crew is on shift in this server's kitchen (watch the lobby TV). In Studio only one shift runs at a time.")
	end
	if profile and profile.memoryOnly then
		table.insert(notes, "⚠ Saves are off in this session (Studio without API access).")
	end
	notice.Text = table.concat(notes, "\n")
	notice.Visible = #notes > 0
	local showStart = not boothCard.Visible and not lobby.shiftServer
	startCard.Visible = showStart
	if showStart then
		local first = startCard:FindFirstChild("First") :: TextButton
		local rejoin = startCard:FindFirstChild("Rejoin") :: TextButton
		local quick = startCard:FindFirstChild("Quick") :: TextButton
		first.Visible = lobby.firstJoin == true
		quick.Visible = lobby.firstJoin ~= true
		quick.Text = ("QUICK SOLO SHIFT — NIGHT %d"):format(math.clamp(lobby.unlocked or 1, 1, 5))
		rejoin.Visible = lobby.rejoin ~= nil
		if lobby.rejoin then
			rejoin.Text = ("REJOIN YOUR SHIFT (NIGHT %d)"):format(lobby.rejoin.night or 1)
		end
	end
end

local function quickStart(night: number?)
	if quickStartBusy then
		return
	end
	quickStartBusy = true
	local result = State.request("QuickStart", { night = night })
	if not result.ok and result.message then
		toast(result.message, "warn")
	end
	task.delay(2, function()
		quickStartBusy = false
	end)
end

function Lobby.init()
	gui = Kit.screen("NightShiftLobby", 4, true)
	root = Kit.root(gui)
	local top = Kit.new("Frame", { Position = UDim2.fromOffset(12, 8), Size = UDim2.fromOffset(560, 56), BackgroundTransparency = 1, Parent = root })
	Kit.list(top, Enum.FillDirection.Horizontal, 8)
	money = Kit.label(top, "💵 0 Paychecks", { Size = UDim2.fromOffset(220, 52), BackgroundTransparency = 0.15, BackgroundColor3 = T.ink, Font = T.title, TextColor3 = T.good, LayoutOrder = 1 })
	Kit.corner(money, 12)
	Kit.button(top, "📘 FIELD GUIDE", T.pickle, function()
		Panels.open("FieldGuide", State.profile)
	end, { Size = UDim2.fromOffset(170, 52), LayoutOrder = 2 })
	Kit.button(top, "⚙", T.panelLight, function()
		Panels.open("Settings", State.profile)
	end, { Size = UDim2.fromOffset(60, 52), LayoutOrder = 3 })
	Kit.button(top, "👕", T.navy, function()
		Panels.open("Locker", State.profile)
	end, { Size = UDim2.fromOffset(60, 52), LayoutOrder = 4 })

	notice = Kit.label(root, "", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 70),
		Size = UDim2.fromOffset(720, 60),
		BackgroundTransparency = 0.2,
		BackgroundColor3 = T.ink,
		Font = T.bold,
		Visible = false,
		MaxText = 18,
	})
	Kit.corner(notice, 10)

	boothCard = Kit.new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.5, 0),
		Size = UDim2.fromOffset(400, 470),
		BackgroundColor3 = T.panel,
		BackgroundTransparency = 0.05,
		Visible = false,
		Parent = root,
	})
	Kit.corner(boothCard, 16)
	Kit.stroke(boothCard, T.mustard, 3)
	boothBody = Kit.new("Frame", { Size = UDim2.new(1, -24, 1, -24), Position = UDim2.fromOffset(12, 12), BackgroundTransparency = 1, Parent = boothCard })
	Kit.list(boothBody, Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center)

	startCard = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -24),
		Size = UDim2.fromOffset(560, 200),
		BackgroundTransparency = 1,
		Parent = root,
	})
	Kit.list(startCard, Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center).VerticalAlignment = Enum.VerticalAlignment.Bottom
	Kit.button(startCard, "REJOIN YOUR SHIFT", T.warn, function()
		local result = State.request("Rejoin")
		if not result.ok and result.message then
			toast(result.message, "bad")
		end
	end, { Name = "Rejoin", Size = UDim2.fromOffset(520, 60), Visible = false, LayoutOrder = 1 })
	Kit.button(startCard, "START YOUR FIRST SHIFT ▶", T.ketchup, function()
		quickStart(1)
	end, { Name = "First", Size = UDim2.fromOffset(520, 76), Visible = false, LayoutOrder = 2 })
	Kit.button(startCard, "QUICK SOLO SHIFT", T.panelLight, function()
		quickStart(nil)
	end, { Name = "Quick", Size = UDim2.fromOffset(520, 56), LayoutOrder = 3 })
	Kit.label(startCard, "...or step on a CLOCK-IN pad with friends (1–4 crew).", { Size = UDim2.fromOffset(520, 26), TextStrokeTransparency = 0.4, Font = T.bold, LayoutOrder = 4, MaxText = 16 })

	State.LobbyChanged:Connect(render)
	State.ProfileChanged:Connect(render)
	player:GetAttributeChangedSignal("Crew"):Connect(render)
	render()
end

return Lobby
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">MenuPanels</string>
              <string name="Source"><![CDATA[-- Lobby menus: Locker (cosmetics shop), Fax (codes), Field Guide (anomaly trading cards, badges,
-- endings) and Settings (reduced flashing, captions, Fast Start).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Cosmetics = require(Shared.Data.Cosmetics)
local Anomalies = require(Shared.Data.Anomalies)
local BadgeData = require(Shared.Data.Badges)
local WeirdEvents = require(Shared.Data.WeirdEvents)
local StoryData = require(Shared.Data.Story)
local Kit = require(script.Parent.Parent.UI.Kit)
local State = require(script.Parent.State)
local Panels = require(script.Parent.Panels)

local T = Kit.Theme

local MenuPanels = {}

local function toast(text: string, kind: string?)
	local HUD = require(script.Parent.HUD) :: any
	HUD.toast(text, kind)
end

---------------------------------------------------------------------------
-- Locker
---------------------------------------------------------------------------

local Locker = {}
do
	local layer: Frame
	local grid: ScrollingFrame
	local balance: TextLabel
	local slot = "Hat"
	local tabs: { [string]: TextButton } = {}

	local function render()
		local profile = State.profile
		if not layer or not layer.Visible or not profile then
			return
		end
		balance.Text = ("💵 %d Paychecks"):format(profile.paychecks or 0)
		for name, button in tabs do
			button.BackgroundColor3 = if name == slot then T.ketchup else T.panelLight
		end
		Kit.clear(grid)
		for i, item in Cosmetics.List do
			if item.slot ~= slot then
				continue
			end
			local owned = profile.owned and profile.owned[item.id]
			local equipped = profile.equipped and profile.equipped[item.slot] == item.id
			local card = Kit.new("Frame", { BackgroundColor3 = T.panelLight, LayoutOrder = i, Parent = grid })
			Kit.corner(card, 12)
			if item.color then
				local swatch = Kit.new("Frame", { Position = UDim2.fromOffset(10, 10), Size = UDim2.new(1, -20, 0, 50), BackgroundColor3 = item.color, Parent = card })
				Kit.corner(swatch, 10)
			end
			Kit.label(card, item.name, { Position = UDim2.fromOffset(8, 66), Size = UDim2.new(1, -16, 0, 40), Font = T.bold, MaxText = 18 })
			local text, color, enabled
			if equipped then
				text, color, enabled = "EQUIPPED", T.good, false
			elseif owned then
				text, color, enabled = "EQUIP", T.navy, true
			elseif item.price then
				text, color, enabled = ("BUY  💵%d"):format(item.price), T.mustard, true
			elseif item.robux then
				text, color, enabled = "BUY (Robux)", T.ketchup, true
			else
				text, color, enabled = item.hint or "LOCKED", T.ink, false
			end
			Kit.button(card, text, color, function()
				if not enabled then
					return
				end
				local result
				if owned then
					result = State.request("Equip", { id = item.id })
				else
					result = State.request("BuyCosmetic", { id = item.id })
					if result.ok and not result.prompted then
						State.request("Equip", { id = item.id })
					end
				end
				if result.message then
					toast(result.message, if result.ok then "good" else "bad")
				end
			end, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), Size = UDim2.new(1, -16, 0, 44), TextColor3 = if color == T.mustard then T.ink else T.white })
		end
	end

	function Locker.open()
		if not layer then
			local created = Panels.layer("Locker", 0.4)
			layer = created
			local _, content = Kit.panel(created, "LOCKER ROOM", UDim2.fromOffset(980, 580), function()
				Panels.close("Locker")
			end)
			balance = Kit.label(content, "", { Size = UDim2.new(1, 0, 0, 34), Font = T.title, TextColor3 = T.good, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 24 })
			local tabRow = Kit.new("Frame", { Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, 0, 0, 48), BackgroundTransparency = 1, Parent = content })
			Kit.list(tabRow, Enum.FillDirection.Horizontal, 8)
			local labels = { Hat = "HATS", Apron = "APRONS", Ghost = "GHOST SKINS", Tag = "NAME TAGS", Trail = "TRAILS" }
			for i, name in Cosmetics.Slots do
				tabs[name] = Kit.button(tabRow, labels[name] or name, T.panelLight, function()
					slot = name
					render()
				end, { Size = UDim2.fromOffset(170, 46), LayoutOrder = i })
			end
			grid = Kit.scroll(content, { Position = UDim2.fromOffset(0, 96), Size = UDim2.new(1, 0, 1, -160) })
			Kit.new("UIGridLayout", { CellSize = UDim2.fromOffset(220, 170), CellPadding = UDim2.fromOffset(10, 10), Parent = grid })
			Kit.button(content, "⭐ SUPPORTER PASS (golden name tag)", T.mustard, function()
				local result = State.request("BuySupporter")
				if result.message then
					toast(result.message, if result.ok then "good" else "bad")
				end
			end, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromOffset(420, 54), TextColor3 = T.ink })
			Kit.label(content, "Cosmetic only. Never revives, never stats, never mid-shift.", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromScale(1, 1), Size = UDim2.fromOffset(480, 54), TextColor3 = T.muted, MaxText = 15 })
			State.ProfileChanged:Connect(render)
		end
		layer.Visible = true
		render()
	end
	function Locker.close()
		if layer then
			layer.Visible = false
		end
	end
end

---------------------------------------------------------------------------
-- Fax (codes)
---------------------------------------------------------------------------

local Fax = {}
do
	local layer: Frame
	local box: TextBox
	local result: TextLabel
	function Fax.open()
		if not layer then
			local created = Panels.layer("Fax", 0.4)
			layer = created
			local _, content = Kit.panel(created, "CORPORATE FAX — ENTER CODE", UDim2.fromOffset(620, 320), function()
				Panels.close("Fax")
			end)
			box = Kit.new("TextBox", {
				Size = UDim2.new(1, 0, 0, 64),
				BackgroundColor3 = T.paper,
				TextColor3 = T.ink,
				PlaceholderText = "TYPE A CODE",
				Font = T.mono,
				TextScaled = true,
				ClearTextOnFocus = false,
				Text = "",
				Parent = content,
			})
			Kit.corner(box, 10)
			result = Kit.label(content, "", { Position = UDim2.fromOffset(0, 74), Size = UDim2.new(1, 0, 0, 50), Font = T.bold, MaxText = 20 })
			Kit.button(content, "SEND FAX 📠", T.good, function()
				local response = State.request("RedeemCode", { code = box.Text })
				result.Text = response.message or ""
				result.TextColor3 = if response.ok then T.good else T.bad
			end, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 1), Size = UDim2.fromOffset(260, 60) })
		end
		box.Text = ""
		result.Text = "Codes come in updates, on the group page... and sometimes on sticky notes."
		result.TextColor3 = T.muted
		layer.Visible = true
	end
	function Fax.close()
		if layer then
			layer.Visible = false
		end
	end
end

---------------------------------------------------------------------------
-- Field Guide (+ badges + endings)
---------------------------------------------------------------------------

local FieldGuide = {}
do
	local layer: Frame
	local body: ScrollingFrame
	local mode = "Cards"
	local tabs: { [string]: TextButton } = {}
	local CHANNEL_ICONS = { Window = "🪟", Mirror = "🪞", LaneCam = "📹", Receipt = "🧾", Speaker = "🔊", UV = "🔦" }

	local function renderCards(profile)
		local guide = profile.fieldGuide or {}
		local anyEnding = next(profile.endings or {}) ~= nil
		for i, entry in Anomalies.List do
			local status = guide[entry.id]
			local card = Kit.new("Frame", { Size = UDim2.new(1, -12, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = if status then T.paper else T.panelLight, LayoutOrder = i, Parent = body })
			Kit.corner(card, 12)
			Kit.padding(card, 10)
			Kit.list(card, Enum.FillDirection.Vertical, 2)
			if not status then
				Kit.label(card, ("#%03d — ??? (not yet encountered)"):format(entry.number), { Size = UDim2.new(1, 0, 0, 28), Font = T.title, TextColor3 = T.muted, TextXAlignment = Enum.TextXAlignment.Left })
				continue
			end
			local danger = string.rep("★", entry.danger or 0) .. string.rep("☆", 5 - (entry.danger or 0))
			Kit.label(card, ("#%03d — %s  %s"):format(entry.number, string.upper(entry.name), if status == "caught" then "✅ CAUGHT" else "👀 SEEN"), { Size = UDim2.new(1, 0, 0, 30), Font = T.title, TextColor3 = T.ketchup, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 1 })
			Kit.label(card, ("Late Customer • Danger: %s • %s"):format(danger, entry.look or ""), { Size = UDim2.new(1, 0, 0, 22), TextColor3 = T.ink, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 16, LayoutOrder = 2 })
			for j, tell in entry.tells or {} do
				Kit.label(card, ("%s %s: %s"):format(CHANNEL_ICONS[tell.channel] or "•", string.upper(tell.channel), tell.text), { Size = UDim2.new(1, 0, 0, 22), TextColor3 = T.ink, Font = T.bold, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 16, LayoutOrder = 2 + j })
			end
			Kit.label(card, ("Says: \"%s\""):format(entry.speaker and entry.speaker[1] or ""), { Size = UDim2.new(1, 0, 0, 22), TextColor3 = T.navy, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 16, LayoutOrder = 10 })
			local event = WeirdEvents.ById[entry.weirdEvent]
			if event then
				Kit.label(card, ("If served: %s — %s"):format(event.name, event.description), { Size = UDim2.new(1, 0, 0, 22), TextColor3 = T.uv, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 15, LayoutOrder = 11 })
			end
			Kit.label(card, "Notes from Deb: \"" .. (entry.debNote or "") .. "\"", { Size = UDim2.new(1, 0, 0, 22), Font = T.hand, TextColor3 = T.ink, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 18, LayoutOrder = 12 })
			if entry.photo and (anyEnding or (profile.freed and profile.freed[entry.id])) then
				Kit.label(card, ("🔦 %s, %s, %d. \"The usual\": %s"):format(entry.photo.employee, entry.photo.job, entry.photo.year, entry.photo.usualText), { Size = UDim2.new(1, 0, 0, 22), Font = T.bold, TextColor3 = Color3.fromRGB(120, 60, 180), TextXAlignment = Enum.TextXAlignment.Left, MaxText = 16, LayoutOrder = 13 })
			end
		end
	end

	local function renderBadges(profile)
		local earned = profile.badges or {}
		local count = 0
		for _ in earned do
			count += 1
		end
		Kit.label(body, ("%d / %d badges"):format(count, #BadgeData.List), { Size = UDim2.new(1, -12, 0, 30), Font = T.title, TextColor3 = T.mustard, LayoutOrder = 0 })
		for i, badge in BadgeData.List do
			local has = earned[badge.id] ~= nil
			local row = Kit.label(body, ("%s  %s — %s"):format(if has then "🏅" else "🔒", badge.name, if has or badge.desc ~= "???" then badge.desc else "???"), {
				Size = UDim2.new(1, -12, 0, 30),
				BackgroundTransparency = 0,
				BackgroundColor3 = if has then T.panelLight else T.ink,
				TextColor3 = if has then T.white else T.muted,
				Font = T.bold,
				TextXAlignment = Enum.TextXAlignment.Left,
				LayoutOrder = i,
				MaxText = 16,
			})
			Kit.corner(row, 8)
			Kit.padding(row, 4)
		end
	end

	local function renderEndings(profile)
		local seen = profile.endings or {}
		local order = { "Company", "Freed", "Fired", "Mascot" }
		for i, id in order do
			local ending = StoryData.Endings[id]
			local has = seen[id] ~= nil
			local row = Kit.label(body, if has then ("✅ %s"):format(ending.title) else "🔒 ???", {
				Size = UDim2.new(1, -12, 0, 40),
				BackgroundTransparency = 0,
				BackgroundColor3 = if has then T.panelLight else T.ink,
				Font = T.title,
				LayoutOrder = i,
			})
			Kit.corner(row, 8)
		end
		local nights = profile.nightResults or {}
		for n = 1, 5 do
			local r = nights[tostring(n)]
			Kit.label(body, ("Night %d: %s"):format(n, if r then ("%s badge (%.1f★)"):format(r.grade, r.stars) else if n <= (profile.nightsUnlocked or 1) then "unlocked" else "locked"), {
				Size = UDim2.new(1, -12, 0, 26),
				TextColor3 = T.muted,
				LayoutOrder = 10 + n,
				MaxText = 16,
			})
		end
	end

	local function render()
		local profile = State.profile
		if not layer or not layer.Visible or not profile then
			return
		end
		for name, button in tabs do
			button.BackgroundColor3 = if name == mode then T.ketchup else T.panelLight
		end
		Kit.clear(body)
		if mode == "Cards" then
			renderCards(profile)
		elseif mode == "Badges" then
			renderBadges(profile)
		else
			renderEndings(profile)
		end
	end

	function FieldGuide.open()
		if not layer then
			local created = Panels.layer("FieldGuide", 0.4)
			layer = created
			local _, content = Kit.panel(created, "FIELD GUIDE", UDim2.fromOffset(1000, 600), function()
				Panels.close("FieldGuide")
			end)
			local tabRow = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 48), BackgroundTransparency = 1, Parent = content })
			Kit.list(tabRow, Enum.FillDirection.Horizontal, 8)
			for i, name in { "Cards", "Badges", "Endings" } do
				tabs[name] = Kit.button(tabRow, string.upper(name), T.panelLight, function()
					mode = name
					render()
				end, { Size = UDim2.fromOffset(180, 46), LayoutOrder = i })
			end
			body = Kit.scroll(content, { Position = UDim2.fromOffset(0, 56), Size = UDim2.new(1, 0, 1, -56) })
			Kit.list(body, Enum.FillDirection.Vertical, 8)
			State.ProfileChanged:Connect(render)
		end
		layer.Visible = true
		render()
	end
	function FieldGuide.close()
		if layer then
			layer.Visible = false
		end
	end
end

---------------------------------------------------------------------------
-- Settings
---------------------------------------------------------------------------

local Settings = {}
do
	local layer: Frame
	local list: Frame
	local OPTIONS = {
		{ key = "reducedFlashing", label = "Reduced flashing lights", desc = "Lights dim instead of strobing during scares." },
		{ key = "captions", label = "Captions for sounds", desc = "[squeak... squeak... — left] style captions for every audio cue." },
		{ key = "fastStart", label = "Fast Start", desc = "Skip the guided first shift and shorten pre-shift." },
	}
	local function render()
		if not layer or not layer.Visible then
			return
		end
		Kit.clear(list)
		for i, option in OPTIONS do
			local on = State.setting(option.key) == true
			local row = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 76), BackgroundColor3 = T.panelLight, LayoutOrder = i, Parent = list })
			Kit.corner(row, 10)
			Kit.label(row, option.label, { Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -170, 0, 32), Font = T.bold, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 22 })
			Kit.label(row, option.desc, { Position = UDim2.fromOffset(12, 40), Size = UDim2.new(1, -170, 0, 28), TextColor3 = T.muted, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 15 })
			Kit.button(row, if on then "ON" else "OFF", if on then T.good else T.ink, function()
				State.request("SetSetting", { key = option.key, value = not on })
			end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(130, 52) })
		end
	end
	function Settings.open()
		if not layer then
			local created = Panels.layer("Settings", 0.4)
			layer = created
			local _, content = Kit.panel(created, "SETTINGS", UDim2.fromOffset(720, 400), function()
				Panels.close("Settings")
			end)
			list = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = content })
			Kit.list(list, Enum.FillDirection.Vertical, 10)
			State.ProfileChanged:Connect(render)
		end
		layer.Visible = true
		render()
	end
	function Settings.close()
		if layer then
			layer.Visible = false
		end
	end
end

function MenuPanels.init()
	Panels.register("Locker", Locker)
	Panels.register("Fax", Fax)
	Panels.register("FieldGuide", FieldGuide)
	Panels.register("Settings", Settings)
end

return MenuPanels
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">OrderPanel</string>
              <string name="Source"><![CDATA[-- The order station CRT (design doc §6.4 "Order (speaker)"): the customer's words come through the
-- headset (with speaker-channel tells: static, backwards words, unison voices, pitch shifts) and you
-- tap the menu to enter the order. Flag SUSPICIOUS to warn the crew.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Menu = require(Shared.Data.Menu)
local OrderLogic = require(Shared.OrderLogic)
local Kit = require(script.Parent.Parent.UI.Kit)
local State = require(script.Parent.State)
local Audio = require(script.Parent.Audio)
local Panels = require(script.Parent.Panels)
local Effects = require(script.Parent.Effects)

local T = Kit.Theme
local player = Players.LocalPlayer

local OrderPanel = {}

local layer: Frame
local speakerBox: ScrollingFrame
local orderList: ScrollingFrame
local flagButton: TextButton
local current: any = nil
local lines: { { item: string, mods: { string } } } = {}
local flagged = false
local typeToken = 0

local GLITCH = { "▒", "#", "%", "?", "@", "~" }

local function glitch(text: string): string
	local out = {}
	for i = 1, #text do
		local c = string.sub(text, i, i)
		if c ~= " " and math.random() < 0.18 then
			c = GLITCH[math.random(1, #GLITCH)]
		end
		table.insert(out, c)
	end
	return table.concat(out)
end

local function renderOrder()
	Kit.clear(orderList)
	if #lines == 0 then
		Kit.label(orderList, "(empty — tap the menu to add items)", { Size = UDim2.new(1, -10, 0, 30), TextColor3 = T.muted, MaxText = 16 })
	end
	for i, line in lines do
		local row = Kit.new("Frame", { Size = UDim2.new(1, -10, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.panelLight, LayoutOrder = i, Parent = orderList })
		Kit.corner(row, 8)
		Kit.padding(row, 6)
		local def = Menu.Items[line.item]
		Kit.label(row, ("#%d %s"):format(def.number, OrderLogic.lineLabel(line)), { Size = UDim2.new(1, -60, 0, 28), Font = T.bold, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 18 })
		Kit.button(row, "✕", T.bad, function()
			table.remove(lines, i)
			renderOrder()
		end, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(44, 30) })
		local valid = OrderLogic.validMods(line.item)
		if #valid > 0 then
			local chips = Kit.new("Frame", { Position = UDim2.fromOffset(0, 32), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = row })
			Kit.new("UIGridLayout", { CellSize = UDim2.fromOffset(118, 30), CellPadding = UDim2.fromOffset(4, 4), Parent = chips })
			for j, modId in valid do
				local on = table.find(line.mods, modId) ~= nil
				Kit.button(chips, Menu.Mods[modId].label, if on then T.mustard else T.ink, function()
					local index = table.find(line.mods, modId)
					if index then
						table.remove(line.mods, index)
					else
						-- one mod per topping (can't have "No Cheese" and "Extra Cheese")
						for k = #line.mods, 1, -1 do
							if Menu.Mods[line.mods[k]].topping == Menu.Mods[modId].topping then
								table.remove(line.mods, k)
							end
						end
						table.insert(line.mods, modId)
					end
					renderOrder()
				end, { LayoutOrder = j, Font = T.bold, TextColor3 = if on then T.ink else T.white })
			end
		end
	end
end

local function typeSpeaker(data)
	typeToken += 1
	local token = typeToken
	Kit.clear(speakerBox)
	local surf = Effects.flagActive("ChannelSurf")
	task.spawn(function()
		for i, text in data.lines or {} do
			if token ~= typeToken then
				return
			end
			local shown = text
			if data.reversed then
				shown = text .. "  [the words sound... backwards]"
			end
			local label = Kit.label(speakerBox, "", {
				Size = UDim2.new(1, -8, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				TextScaled = false,
				TextSize = 22,
				Font = T.mono,
				TextColor3 = if data.unison then Color3.fromRGB(200, 255, 200) else T.crtText,
				TextXAlignment = Enum.TextXAlignment.Left,
				LayoutOrder = i,
			})
			for c = 1, #shown do
				if token ~= typeToken then
					return
				end
				local partial = string.sub(shown, 1, c)
				if data.static or surf then
					partial = glitch(partial)
				end
				label.Text = "🔊 " .. partial
				if c % 2 == 0 then
					Audio.blip(data.voiceSeed or 3, data.static or data.reversed)
				end
				task.wait(0.022)
			end
			if data.static then
				label.Text = "🔊 " .. glitch(shown)
			end
			task.wait(0.35)
		end
		for j, caption in data.captions or {} do
			Kit.label(speakerBox, caption, {
				Size = UDim2.new(1, -8, 0, 26),
				Font = T.bold,
				TextColor3 = T.muted,
				TextXAlignment = Enum.TextXAlignment.Left,
				LayoutOrder = 100 + j,
				MaxText = 18,
			})
		end
		if data.wantsUsual then
			Kit.label(speakerBox, "(The usual? Check the back of their Employee of the Month photo — with UV.)", {
				Size = UDim2.new(1, -8, 0, 44),
				Font = T.bold,
				TextColor3 = T.uv,
				TextXAlignment = Enum.TextXAlignment.Left,
				LayoutOrder = 200,
				MaxText = 16,
			})
		end
	end)
end

local function build()
	layer = Panels.layer("Order", 0.35)
	local _, content = Kit.panel(layer, "MUNCHIE'S POS v1.987 — TAKE ORDER", UDim2.fromOffset(1060, 600), function()
		OrderPanel.cancel()
	end)
	-- speaker side
	local crt = Kit.new("Frame", { Size = UDim2.new(0.42, -8, 1, -70), BackgroundColor3 = T.crt, Parent = content })
	Kit.corner(crt, 12)
	Kit.stroke(crt, Color3.fromRGB(60, 90, 60), 3)
	Kit.label(crt, "🎧 HEADSET", { Size = UDim2.new(1, -16, 0, 28), Position = UDim2.fromOffset(8, 6), Font = T.mono, TextColor3 = T.crtText, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 20 })
	speakerBox = Kit.scroll(crt, { Size = UDim2.new(1, -16, 1, -80), Position = UDim2.fromOffset(8, 38) })
	Kit.list(speakerBox, Enum.FillDirection.Vertical, 8)
	Kit.button(crt, "▶ REPLAY", Color3.fromRGB(30, 60, 35), function()
		if current then
			typeSpeaker(current)
		end
	end, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 8, 1, -8), Size = UDim2.fromOffset(150, 40) })
	-- menu side
	local right = Kit.new("Frame", { Position = UDim2.new(0.42, 8, 0, 0), Size = UDim2.new(0.58, -8, 1, -70), BackgroundTransparency = 1, Parent = content })
	local menu = Kit.new("Frame", { Size = UDim2.new(1, 0, 0, 150), BackgroundTransparency = 1, Parent = right })
	Kit.new("UIGridLayout", { CellSize = UDim2.new(1 / 3, -6, 0, 70), CellPadding = UDim2.fromOffset(8, 8), Parent = menu })
	for i, itemId in Menu.Order do
		local def = Menu.Items[itemId]
		Kit.button(menu, ("#%d %s"):format(def.number, def.name), def.color, function()
			table.insert(lines, { item = itemId, mods = {} })
			renderOrder()
		end, { LayoutOrder = i, TextColor3 = T.ink })
	end
	Kit.label(right, "Gerald's #7? There is no #7. Send an empty order.", { Position = UDim2.fromOffset(0, 154), Size = UDim2.new(1, 0, 0, 20), TextColor3 = T.muted, MaxText = 13 })
	orderList = Kit.scroll(right, { Position = UDim2.fromOffset(0, 178), Size = UDim2.new(1, 0, 1, -178) })
	Kit.list(orderList, Enum.FillDirection.Vertical, 6)
	-- bottom bar
	local bar = Kit.new("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 60), BackgroundTransparency = 1, Parent = content })
	flagButton = Kit.button(bar, "⚠ FLAG SUSPICIOUS", T.panelLight, function()
		flagged = not flagged
		flagButton.BackgroundColor3 = if flagged then T.warn else T.panelLight
	end, { Size = UDim2.fromOffset(300, 56) })
	Kit.button(bar, "CLEAR", T.panelLight, function()
		table.clear(lines)
		renderOrder()
	end, { Position = UDim2.fromOffset(312, 0), Size = UDim2.fromOffset(140, 56) })
	Kit.button(bar, "SEND TO KITCHEN ▶", T.good, function()
		if not current then
			return
		end
		local payload = {}
		for _, line in lines do
			table.insert(payload, { item = line.item, mods = line.mods })
		end
		State.action("SubmitOrder", { carId = current.carId, lines = payload, flagged = flagged })
	end, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(320, 56) })
end

function OrderPanel.open(data)
	if not layer then
		build()
	end
	current = data
	table.clear(lines)
	flagged = false
	flagButton.BackgroundColor3 = T.panelLight
	layer.Visible = true
	renderOrder()
	typeSpeaker(data)
end

function OrderPanel.close()
	typeToken += 1
	current = nil
	if layer then
		layer.Visible = false
	end
end

function OrderPanel.cancel()
	if current then
		State.action("CancelOrder", { carId = current.carId })
	end
	Panels.close("Order")
end

function OrderPanel.init()
	Panels.register("Order", OrderPanel)
	-- walking away from the console closes it
	task.spawn(function()
		while true do
			task.wait(0.5)
			if current and layer and layer.Visible then
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
				local map = workspace:FindFirstChild("Munchies")
				local console = map and map:FindFirstChild("Kitchen") and map.Kitchen:FindFirstChild("OrderConsole") :: BasePart?
				if root and console and (root.Position - console.Position).Magnitude > 16 then
					OrderPanel.cancel()
				end
			end
		end
	end)
end

return OrderPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">Panels</string>
              <string name="Source"><![CDATA[-- Panel manager (server opens/closes panels by name) + the smaller shift panels:
-- PreShift (role pick + Deb's sticky note), HoldBreath, Report (the corporate report card),
-- Ending, VHS.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Kit = require(script.Parent.Parent.UI.Kit)
local State = require(script.Parent.State)
local Audio = require(script.Parent.Audio)

local T = Kit.Theme
local player = Players.LocalPlayer

local Panels = {}

local registry: { [string]: any } = {}
local isOpen: { [string]: boolean } = {}
local gui: ScreenGui
Panels.root = (nil :: any) :: Frame

function Panels.register(name: string, module: any)
	registry[name] = module
end

function Panels.open(name: string, data: any)
	local module = registry[name]
	if not module then
		warn("[Panels] no panel named " .. tostring(name))
		return
	end
	isOpen[name] = true
	module.open(data or {})
end

function Panels.close(name: string)
	if name == "All" then
		for openName in table.clone(isOpen) do
			Panels.close(openName)
		end
		return
	end
	local module = registry[name]
	if module and isOpen[name] then
		isOpen[name] = nil
		module.close()
	end
end

function Panels.markClosed(name: string)
	isOpen[name] = nil
end

function Panels.isOpen(name: string): boolean
	return isOpen[name] == true
end

-- A dimmed full-screen container for one panel.
-- Panels that must sit on top of others regardless of creation order.
local LAYER_Z = { Ending = 20, HoldBreath = 15, Report = 10 }

function Panels.layer(name: string, dim: number?): Frame
	local layer = Kit.new("Frame", {
		Name = name,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = dim or 0.45,
		Visible = false,
		ZIndex = LAYER_Z[name] or 1,
		Parent = Panels.root,
	})
	return layer
end

---------------------------------------------------------------------------
-- PreShift
---------------------------------------------------------------------------

local ROLE_INFO = {
	Order = "EARS — take orders at the CRT. Flag weird voices.",
	Grill = "HANDS — patties on the grill, build burgers on the plate.",
	Fry = "HANDS — fries, drinks & shakes. (Gizmo covers it if nobody does.)",
	Window = "DETECTIVE — bag it, inspect the car, HAND OUT or REFUSE.",
}

local PreShift = {}
do
	local layer: Frame
	local content: Frame
	local timerLabel: TextLabel
	local timerToken = 0
	local endsAt = 0
	function PreShift.open(data)
		if not layer then
			local created = Panels.layer("PreShift", 0.35)
			layer = created
			local _, c = Kit.panel(created, "CLOCKING IN", UDim2.fromOffset(940, 560))
			content = c
		end
		layer.Visible = true
		Kit.clear(content)
		endsAt = os.clock() + (data.endsIn or 20)
		Kit.label(content, ("NIGHT %d: %s"):format(data.night, data.title), { Size = UDim2.new(1, 0, 0, 44), Font = T.title, TextColor3 = T.mustard, MaxText = 36 })
		local note = Kit.label(content, data.note or "", {
			Size = UDim2.fromOffset(380, 300),
			Position = UDim2.fromOffset(0, 56),
			BackgroundTransparency = 0,
			BackgroundColor3 = Color3.fromRGB(255, 240, 120),
			TextColor3 = T.ink,
			Font = T.hand,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			MaxText = 26,
		})
		Kit.padding(note, 14)
		note.Rotation = -2
		local right = Kit.new("Frame", { Size = UDim2.new(1, -410, 1, -60), Position = UDim2.fromOffset(410, 56), BackgroundTransparency = 1, Parent = content })
		Kit.list(right, Enum.FillDirection.Vertical, 6)
		Kit.label(right, "PICK A STATION (you can still do anything)", { Size = UDim2.new(1, 0, 0, 24), Font = T.bold, TextColor3 = T.muted, MaxText = 16 })
		local myRole = nil
		for _, r in data.roles do
			if r.userId == player.UserId then
				myRole = r.role
			end
		end
		for i, role in data.allRoles do
			local taken = {}
			for _, r in data.roles do
				if r.role == role then
					table.insert(taken, r.name .. (if r.ready then " ✓" else ""))
				end
			end
			Kit.button(right, ("%s%s\n%s"):format(role, if #taken > 0 then "  (" .. table.concat(taken, ", ") .. ")" else "", ROLE_INFO[role] or ""), if role == myRole then T.ketchup else T.panelLight, function()
				State.action("PickRole", { role = role })
			end, { Size = UDim2.new(1, 0, 0, 70), LayoutOrder = i, Font = T.bold, TextXAlignment = Enum.TextXAlignment.Left })
		end
		Kit.button(content, "READY!", T.good, function()
			State.action("Ready")
		end, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromScale(1, 1), Size = UDim2.fromOffset(220, 60) })
		timerLabel = Kit.label(content, "", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromOffset(380, 40), Font = T.bold, TextColor3 = T.muted, MaxText = 20 })
		timerToken += 1
		local myToken = timerToken
		task.spawn(function()
			while myToken == timerToken and layer.Visible and Panels.isOpen("PreShift") do
				timerLabel.Text = ("Shift starts in %d..."):format(math.max(0, math.ceil(endsAt - os.clock())))
				task.wait(0.25)
			end
		end)
	end
	function PreShift.close()
		if layer then
			layer.Visible = false
		end
	end
end

---------------------------------------------------------------------------
-- HoldBreath (Night 4+: Mr. Munch knocks on your hiding spot)
---------------------------------------------------------------------------

local HoldBreath = {}
do
	local layer: Frame
	local token = 0
	function HoldBreath.open(data)
		if not layer then
			layer = Panels.layer("HoldBreath", 0.55)
		end
		token += 1
		local myToken = token
		Kit.clear(layer)
		layer.Visible = true
		Audio.play("Knock")
		Kit.label(layer, "KNOCK. KNOCK.\nHOLD YOUR BREATH!", { Size = UDim2.new(1, 0, 0, 110), Position = UDim2.fromScale(0, 0.18), Font = T.title, TextColor3 = T.bad, MaxText = 52 })
		local bar = Kit.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.52), Size = UDim2.fromOffset(560, 54), BackgroundColor3 = T.ink, Parent = layer })
		Kit.corner(bar, 12)
		Kit.stroke(bar, T.white, 2)
		local zone = Kit.new("Frame", { Size = UDim2.fromScale(0.22, 1), BackgroundColor3 = T.good, Parent = bar })
		local marker = Kit.new("Frame", { Size = UDim2.new(0, 10, 1, 10), Position = UDim2.new(0, 0, 0, -5), BackgroundColor3 = T.white, Parent = bar })
		local status = Kit.label(layer, "", { Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromScale(0, 0.6), Font = T.bold, MaxText = 26 })
		local hits, misses = 0, 0
		local need = data.hits or 3
		local done = false
		local function placeZone()
			zone.Position = UDim2.fromScale(math.random() * 0.7 + 0.04, 0)
		end
		placeZone()
		local function finish(success: boolean)
			if done then
				return
			end
			done = true
			State.action("HoldBreath", { success = success })
			status.Text = if success then "...he moves on." else "*GASP*"
			task.delay(0.8, function()
				if token == myToken then
					layer.Visible = false
					Panels.markClosed("HoldBreath")
				end
			end)
		end
		local function tap()
			if done then
				return
			end
			local x = marker.Position.X.Scale
			local z0 = zone.Position.X.Scale
			if x >= z0 - 0.01 and x <= z0 + zone.Size.X.Scale + 0.01 then
				hits += 1
				Audio.play("Click")
				placeZone()
				if hits >= need then
					finish(true)
				end
			else
				misses += 1
				if misses > 1 then
					finish(false)
				end
			end
			status.Text = ("%d / %d"):format(hits, need) .. (if misses > 0 then "  (careful!)" else "")
		end
		Kit.button(layer, "HOLD (Space)", T.navy, tap, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.68), Size = UDim2.fromOffset(300, 90) })
		ContextActionService:BindAction("NS_Breath", function(_, inputState)
			if inputState == Enum.UserInputState.Begin then
				tap()
			end
			return Enum.ContextActionResult.Sink
		end, false, Enum.KeyCode.Space)
		local start = os.clock()
		task.spawn(function()
			while not done and token == myToken do
				local t = os.clock() - start
				local speed = 1.1 + hits * 0.25
				marker.Position = UDim2.new((math.sin(t * speed * 2.4) + 1) / 2 * 0.98, 0, 0, -5)
				if t > (data.seconds or 6) then
					finish(hits >= need)
				end
				RunService.RenderStepped:Wait()
			end
			ContextActionService:UnbindAction("NS_Breath")
		end)
	end
	function HoldBreath.close()
		token += 1
		ContextActionService:UnbindAction("NS_Breath")
		if layer then
			layer.Visible = false
		end
	end
end

---------------------------------------------------------------------------
-- Report (6 AM Shift Report)
---------------------------------------------------------------------------

local REASONS = {
	CorporateCalled = "CORPORATE CALLED. (Stars hit zero.)",
	GhostTown = "GHOST TOWN: STORE CLOSED EARLY.",
}

local Report = {}
do
	local layer: Frame
	function Report.open(data)
		if not layer then
			layer = Panels.layer("Report", 0.4)
		end
		Kit.clear(layer)
		layer.Visible = true
		local _, content = Kit.panel(layer, "MUNCH HOLDINGS LLC — SHIFT REPORT", UDim2.fromOffset(960, 580))
		local gradeColor = ({ Gold = T.mustard, Silver = Color3.fromRGB(200, 200, 210), Bronze = Color3.fromRGB(200, 130, 70) })[data.grade] or T.bad
		Kit.label(content, ("NIGHT %d: %s"):format(data.night, data.title), { Size = UDim2.new(1, 0, 0, 36), Font = T.title, TextColor3 = T.white, MaxText = 30 })
		local headline = if data.success then ("EMPLOYEE BADGE: %s"):format(string.upper(data.grade)) else (REASONS[data.reason] or "SHIFT FAILED")
		local badge = Kit.label(content, headline, { Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, 0, 0, 46), BackgroundTransparency = 0, BackgroundColor3 = gradeColor, TextColor3 = T.ink, Font = T.title, MaxText = 32 })
		Kit.corner(badge, 10)
		local left = Kit.new("Frame", { Position = UDim2.fromOffset(0, 96), Size = UDim2.new(0.5, -8, 1, -170), BackgroundTransparency = 1, Parent = content })
		Kit.list(left, Enum.FillDirection.Vertical, 2)
		local s = data.stats or {}
		local rows = {
			("Stars: %.1f / 5"):format(data.stars or 0),
			("Orders served: %d  (perfect: %d)"):format(s.served or 0, s.perfect or 0),
			("Late Customers caught: %d"):format(s.caught or 0),
			("Late Customers served (oops): %d"):format(s.lateServed or 0),
			("Late Customers who drove off: %d"):format(s.lateMissed or 0),
			("Normal customers refused: %d"):format(s.refusedNormal or 0),
			("Customers who left angry: %d"):format(s.leftAngry or 0),
		}
		if (s.freed or 0) > 0 then
			table.insert(rows, ("Photo-employees freed: %d"):format(s.freed))
		end
		for _, row in rows do
			Kit.label(left, row, { Size = UDim2.new(1, 0, 0, 26), Font = T.bold, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 18 })
		end
		local right = Kit.new("Frame", { Position = UDim2.new(0.5, 8, 0, 96), Size = UDim2.new(0.5, -8, 1, -170), BackgroundTransparency = 1, Parent = content })
		Kit.list(right, Enum.FillDirection.Vertical, 4)
		for _, title in data.titles or {} do
			Kit.label(right, "🏆 " .. title, { Size = UDim2.new(1, 0, 0, 26), Font = T.bold, TextColor3 = T.mustard, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 18 })
		end
		if data.bestCatch then
			Kit.label(right, "Best catch: " .. data.bestCatch, { Size = UDim2.new(1, 0, 0, 44), Font = T.body, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 16 })
		end
		if data.moment then
			Kit.label(right, "📼 Moment of the Night: " .. data.moment, { Size = UDim2.new(1, 0, 0, 66), Font = T.body, TextColor3 = T.paper, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 16 })
		end
		Kit.label(right, ("💵 Paycheck: +%d"):format(data.paychecks or 0), { Size = UDim2.new(1, 0, 0, 34), Font = T.title, TextColor3 = T.good, TextXAlignment = Enum.TextXAlignment.Left, MaxText = 24 })
		local bar = Kit.new("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 60), BackgroundTransparency = 1, Parent = content })
		Kit.list(bar, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Right)
		if not data.isLeader then
			Kit.label(bar, "The shift leader picks what's next.", { Size = UDim2.fromOffset(220, 56), TextColor3 = T.muted, MaxText = 16, LayoutOrder = 0 })
		end
		if data.canNext then
			Kit.button(bar, "NEXT NIGHT ▶", T.good, function()
				State.action("Choose", { choice = "next" })
			end, { Size = UDim2.fromOffset(210, 56), LayoutOrder = 1 })
		end
		Kit.button(bar, "RETRY NIGHT", T.warn, function()
			State.action("Choose", { choice = "retry" })
		end, { Size = UDim2.fromOffset(190, 56), LayoutOrder = 2 })
		Kit.button(bar, "BACK TO THE LOT", T.panelLight, function()
			State.action("Choose", { choice = "lobby" })
		end, { Size = UDim2.fromOffset(220, 56), LayoutOrder = 3 })
	end
	function Report.close()
		if layer then
			layer.Visible = false
		end
	end
end

---------------------------------------------------------------------------
-- Ending
---------------------------------------------------------------------------

local Ending = {}
do
	local layer: Frame
	local token = 0
	function Ending.open(data)
		if not layer then
			layer = Panels.layer("Ending", 0)
		end
		token += 1
		local myToken = token
		Kit.clear(layer)
		layer.Visible = true
		layer.BackgroundTransparency = 1
		TweenService:Create(layer, TweenInfo.new(1.5), { BackgroundTransparency = 0 }):Play()
		local title = Kit.label(layer, data.title or "", { Size = UDim2.new(1, 0, 0, 90), Position = UDim2.fromScale(0, 0.12), Font = T.title, TextColor3 = T.mustard, TextTransparency = 1, MaxText = 70 })
		TweenService:Create(title, TweenInfo.new(2), { TextTransparency = 0 }):Play()
		local list = Kit.scroll(layer, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.26), Size = UDim2.fromOffset(860, 440) })
		Kit.list(list, Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Center)
		Audio.jingle(if data.id == "Freed" then "normal" else "slow")
		task.spawn(function()
			task.wait(2)
			for i, line in data.lines or {} do
				if token ~= myToken then
					return
				end
				local label = Kit.label(list, line, { Size = UDim2.new(1, -16, 0, 28), Font = T.bold, TextColor3 = T.paper, TextTransparency = 1, LayoutOrder = i, MaxText = 22 })
				list.CanvasPosition = Vector2.new(0, math.huge)
				TweenService:Create(label, TweenInfo.new(1), { TextTransparency = 0 }):Play()
				task.wait(if line == "" then 0.6 else 1.6)
			end
			for i, line in data.credits or {} do
				if token ~= myToken then
					return
				end
				Kit.label(list, line, { Size = UDim2.new(1, 0, 0, 22), Font = T.body, TextColor3 = T.muted, LayoutOrder = 100 + i, MaxText = 18 })
				task.wait(0.4)
			end
		end)
		Kit.button(layer, "CONTINUE", T.panelLight, function()
			Panels.close("Ending")
		end, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -20, 1, -20), Size = UDim2.fromOffset(200, 56) })
	end
	function Ending.close()
		token += 1
		if layer then
			layer.Visible = false
		end
	end
end

---------------------------------------------------------------------------
-- VHS training tape
---------------------------------------------------------------------------

local VHS = {}
do
	local layer: Frame
	local token = 0
	function VHS.open(data)
		if not layer then
			layer = Panels.layer("VHS", 0.3)
		end
		token += 1
		local myToken = token
		Kit.clear(layer)
		layer.Visible = true
		local _, content = Kit.panel(layer, "▶ PLAY — " .. (data.title or "VHS"), UDim2.fromOffset(820, 500), function()
			Panels.close("VHS")
		end)
		local screen = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(15, 18, 30), Parent = content })
		Kit.corner(screen, 12)
		Kit.padding(screen, 16)
		Kit.list(screen, Enum.FillDirection.Vertical, 6)
		task.spawn(function()
			for i, line in data.lines or {} do
				if token ~= myToken then
					return
				end
				local label = Kit.label(screen, "", { Size = UDim2.new(1, 0, 0, 40), Font = T.mono, TextColor3 = Color3.fromRGB(190, 220, 255), TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = i, MaxText = 18 })
				for c = 1, #line do
					if token ~= myToken then
						return
					end
					label.Text = string.sub(line, 1, c)
					if c % 3 == 0 then
						Audio.blip(7)
					end
					task.wait(0.025)
				end
				task.wait(0.6)
			end
		end)
	end
	function VHS.close()
		token += 1
		if layer then
			layer.Visible = false
		end
	end
end

---------------------------------------------------------------------------

function Panels.init()
	gui = Kit.screen("NightShiftPanels", 10)
	Panels.root = Kit.root(gui)
	Panels.register("PreShift", PreShift)
	Panels.register("HoldBreath", HoldBreath)
	Panels.register("Report", Report)
	Panels.register("Ending", Ending)
	Panels.register("VHS", VHS)
	Net.event("OpenPanel").OnClientEvent:Connect(function(name, data)
		local ok, err = pcall(Panels.open, name, data)
		if not ok then
			warn("[Panels] open " .. tostring(name) .. ": " .. tostring(err))
		end
	end)
	Net.event("ClosePanel").OnClientEvent:Connect(function(name)
		local ok, err = pcall(Panels.close, name)
		if not ok then
			warn("[Panels] close " .. tostring(name) .. ": " .. tostring(err))
		end
	end)
	player:GetAttributeChangedSignal("Crew"):Connect(function()
		if not State.isCrew() then
			for _, name in { "PreShift", "HoldBreath", "Order", "Assembly", "Window" } do
				Panels.close(name)
			end
		end
	end)
end

return Panels
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">State</string>
              <string name="Source"><![CDATA[-- Latest server snapshots for the UI: the shift HUD state, the saved profile and the lobby.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Signal)

local State = {}

State.shift = nil :: any
State.profile = nil :: any
State.lobby = nil :: any
State.ShiftChanged = Signal.new()
State.ProfileChanged = Signal.new()
State.LobbyChanged = Signal.new()
State.flags = {} :: { [string]: any } -- client-side effect flags (ChannelSurf, MascotMob, ...)

local player = Players.LocalPlayer

function State.isCrew(): boolean
	return player:GetAttribute("Crew") ~= nil
end

function State.isGhost(): boolean
	return player:GetAttribute("Ghost") == true
end

function State.isHidden(): boolean
	return player:GetAttribute("Hidden") ~= nil
end

function State.setting(name: string): any
	local profile = State.profile
	if profile and profile.settings then
		return profile.settings[name]
	end
	if name == "captions" then
		return true
	end
	return false
end

function State.action(name: string, data: any?)
	Net.event("Action"):FireServer(name, data or {})
end

function State.request(name: string, data: any?): any
	local ok, result = pcall(function()
		return Net.func("Request"):InvokeServer(name, data or {})
	end)
	if ok then
		return result or {}
	end
	return { ok = false, message = "Couldn't reach the server." }
end

function State.init()
	Net.event("State").OnClientEvent:Connect(function(snapshot)
		State.shift = snapshot
		State.ShiftChanged:Fire(snapshot)
	end)
	Net.event("Profile").OnClientEvent:Connect(function(profile)
		State.profile = profile
		State.ProfileChanged:Fire(profile)
	end)
	Net.event("LobbyState").OnClientEvent:Connect(function(lobby)
		State.lobby = lobby
		State.LobbyChanged:Fire(lobby)
	end)
	task.spawn(function()
		local profile = State.request("GetProfile")
		if profile and profile.paychecks ~= nil then
			State.profile = profile
			State.ProfileChanged:Fire(profile)
		end
	end)
end

return State
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">WindowPanel</string>
              <string name="Source"><![CDATA[-- The pickup window inspection (design doc §5.1 detection channels, §7.8 "a single swipe cycles
-- Window <-> Mirror <-> Lane Cam <-> Receipt", big HAND OUT / REFUSE buttons placed apart).
--   WINDOW   the real 3D view out the pickup window (ears, fingers, faces, hats)
--   MIRROR   the convex safety mirror (a ViewportFrame "reflection" — waves late, wrong head...)
--   LANE CAM the CCTV view (camera-only tells: missing shadows, one tall guy, painted faces)
--   RECEIPT  what the printer printed
--   UV       (Night 4+) hidden marks glow

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Layout = require(Shared.Builders.Layout)
local ModelFactory = require(Shared.Builders.ModelFactory)
local Kit = require(script.Parent.Parent.UI.Kit)
local State = require(script.Parent.State)
local Panels = require(script.Parent.Panels)
local CameraView = require(script.Parent.CameraView)
local World = require(script.Parent.World)
local Effects = require(script.Parent.Effects)
local Audio = require(script.Parent.Audio)

local T = Kit.Theme
local player = Players.LocalPlayer

local WindowPanel = {}

local TABS = { "WINDOW", "MIRROR", "LANE CAM", "RECEIPT" }
local HINTS = {
	WINDOW = "Look closely: ears, fingers, faces, hats, who's even driving.",
	MIRROR = "Reflections don't lie. Is it doing what they're doing?",
	["LANE CAM"] = "On camera: shadows, passengers, the driver... what's different?",
	RECEIPT = "Check the name and the total.",
}

local layer: Frame
local tabBar: Frame
local tabButtons: { [string]: TextButton } = {}
local hintLabel: TextLabel
local infoLabel: TextLabel
local mirrorFrame: Frame
local viewport: ViewportFrame
local camOverlay: Frame
local receiptCard: Frame
local handOut: TextButton
local refuse: TextButton
local uvButton: TextButton
local data: any = nil
local tab = "WINDOW"
local mirrorToken = 0
local cc: ColorCorrectionEffect? = nil
local decided = false

local function camCFrame(name: string): (CFrame, number)
	local c = Layout.Cameras[name]
	return CFrame.lookAt(c.from, c.to), c.fov
end

---------------------------------------------------------------------------
-- Mirror (viewport reflection)
---------------------------------------------------------------------------

local function stripChannelParts(model: Instance)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			local channel = d:GetAttribute("Channel")
			if channel == "CamOnly" or channel == "UVOnly" then
				d:Destroy()
			end
		elseif d:IsA("BillboardGui") or d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy()
		end
	end
end

local function replaceWithMunchHead(clone: Model)
	local knockoff = clone:FindFirstChild("KnockoffHead")
	local bunBottom = knockoff and knockoff:FindFirstChild("BunBottom") :: BasePart?
	if not knockoff or not bunBottom then
		return
	end
	local munch = ModelFactory.buildMunch({ scale = 0.6 })
	local head = munch:FindFirstChild("Head") :: Model?
	local munchBun = head and head:FindFirstChild("BunBottom") :: BasePart?
	if head and munchBun then
		local delta = bunBottom.CFrame * munchBun.CFrame:Inverse()
		for _, d in head:GetDescendants() do
			if d:IsA("BasePart") then
				d.CFrame = delta * d.CFrame
			end
		end
		head.Parent = clone
	end
	knockoff:Destroy()
	munch:Destroy()
end

-- ViewportFrames don't render SurfaceGuis, so faces in the reflection are rebuilt from parts.
local function facePart(parent: Instance, cf: CFrame, size: Vector3, color: Color3, neon: boolean?)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = if neon then Enum.Material.Neon else Enum.Material.SmoothPlastic
	p.Parent = parent
	return p
end

local function rebuildFaces(clone: Model, crying: boolean)
	for _, d in clone:GetDescendants() do
		if d:IsA("SurfaceGui") and d.Parent and d.Parent:IsA("BasePart") then
			local part = d.Parent :: BasePart
			local w, h = part.Size.X, part.Size.Y
			local front = part.CFrame * CFrame.new(0, 0, -part.Size.Z / 2 - 0.03)
			local container = part.Parent or clone
			if d.Name == "FaceGui" or d.Name == "MunchFace" then
				local face = d:FindFirstChild("Face")
				local mouth = face and face:FindFirstChild("Mouth") :: Frame?
				local mouthWidth = if mouth then mouth.Size.X.Scale else 0.36
				for _, x in { -0.18, 0.18 } do
					facePart(container, front * CFrame.new(x * w, 0.1 * h, 0), Vector3.new(0.2 * w, 0.2 * h, 0.04), Color3.new(1, 1, 1))
					facePart(container, front * CFrame.new(x * w, 0.08 * h, -0.02), Vector3.new(0.1 * w, 0.1 * h, 0.04), Color3.new(0, 0, 0))
				end
				facePart(container, front * CFrame.new(0, -0.22 * h, 0), Vector3.new(mouthWidth * w, 0.07 * h, 0.04), Color3.fromRGB(150, 40, 50))
				if crying then
					for _, x in { -0.2, 0.2 } do
						facePart(container, front * CFrame.new(x * w, -0.1 * h, -0.02), Vector3.new(0.06 * w, 0.16 * h, 0.04), Color3.fromRGB(90, 160, 255), true)
					end
				end
			elseif d.Name == "RobotFace" then
				for _, x in { -0.2, 0.2 } do
					facePart(container, front * CFrame.new(x * w, 0.1 * h, 0), Vector3.new(0.18 * w, 0.18 * h, 0.04), Color3.fromRGB(80, 255, 140), true)
				end
			end
			d:Destroy()
		end
	end
end

local function clearViewport()
	for _, child in viewport:GetChildren() do
		if not child:IsA("UICorner") then
			child:Destroy()
		end
	end
end

local function buildMirror()
	mirrorToken += 1
	local token = mirrorToken
	clearViewport()
	if not data or not data.car or not data.car.Parent then
		return
	end
	local ok, clone = pcall(function()
		return data.car:Clone()
	end)
	if not ok or not clone then
		return
	end
	stripChannelParts(clone)
	local tell = data.mirrorTell or "None"
	if tell == "MunchReflection" then
		replaceWithMunchHead(clone)
	elseif tell == "NoReflection" then
		for _, name in { "Head", "Torso", "Hair", "Hand", "Arm" } do
			local p = clone:FindFirstChild(name)
			if p then
				p:Destroy()
			end
		end
	end
	rebuildFaces(clone, tell == "Crying")
	clone.Parent = viewport
	local camera = Instance.new("Camera")
	local cf, fov = camCFrame("Mirror")
	camera.CFrame = cf
	camera.FieldOfView = fov
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	-- the reflection waves while the real customer doesn't
	if tell == "LateWave" or tell == "Crying" then
		local hand = clone:FindFirstChild("Hand") :: Model?
		local palm = hand and hand:FindFirstChild("Palm") :: BasePart?
		if hand and palm then
			local baseCFrames = {}
			for _, p in hand:GetChildren() do
				if p:IsA("BasePart") then
					baseCFrames[p] = palm.CFrame:ToObjectSpace(p.CFrame)
				end
			end
			local pivot = palm.CFrame
			task.spawn(function()
				local t = 0
				while token == mirrorToken and tab == "MIRROR" do
					t += RunService.RenderStepped:Wait()
					local wave = pivot * CFrame.Angles(0, 0, math.rad(math.sin(t * 7) * 30))
					for p, rel in baseCFrames do
						p.CFrame = wave * rel
					end
				end
			end)
		end
	end
end

---------------------------------------------------------------------------
-- Receipt
---------------------------------------------------------------------------

local function buildReceipt()
	Kit.clear(receiptCard)
	local r = data and data.receipt
	local list = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = receiptCard })
	Kit.list(list, Enum.FillDirection.Vertical, 2, Enum.HorizontalAlignment.Center)
	local function line(text: string, props: { [string]: any }?)
		local p = { Size = UDim2.new(1, 0, 0, 24), TextColor3 = T.ink, Font = T.mono, MaxText = 16, LayoutOrder = #list:GetChildren() }
		if props then
			for k, v in props do
				p[k] = v
			end
		end
		return Kit.label(list, text, p)
	end
	line("MUNCHIE'S #001 — EXIT 13", { Font = T.bold })
	line("OPEN LATE. OPEN ALWAYS.", { MaxText = 13 })
	line("--------------------------")
	if not r then
		line("(no receipt — nobody took", { MaxText = 14 })
		line(" this car's order)", { MaxText = 14 })
		return
	end
	line(("TICKET #%d   %s"):format(r.number or 0, r.time or ""))
	line("GUEST: " .. tostring(r.name or "GUEST"), { Font = T.bold })
	line("--------------------------")
	for _, item in r.lines or {} do
		line(item, { TextXAlignment = Enum.TextXAlignment.Left })
	end
	if #(r.lines or {}) == 0 then
		line("(nothing)")
	end
	line("--------------------------")
	line("TOTAL  " .. tostring(r.total or ""), { Font = T.bold })
	if r.note and r.note ~= "" then
		line(r.note, { Font = T.hand, TextColor3 = Color3.fromRGB(80, 60, 160), MaxText = 20 })
	end
	if r.warm then
		line("(it's warm. and damp.)", { Font = T.hand, TextColor3 = T.bad, MaxText = 18 })
	end
	line("THANK YOU! COME BACK ALWAYS.", { MaxText = 13 })
end

---------------------------------------------------------------------------
-- Tabs
---------------------------------------------------------------------------

local function setTab(name: string)
	tab = name
	for tabName, button in tabButtons do
		button.BackgroundColor3 = if tabName == name then T.ketchup else T.panelLight
	end
	hintLabel.Text = HINTS[name] or ""
	mirrorFrame.Visible = name == "MIRROR"
	camOverlay.Visible = name == "LANE CAM"
	receiptCard.Visible = name == "RECEIPT"
	if name == "LANE CAM" then
		local cf, fov = camCFrame("LaneCam")
		CameraView.push("LaneCam", cf, fov)
		World.setMode("LaneCam")
		if cc then
			cc.Enabled = true
		end
		local noSignal = camOverlay:FindFirstChild("NoSignal") :: TextLabel?
		if noSignal then
			noSignal.Visible = Effects.flagActive("MascotMob")
		end
	else
		CameraView.pop("LaneCam")
		World.setMode("Normal")
		if cc then
			cc.Enabled = false
		end
	end
	if name == "MIRROR" then
		buildMirror()
	else
		mirrorToken += 1
	end
	if name == "RECEIPT" then
		buildReceipt()
	end
end

local function cycle(step: number)
	local index = table.find(TABS, tab) or 1
	index = ((index - 1 + step) % #TABS) + 1
	setTab(TABS[index])
end

local function decide(decision: string)
	if not data or decided then
		return
	end
	decided = true
	handOut.Active = false
	refuse.Active = false
	if decision == "refuse" then
		Audio.play("Shutter")
	end
	State.action("Decide", { carId = data.carId, decision = decision })
end

---------------------------------------------------------------------------

local function build()
	layer = Panels.layer("Window", 1)
	layer.Active = false
	-- tabs
	tabBar = Kit.new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 12), Size = UDim2.fromOffset(820, 56), BackgroundTransparency = 1, Parent = layer })
	Kit.list(tabBar, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center)
	Kit.button(tabBar, "◀", T.ink, function()
		cycle(-1)
	end, { Size = UDim2.fromOffset(56, 52), LayoutOrder = 0 })
	for i, name in TABS do
		tabButtons[name] = Kit.button(tabBar, name, T.panelLight, function()
			setTab(name)
		end, { Size = UDim2.fromOffset(150, 52), LayoutOrder = i })
	end
	Kit.button(tabBar, "▶", T.ink, function()
		cycle(1)
	end, { Size = UDim2.fromOffset(56, 52), LayoutOrder = 10 })
	uvButton = Kit.button(layer, "🔦 UV", T.panelLight, function()
		World.setUV(not World.uv)
		uvButton.BackgroundColor3 = if World.uv then T.uv else T.panelLight
		if World.uv then
			State.action("UsedUV")
		end
	end, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 76), Size = UDim2.fromOffset(140, 52), Visible = false })
	Kit.button(layer, "✕ BACK", T.ink, function()
		WindowPanel.userClose()
	end, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 14), Size = UDim2.fromOffset(140, 52) })
	hintLabel = Kit.label(layer, "", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 74), Size = UDim2.fromOffset(760, 30), Font = T.bold, TextStrokeTransparency = 0.3, MaxText = 20 })
	infoLabel = Kit.label(layer, "", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, if UserInputService.TouchEnabled then -242 else -112),
		Size = UDim2.fromOffset(760, 34),
		BackgroundTransparency = 0.25,
		BackgroundColor3 = T.ink,
		Font = T.bold,
		MaxText = 18,
	})
	Kit.corner(infoLabel, 10)
	-- mirror
	mirrorFrame = Kit.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.48), Size = UDim2.fromOffset(470, 470), BackgroundColor3 = Color3.fromRGB(190, 195, 205), Visible = false, Parent = layer })
	Kit.corner(mirrorFrame, 235)
	viewport = Kit.new("ViewportFrame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(440, 440),
		BackgroundColor3 = Color3.fromRGB(20, 22, 30),
		Ambient = Color3.fromRGB(170, 170, 180),
		LightColor = Color3.fromRGB(255, 240, 220),
		LightDirection = Vector3.new(-1, -1, -0.5),
		Parent = mirrorFrame,
	})
	Kit.corner(viewport, 220)
	Kit.label(mirrorFrame, "CONVEX SAFETY MIRROR", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 1, 6), Size = UDim2.fromOffset(300, 24), Font = T.bold, TextStrokeTransparency = 0.3, MaxText = 16 })
	-- lane cam overlay
	camOverlay = Kit.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = layer })
	for i = 0, 40 do
		Kit.new("Frame", { Position = UDim2.fromScale(0, i / 40), Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.8, Parent = camOverlay })
	end
	Kit.label(camOverlay, "CAM 01  ● REC", { Position = UDim2.fromOffset(24, 120), Size = UDim2.fromOffset(300, 36), Font = T.mono, TextColor3 = Color3.fromRGB(255, 70, 70), TextXAlignment = Enum.TextXAlignment.Left, MaxText = 28 })
	Kit.label(camOverlay, "NO SIGNAL\n▒▓░ (knockoff mascots are dancing on the camera) ░▓▒", {
		Name = "NoSignal",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 0.1,
		BackgroundColor3 = Color3.fromRGB(30, 30, 30),
		Font = T.mono,
		Visible = false,
		MaxText = 40,
	})
	-- receipt
	receiptCard = Kit.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.48), Size = UDim2.fromOffset(360, 470), BackgroundColor3 = Color3.fromRGB(250, 248, 240), Visible = false, Parent = layer })
	Kit.corner(receiptCard, 6)
	Kit.padding(receiptCard, 12)
	-- decision buttons (far apart)
	-- on touch screens keep clear of the thumbstick (bottom-left) and jump button (bottom-right)
	local lift = if UserInputService.TouchEnabled then 150 else 20
	handOut = Kit.button(layer, "HAND OUT", T.good, function()
		decide("handout")
	end, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 24, 1, -lift), Size = UDim2.fromOffset(300, 86) })
	refuse = Kit.button(layer, "REFUSE\nSORRY, WE'RE CLOSED", T.bad, function()
		decide("refuse")
	end, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -lift), Size = UDim2.fromOffset(300, 86) })
end

function WindowPanel.open(d)
	if not layer then
		build()
	end
	data = d
	decided = false
	handOut.Active = true
	refuse.Active = true
	layer.Visible = true
	local cf, fov = camCFrame("Window")
	CameraView.push("Window", cf, fov)
	uvButton.Visible = d.uv == true
	uvButton.BackgroundColor3 = if World.uv then T.uv else T.panelLight
	local info = {}
	if d.bag then
		table.insert(info, ("Ticket #%d • Bag %d/%d"):format(d.bag.number, d.bag.ticketMatched, d.bag.ticketLines))
		if d.bag.flagged then
			table.insert(info, "⚠ FLAGGED SUSPICIOUS")
		end
	elseif not d.onFoot then
		table.insert(info, "No ticket for this car")
	end
	if d.wantsUsual then
		table.insert(info, "They want THE USUAL (check the photos with UV)")
	end
	infoLabel.Text = table.concat(info, "   •   ")
	infoLabel.Visible = #info > 0
	refuse.BackgroundColor3 = T.bad
	if d.tutorialRefuse then
		TweenService:Create(refuse, TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 8, true), { BackgroundColor3 = T.mustard }):Play()
	end
	setTab("WINDOW")
	ContextActionService:BindAction("NS_WindowTabs", function(_, inputState, input)
		if inputState == Enum.UserInputState.Begin then
			cycle(if input.KeyCode == Enum.KeyCode.Left or input.KeyCode == Enum.KeyCode.A then -1 else 1)
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.Left, Enum.KeyCode.Right)
end

function WindowPanel.close()
	mirrorToken += 1
	data = nil
	ContextActionService:UnbindAction("NS_WindowTabs")
	if layer then
		layer.Visible = false
		clearViewport()
	end
	CameraView.pop("LaneCam")
	CameraView.pop("Window")
	World.setMode("Normal")
	if cc then
		cc.Enabled = false
	end
end

function WindowPanel.userClose()
	State.action("CloseWindow")
	Panels.close("Window")
end

function WindowPanel.init()
	Panels.register("Window", WindowPanel)
	local tint = Instance.new("ColorCorrectionEffect")
	tint.Name = "LaneCamTint"
	tint.TintColor = Color3.fromRGB(170, 255, 170)
	tint.Saturation = -0.7
	tint.Contrast = 0.2
	tint.Enabled = false
	tint.Parent = game:GetService("Lighting")
	cc = tint
	UserInputService.TouchSwipe:Connect(function(direction)
		if data and layer and layer.Visible then
			if direction == Enum.SwipeDirection.Left then
				cycle(1)
			elseif direction == Enum.SwipeDirection.Right then
				cycle(-1)
			end
		end
	end)
	player:GetAttributeChangedSignal("Ghost"):Connect(function()
		if State.isGhost() then
			-- a ghost can't work any station
			for _, name in { "Window", "Order", "Assembly" } do
				Panels.close(name)
			end
		end
	end)
end

return WindowPanel
]]></string>
            </Properties>
